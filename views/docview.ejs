<script>
    const reportOverlay = document.getElementById("report-overlay");
    const openReportModalBtn = document.getElementById("open-report-modal");
    const closeReportModalBtn = document.getElementById("close-report-modal");
    const cancelReportModalBtn = document.getElementById("cancel-report-modal");
    const doneReportModalBtn = document.getElementById("done-report-modal");
    const reportForm = document.getElementById("report-form");
    const reportSuccess = document.getElementById("report-success");
    const reportMessage = document.getElementById("report-message");
    const reportCount = document.getElementById("report-count");
    const submitReportBtn = document.getElementById("submit-report-btn");

    function openReportModal() {
        reportOverlay.classList.add("active");
        document.body.classList.add("report-modal-open");
    }

    function closeReportModal() {
        reportOverlay.classList.remove("active");
        document.body.classList.remove("report-modal-open");
        setTimeout(() => {
            reportForm.style.display = "flex";
            reportSuccess.classList.remove("active");
            reportForm.reset();
            reportCount.textContent = "0 / 500";
            submitReportBtn.disabled = false;
            submitReportBtn.textContent = "Submit Report";
        }, 180);
    }

    if (openReportModalBtn) {
        openReportModalBtn.addEventListener("click", openReportModal);
    }

    [closeReportModalBtn, cancelReportModalBtn, doneReportModalBtn].forEach((btn) => {
        if (btn) btn.addEventListener("click", closeReportModal);
    });
    if (reportOverlay) {
        reportOverlay.addEventListener("click", (e) => {
            if (e.target === reportOverlay) {
                closeReportModal();
            }
        });
    }

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && reportOverlay.classList.contains("active")) {
            closeReportModal();
        }
    });
    if (reportMessage) {
        reportMessage.addEventListener("input", () => {
            reportCount.textContent = `${reportMessage.value.length} / 500`;
        });
    }

    if (reportForm) {
        reportForm.addEventListener("submit", async (e) => {
            e.preventDefault();

            const selectedReason = document.querySelector('input[name="report_reason"]:checked');
            const details = reportMessage.value.trim();

            if (!selectedReason) {
                showDocupPopup("Select a Reason", "Please choose a report reason before submitting.");

                return;
            }

            submitReportBtn.disabled = true;
            submitReportBtn.textContent = "Submitting...";

            try {
                const response = await fetch("/report_doc", {

                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({

                        email: "<%= user.email %>",
                        report_text: `${selectedReason.value}${details ? " — " + details : ""}`,
                        doc_new_id: "<%= doc._id %>"

                    })
                });
                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.message || "Failed to submit report.");
                }

                reportForm.style.display = "none";
                reportSuccess.classList.add("active");
            } catch (err) {
                showDocupPopup("Submission Failed", err.message || "Something went wrong.");
                submitReportBtn.disabled = false;
                submitReportBtn.textContent = "Submit Report";
            }
        });
    }
</script>

