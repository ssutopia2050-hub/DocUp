<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>DocUp | ViewDoc</title>
    <link rel="shortcut icon" href="/images/favicon-32x32.png" type="image/x-icon">
    <link rel="stylesheet" href="/docview.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Saira:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
</head>
<body>
<header class="topbar">
    <div class="topbar-left">
        <div class="logo-text-container">DocUp</div>
    </div>

    <div class="pg-links">
        <a class="topbar-link active-link" href="/dashboard">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 2a8 8 0 105.293 14.293l4.707 4.707 1.414-1.414-4.707-4.707A8 8 0 0010 2zm0 2a6 6 0 110 12 6 6 0 010-12z"/>
            </svg>
            <span>FindDocs</span>
        </a>

        <div class="notification-wrap">
            <div class="notification-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none">
                    <path d="M9 17H15M6.5 17H17.5C16.9 16.35 16.5 15.48 16.5 14.5V10.5C16.5 8.01 14.49 6 12 6C9.51 6 7.5 8.01 7.5 10.5V14.5C7.5 15.48 7.1 16.35 6.5 17Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>
                    <path d="M10.5 20C10.74 20.62 11.32 21 12 21C12.68 21 13.26 20.62 13.5 20"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>
                </svg>

                <% const unreadCount = (user.notifications || []).filter(n => !n.isRead).length; %>
                <% if (unreadCount > 0) { %>
                <span class="notification-badge"><%= unreadCount > 9 ? "9+" : unreadCount %></span>
                <% } %>
            </div>

            <div class="notification-dropdown">
                <div class="notification-dropdown-header">
                    <span>Notifications</span>
                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <a href="/notifications" class="notification-view-all">View all</a>
                    <% } %>
                </div>

                <div class="notification-list">
                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <% user.notifications.slice().reverse().forEach((item) => { %>
                    <div class="notification-item <%= item.isRead ? '' : 'unread' %>">
                        <div class="notification-item-top">
                            <div class="notification-item-top-left">
                                <span class="notification-dot"></span>
                                <span class="notification-label"><%= item.isRead ? "Seen" : "New" %></span>
                            </div>

                            <span class="notification-meta">
                                <%= item.createdAt
                                ? new Date(item.createdAt).toLocaleString("en-IN", {
                                    dateStyle: "medium",
                                    timeStyle: "short"
                                })
                                : "Just now" %>
                            </span>
                        </div>

                        <div class="notification-content">
                            <%= item.content %>
                        </div>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="notification-empty">
                        No notifications yet.
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="profile-btn">
            <% if (user.avatar_img_path) { %>
            <img src="<%= user.avatar_img_path %>" alt="">
            <% } else { %>
            <%= user.name ? user.name.charAt(0).toUpperCase() : "U" %>
            <% } %>
        </div>
    </div>
</header>

<div class="profile-btn-dropdown">
    <a href="/profile">Profile</a>
    <a href="/pricing">Recharge DocScore</a>
</div>

<main class="viewer-page">
    <section class="doc-shell">
        <div class="doc-summary-card">
            <div class="doc-summary-left">
                <div class="hero-logo">
                    <img
                            src="<%= college_data && college_data.image ? college_data.image : '/images/default.png' %>"
                            alt="college logo"
                            onerror="this.onerror=null; this.src='/images/default.png';"
                    >
                </div>

                <div class="doc-summary-meta">
                    <div class="doc-summary-topline">
                        <span class="doc-pill subtle-pill"><%= doc.college %></span>
                        <% if (doc.reviewed) { %>
                        <span class="verif-status verified">Verified</span>
                        <% } else { %>
                        <span class="verif-status not-verified">To be reviewed</span>
                        <% } %>
                    </div>

                    <h1><%= doc.title || doc.chapter %></h1>

                    <p class="doc-subtitle">
                        <%= doc.subject %> • <%= doc.branch %> • <%= doc.year %> • Semester <%= doc.semester %>
                    </p>

                    <div class="doc-tags">
                        <span class="doc-tag"><%= doc.subject %></span>
                        <span class="doc-tag"><%= doc.branch %></span>
                        <span class="doc-tag"><%= doc.year %></span>
                        <span class="doc-tag"><%= doc.chapter %></span>
                    </div>
                </div>
            </div>

            <div class="doc-actions">
                <a href="/college/<%= encodeURIComponent(doc.college) %>" class="ghost-btn">Back</a>

                <button
                        type="button"
                        id="open-share-doc-modal"
                        class="share-doc-btn"
                        data-doc-id="<%= doc._id %>"
                        data-doc-college="<%= doc.college %>"
                        data-doc-subject="<%= doc.subject %>"
                        data-doc-chapter="<%= doc.chapter %>"
                >
                    Share to College Chat
                </button>

                <a href="/update_likes/<%= doc._id %>" class="ghost-btn stat-btn">
                    <span class="stat-count"><%= doc.likes %></span>
                    <span>Like</span>
                </a>

                <a href="/update_dislikes/<%= doc._id %>" class="ghost-btn stat-btn">
                    <span>Dislike</span>
                    <span class="stat-count"><%= doc.dislikes %></span>
                </a>

                <a href="/save/<%= doc._id %>" class="ghost-btn save-btn">Save</a>
            </div>
        </div>

        <section class="viewer-layout">
            <div class="pdf-panel">
                <div class="viewer-toolbar">
                    <div class="toolbar-left">
                        <div class="toolbar-group">
                            <button type="button" class="tool-btn" id="zoom-out">−</button>

                            <div class="zoom-pill">
                                <span id="zoom-percentage">115%</span>
                            </div>

                            <button type="button" class="tool-btn" id="zoom-in">+</button>
                            <button type="button" class="tool-btn" id="fit-width">Fit Width</button>
                        </div>

                        <div class="toolbar-group toolbar-ai-actions">
                            <button type="button" class="tool-btn ai-tool-btn" id="ask-pdf-btn">Ask PDF</button>
                            <button type="button" class="tool-btn ai-tool-btn" id="explain-page-btn">Explain This Page</button>
                            <button type="button" class="tool-btn ai-tool-btn" id="summarize-doc-btn">Summarize Document</button>
                        </div>
                    </div>

                    <div class="toolbar-right">
                        <div class="page-jump-box">
                            <label for="page-jump-input">Page</label>
                            <input id="page-jump-input" type="number" min="1" value="1">
                            <span id="page-jump-total">/ 0</span>
                        </div>

                        <span id="page-status">Loading PDF...</span>
                    </div>
                </div>

                <div class="pdf-stage-topline">
                    <div class="pdf-page-indicator" id="pdf-page-indicator">
                        <span id="current-page-number">1</span>
                        /
                        <span id="total-page-number">0</span>
                    </div>
                </div>

                <div class="pdf-scroll-area" id="pdf-scroll-area">
                    <div class="reader-watermark-shell">
                        <div id="pdf-container"></div>
                    </div>
                </div>
            </div>

            <aside class="side-panel">
                <div class="side-card ai-explainer-card primary-side-card">
                    <div class="ai-card-header">
                        <h2>AI Explainer</h2>
                        <span id="ai-status-badge">Still in Development</span>
                    </div>

                    <div class="ai-quick-question">
                        <input
                                type="text"
                                id="ask-pdf-input"
                                placeholder="Ask something from this PDF..."
                        >
                        <button type="button" id="ask-pdf-send-btn">Ask</button>
                    </div>

                    <div class="ai-suggestion-row">
                        <button type="button" class="mini-suggestion" id="mini-explain-trigger">Explain this page</button>
                        <button type="button" class="mini-suggestion" id="mini-summary-trigger">Summarize doc</button>
                    </div>

                    <div id="ai-panel-content" class="ai-panel-content">
                        <p class="ai-placeholder">
                            Use Ask PDF, Explain This Page, or Summarize Document.
                        </p>
                    </div>
                </div>

                <div class="side-card">
                    <h2>Document Info</h2>
                    <div class="info-list info-grid">
                        <p><span>College</span><strong><a href="/college/<%= encodeURIComponent(doc.college) %>"><%= doc.college %></a></strong></p>
                        <p><span>Subject</span><strong><%= doc.subject %></strong></p>
                        <p><span>Semester</span><strong><%= doc.semester %></strong></p>
                        <p><span>Branch</span><strong><%= doc.branch %></strong></p>
                        <p><span>Chapter</span><strong><%= doc.chapter %></strong></p>
                        <p><span>Uploader</span><strong><%= doc.uploaded_by || "DocUp User" %></strong></p>
                    </div>
                </div>

                <div class="side-card discussion-card">
                    <div class="side-card-topline">
                        <h2 class="discussion-panel-title">Discussion</h2>
                        <span class="discussion-count"><%= doc.comment_section ? doc.comment_section.length : 0 %> comments</span>
                    </div>

                    <div class="discussion-panel">
                        <div class="comment-input-panel">
                            <input class="comment-input-container" type="text" placeholder="Form a discussion...">
                            <svg class="comment-send-button" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#FF4500FF">
                                <g id="SVGRepo_iconCarrier">
                                    <path d="M10.3009 13.6949L20.102 3.89742M10.5795 14.1355L12.8019 18.5804C13.339 19.6545 13.6075 20.1916 13.9458 20.3356C14.2394 20.4606 14.575 20.4379 14.8492 20.2747C15.1651 20.0866 15.3591 19.5183 15.7472 18.3818L19.9463 6.08434C20.2845 5.09409 20.4535 4.59896 20.3378 4.27142C20.2371 3.98648 20.013 3.76234 19.7281 3.66167C19.4005 3.54595 18.9054 3.71502 17.9151 4.05315L5.61763 8.2523C4.48114 8.64037 3.91289 8.83441 3.72478 9.15032C3.56153 9.42447 3.53891 9.76007 3.66389 10.0536C3.80791 10.3919 4.34498 10.6605 5.41912 11.1975L9.86397 13.42C10.041 13.5085 10.1295 13.5527 10.2061 13.6118C10.2742 13.6643 10.3352 13.7253 10.3876 13.7933C10.4468 13.87 10.491 13.9585 10.5795 14.1355Z"
                                          stroke="#FF4500FF"
                                          stroke-width="2"
                                          stroke-linecap="round"
                                          stroke-linejoin="round"></path>
                                </g>
                            </svg>
                        </div>

                        <div class="comments-container-panel">
                            <% if (doc.comment_section && doc.comment_section.length > 0) { %>
                            <% doc.comment_section.forEach((item) => { %>
                            <div class="comment">
                                <div class="comment-avatar">
                                    <img
                                            src="<%= item.user_id && item.user_id.avatar_img_path ? item.user_id.avatar_img_path : '/images/default-avatar.png' %>"
                                            alt="avatar">
                                </div>

                                <div class="comment-body">
                                    <div class="comment-head">
                                        <a class="comment-name" href="/show_other_user_profile/<%= encodeURIComponent(item.user_id.email) %>">
                                            <%= item.user_id && item.user_id.name ? item.user_id.name : "DocUp User" %>
                                        </a>

                                        <div
                                                class="reply-btn"
                                                data-reply-name="<%= item.user_id && item.user_id.name ? item.user_id.name : 'DocUp User' %>"
                                                data-reply-email="<%= item.user_id && item.user_id.email ? item.user_id.email : '' %>"
                                        >
                                            Reply
                                        </div>
                                    </div>

                                    <div class="comment-time">
                                        <%= new Date(item.createdAt).toLocaleString() %>
                                    </div>

                                    <div class="comment-text">
                                        <%= item.comment %>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                            <% } else { %>
                            <div class="comment empty-comment">
                                <div class="comment-text">No comments yet. Be the first to comment.</div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="side-card scroll-top-card">
                    <button id="scrollTopBtn" class="scroll-top-btn">↑ Back To Top</button>
                </div>
            </aside>
        </section>
    </section>
</main>

<div id="share-doc-modal" class="share-doc-modal hidden">
    <div class="share-doc-backdrop"></div>

    <div class="share-doc-card">
        <div class="share-doc-head">
            <div>
                <div class="share-doc-badge">DocUp Share</div>
                <h2>Share to College Chat</h2>
                <p>Send this document to your college room with an optional message.</p>
            </div>
        </div>

        <div class="share-doc-preview">
            <div class="share-doc-preview-label">Document</div>
            <div class="share-doc-preview-title"><%= doc.subject %></div>
            <div class="share-doc-preview-subtitle"><%= doc.chapter %> • <%= doc.college %></div>
        </div>

        <textarea
                id="share-doc-text"
                class="share-doc-textarea"
                placeholder="Add a message about this document..."
                maxlength="300"
        ></textarea>

        <div class="share-doc-actions">
            <button type="button" id="close-share-doc-modal" class="share-doc-action-btn secondary">Cancel</button>
            <button type="button" id="confirm-share-doc" class="share-doc-action-btn primary">Share</button>
        </div>
    </div>
</div>

<div id="share-success-modal" class="share-doc-modal hidden">
    <div class="share-doc-backdrop"></div>

    <div class="share-doc-card share-success-card">
        <div class="share-success-icon">✓</div>
        <h2>Document Shared</h2>
        <p>Your document was shared successfully to the college chat room.</p>

        <div class="share-doc-actions">
            <button type="button" id="continue-reading-btn" class="share-doc-action-btn secondary">
                Continue Reading
            </button>
            <a
                    id="go-to-chat-room-btn"
                    class="share-doc-action-btn primary share-doc-link-btn"
                    href="/college_chat/<%= encodeURIComponent(doc.college) %>"
            >
                Go to Chat Room
            </a>
        </div>
    </div>
</div>

<script>
    window.DOC_SHARE_CONFIG = {
        docId: <%- JSON.stringify(String(doc._id)) %>,
        collegeName: <%- JSON.stringify(doc.college) %>
    };
</script>

<script src="/doc_share.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const input = document.querySelector(".comment-input-container");
        const replyButtons = document.querySelectorAll(".reply-btn");
        const miniExplain = document.getElementById("mini-explain-trigger");
        const miniSummary = document.getElementById("mini-summary-trigger");

        replyButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const email = btn.dataset.replyEmail || "";
                input.value = `@$${email}# : `;
                input.focus();
            });
        });

        if (miniExplain) {
            miniExplain.addEventListener("click", () => {
                const trigger = document.getElementById("explain-page-btn");
                if (trigger) trigger.click();
            });
        }

        if (miniSummary) {
            miniSummary.addEventListener("click", () => {
                const trigger = document.getElementById("summarize-doc-btn");
                if (trigger) trigger.click();
            });
        }
    });
</script>

<script src="/dashboard2.js"></script>

<script>
    const DOC_ID = "<%= doc._id %>";
</script>

<script src="/doc_ai.js"></script>
<script src="/comments.js"></script>

<script>
    const scrollBtn = document.getElementById("scrollTopBtn");

    window.addEventListener("scroll", () => {
        if (window.scrollY > 400) {
            scrollBtn.style.opacity = "1";
            scrollBtn.style.pointerEvents = "auto";
        } else {
            scrollBtn.style.opacity = "0";
            scrollBtn.style.pointerEvents = "none";
        }
    });

    scrollBtn.addEventListener("click", () => {
        window.scrollTo({
            top: 0,
            behavior: "smooth"
        });
    });

    const pdfUrl = "<%= doc.file_url %>";

    document.addEventListener("contextmenu", function(e){
        e.preventDefault();
        alert("Printing and saving are disabled on DocUp.");
    });

    document.addEventListener("keydown", function(e) {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "s") {
            e.preventDefault();
            alert("Printing and saving are disabled on DocUp.");
        }

        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "p") {
            e.preventDefault();
            alert("Printing and saving are disabled on DocUp.");
        }

        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "u") {
            e.preventDefault();
            alert("Printing and saving are disabled on DocUp.");
        }

        if ((e.ctrlKey || e.metaKey) && e.shiftKey && e.key.toLowerCase() === "i") {
            e.preventDefault();
            alert("Printing and saving are disabled on DocUp.");
        }

        if (e.key === "F12") {
            e.preventDefault();
            alert("Printing and saving are disabled on DocUp.");
        }

        if ((e.command || e.metaKey) && e.shiftKey && e.code === "Digit3") {
            e.preventDefault();
            alert("Printing and saving are disabled on DocUp.");
        }
    });
</script>

<script>
    window.addEventListener("pageshow", function (event) {
        if (event.persisted) {
            window.location.reload();
        }
    });

    window.addEventListener("popstate", function () {
        window.location.reload();
    });
</script>
<script>
    document.addEventListener("mousemove", (e) => {
        document.documentElement.style.setProperty("--mx", `${e.clientX}px`);
        document.documentElement.style.setProperty("--my", `${e.clientY}px`);
    });
</script>
<script src="/docview.js"></script>
</body>
</html>