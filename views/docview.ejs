}
.capsule-pill-small .cpa-left  { flex: 1; background: linear-gradient(135deg, #ff4500, #ff6a00); animation: none; }
.capsule-pill-small .cpa-right { flex: 1; background: linear-gradient(135deg, #1a2235, #232e44); animation: none; }

.capsule-title {
    font-size: 19px;
    font-weight: 700;
    color: var(--text-primary, #e8edf5);
    margin: 0;
    letter-spacing: -0.01em;
}

.capsule-sub {
    font-size: 12.5px;
    color: var(--text-muted, #8a9ab5);
    line-height: 1.65;
    margin: 0;
    max-width: 360px;
}

/* ── AI Grid ── */
.capsule-ai-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 16px;
}

/* ── Base card ── */
.capsule-ai-opt {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 22px 12px 18px;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.07);
    background: rgba(255,255,255,0.03);
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1),
                border-color 0.2s ease,
                box-shadow 0.2s ease;
    color: var(--text-primary, #e8edf5);
    animation: cardFloat 4s ease-in-out infinite;
}

/* Stagger the float animation per card so they don't all move together */
.capsule-ai-opt:nth-child(1) { animation-delay: 0s; }
.capsule-ai-opt:nth-child(2) { animation-delay: 0.8s; }
.capsule-ai-opt:nth-child(3) { animation-delay: 1.6s; }
.capsule-ai-opt:nth-child(4) { animation-delay: 2.4s; }

@keyframes cardFloat {
    0%,100% { transform: translateY(0px); }
    50%      { transform: translateY(-4px); }
}

/* Hover lifts card and pauses the float */
.capsule-ai-opt:hover {
    transform: translateY(-6px) scale(1.03) !important;
    animation-play-state: paused;
}
.capsule-ai-opt:active {
    transform: translateY(-2px) scale(1.01) !important;
}

/* ── Ambient glow blob behind each card ── */
.cao-glow {
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    filter: blur(32px);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 0;
}
.capsule-ai-opt:hover .cao-glow { opacity: 1; }

/* Per-brand glow colours */
.cao-glow-chatgpt    { background: radial-gradient(circle, rgba(16,163,127,0.55) 0%, transparent 70%); }
.cao-glow-claude     { background: radial-gradient(circle, rgba(209,124,70,0.55)  0%, transparent 70%); }
.cao-glow-gemini     { background: radial-gradient(circle, rgba(138,100,249,0.55) 0%, transparent 70%); }
.cao-glow-perplexity { background: radial-gradient(circle, rgba(32,196,160,0.55)  0%, transparent 70%); }

/* Per-brand border + box-shadow on hover */
.cao-chatgpt-card:hover    { border-color: rgba(16,163,127,0.55);  box-shadow: 0 8px 32px rgba(16,163,127,0.22),  0 0 0 1px rgba(16,163,127,0.18); }
.cao-claude-card:hover     { border-color: rgba(209,124,70,0.55);   box-shadow: 0 8px 32px rgba(209,124,70,0.22),   0 0 0 1px rgba(209,124,70,0.18); }
.cao-gemini-card:hover     { border-color: rgba(138,100,249,0.55);  box-shadow: 0 8px 32px rgba(138,100,249,0.22),  0 0 0 1px rgba(138,100,249,0.18); }
.cao-perplexity-card:hover { border-color: rgba(32,196,160,0.55);   box-shadow: 0 8px 32px rgba(32,196,160,0.22),   0 0 0 1px rgba(32,196,160,0.18); }

/* ── Logo image wrap ── */
.cao-icon-wrap {
    position: relative;
    z-index: 1;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.06);
    backdrop-filter: blur(4px);
    transition: transform 0.2s ease;
}
.capsule-ai-opt:hover .cao-icon-wrap {
    transform: scale(1.1);
}

.cao-logo {
    width: 30px;
    height: 30px;
    object-fit: contain;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
}

.cao-label {
    position: relative;
    z-index: 1;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary, #e8edf5);
}
.cao-sub {
    position: relative;
    z-index: 1;
    font-size: 10.5px;
    color: var(--text-muted, #8a9ab5);
    margin-top: -4px;
}

/* ── Security Note ── */
.capsule-security-note {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 11.5px;
    color: var(--text-muted, #8a9ab5);
    line-height: 1.55;
    padding: 10px 13px;
    border-radius: 9px;
    background: rgba(255,255,255,0.025);
    border: 1px solid var(--border, rgba(255,255,255,0.06));
    margin-bottom: 14px;
}
.capsule-security-note svg { flex-shrink:0; margin-top:1px; color: #ff4500; }

/* ── Gemini paste hint ── */
.capsule-paste-hint {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: #e8edf5;
    line-height: 1.5;
    padding: 10px 13px;
    border-radius: 9px;
    background: rgba(138,100,249,0.13);
    border: 1px solid rgba(138,100,249,0.35);
    margin-bottom: 14px;
    animation: capsuleFadeIn 0.3s ease;
}
.capsule-paste-hint svg { flex-shrink:0; color: #a78bfa; }
.capsule-paste-hint kbd {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 5px;
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.18);
    font-size: 11px;
    font-family: monospace;
    color: #c4b5fd;
}

/* ── Close Button ── */
.capsule-close-btn {
    width: 100%;
    padding: 10px;
    border-radius: 9px;
    border: 1px solid var(--border, rgba(255,255,255,0.1));
    background: transparent;
    color: var(--text-muted, #8a9ab5);
    font-size: 13px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
}
.capsule-close-btn:hover { background: rgba(255,255,255,0.05); color: var(--text-primary, #e8edf5); }
</style>
<script>
/* ══════════════════════════════════════════════════════════
   CAPSULE SYSTEM  —  DocUp AI Discuss Feature
══════════════════════════════════════════════════════════ */
document.addEventListener("DOMContentLoaded", function () {
    var discussBtn      = document.getElementById("discuss-ai-btn");
    var capsuleOverlay  = document.getElementById("capsule-overlay");
    var capsuleBackdrop = document.getElementById("capsule-backdrop");
    var phaseLoading    = document.getElementById("capsule-phase-loading");
    var phaseChoose     = document.getElementById("capsule-phase-choose");
    var capsuleCloseBtn = document.getElementById("capsule-close-btn");
    var animLabel       = document.getElementById("capsule-anim-label");

    if (!discussBtn || !capsuleOverlay) {
        console.error("[Capsule] Required elements not found. discussBtn:", discussBtn, "capsuleOverlay:", capsuleOverlay);
        return;
    }

    var CAPSULE_DOC_ID  = discussBtn.getAttribute("data-doc-id") || "";
    var HAS_CAPSULE     = discussBtn.getAttribute("data-has-capsule") === "true";

    var capsuleText = null;

    /* ── Utility ── */
    function openOverlay() {
        capsuleOverlay.classList.remove("capsule-hidden");
        document.body.style.overflow = "hidden";
    }
    function closeOverlay() {
        capsuleOverlay.classList.add("capsule-hidden");
        document.body.style.overflow = "";
    }
    function showPhase(phase) {
        phaseLoading.classList.add("capsule-hidden");
        phaseChoose.classList.add("capsule-hidden");
        if (phase === "loading") phaseLoading.classList.remove("capsule-hidden");
        if (phase === "choose")  phaseChoose.classList.remove("capsule-hidden");
    }

    /* ── Bar Loader system ── */
    const STEPS = [
        { label: "Scanning document metadata…",    pct: 12 },
        { label: "Encapsulating your document…",   pct: 28 },
        { label: "Extracting key concepts…",        pct: 44 },
        { label: "Mapping subject context…",        pct: 58 },
        { label: "Generating academic summary…",    pct: 72 },
        { label: "Compressing into capsule…",       pct: 84 },
        { label: "Linking AI context layer…",       pct: 93 },
        { label: "Capsule ready ✔",                 pct: 100 }
    ];

    var loaderTimer = null;
    var currentStep = 0;

    function setBar(pct) {
        var fill = document.getElementById("cl-bar-fill");
        var pctEl = document.getElementById("cl-bar-pct");
        if (fill) fill.style.width = pct + "%";
        if (pctEl) pctEl.textContent = pct + "%";
    }

    function appendLogLine(text, state) {
        var log = document.getElementById("cl-log");
        if (!log) return;
        var line = document.createElement("div");
        line.className = "cl-log-line " + (state || "active");
        line.innerHTML =
            '<span class="cl-log-dot"></span>' +
            '<span>' + text + '</span>' +
            '<span class="cl-log-tick">✓</span>';
        log.appendChild(line);
        // keep only last 4 visible
        var lines = log.querySelectorAll(".cl-log-line");
        if (lines.length > 4) lines[0].remove();
    }

    function markLastDone() {
        var log = document.getElementById("cl-log");
        if (!log) return;
        var lines = log.querySelectorAll(".cl-log-line");
        if (lines.length) {
            var last = lines[lines.length - 1];
            last.classList.remove("active");
            last.classList.add("done");
        }
    }

    function startLoader() {
        currentStep = 0;
        var log = document.getElementById("cl-log");
        if (log) log.innerHTML = "";
        setBar(0);
        if (animLabel) animLabel.textContent = STEPS[0].label;

        appendLogLine(STEPS[0].label, "active");
        setBar(STEPS[0].pct);

        loaderTimer = setInterval(function() {
            currentStep++;
            if (currentStep >= STEPS.length - 1) {
                clearInterval(loaderTimer);
                return;
            }
            markLastDone();
            var s = STEPS[currentStep];
            if (animLabel) animLabel.textContent = s.label;
            appendLogLine(s.label, "active");
            setBar(s.pct);
        }, 430);
    }

    function finishLoader(cb) {
        clearInterval(loaderTimer);
        markLastDone();
        var last = STEPS[STEPS.length - 1];
        if (animLabel) animLabel.textContent = last.label;
        appendLogLine(last.label, "done");
        setBar(100);
        setTimeout(cb, 520);
    }

    function stopLoader() {
        clearInterval(loaderTimer);
    }

    /* ── Main init ── */
    async function initCapsule() {
        openOverlay();
        showPhase("loading");
        startLoader();

        try {
            // If capsule cached in DB, instant GET
            if (HAS_CAPSULE) {
                if (animLabel) animLabel.textContent = "Fetching your capsule…";
                var res  = await fetch(`/api/capsule/${CAPSULE_DOC_ID}`);
                var rdata = await res.json();
                if (rdata.success && rdata.capsule) {
                    capsuleText = rdata.capsule;
                    finishLoader(() => showPhase("choose"));
                    return;
                }
            }

            // Otherwise generate it (fast — metadata only, no PDF)
            var res  = await fetch(`/api/capsule/${CAPSULE_DOC_ID}`, { method: "POST" });
            var rdata = await res.json();

            if (rdata.success && rdata.capsule) {
                capsuleText = rdata.capsule;
                if (discussBtn) discussBtn.dataset.hasCapsule = "true";
                finishLoader(() => showPhase("choose"));
            } else {
                stopLoader();
                closeOverlay();
                alert("Capsule generation failed. Please try again.");
            }
        } catch (err) {
            stopLoader();
            closeOverlay();
            alert("Something went wrong. Please try again.");
        }
    }

    /* ── AI deep-link builder ── */
    function safeText(t) { return t.length > 3500 ? t.slice(0, 3500) + "…" : t; }

    const AI_URLS = {
        chatgpt:    function(t) { return "https://chatgpt.com/?q=" + encodeURIComponent("I have the following academic document summary. Please help me understand and discuss it deeply:\n\n" + safeText(t)); },
        claude:     function(t) { return "https://claude.ai/new?q=" + encodeURIComponent("I have the following academic document summary. Please help me understand and discuss it deeply:\n\n" + safeText(t)); },
        gemini:     function()  { return "https://gemini.google.com/app"; },
        perplexity: function(t) { return "https://www.perplexity.ai/?q=" + encodeURIComponent("I have the following academic document summary. Please help me understand and discuss it deeply:\n\n" + safeText(t)); },
    };

    /* Gemini doesn't support URL prefill natively — copy to clipboard instead */
    const pasteHint = document.getElementById("capsule-paste-hint");
    let pasteHintTimer = null;

    function showPasteHint() {
        if (!pasteHint) return;
        pasteHint.classList.remove("capsule-hidden");
        clearTimeout(pasteHintTimer);
        pasteHintTimer = setTimeout(() => pasteHint.classList.add("capsule-hidden"), 6000);
    }

    document.querySelectorAll(".capsule-ai-opt").forEach(btn => {
        btn.addEventListener("click", async () => {
            const ai = btn.dataset.ai;
            if (!capsuleText || !AI_URLS[ai]) return;

            if (ai === "gemini") {
                const fullText = "I have the following academic document summary. Please help me understand and discuss it deeply:\n\n" + safeText(capsuleText);
                try {
                    await navigator.clipboard.writeText(fullText);
                } catch (_) {
                    /* clipboard blocked — open anyway, user sees the hint */
                }
                window.open(AI_URLS[ai](), "_blank", "noopener,noreferrer");
                showPasteHint();
                return;
            }

            window.open(AI_URLS[ai](capsuleText), "_blank", "noopener,noreferrer");
        });
    });

    /* ── Event Listeners ── */
    discussBtn?.addEventListener("click", initCapsule);
    capsuleCloseBtn?.addEventListener("click", closeOverlay);
    capsuleBackdrop?.addEventListener("click", closeOverlay);
    document.addEventListener("keydown", e => {
        if (e.key === "Escape" && !capsuleOverlay.classList.contains("capsule-hidden")) {
            closeOverlay();
        }
    });
});
</script>


<%- include('partials/page-loader') %>
</body>
</html>