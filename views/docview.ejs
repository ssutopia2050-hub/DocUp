<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>DocUp | ViewDoc</title>
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/docview.css">
    <link rel="stylesheet" href="/page-loader.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
</head>
<body class="theme-dark">

<header class="topbar">
    <div class="topbar-left">
        <a href="/dashboard" class="logo-wordmark">DocUp</a>
        <div class="topbar-divider"></div>

        <span class="topbar-breadcrumb">
            <a href="/college/<%= encodeURIComponent(doc.college) %>"><%= doc.college %></a>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M4.5 2.5L7.5 6L4.5 9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="breadcrumb-current"><%= doc.subject %></span>
        </span>
    </div>

    <div class="topbar-right">
        <button class="icon-btn" aria-label="Search"

                onclick="window.location.href='/dashboard'">

            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                <path d="M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35"
                      stroke="currentColor"

                      stroke-width="1.8"
                      stroke-linecap="round"/>
            </svg>
        </button>
        <!-- Collections -->
        <a href="/collections" class="icon-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none">
                <rect x="3" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
                <rect x="14" y="3" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
                <rect x="3" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
                <rect x="14" y="14" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.8"/>
            </svg>
        </a>
        <div class="notification-wrap">
            <button class="icon-btn notification-btn" aria-label="Notifications">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                     fill="none">
                    <path d="M9 17H15M6.5 17H17.5C16.9 16.35 16.5 15.48 16.5 14.5V10.5C16.5 8.01 14.49 6 12 6C9.51 6 7.5 8.01 7.5 10.5V14.5C7.5 15.48 7.1 16.35 6.5 17Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M10.5 20C10.74 20.62 11.32 21 12 21C12.68 21 13.26 20.62 13.5 20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

                <% const unreadCount = (user.notifications ||
                []).filter(n => !n.isRead).length; %>
                <% if (unreadCount > 0) { %>
                <span class="notif-badge"><%= unreadCount > 9 ?
"9+" : unreadCount %></span>
                <% } %>
            </button>

            <div class="notification-dropdown">
                <div class="nd-header">
                    <span class="nd-title">Notifications</span>

                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <a href="/notifications" class="nd-view-all">See all</a>
                    <% } %>
                </div>
                <div class="nd-list">

                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <% user.notifications.slice().reverse().forEach((item) => { %>
                    <div class="nd-item <%= item.isRead ? '' : 'unread' %>">
                        <div class="nd-item-row">

                            <span class="nd-dot"></span>
                            <span class="nd-when">
                                <%= item.createdAt ? new Date(item.createdAt).toLocaleString("en-IN",{dateStyle:"medium",timeStyle:"short"}) : "Just now" %>

                             </span>
                        </div>
                        <p class="nd-text"><%= item.content %></p>
                    </div>

                    <% }) %>
                    <% } else { %>
                    <div class="nd-empty">No notifications yet.</div>
                    <% } %>
                </div>

            </div>
        </div>

        <div class="avatar-btn">
            <% if (user.avatar_img_path) { %>
            <img src="<%= user.avatar_img_path %>" alt="">
            <% } else { %>
            <%= user.name
            ? user.name.charAt(0).toUpperCase() : "U" %>
            <% } %>
        </div>
    </div>
</header>

<div class="avatar-dropdown">
    <a href="/profile">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        Profile
    </a>
    <a href="/pricing">
        <svg width="15" height="15" viewBox="0 0 24
24" fill="none"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Recharge DocScore
    </a>
    <a href="/upgrade-plans">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                  stroke-width="1.6"/>
        </svg>
        Upgrade Plans

    </a>
    <a href="/contact">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2
                 19.79 19.79 0 0 1-8.63-3.07
                 19.5 19.5 0 0 1-6-6

19.79 19.79 0 0 1-3.07-8.67
                 A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72
                 c.12.89.32 1.76.6 2.6
                 a2 2 0 0 1-.45 2.11L8.09 9.91
                 a16 16 0 0 0 6 6l1.48-1.17

                a2 2 0 0 1 2.11-.45
                 c.84.28 1.71.48 2.6.6
                 a2 2 0 0 1 1.72 2z"
                  stroke="currentColor"
                  stroke-width="1.6"

                  stroke-linecap="round"
                  stroke-linejoin="round"/>
        </svg>
        Contact Us / Feedback
    </a>
</div>

<div class="hero-strip">
    <div class="hero-strip-inner">
        <div class="hero-left">
            <% if (doc.doc_type !== 'ed_doc') { %>
            <div class="college-logo-wrap">

                <img
                        src="<%= college_data && college_data.image ?
college_data.image : '/images/default.png' %>"
                        alt="college logo"
                        onerror="this.onerror=null;this.src='/images/default.png';"
                >
            </div>
            <% } %>
            <div class="hero-meta">

                <div class="hero-meta-top">
                    <% if (doc.doc_type === 'ed_doc') { %>
                    <span class="college-chip"><%= doc.college %></span>
                    <% } else { %>
                    <span class="college-chip"><%= doc.college %></span>
                    <% } %>
                    <% if (doc.reviewed) { %>
                    <span class="status-chip verified">

    <svg width="10" height="10" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Verified
                    </span>
                    <% } else { %>

                    <span class="status-chip pending">Under Review</span>
                    <% } %>
                </div>
                <h1 class="hero-title"><%= doc.title || doc.chapter %></h1>
                <% if (doc.doc_type === 'ed_doc') { %>
                <p class="hero-sub"><%= doc.subject %> &nbsp;·&nbsp; <%= doc.branch %> &nbsp;·&nbsp; <%= doc.year %></p>
                <div class="hero-tags">
                    <span class="htag"><%= doc.college %></span>
                    <span class="htag"><%= doc.year %></span>
                    <span class="htag"><%= doc.branch %></span>
                    <span class="htag"><%= doc.subject %></span>
                    <span class="htag"><%= doc.chapter %></span>
                    <span class="htag"><%= views %> Views</span>
                </div>
                <% } else { %>
                <p class="hero-sub"><%= doc.subject %> &nbsp;·&nbsp;
                    <%= doc.branch %> &nbsp;·&nbsp;  <%= doc.year %> &nbsp;·&nbsp;  <%= doc.semester %></p>
                <div class="hero-tags">
                    <span class="htag"><%= doc.subject %></span>
                    <span class="htag"><%= doc.branch %></span>
                    <span class="htag"><%= doc.year %></span>

                    <span class="htag"><%= doc.chapter %></span>
                    <span class="htag"><%= views %> Views</span>
                </div>
                <% } %>
            </div>
        </div>

        <div class="hero-actions">

            <a href="/college/<%= encodeURIComponent(doc.college) %>" class="ha-btn ghost">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                More Docs from <span style="color:orangered"><%= doc.college %></span>
            </a>
            <button class="ha-btn ghost" id="openAddToCollectionModal" title="Add to Collection">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M19 11H5M12 4v14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Add to Collection
            </button>
            <% if (uploaderProfile && uploaderProfile._id) { %>

            <a href="/all_uploads_view_second_pov_profile/<%= uploaderProfile._id %>" class="ha-btn ghost">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                    <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                    <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7"/>

                </svg>
                More Docs from <span style="color:orangered"><%= uploaderProfile.name %></span>
            </a>
            <% } %>
            <button type="button" class="ha-btn ghost report-trigger" id="open-report-modal">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none">

                    <path d="M5 21V5M5 5h10l-1.6 3L15 11H5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Report
            </button>
            <% if (doc.doc_type !== 'ed_doc') { %>
            <button type="button" id="open-share-doc-modal" class="ha-btn accent"
                    data-doc-id="<%= doc._id
%>"
                    data-doc-college="<%= doc.college %>"
                    data-doc-subject="<%= doc.subject %>"
                    data-doc-chapter="<%= doc.chapter %>">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4
4M12 2v13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Share to <%= doc.college %> Chat
            </button>
            <% } %>

            <div class="vote-cluster">
                <button type="button" class="vote-btn like" id="like-btn" data-doc-id="<%= doc._id %>">
                    <svg width="15" height="15" viewBox="0 0 24
24" fill="none"><path d="M14 9V5a3 3 0 00-3-3l-4 9v11h11.28a2 2 0 002-1.7l1.38-9a2 2 0 00-2-2.3H14zM7 22H4a2 2 0 01-2-2v-7a2 2 0 012-2h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span id="like-count"><%= doc.likes %></span>
                </button>
                <span class="vote-sep"></span>
                <button type="button" class="vote-btn dislike"
                        id="dislike-btn" data-doc-id="<%= doc._id %>">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M10 15v4a3 3 0 003 3l4-9V2H5.72a2 2 0 00-2 1.7l-1.38 9a2 2 0 002 2.3H10zM17 2h2.67A2.31 2.31 0 0122 4v7a2.31 2.31 0 01-2.33 2H17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span id="dislike-count"><%= doc.dislikes %></span>
                </button>

            </div>

            <button type="button" class="ha-btn ghost save-btn" id="save-btn" data-doc-id="<%= doc._id %>">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span id="save-btn-label">Save</span>
            </button>


            <button type="button" id="reading-mode-btn" class="ha-btn ghost reading-mode-btn" aria-label="Toggle reading mode">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M6.5 2H20v18H6.5A2.5 2.5 0 0 0 4 22V4.5A2.5 2.5
0 0 1 6.5 2Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span id="reading-mode-text">Reading Mode</span>
            </button>

            <button type="button" id="zen-mode-btn" class="ha-btn ghost zen-mode-btn" aria-label="Toggle Zen mode">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                    <path d="M4 8V4m0 0h4M4 4l5 5M20 8V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5M20 16v4m0 0h-4m4 0l-5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span id="zen-mode-text">Zen Mode</span>
            </button>

            <div class="theme-menu" id="theme-menu">
                <button type="button" id="theme-menu-btn" class="ha-btn ghost theme-menu-btn" aria-label="Open theme menu" aria-expanded="false">

                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                        <path d="M12 3v2.2M12 18.8V21M3 12h2.2M18.8 12H21M5.64 5.64l1.55 1.55M16.81 16.81l1.55 1.55M5.64 18.36l1.55-1.55M16.81 7.19l1.55-1.55" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/>

                    </svg>
                    <span id="theme-menu-label">Theme</span>
                </button>

                <div class="theme-popover" id="theme-popover">
                    <div class="theme-popover-head">

                        <div>
                            <div class="theme-popover-title">Choose theme</div>
                            <div class="theme-popover-sub">Reader UI only — PDF stays original</div>
                        </div>

                        <span class="theme-current-chip" id="theme-current-chip">Light</span>
                    </div>

                    <div class="theme-swatch-list">
                        <button type="button" class="theme-swatch" data-theme="theme-dark" data-theme-label="Midnight">

                   <span class="theme-preview-dots">
                                <span class="theme-dot theme-dot-dark-1"></span>
                                <span class="theme-dot theme-dot-dark-2"></span>

                    <span class="theme-dot theme-dot-dark-3"></span>
                            </span>
                            <span class="theme-swatch-copy">

           <span class="theme-swatch-name">Midnight</span>
                                <span class="theme-swatch-desc">Deep dark DocUp look</span>
                            </span>

                        </button>

                        <button type="button" class="theme-swatch" data-theme="theme-light" data-theme-label="Light">
                            <span class="theme-preview-dots">
                                <span class="theme-dot theme-dot-light-1"></span>

                       <span class="theme-dot theme-dot-light-2"></span>
                                <span class="theme-dot theme-dot-light-3"></span>
                            </span>

                            <span class="theme-swatch-copy">
                                <span class="theme-swatch-name">Light</span>
                                <span class="theme-swatch-desc">Clean daylight reading</span>

            </span>
                        </button>

                        <button type="button" class="theme-swatch" data-theme="theme-sepia" data-theme-label="Paper">
                            <span class="theme-preview-dots">

                         <span class="theme-dot theme-dot-sepia-1"></span>
                                <span class="theme-dot theme-dot-sepia-2"></span>
                                <span class="theme-dot theme-dot-sepia-3"></span>

                       </span>
                            <span class="theme-swatch-copy">
                                <span class="theme-swatch-name">Paper</span>

                 <span class="theme-swatch-desc">Warm study session feel</span>
                            </span>
                        </button>

                        <button type="button" class="theme-swatch"
                                data-theme="theme-contrast" data-theme-label="Contrast">
                            <span class="theme-preview-dots">
                                <span class="theme-dot theme-dot-contrast-1"></span>
                                <span class="theme-dot theme-dot-contrast-2"></span>

                              <span class="theme-dot theme-dot-contrast-3"></span>
                            </span>
                            <span class="theme-swatch-copy">

                     <span class="theme-swatch-name">Contrast</span>
                                <span class="theme-swatch-desc">Maximum UI readability</span>
                            </span>

                        </button>
                    </div>
                </div>
            </div>
            <div class="share-doc-wrap">
                <button type="button" id="share-doc-toggle" class="ha-btn ghost">

                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M14 5L19 5C20.1046 5 21 5.89543 21 7V18C21 19.1046 20.1046 20 19 20H7C5.89543 20 5 19.1046 5 18V13"
                              stroke="currentColor"

                              stroke-width="1.7"
                              stroke-linecap="round"
                              stroke-linejoin="round"/>

                        <path d="M10 14L20 4"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round"

                              stroke-linejoin="round"/>
                        <path d="M14 4H20V10"
                              stroke="currentColor"

                              stroke-width="1.7"
                              stroke-linecap="round"
                              stroke-linejoin="round"/>
                    </svg>

                    Share Doc
                </button>

                <div class="share-doc-dropdown" id="share-doc-dropdown">
                    <div class="sdd-label">Share this document</div>

                    <div class="sdd-link-row">

                        <input
                                type="text"
                                id="share-doc-link-input"

                                class="sdd-link-input"
                                readonly
                                value="<%= shareDocLink %>"

                        >
                        <button type="button" id="copy-share-doc-link" class="sdd-copy-btn">Copy Link</button>
                    </div>

                    <div class="sdd-note">
                        Anyone with this link can
                        open the doc after signing in.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<main class="workspace">

    <section class="pdf-column">

        <div class="pdf-toolbar">
            <div class="ptb-left">

                <div class="ptb-zoom-group">
                    <button class="ptb-btn" id="zoom-out" title="Zoom out">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </button>

                    <span class="ptb-zoom-pill" id="zoom-percentage">115%</span>
                    <button class="ptb-btn" id="zoom-in" title="Zoom in">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </button>

                    <button class="ptb-btn ptb-fit" id="fit-width">Fit</button>
                </div>

                <div class="ptb-divider"></div>

                <div class="ptb-ai-group">
                    <button class="ptb-btn ptb-ai" id="ask-pdf-btn">

                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.7"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3M12 17h.01" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                        Ask PDF
                    </button>

                    <button class="ptb-btn ptb-ai" id="explain-page-btn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Explain Page

                    </button>
                    <button class="ptb-btn ptb-ai" id="summarize-doc-btn">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h10M4 18h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                        Summarize

                    </button>
                    <button class="ptb-btn ptb-ai" id="rotate-page-btn" title="Rotate current page 90°">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M21 2v6h-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 8A9 9 0 1 0 19.06 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Rotate Page
                    </button>
                    <button class="ptb-btn ptb-ai" id="exit-zen-btn" aria-label="Exit Zen Mode">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M8 3v3a2 2 0 01-2 2H3m18 0h-3a2 2 0 01-2-2V3m0 18v-3a2 2 0 012-2h3M3 16h3a2 2 0 012 2v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Exit Zen
                    </button>
                    <button id="toggle-topbar-btn" class="ptb-btn ptb-ai">
                        <span id="hide-topbar-text">Hide Topbar</span>
                    </button>
                </div>
            </div>

            <div class="ptb-right">
                <div class="ptb-page-nav">
                    <span class="ptb-page-label">Page</span>

                    <input id="page-jump-input" type="number" min="1" value="1">
                    <span id="page-jump-total" class="ptb-page-total">/ 0</span>
                </div>
                <span id="page-status" class="ptb-status">Loading…</span>
            </div>
        </div>

        <div style="display:none;"
             class="page-bubble-wrap">
            <div class="page-bubble" id="pdf-page-indicator">
                <span id="current-page-number">1</span>
                <span class="pb-sep">/</span>
