<script>
    const DOCUP_THEMES = ["theme-dark", "theme-light", "theme-sepia", "theme-contrast"];
    const THEME_LABELS = {
        "theme-dark": "Midnight",
        "theme-light": "Light",
        "theme-sepia": "Paper",
        "theme-contrast": "Contrast"
    };

    const themeMenu = document.getElementById("theme-menu");
    const themeMenuBtn = document.getElementById("theme-menu-btn");
    const themePopover = document.getElementById("theme-popover");
    const themeCurrentChip = document.getElementById("theme-current-chip");
    const themeSwatches = document.querySelectorAll(".theme-swatch");
    const readingModeBtn = document.getElementById("reading-mode-btn");
    const readingModeText = document.getElementById("reading-mode-text");
    const themeTransitionOverlay = document.getElementById("theme-transition-overlay");

    function setThemeClasses(themeName) {
        document.body.classList.remove(...DOCUP_THEMES);
        document.body.classList.add(themeName);
        document.body.classList.toggle("light-mode", themeName !== "theme-dark");
    }

    function syncThemeUi(themeName) {
        const themeLabel = THEME_LABELS[themeName] || "Theme";

        if (themeCurrentChip) {
            themeCurrentChip.textContent = themeLabel;
        }

        themeSwatches.forEach((btn) => {
            const active = btn.dataset.theme === themeName;
            btn.classList.toggle("active", active);
            btn.setAttribute("aria-pressed", active ? "true" : "false");
        });
    }

    function animateThemeTransition(callback) {
        if (!themeTransitionOverlay) {
            callback();
            return;
        }

        themeTransitionOverlay.classList.remove("animate");
        void themeTransitionOverlay.offsetWidth;
        themeTransitionOverlay.classList.add("animate");

        callback();

        window.setTimeout(() => {
            themeTransitionOverlay.classList.remove("animate");
        }, 520);
    }

    function applyTheme(themeName, options = {}) {
        const { persist = true, animated = false } = options;

        const run = () => {
            setThemeClasses(themeName);
            syncThemeUi(themeName);

            if (persist) {
                localStorage.setItem("docup-theme", themeName);
            }
        };

        if (animated) {
            animateThemeTransition(run);
        } else {
            run();
        }
    }

    function closeThemePopover() {
        themePopover?.classList.remove("active");
        themeMenuBtn?.setAttribute("aria-expanded", "false");
    }

    function positionThemePopover() {
        if (!themePopover || !themeMenuBtn) return;

        themePopover.classList.remove("shift-left", "shift-right");

        const rect = themePopover.getBoundingClientRect();
        const gap = 14;

        if (rect.right > window.innerWidth - gap) {
            themePopover.classList.add("shift-right");
        }

        if (rect.left < gap) {
            themePopover.classList.remove("shift-right");
            themePopover.classList.add("shift-left");
        }
    }
    window.addEventListener("resize", () => {
        if (themePopover?.classList.contains("active")) {
            positionThemePopover();
        }
    });

    function openThemePopover() {
        if (!themePopover) return;

        themePopover.classList.add("active");
        themeMenuBtn?.setAttribute("aria-expanded", "true");

        requestAnimationFrame(() => {
            positionThemePopover();
        });
    }

    function updateReadingModeUi() {
        const active = document.body.classList.contains("reading-mode");
        readingModeBtn?.classList.toggle("active", active);

        if (readingModeText) {
            readingModeText.textContent = active ? "Exit Reading" : "Reading Mode";
        }
    }

    function enableReadingMode() {
        document.body.classList.add("reading-mode");
        localStorage.setItem("docup-reading-mode", "true");
        updateReadingModeUi();
    }

    function disableReadingMode() {
        document.body.classList.remove("reading-mode");
        localStorage.setItem("docup-reading-mode", "false");
        updateReadingModeUi();
    }

    function toggleReadingMode() {
        if (document.body.classList.contains("reading-mode")) {
            disableReadingMode();
        } else {
            enableReadingMode();
        }
    }

    (function initDocThemes() {
        const savedTheme = localStorage.getItem("docup-theme") || "theme-dark";
        applyTheme(savedTheme, { persist: false, animated: false });

        if (localStorage.getItem("docup-reading-mode") === "true") {
            document.body.classList.add("reading-mode");
        }

        updateReadingModeUi();
    })();

    themeMenuBtn?.addEventListener("click", (event) => {
        event.stopPropagation();

        if (themePopover?.classList.contains("active")) {
            closeThemePopover();
        } else {
            openThemePopover();
        }
    });

    themeSwatches.forEach((btn) => {
        btn.addEventListener("click", () => {
            const selectedTheme = btn.dataset.theme;
            applyTheme(selectedTheme, { persist: true, animated: true });
            closeThemePopover();
        });
    });

    readingModeBtn?.addEventListener("click", () => {
        toggleReadingMode();
        closeThemePopover();
    });

    document.addEventListener("click", (event) => {
        if (!themeMenu?.contains(event.target)) {
            closeThemePopover();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            closeThemePopover();
        }
    });
</script>
<script>
    const shareDocToggle = document.getElementById("share-doc-toggle");
    const shareDocDropdown = document.getElementById("share-doc-dropdown");
    const shareDocLinkInput = document.getElementById("share-doc-link-input");
    const copyShareDocLinkBtn = document.getElementById("copy-share-doc-link");
    const copyToast = document.getElementById("copy-toast");

    let copyToastTimer;

    function closeShareDocDropdown() {
        shareDocDropdown?.classList.remove("active");
    }

    function showCopyToast(message = "Link copied!") {
        if (!copyToast) return;

        copyToast.textContent = message;
        copyToast.classList.add("show");

        clearTimeout(copyToastTimer);
        copyToastTimer = setTimeout(() => {
            copyToast.classList.remove("show");
        }, 1600);
    }

    function setCopiedState() {
        if (!copyShareDocLinkBtn) return;

        copyShareDocLinkBtn.textContent = "Copied!";
        copyShareDocLinkBtn.classList.add("copied");

        setTimeout(() => {
            copyShareDocLinkBtn.textContent = "Copy Link";
            copyShareDocLinkBtn.classList.remove("copied");
        }, 1400);
    }

    shareDocToggle?.addEventListener("click", (event) => {
        event.stopPropagation();
        shareDocDropdown?.classList.toggle("active");
    });

    copyShareDocLinkBtn?.addEventListener("click", async () => {
        const link = shareDocLinkInput?.value || "";
        if (!link) return;

        try {
            await navigator.clipboard.writeText(link);
            setCopiedState();
            showCopyToast("Link copied!");
        } catch (err) {
            try {
                shareDocLinkInput.focus();
                shareDocLinkInput.select();
                document.execCommand("copy");
                setCopiedState();
                showCopyToast("Link copied!");
            } catch (fallbackErr) {
                showCopyToast("Copy failed");
            }
        }
    });

    document.addEventListener("click", (event) => {
        if (!event.target.closest(".share-doc-wrap")) {
            closeShareDocDropdown();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            closeShareDocDropdown();
        }
    });
</script>
<script src="/dashboard3.js"></script>
<script src="/docview.js"></script>
</body>
</html>