<!-- ╔══════════════════════════════════════════════════╗
     ║  SCRIPT                                          ║
     ╚══════════════════════════════════════════════════╝ -->
<script>
(function () {
  "use strict";

  /* ── Config ─────────────────────────────────────── */
  const DOC_ID = "<%= doc._id %>";   // injected by EJS

  /* ── Elements ───────────────────────────────────── */
  const backdrop     = document.getElementById("atcDrawerBackdrop");
  const drawer       = document.getElementById("atcDrawer");
  const closeBtn     = document.getElementById("atcCloseBtn");
  const handleBar    = document.getElementById("atcHandleBar");
  const subtitle     = document.getElementById("atcSubtitle");

  const searchInput  = document.getElementById("atcSearch");
  const searchClear  = document.getElementById("atcSearchClear");

  const loadingEl    = document.getElementById("atcLoading");
  const listEl       = document.getElementById("atcList");
  const emptyEl      = document.getElementById("atcEmpty");
  const noResultsEl  = document.getElementById("atcNoResults");
  const errorEl      = document.getElementById("atcError");
  const retryBtn     = document.getElementById("atcRetryBtn");

  const qcTrigger    = document.getElementById("atcQcTrigger");
  const qcForm       = document.getElementById("atcQcForm");
  const qcCancel     = document.getElementById("atcQcCancel");
  const qcNameInput  = document.getElementById("atcQcNameInput");
  const qcSubmitBtn  = document.getElementById("atcQcSubmitBtn");
  const qcSelEmoji   = document.getElementById("atcQcSelEmoji");
  const toastZone    = document.getElementById("atcToastZone");

  const openBtn      = document.getElementById("openAddToCollectionModal");

  /* ── State ──────────────────────────────────────── */
  let collections    = [];   // [{_id, name, emoji, color, contains, docCount}]
  let qcEmoji        = "📁";
  let qcColor        = "#ff6a00";
  let searchQuery    = "";
  let isDragging     = false;
  let dragStartY     = 0;
  let dragCurrentY   = 0;

  /* ── Toast ───────────────────────────────────────── */
  function showToast(msg, type = "success") {
    const t = document.createElement("div");
    t.className = `atc-toast atc-toast-${type}`;
    t.textContent = msg;
    toastZone.appendChild(t);
    requestAnimationFrame(() => t.classList.add("atc-toast-show"));
    setTimeout(() => {
      t.classList.remove("atc-toast-show");
      t.addEventListener("transitionend", () => t.remove(), { once: true });
    }, 2600);
  }

  /* ── API ─────────────────────────────────────────── */
  async function apiCall(method, url, body) {
    const res = await fetch(url, {
      method,
      headers: { "Content-Type": "application/json" },
      body: body ? JSON.stringify(body) : undefined
    });
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return res.json();
  }

  /* ── Open / Close ────────────────────────────────── */
  function openDrawer() {
    backdrop.classList.add("atc-open");
    drawer.classList.add("atc-open");
    document.body.style.overflow = "hidden";
    searchInput.value = "";
    searchQuery = "";
    searchClear.classList.remove("visible");
    fetchCollections();
  }

  function closeDrawer() {
    backdrop.classList.remove("atc-open");
    drawer.classList.remove("atc-open");
    drawer.style.transform = "";
    document.body.style.overflow = "";
    collapseQcForm();
  }

  openBtn?.addEventListener("click", openDrawer);
  closeBtn.addEventListener("click", closeDrawer);
  backdrop.addEventListener("click", closeDrawer);
  document.addEventListener("keydown", e => {
    if (e.key === "Escape" && drawer.classList.contains("atc-open")) closeDrawer();
  });

  /* ── Drag-to-dismiss (touch + mouse) ─────────────── */
  function onDragStart(clientY) {
    isDragging = true;
    dragStartY = clientY;
    dragCurrentY = 0;
    drawer.style.transition = "none";
  }
  function onDragMove(clientY) {
    if (!isDragging) return;
    const delta = Math.max(0, clientY - dragStartY);
    dragCurrentY = delta;
    drawer.style.transform = `translateX(-50%) translateY(${delta}px)`;
  }
  function onDragEnd() {
    if (!isDragging) return;
    isDragging = false;
    drawer.style.transition = "";
    if (dragCurrentY > 120) {
      closeDrawer();
    } else {
      drawer.style.transform = "translateX(-50%) translateY(0)";
    }
  }
  handleBar.addEventListener("mousedown",  e => onDragStart(e.clientY));
  handleBar.addEventListener("touchstart", e => onDragStart(e.touches[0].clientY), { passive: true });
  window.addEventListener("mousemove",  e => { if (isDragging) onDragMove(e.clientY); });
  window.addEventListener("touchmove",  e => { if (isDragging) onDragMove(e.touches[0].clientY); }, { passive: true });
  window.addEventListener("mouseup",   () => { if (isDragging) onDragEnd(); });
  window.addEventListener("touchend",  () => { if (isDragging) onDragEnd(); });

  /* ── Fetch & Render ──────────────────────────────── */
  function showState(state) {
    // state: "loading" | "list" | "empty" | "noresults" | "error"
    [loadingEl, listEl, emptyEl, noResultsEl, errorEl].forEach(el => el.classList.add("atc-hidden"));
    const map = { loading: loadingEl, list: listEl, empty: emptyEl, noresults: noResultsEl, error: errorEl };
    if (map[state]) map[state].classList.remove("atc-hidden");
  }

  async function fetchCollections() {
    showState("loading");
    try {
      const data = await apiCall("GET", `/api/collections/check/${DOC_ID}`);
      if (!data.success) throw new Error("API returned failure");
      collections = data.collections || [];
      renderList();
      updateSubtitle();
    } catch (err) {
      showState("error");
    }
  }

  function updateSubtitle() {
    const saved = collections.filter(c => c.contains).length;
    if (saved === 0) {
      subtitle.textContent = `${collections.length} collection${collections.length !== 1 ? "s" : ""} available`;
    } else {
      subtitle.textContent = `Saved in ${saved} collection${saved !== 1 ? "s" : ""}`;
    }
  }

  function renderList() {
    const q = searchQuery.toLowerCase().trim();
    const filtered = q
      ? collections.filter(c => c.name.toLowerCase().includes(q))
      : collections;

    if (collections.length === 0) { showState("empty"); return; }
    if (filtered.length === 0)    { showState("noresults"); return; }

    showState("list");
    listEl.innerHTML = "";

    filtered.forEach(col => {
      const card = buildCard(col);
      listEl.appendChild(card);
    });
  }

  function buildCard(col) {
    const card = document.createElement("div");
    card.className = "atc-col-card" + (col.contains ? " atc-col-active" : "");
    card.dataset.id = col._id;
    card.style.setProperty("--atc-col-color", col.color || "#ff6a00");

    card.innerHTML = `
      <div class="atc-col-emoji-wrap">${col.emoji || "📁"}</div>
      <div class="atc-col-info">
        <a class="atc-col-name" href="/collections/${col._id}" title="View collection">${escHtml(col.name)}</a>
        <div class="atc-col-meta">
          <span>${col.contains ? "In this collection" : "Not added"}</span>
          ${col.docCount !== undefined
            ? `<span class="atc-col-dot"></span><span>${col.docCount} doc${col.docCount !== 1 ? "s" : ""}</span>`
            : ""}
        </div>
      </div>
      <div class="atc-toggle">
        <div class="atc-toggle-thumb"></div>
      </div>`;

    card.addEventListener("click", () => toggleDoc(col, card));

    // Name link navigates — don't also toggle the card
    card.querySelector(".atc-col-name").addEventListener("click", e => e.stopPropagation());
    return card;
  }

  function escHtml(str) {
    return str.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
  }

  /* ── Toggle doc in collection ────────────────────── */
  async function toggleDoc(col, card) {
    if (card.classList.contains("atc-col-loading")) return;

    const wasIn   = col.contains;
    const endpoint = wasIn ? "remove-doc" : "add-doc";

    // Optimistic
    col.contains = !wasIn;
    card.classList.toggle("atc-col-active", col.contains);
    card.classList.add("atc-col-loading");
    card.querySelector(".atc-col-meta span").textContent = col.contains ? "In this collection" : "Not added";

    try {
      const data = await apiCall("POST", `/api/collections/${col._id}/${endpoint}`, { docId: DOC_ID });
      if (!data.success) throw new Error(data.message || "Failed");

      if (!wasIn) {
        // Update doc count from response
        if (data.docCount !== undefined) col.docCount = data.docCount;
        showToast(`Added to "${col.name}" ✓`, "success");
      } else {
        if (col.docCount > 0) col.docCount--;
        showToast(`Removed from "${col.name}"`, "info");
      }
      updateSubtitle();
    } catch (err) {
      // Revert
      col.contains = wasIn;
      card.classList.toggle("atc-col-active", col.contains);
      card.querySelector(".atc-col-meta span").textContent = col.contains ? "In this collection" : "Not added";
      showToast("Something went wrong. Try again.", "error");
    } finally {
      card.classList.remove("atc-col-loading");
    }
  }

  /* ── Search ──────────────────────────────────────── */
  searchInput.addEventListener("input", () => {
    searchQuery = searchInput.value;
    const hasVal = searchQuery.length > 0;
    searchClear.classList.toggle("visible", hasVal);
    renderList();
  });
  searchClear.addEventListener("click", () => {
    searchInput.value = "";
    searchQuery = "";
    searchClear.classList.remove("visible");
    renderList();
    searchInput.focus();
  });

  /* ── Retry ───────────────────────────────────────── */
  retryBtn.addEventListener("click", fetchCollections);

  /* ── Quick-create ────────────────────────────────── */
  qcTrigger.addEventListener("click", () => {
    qcForm.classList.add("atc-qc-open");
    qcTrigger.parentElement.style.display = "none";
    qcNameInput.focus();
    // Default selections
    selectQcEmoji("📁");
    selectQcColor("#ff6a00");
  });

  function collapseQcForm() {
    qcForm.classList.remove("atc-qc-open");
    qcTrigger.parentElement.style.display = "";
    qcNameInput.value = "";
    qcSubmitBtn.disabled = false;
  }

  qcCancel.addEventListener("click", collapseQcForm);

  /* Emoji picker */
  document.querySelectorAll(".atc-qc-emoji-opt").forEach(btn => {
    btn.addEventListener("click", () => selectQcEmoji(btn.dataset.emoji));
  });
  function selectQcEmoji(e) {
    qcEmoji = e;
    qcSelEmoji.textContent = e;
    qcSelEmoji.style.transform = "scale(1.3)";
    setTimeout(() => qcSelEmoji.style.transform = "", 220);
    document.querySelectorAll(".atc-qc-emoji-opt").forEach(b => {
      b.classList.toggle("atc-sel", b.dataset.emoji === e);
    });
  }

  /* Color picker */
  document.querySelectorAll(".atc-qc-color-opt").forEach(btn => {
    btn.addEventListener("click", () => selectQcColor(btn.dataset.color));
  });
  function selectQcColor(c) {
    qcColor = c;
    document.querySelectorAll(".atc-qc-color-opt").forEach(b => {
      b.classList.toggle("atc-sel", b.dataset.color === c);
    });
  }

  /* Submit */
  qcSubmitBtn.addEventListener("click", submitQuickCreate);
  qcNameInput.addEventListener("keydown", e => {
    if (e.key === "Enter") submitQuickCreate();
  });

  async function submitQuickCreate() {
    const name = qcNameInput.value.trim();
    if (!name) {
      qcNameInput.focus();
      qcNameInput.style.borderColor = "rgba(248,113,113,0.6)";
      setTimeout(() => qcNameInput.style.borderColor = "", 1200);
      return;
    }
    qcSubmitBtn.disabled = true;

    try {
      // 1. Create the collection
      const createData = await apiCall("POST", "/api/collections/create", {
        name, emoji: qcEmoji, color: qcColor, isPublic: false
      });
      if (!createData.success) throw new Error(createData.message || "Failed to create");

      const newCol = createData.collection;

      // 2. Immediately add the current doc to it
      const addData = await apiCall("POST", `/api/collections/${newCol._id}/add-doc`, { docId: DOC_ID });

      // 3. Push into local state
      const entry = {
        _id: newCol._id,
        name: newCol.name,
        emoji: newCol.emoji,
        color: newCol.color,
        contains: true,
        docCount: addData.docCount || 1
      };
      collections.unshift(entry);

      // 4. Reset form & re-render
      collapseQcForm();
      renderList();
      updateSubtitle();
      showToast(`"${name}" created & doc added ✓`, "success");
    } catch (err) {
      showToast(err.message || "Failed. Try again.", "error");
      qcSubmitBtn.disabled = false;
    }
  }

})();
</script>

