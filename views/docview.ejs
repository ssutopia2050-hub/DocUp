  transition: background 0.25s, border-color 0.25s, box-shadow 0.25s;
  pointer-events: none; /* card handles click */
}
.atc-toggle-thumb {
  position: absolute;
  top: 3px; left: 3px;
  width: 17px; height: 17px;
  border-radius: 50%;
  background: rgba(255,255,255,0.55);
  box-shadow: 0 1px 4px rgba(0,0,0,0.3);
  transition: transform 0.28s cubic-bezier(0.34,1.56,0.64,1), background 0.25s;
}
.atc-col-card.atc-col-active .atc-toggle {
  background: var(--atc-col-color, #ff6a00);
  border-color: transparent;
  box-shadow: 0 0 0 3px rgba(255,106,0,0.18);
}
.atc-col-card.atc-col-active .atc-toggle-thumb {
  transform: translateX(19px);
