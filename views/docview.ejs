<script>
    document.addEventListener("contextmenu", e => {
        e.preventDefault();
        showDocupPopup("Action Blocked", "Printing, saving, and right-click actions are disabled for this page on DocUp");
    });

    document.addEventListener("keydown", e => {
        const ctrl = e.ctrlKey || e.metaKey;
        const key = e.key.toLowerCase();

        const blockedBrowserShortcuts =
            (ctrl && ["s", "p", "u"].includes(key)) ||
            (ctrl && e.shiftKey && key === "i") ||
            e.key === "F12";

        const screenshotShortcuts =
            (e.metaKey && e.shiftKey && (key === "3" || key === "4")) ||
            (e.ctrlKey && e.shiftKey && key === "s") ||
            (key === "printscreen");

        if (blockedBrowserShortcuts) {
            e.preventDefault();
            showDocupPopup("Action Blocked", "Printing, saving, and developer shortcuts are disabled on DocUp.");
            return;
        }

        if (screenshotShortcuts) {
            e.preventDefault();
            showDocupPopup("Screenshot Shortcut Detected", "System screenshot shortcuts cannot be fully blocked on web pages.");
        }
    });


</script>
