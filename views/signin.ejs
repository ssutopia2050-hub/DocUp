<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/signup_style.css">
    <link rel="shortcut icon" href="/images/favicon-32x32.png" type="image/x-icon">
    <meta charset="UTF-8">
    <title>DocUp |  SignIn</title>
</head>
<body>
<div class="box">
    <h1>DocUp</h1>
    <form method="post" action="/signin">
        <input type="text" placeholder="Email Address" name="email" required>
        <input type="text" placeholder="Enter Password" name="password" required minlength="6" maxlength="10">
        <% if(err){ %>
        <p style="color:#ffb100"><%= err.message %></p>
        <% } %>
        <button type="submit">Sign In</button>
        <a
                href="/auth/google"
                style="
        width:250px;
        height:50px;
        border:2px solid rgba(255, 255, 255, 0.47);
        background-color:transparent;
        color:white;
        font-size:1.05rem;
        font-weight:bold;
        cursor:pointer;
        display:flex;
        align-items:center;
        justify-content:center;
        gap:12px;
        transition:0.3s;
        text-decoration:none;
    "
                onmouseover="this.style.backgroundColor='rgba(240, 248, 255, 0.09)'"
                onmouseout="this.style.backgroundColor='transparent'"
        >
            <svg width="20" height="20" viewBox="0 0 48 48" fill="none">
                <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303C33.654 32.657 29.243 36 24 36c-6.627 0-12-5.373-12-12S17.373 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.27 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.651-.389-3.917z"/>
                <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 16.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.27 4 24 4c-7.682 0-14.347 4.337-17.694 10.691z"/>
                <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.143 35.091 26.715 36 24 36c-5.222 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
                <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.793 2.237-2.231 4.166-4.084 5.57l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.651-.389-3.917z"/>
            </svg>
            Continue with Google
        </a>
        <a href="/signup">Not a Member ? Sign Up</a>
        <a href="/forgot_password">Forgot Password ? Retrieve Password </a>

    </form>
    <p style="color: rgba(255,255,255,0.15)">You are currently on version <%= process.env.VERSION %>of DocUp</p>
</div>
</body>
</html>