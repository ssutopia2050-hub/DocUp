<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/signup_style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DocUp | Sign In</title>
</head>
<body>

<a href="/" class="auth-wordmark">DocUp</a>

<div class="auth-card">

    <div class="auth-card-header">
        <img src="/images/android-chrome-192x192.png" alt="DocUp" style="width:48px;height:48px;border-radius:12px;margin-bottom:4px;">
        <h1 class="auth-card-title">Welcome back</h1>
        <p class="auth-card-sub">Sign in to your DocUp account to continue.</p>
    </div>

    <form class="auth-form" method="post" action="/signin" id="signin-form">

        <div class="input-group">
            <label for="email">Email Address</label>
            <input
                class="auth-input"
                type="text"
                id="email"
                placeholder="you@example.com"
                name="email"
                required
                autocomplete="email"
                spellcheck="false"
            >
        </div>

        <div class="input-group">
            <label for="password">Password</label>
            <input
                class="auth-input"
                type="password"
                id="password"
                placeholder="Your password"
                name="password"
                required
                minlength="6"
                maxlength="10"
                autocomplete="current-password"
            >
        </div>

        <% if(err){ %>
        <p class="auth-warn"><%= err.message %></p>
        <% } %>

        <button class="auth-btn-primary" type="submit">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Sign In
        </button>

    </form>

    <div class="auth-divider">or</div>

    <a
        href="/auth/google"
        id="google-signin-link"
        class="auth-btn-google"
    >
        <svg width="18" height="18" viewBox="0 0 48 48" fill="none">
            <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303C33.654 32.657 29.243 36 24 36c-6.627 0-12-5.373-12-12S17.373 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.27 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.651-.389-3.917z"/>
            <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 16.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.27 4 24 4c-7.682 0-14.347 4.337-17.694 10.691z"/>
            <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.143 35.091 26.715 36 24 36c-5.222 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
            <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.793 2.237-2.231 4.166-4.084 5.57l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.651-.389-3.917z"/>
        </svg>
        Continue with Google
    </a>

    <div class="auth-links">
        <a href="/signup" class="auth-link">Don't have an account? <strong>Sign Up</strong></a>
        <a href="/forgot_password" class="auth-link">Forgot password? <strong>Retrieve it</strong></a>
        <p class="auth-version">© 2026 DocUp. All rights reserved.</p>
        <p class="auth-version">DocUp v<%= process.env.VERSION %></p>
    </div>

</div>

<script>
    (function () {
        const params = new URLSearchParams(window.location.search);
        const next = params.get("next");
        if (!next) return;

        const form = document.getElementById("signin-form");
        const googleLink = document.getElementById("google-signin-link");

        if (form) {
            form.action = "/signin?next=" + encodeURIComponent(next);
        }
        if (googleLink) {
            googleLink.href = "/auth/google?next=" + encodeURIComponent(next);
        }
    })();
</script>

</body>
</html>
