<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/pricing.css">
    <link rel="stylesheet" href="/page-loader.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <title>Upgrade Plans | DocUp</title>

    <style>
        /* ── Sale Banner ── */
        .sale-banner {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: linear-gradient(90deg, #ff5e00, #ff8c00);
            color: #fff;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.92rem;
            font-weight: 600;
            padding: 10px 20px;
            text-align: center;
            letter-spacing: 0.02em;
        }
        .sale-banner .sale-badge {
            background: rgba(255,255,255,0.25);
            border-radius: 20px;
            padding: 2px 10px;
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        /* ── Strike-through original price when sale active ── */
        .price-original {
            font-size: 1rem;
            color: rgba(255,255,255,0.38);
            text-decoration: line-through;
            margin-right: 6px;
            font-family: 'DM Sans', sans-serif;
        }
    </style>
</head>
<body>

<!-- ══════════════════════════════════════════════════════════
     SALE BANNER — only rendered when a sale is active
════════════════════════════════════════════════════════════ -->
<% if (saleConfig) { %>
<div class="sale-banner">
    <span class="sale-badge">Sale</span>
    <span><%= saleConfig.sale_label %> — <strong><%= saleConfig.discount_percent %>% off</strong> all plans</span>
    <span style="opacity:0.7;font-size:0.8rem;">Ends <%= new Date(saleConfig.ends_at).toLocaleDateString('en-IN', {day:'numeric',month:'short'}) %></span>
</div>
<% } %>

<header class="topbar">
    <div class="topbar-left">
        <a href="/dashboard" class="logo-wordmark">DocUp</a>
    </div>

    <div class="topbar-right">
        <a href="/dashboard" class="topbar-pill">FindDocs</a>

        <div class="docscore-pill">
            <span class="docscore-label">DocScore</span>
            <span class="docscore-value"><%= data.Doc_score %></span>
            <img src="/fire.png" alt="">
        </div>

        <a href="/uploads" class="topbar-pill">Upload</a>

        <div class="avatar-btn" id="avatarBtn">
            <% if (data.avatar_img_path) { %>
            <img src="<%= data.avatar_img_path %>" alt="">
            <% } else { %>
            <%= data.name ? data.name.charAt(0).toUpperCase() : "U" %>
            <% } %>
        </div>
    </div>
</header>

<div class="avatar-dropdown" id="avatarDropdown">
    <a href="/profile">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        Profile
    </a>
    <a href="/pricing">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Recharge DocScore
    </a>
    <a href="/upgrade-plans">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/>
        </svg>
        Upgrade Plans
    </a>
    <a href="/contact">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.89.32 1.76.6 2.6a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.48-1.17a2 2 0 0 1 2.11-.45c.84.28 1.71.48 2.6.6a2 2 0 0 1 1.72 2z"
                  stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Contact Us / Feedback
    </a>
</div>

<section class="hero-section">
    <div class="hero-content">
        <p class="hero-tag">Monthly Subscription</p>
        <h1>Upgrade Your DocUp Access</h1>
        <p class="hero-subtext">
            Choose a monthly DocUp plan and get DocScore added every month for smoother,
            uninterrupted access to notes, study materials, and academic documents.
        </p>
    </div>
</section>

<%
    // Server-side: compute sale prices for display
    const SUB_PLANS = {
        essential_monthly: { amount: 99  },
        standard_monthly:  { amount: 149 },
        power_monthly:     { amount: 250 }
    };
    function salePrice(base) {
        if (!saleConfig) return null;
        return Math.max(1, Math.round(base * (1 - saleConfig.discount_percent / 100)));
    }
%>

<section class="pricing-section">

    <div class="pricing-card starter">
        <p class="plan-tag">Prep</p>
        <h2>Essential Monthly</h2>

        <div class="price-row">
            <% if (saleConfig) { %>
            <span class="price-original">₹<%= SUB_PLANS.essential_monthly.amount %></span>
            <% } %>
            <span class="currency">₹</span>
            <span class="price"><%= saleConfig ? salePrice(SUB_PLANS.essential_monthly.amount) : SUB_PLANS.essential_monthly.amount %>
                <span style="margin-left:-10px;font-size:2rem;font-family:'DM Sans',sans-serif;color:rgba(255,69,0,0.76)">/month</span>
            </span>
        </div>

        <p class="docscore-count">+100 DocScore / month</p>

        <div class="features">
            <div class="feature">Monthly subscription billing</div>
            <div class="feature">100 DocScore credited every month</div>
            <div class="feature">Good for light but regular use</div>
        </div>

        <button type="button" class="buy-btn subscription-btn" data-plan="essential_monthly">
            Upgrade Now
        </button>
    </div>

    <div class="pricing-card popular">
        <div class="popular-badge">Most Popular</div>
        <p class="plan-tag">Value</p>
        <h2>Standard Monthly</h2>

        <div class="price-row">
            <% if (saleConfig) { %>
            <span class="price-original">₹<%= SUB_PLANS.standard_monthly.amount %></span>
            <% } %>
            <span class="currency">₹</span>
            <span class="price"><%= saleConfig ? salePrice(SUB_PLANS.standard_monthly.amount) : SUB_PLANS.standard_monthly.amount %>
                <span style="margin-left:-10px;font-size:2rem;font-family:'DM Sans',sans-serif;color:rgba(255,69,0,0.76)">/month</span>
            </span>
        </div>

        <p class="docscore-count">+200 DocScore / month</p>

        <div class="features">
            <div class="feature">Balanced monthly value</div>
            <div class="feature">200 DocScore credited every month</div>
            <div class="feature">Best for regular DocUp users</div>
        </div>

        <button type="button" class="buy-btn featured-btn subscription-btn" data-plan="standard_monthly">
            Upgrade Now
        </button>
    </div>

    <div class="pricing-card premium">
        <p class="plan-tag">Pro</p>
        <h2>Power Monthly</h2>

        <div class="price-row">
            <% if (saleConfig) { %>
            <span class="price-original">₹<%= SUB_PLANS.power_monthly.amount %></span>
            <% } %>
            <span class="currency">₹</span>
            <span class="price"><%= saleConfig ? salePrice(SUB_PLANS.power_monthly.amount) : SUB_PLANS.power_monthly.amount %>
                <span style="margin-left:-10px;font-size:2rem;font-family:'DM Sans',sans-serif;color:rgba(255,69,0,0.76)">/month</span>
            </span>
        </div>

        <p class="docscore-count">+300 DocScore / month</p>

        <div class="features">
            <div class="feature">Best value for heavy usage</div>
            <div class="feature">300 DocScore credited every month</div>
            <div class="feature">Built for serious, high-frequency access</div>
        </div>

        <button type="button" class="buy-btn subscription-btn" data-plan="power_monthly">
            Upgrade Now
        </button>
    </div>

</section>

<section class="comparison-section">
    <div class="comparison-card">
        <h2>Why Upgrade?</h2>
        <p>
            A subscription plan gives you DocScore automatically every month, so you do not have
            to manually recharge again and again while using DocUp regularly.
        </p>
        <div class="comparison-points">
            <div class="comparison-point">Automatic monthly renewal</div>
            <div class="comparison-point">Predictable DocScore every month</div>
            <div class="comparison-point">Better for regular users than one-time recharge</div>
        </div>
    </div>
</section>

<section class="faq-section">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-grid">
        <div class="faq-card">
            <h3>Is this a recurring plan?</h3>
            <p>Yes, these are monthly subscription plans intended for recurring billing.</p>
        </div>
        <div class="faq-card">
            <h3>When will DocScore be added?</h3>
            <p>DocScore should be added each month after the subscription charge succeeds.</p>
        </div>
        <div class="faq-card">
            <h3>Can I cancel later?</h3>
            <p>Yes, subscription plans should be cancellable from your subscription flow or backend controls.</p>
        </div>
    </div>
</section>

<div class="footer">
    <div style="display:flex;flex-direction:row;justify-content:flex-end;align-items:flex-end;font-family:'Archivo Black',sans-serif" class="footer-left">
        DocUp
        <a href="/version_report" style="font-size:0.8rem;color:rgba(255,255,255,0.22);text-decoration:none">
            v<%= process.env.VERSION %>
        </a>
    </div>
    <div class="footer-right">
        <a href="/dashboard">FindDocs</a>
        <a href="/uploads">Upload</a>
        <a href="/profile">Profile</a>
        <a href="/contact">ContactUs</a>
        <a href="/privacy_policy">Privacy Policy</a>
        <a href="/pricing">Recharge</a>
        <a href="/about_us">About Us</a>
        <a href="/logout">Logout</a>
    </div>
</div>

<script src="/dashboard2.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
/* ──────────────────────────────────────────────────────────────
   AVATAR DROPDOWN
────────────────────────────────────────────────────────────── */
const avatarBtn      = document.getElementById("avatarBtn");
const avatarDropdown = document.getElementById("avatarDropdown");

if (avatarBtn && avatarDropdown) {
    avatarBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        avatarDropdown.classList.toggle("active");
    });
    document.addEventListener("click", (e) => {
        if (!avatarDropdown.contains(e.target) && !avatarBtn.contains(e.target)) {
            avatarDropdown.classList.remove("active");
        }
    });
}

/* ──────────────────────────────────────────────────────────────
   SUBSCRIPTION BUTTONS
────────────────────────────────────────────────────────────── */
const buttons = document.querySelectorAll(".subscription-btn");

buttons.forEach((btn) => {
    btn.addEventListener("click", async () => {
        const originalText = btn.innerText;

        try {
            btn.disabled = true;
            btn.innerText = "Please wait...";

            const plan = btn.dataset.plan;

            const response = await fetch("/buy-subscription", {
                method:  "POST",
                headers: { "Content-Type": "application/json" },
                body:    JSON.stringify({ plan })
            });

            const data = await response.json();

            if (!data.success) {
                alert(data.message || "Could not start subscription");
                btn.disabled = false;
                btn.innerText = originalText;
                return;
            }

            const options = {
                key:             data.key,
                subscription_id: data.subscriptionId,
                name:            "DocUp",
                description:     data.planLabel || "DocUp Monthly Subscription",
                prefill:         { email: data.userEmail },
                theme:           { color: "#ff5e00" },
                handler: async function (paymentResponse) {
                    try {
                        const verifyRes = await fetch("/subscription/verify", {
                            method:  "POST",
                            headers: { "Content-Type": "application/json" },
                            body:    JSON.stringify({ ...paymentResponse, plan })
                        });
                        const verifyData = await verifyRes.json();

                        if (verifyData.success) {
                            window.location.href = verifyData.redirectUrl || "/profile";
                        } else {
                            btn.disabled = false;
                            btn.innerText = originalText;
                            alert(verifyData.message || "Subscription verification failed");
                        }
                    } catch (err) {
                        console.error(err);
                        btn.disabled = false;
                        btn.innerText = originalText;
                        alert("Subscription verification failed");
                    }
                },
                modal: {
                    ondismiss: function () {
                        btn.disabled = false;
                        btn.innerText = originalText;
                    }
                }
            };

            const rzp = new Razorpay(options);
            rzp.on("payment.failed", function () {
                btn.disabled = false;
                btn.innerText = originalText;
                alert("Payment failed. Please try again.");
            });
            rzp.open();

        } catch (err) {
            console.error(err);
            alert("Something went wrong");
            btn.disabled = false;
            btn.innerText = originalText;
        }
    });
});
</script>

<%- include('partials/page-loader') %>
</body>
</html>
