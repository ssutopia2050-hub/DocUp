<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/profile_view.css">
    <link rel="stylesheet" href="/page-loader.css">
    <meta charset="UTF-8">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DocUp | <%= data.name || "Profile" %></title>
</head>
<body>

<%
const uploadCount = Array.isArray(data.uploads) ? data.uploads.length : 0;
const paymentCount = Array.isArray(data.payment_history) ? data.payment_history.length : 0;
const safeDocScore = Math.max(0, Number(data.Doc_score || 0));

const recentUploads = Array.isArray(data.uploads)
? data.uploads.slice().reverse().slice(0, 8)
: [];

let contributorLevel = "Rising Contributor";
if (uploadCount >= 25) contributorLevel = "Elite Contributor";
else if (uploadCount >= 10) contributorLevel = "Trusted Contributor";
else if (uploadCount >= 3) contributorLevel = "Active Contributor";

function initials(name) {
if (!name) return "U";
return name.trim().charAt(0).toUpperCase();
}
%>
<header class="topbar">
    <div class="topbar-left">
        <a href="/dashboard" class="logo-wordmark">DocUp</a>

        <!--        <div class="topbar-divider"></div>-->

        <!--        <span class="topbar-breadcrumb">-->
        <!--            <a href="/dashboard">Dashboard</a>-->
        <!--            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">-->
        <!--                <path d="M4.5 2.5L7.5 6L4.5 9.5"-->
        <!--                      stroke="currentColor"-->
        <!--                      stroke-width="1.4"-->
        <!--                      stroke-linecap="round"-->
        <!--                      stroke-linejoin="round"/>-->
        <!--            </svg>-->
        <!--            <span class="breadcrumb-current">FindDocs</span>-->
        <!--        </span>-->
    </div>

    <div class="topbar-right">

        <!-- FindDocs -->
        <a href="/dashboard" class="topbar-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none">
                <path d="M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"/>
            </svg>
            <span>FindDocs</span>
        </a>

        <!-- DocScore -->
        <div class="docscore-pill">
            <span class="docscore-label">DocScore</span>
            <span class="docscore-value"><%= p_data.Doc_score %></span>
            <img src="/fire.png" alt="">
        </div>

        <!-- Upload -->
        <a href="/uploads" class="topbar-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none">
                <path d="M12 16V4M12 4l-4 4M12 4l4 4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"/>
                <path d="M5 18.5h14"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"/>
            </svg>
            <span>Upload</span>
        </a>

        <!-- Notifications -->
        <div class="notification-wrap">
            <button type="button" class="icon-btn notification-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M9 17H15M6.5 17H17.5C16.9 16.35 16.5 15.48 16.5 14.5V10.5C16.5 8.01 14.49 6 12 6C9.51 6 7.5 8.01 7.5 10.5V14.5C7.5 15.48 7.1 16.35 6.5 17Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>
                    <path d="M10.5 20C10.74 20.62 11.32 21 12 21C12.68 21 13.26 20.62 13.5 20"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>
                </svg>

                <% const unreadCount = (p_data.notifications || []).filter(n => !n.isRead).length; %>
                <% if (unreadCount > 0) { %>
                <span class="notif-badge"><%= unreadCount > 9 ? "9+" : unreadCount %></span>
                <% } %>
            </button>

            <div style="background: #000407" class="notification-dropdown">
                <div class="nd-header">
                    <span class="nd-title">Notifications</span>
                    <% if (p_data.notifications && p_data.notifications.length > 0) { %>
                    <a href="/notifications" class="nd-view-all">View all</a>
                    <% } %>
                </div>

                <div class="nd-list">
                    <% if (p_data.notifications && p_data.notifications.length > 0) { %>
                    <% p_data.notifications.slice().reverse().forEach((item) => { %>
                    <div class="nd-item <%= item.isRead ? '' : 'unread' %>">
                        <div class="nd-item-row">
                            <span class="nd-dot"></span>
                            <span class="nd-when">
                                <%= item.createdAt
                                    ? new Date(item.createdAt).toLocaleString("en-IN", {
                                        dateStyle: "medium",
                                        timeStyle: "short"
                                    })
                                    : "Just now" %>
                            </span>
                        </div>
                        <p class="nd-text"><%= item.content %></p>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="nd-empty">No notifications yet.</div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Avatar -->
        <div class="avatar-btn">
            <% if (p_data.avatar_img_path) { %>
            <img src="<%= p_data.avatar_img_path %>" alt="">
            <% } else { %>
            <%= p_data.name ? p_data.name.charAt(0).toUpperCase() : "U" %>
            <% } %>
        </div>

    </div>
</header>

<!-- Avatar Dropdown -->
<div class="avatar-dropdown">
    <a href="/profile">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"/>
        </svg>
        Profile
    </a>

    <a href="/pricing">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"/>
        </svg>
        Recharge DocScore
    </a>
    <a href="/upgrade-plans">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                  stroke-width="1.6"/>
        </svg>
        Upgrade Plans
    </a>
    <a href="/contact">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2
                 19.79 19.79 0 0 1-8.63-3.07
                 19.5 19.5 0 0 1-6-6
                 19.79 19.79 0 0 1-3.07-8.67
                 A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72
                 c.12.89.32 1.76.6 2.6
                 a2 2 0 0 1-.45 2.11L8.09 9.91
                 a16 16 0 0 0 6 6l1.48-1.17
                 a2 2 0 0 1 2.11-.45
                 c.84.28 1.71.48 2.6.6
                 a2 2 0 0 1 1.72 2z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"/>
        </svg>
        Contact Us / Feedback
    </a>
</div>
<div class="public-profile-page">

    <section class="hero-card glass-card">
        <div class="hero-left">
            <div class="public-avatar <%= data.avatar_img_path ? 'has-image' : '' %>">
                <% if (data.avatar_img_path) { %>
                <img src="<%= data.avatar_img_path %>" alt="avatar">
                <% } else { %>
                <%= initials(data.name) %>
                <% } %>
            </div>

            <div class="hero-text">
                <p class="eyebrow">DocUp Community Profile</p>
                <h1><%= data.name || "DocUp User" %></h1>
                <p class="hero-subtext">
                  Press the back button of browser to return to your document . No DocScore will be deducted for this..
                </p>

                <div class="badge-row">
                    <span style="border-radius:5px" class="profile-badge orange-badge"><%= contributorLevel %></span>
                    <% if( saved_status){ %>
                    <a  style="border-radius:5px" class="profile-badge orange-badge" href="/save_profile/<%= data.email %>"> Saved Profile !</a>
                    <% } else { %>
                    <a  style="border-radius:5px" class="profile-badge orange-badge" href="/save_profile/<%= data.email %>"> Save Profile </a>
                    <% } %>
                    <span class="profile-badge neutral-badge"><%= data.subscription || "Free Tier" %></span>
                    <span class="profile-badge neutral-badge"><%= data.user_type || "DocUp Member" %></span>

                </div>
            </div>
        </div>

        <div class="hero-right">
            <div class="hero-stat-card">
                <p class="hero-stat-number"><%= safeDocScore %></p>
                <p class="hero-stat-label">DocScore</p>
            </div>

            <div class="hero-stat-card">
                <p class="hero-stat-number"><%= uploadCount %></p>
                <p class="hero-stat-label">Uploads</p>
            </div>

            <div class="hero-stat-card">
                <p class="hero-stat-number"><%= paymentCount %></p>
                <p class="hero-stat-label">Payments</p>
            </div>
        </div>
    </section>

    <section class="profile-content-grid">

        <div class="main-column">

            <div class="identity-card glass-card">
                <div class="section-header">
                    <h2>Profile Overview</h2>
                    <span class="mini-tag">Public View</span>
                </div>

                <div class="info-grid">
                    <div class="info-box">
                        <span class="info-label">Full Name</span>
                        <span class="info-value"><%= data.name || "Not Available" %></span>
                    </div>

                    <div class="info-box">
                        <span class="info-label">Account Type</span>
                        <span class="info-value"><%= data.user_type || "DocUp Member" %></span>
                    </div>

                    <div class="info-box">
                        <span class="info-label">Subscription</span>
                        <span class="info-value"><%= data.subscription || "Free Tier" %></span>
                    </div>

                    <div class="info-box">
                        <span class="info-label">Contribution Level</span>
                        <span class="info-value"><%= contributorLevel %></span>
                    </div>
                </div>
            </div>

            <div class="recent-uploads-card glass-card">
                <div class="section-header">
                    <h2>Recent Uploads</h2>
                    <a style="color:orangered" href="/all_uploads_view_second_pov_profile/<%= data._id %>"><span style="color:orangered;font-size: 0.9rem" class="mini-tag">View all Uploads</span></a>
                </div>

                <% if (recentUploads.length > 0) { %>
                <div class="uploads-list">
                    <% recentUploads.forEach(upload => { %>
                    <div class="upload-item">
                        <div class="upload-left">
                            <div class="upload-icon">↑</div>

                            <div class="upload-details">
                                <p class="upload-subject">
                                    <%= upload.chapter || upload.subject || "Uploaded Document" %>
                                </p>

                                <p class="upload-meta">
                                    <%= upload.subject || "Unknown Subject" %>
                                    <% if (upload.college) { %>
                                    • <%= upload.college %>
                                    <% } %>
                                    <% if (upload.uploadedAt) { %>
                                    • <%= new Date(upload.uploadedAt).toLocaleDateString() %>
                                    <% } %>
                                </p>
                            </div>
                        </div>

                        <div class="doc-action-group">
                            <% if (upload.doc_id?.reviewed === true) { %>
                            <span class="review-badge verified-badge">Verified</span>
                            <% } else { %>
                            <span class="review-badge pending-badge">To be Reviewed</span>
                            <% } %>

                            <% if (upload.doc_id?._id) { %>
                            <a href="/view/<%= upload.doc_id._id %>" class="open-upload-btn">Open</a>
                            <% } else { %>
                            <span class="disabled-upload-btn">Unavailable</span>
                            <% } %>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } else { %>
                <div class="empty-state">
                    <p>This contributor has not uploaded any documents yet.</p>
                </div>
                <% } %>
            </div>

        </div>

        <aside class="side-column">

            <div class="contributor-card glass-card">
                <h2>Contributor Snapshot</h2>

                <div class="snapshot-list">
                    <div class="snapshot-item">
                        <span>Public Role</span>
                        <strong>Contributor</strong>
                    </div>

                    <div class="snapshot-item">
                        <span>Total Uploads</span>
                        <strong><%= uploadCount %></strong>
                    </div>

                    <div class="snapshot-item">
                        <span>DocScore</span>
                        <strong><%= safeDocScore %></strong>
                    </div>

                    <div class="snapshot-item">
                        <span>Membership</span>
                        <strong><%= data.subscription || "Free Tier" %></strong>
                    </div>
                </div>
            </div>

            <div class="public-note-card glass-card">
                <h2>About This Page</h2>
                <p class="public-note-text">
                    This is a public-facing DocUp profile designed to help learners discover active contributors and explore the materials they share.
                </p>
            </div>

            <div class="public-action-card glass-card">
                <h2>Explore More</h2>
                <div class="public-action-row">
                    <a href="/dashboard" class="action-btn secondary-btn">Find Documents</a>
                    <a href="/uploads" class="action-btn secondary-btn">Upload Notes</a>
                    <a href="" class="action-btn primary-btn">Message Update Coming soon ...</a>
                </div>
            </div>

        </aside>

    </section>

</div>

<script src="/dashboard2.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const viewLinks = document.querySelectorAll('a[href^="/view/"]');

        function resetViewLinks() {
            document.querySelectorAll('a[href^="/view/"]').forEach(link => {
                link.dataset.clicked = "false";
                link.style.pointerEvents = "";
                link.style.opacity = "";
            });
        }

        viewLinks.forEach(link => {
            link.addEventListener("click", function(e) {
                if (this.dataset.clicked === "true") {
                    e.preventDefault();
                    return;
                }

                this.dataset.clicked = "true";
                this.style.pointerEvents = "none";
                this.style.opacity = "0.6";

                setTimeout(() => {
                    if (!document.hidden) {
                        this.dataset.clicked = "false";
                        this.style.pointerEvents = "";
                        this.style.opacity = "";
                    }
                }, 20000);
            });
        });

        window.addEventListener("pageshow", resetViewLinks);
    });
</script>
<%- include('partials/page-loader') %>
</body>
</html>