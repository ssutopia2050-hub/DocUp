<!DOCTYPE html>
<html lang="en">
<head>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/dashboard.css">

    <meta charset="UTF-8">
    <title>DocUp | Contact</title>

</head>
<body>

<div class="topbar">
    <div style="font-family: Archivo Black , sans-serif;font-size: 2rem" class="logo-text-container">DocUp</div>

    <div style="display: flex;gap: 10px;font-family: 'DM Sans',sans-serif" class="pg-links">
        <a href="/dashboard">FindDocs</a>
        <a href="/uploads">Upload</a>
    </div>
</div>

<div class="contact-page">

    <div class="contact-left glass-card">

        <h1 style="color: #f49671">Contact Us</h1>

        <p class="contact-desc">
            Facing issues with payments, document access or uploads?
            Want to report a bug or suggest improvements?
            We are always happy to help.
        </p>

        <div class="contact-info-block">
            <span class="contact-label">Support Email</span>
            <span class="contact-value">ssbiology26@gmail.com</span>
        </div>

        <div class="contact-info-block">
            <span class="contact-label">Business Queries</span>
            <span class="contact-value">ssbiology26@gmail.com</span>
        </div>

        <div class="contact-info-block">
            <span class="contact-label">Average Response Time</span>
            <span class="contact-value">Within 24 Hours</span>
        </div>

    </div>
</div>

<div class="footer">
    <div style="display: flex;flex-direction: row;justify-content: flex-end;align-items: flex-end;font-family: Archivo Black , sans-serif" class="footer-left">
        DocUp
        <p style="font-size: 0.8rem ; color:rgba(255,255,255,0.22)">v<%= process.env.VERSION %></p>
    </div>
    <div class="footer-right">
        <a href="/dashboard">FindDocs</a>
        <a href="/uploads">Upload</a>
        <a href="/profile">Profile</a>
        <a href="/contact">ContactUs</a>
        <a href="/privacy_policy">Privacy Policy</a>
        <a href="/logout">Logout</a>
    </div>
</div>

</body>
</html>