<%#
  ═══════════════════════════════════════════════════════════════════
  dashboard-collections-snippet.ejs

  HOW TO APPLY
  In dashboard.ejs, find the block that starts with:

      <!-- ── MY COLLECTIONS ── -->
      <% if (dashboardCollections && dashboardCollections.length > 0) { %>
      <section class="discovery-section dash-collections-section">
          ...
      </section>
      <% } %>

  (it sits right after the "SAVED COLLEGES" <section> closes, inside
  #initial-college-grid). Delete that whole block — including the
  surrounding `<% if %> ... <% } %>` — and paste everything below in
  its place.

  WHAT CHANGED
  — Before: if the user had zero collections, this section rendered
    nothing at all. The entire collections feature was invisible on
    the dashboard until someone had already gone to /collections and
    made one manually.
  — Now: an `<% } else { %>` branch renders a proper empty-state card
    (same visual language as your existing `.saved-zero-state`),
    with a direct CTA into /collections.
  — Card icons switched from raw emoji to the shared SVG icon system
    via `renderIcon()` (see server-collections-additions.js — it's
    registered on app.locals, so it's already available here with no
    extra require/import needed once that patch is applied).

  Also add this line to dashboard.ejs's <head>, after the existing
  <link rel="stylesheet" href="/dashboard.css"> line:

      <link rel="stylesheet" href="/dashboard-collections-v2.css">
  ═══════════════════════════════════════════════════════════════════
%>

<%
// Local fallback so this section still renders correctly even before
// the server.js app.locals patch is applied.
const _renderIcon = typeof renderIcon === 'function' ? renderIcon : (slug) => slug || '📁';
%>

<!-- ── MY COLLECTIONS ── -->
<% if (dashboardCollections && dashboardCollections.length > 0) { %>
<section class="discovery-section dash-collections-section">
    <div class="discovery-section-header dash-col-section-header">
        <div>
            <h2 class="discovery-section-title">My Collections</h2>
            <p class="discovery-section-sub">Your organised study playlists</p>
        </div>
        <a href="/collections" class="dash-col-view-all">
            View all
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
    </div>

    <div class="dash-col-grid">
        <% dashboardCollections.forEach(col => { %>
        <a href="/collections/<%= col._id %>" class="dash-col-card" style="--col-accent: <%= col.color || '#ff6a00' %>">
            <div class="dash-col-accent-bar"></div>

            <div class="dash-col-card-head">
                <span class="dash-col-emoji"><%- _renderIcon(col.emoji, 17) %></span>
                <div class="dash-col-badges">
                    <% if (col.pinned) { %>
                    <span class="dash-col-badge dash-col-badge-pin" title="Pinned">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M16 3a1 1 0 0 1 1 1v1l1.5 6H18a1 1 0 0 0-1 1v4l-4 4-4-4v-4a1 1 0 0 0-1-1H6.5L8 5V4a1 1 0 0 1 1-1h7z"/></svg>
                    </span>
                    <% } %>
                    <% if (col.isPublic) { %>
                    <span class="dash-col-badge dash-col-badge-pub" title="Public">
                        <svg width="9" height="9" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 3C10 7 10 17 12 21M12 3C14 7 14 17 12 21M3 12h18" stroke="currentColor" stroke-width="1.6"/></svg>
                    </span>
                    <% } %>
                </div>
            </div>

            <div class="dash-col-card-body">
                <span class="dash-col-name"><%= col.name %></span>
                <% if (col.description) { %>
                <span class="dash-col-desc"><%= col.description %></span>
                <% } %>
            </div>

            <div class="dash-col-docs">
                <% if (col.previewDocs.length === 0) { %>
                    <span class="dash-col-empty-hint">No docs yet</span>
                <% } else { %>
                    <% col.previewDocs.forEach(doc => { %>
                    <div class="dash-col-doc-chip">
                        <span class="dash-col-chip-dot"></span>
                        <span class="dash-col-chip-text"><%= doc.subject %></span>
                    </div>
                    <% }) %>
                <% } %>
            </div>

            <div class="dash-col-footer">
                <span class="dash-col-count">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" stroke="currentColor" stroke-width="1.8"/></svg>
                    <%= col.docCount %> doc<%= col.docCount !== 1 ? 's' : '' %>
                </span>
                <span class="dash-col-arrow">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
            </div>
        </a>
        <% }) %>

        <!-- Create new collection CTA -->
        <a href="/collections" class="dash-col-card dash-col-new-card">
            <div class="dash-col-new-inner">
                <div class="dash-col-new-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                </div>
                <span class="dash-col-new-label">New collection</span>
            </div>
        </a>
    </div>
</section>
<% } else { %>

<!-- ── MY COLLECTIONS — EMPTY STATE ──
     Previously this section rendered nothing when the user had no
     collections. That silence is what made the feature feel absent
     from the dashboard entirely. ── -->
<section class="discovery-section dash-collections-section">
    <div class="discovery-section-header">
        <h2 class="discovery-section-title">My Collections</h2>
        <p class="discovery-section-sub">Group notes, PYQs and references into playlists you can revisit anytime</p>
    </div>

    <a href="/collections" class="dash-col-empty-cta">
        <div class="dash-col-empty-glow"></div>
        <div class="dash-col-empty-icon"><%- _renderIcon('folder', 26) %></div>
        <div class="dash-col-empty-text">
            <span class="dash-col-empty-title">Create your first collection</span>
            <span class="dash-col-empty-sub">Bundle related docs — a subject's full syllabus, an exam's PYQs, or your own study set — into one place you can share or come back to.</span>
        </div>
        <span class="dash-col-empty-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
    </a>
</section>
<% } %>
