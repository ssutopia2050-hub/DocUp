<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DocUp Dev | Reports</title>

    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/dev_reports.css">
    <link rel="stylesheet" href="/page-loader.css">
</head>
<body>

<div class="reports-shell">

    <!-- SIDEBAR -->
    <aside class="reports-sidebar">
        <div class="box" style="display:flex;align-items:flex-end;justify-content:center;gap:6px;padding-bottom:20px;">
            <h1 style="font-size:3rem;font-family:'Archivo Black'">DocUp</h1>
            <h3 style="color:orangered;">Dev</h3>
        </div>

        <nav class="reports-nav">
            <a href="/dev/dashboard">Dashboard</a>
            <a href="/dev/users">Users</a>
            <a href="/dev/docs">Docs</a>
            <a href="/dev/reports" class="active">Reports</a>
            <a href="/dev/activity">Activity</a>
            <a href="/dev/coupons">Coupon Manager</a>
        </nav>
    </aside>

    <!-- MAIN -->
    <main class="reports-main">

        <!-- TOPBAR -->
        <header class="reports-topbar">
            <div>
                <h2>Reports & Contacts</h2>
                <p class="subtitle">Manage flagged docs and user messages</p>
            </div>

            <div class="top-controls">
                <input type="text" id="reportSearch" placeholder="Search..." class="search-input">

                <div class="filter-group">
                    <button class="filter-btn active" data-filter="all">All</button>
                    <button class="filter-btn" data-filter="report">Reports</button>
                    <button class="filter-btn" data-filter="contact">Contacts</button>
                    <button class="filter-btn" data-filter="reviewed">Reviewed</button>
                    <button class="filter-btn" data-filter="unreviewed">Unreviewed</button>
                    <button class="filter-btn" data-filter="missing">Missing</button>
                </div>
            </div>
        </header>

        <!-- CONTENT -->
        <section class="reports-content">

            <% if (reportsData && reportsData.length > 0) { %>
            <div class="reports-grid">

                <% reportsData.forEach(item => { %>

                <div class="report-card"
                     data-type="<%= item.type %>"
                     data-reviewed="<%= item.doc ? item.doc.reviewed : false %>"
                     data-missing="<%= item.doc ? false : true %>"
                     data-search="<%= (
        (item.reported_by_email || '') + ' ' +
        (item.report || '') + ' ' +
        (item.doc?.subject || '')
     ).toLowerCase() %>">

                    <!-- HEADER -->
                    <div class="report-head">
                        <div>
                            <h3>
                                <%= item.type === "contact" ? "Contact Message" : "Report" %>
                            </h3>

                            <p class="report-submeta">
                                <span><%= item.reported_by_email %></span>
                                <span>•</span>
                                <span>
                    <%= item.createdAt ? new Date(item.createdAt).toLocaleString() : "—" %>
                </span>
                            </p>
                        </div>

                        <div class="badge-group">

                            <% if (item.type === "contact") { %>
                            <span class="badge info">Contact</span>
                            <% } else { %>

                            <% if (item.doc) { %>
                            <% if (item.doc.reviewed) { %>
                            <span class="badge good">Reviewed</span>
                            <% } else { %>
                            <span class="badge warn">Unreviewed</span>
                            <% } %>
                            <% } else { %>
                            <span class="badge danger">Missing</span>
                            <% } %>

                            <% } %>

                        </div>
                    </div>

                    <!-- MESSAGE -->
                    <div class="reason-box">
        <span class="reason-label">
            <%= item.type === "contact" ? "Message" : "Report Reason" %>
        </span>
                        <p><%= item.report || "No content" %></p>
                    </div>

                    <!-- CONTACT -->
                    <% if (item.type === "contact") { %>

                    <div class="missing-doc-box">
                        <p>User contact message (not linked to any document).</p>

                        <form action="/dev/contact/<%= item._id %>/delete" method="POST"
                              onsubmit="return confirm('Delete this message?')">
                            <button type="submit" class="btn btn-secondary">
                                Delete Message
                            </button>
                        </form>
                    </div>

                    <% } %>

                    <!-- DOC -->
                    <% if (item.type === "report" && item.doc) { %>

                    <% if (item.doc.file_url) { %>
                    <div class="pdf-preview">
                        <iframe src="<%= item.doc.file_url %>#toolbar=0"></iframe>
                    </div>
                    <% } %>

                    <div class="doc-block">

                        <div class="doc-block-head">
                            <h4><%= item.doc.subject || "Untitled" %></h4>
                            <p>
                                <%= item.doc.college || "Unknown" %> •
                                <%= item.doc.branch || "Unknown" %>
                            </p>
                        </div>

                        <div class="report-meta-grid">
                            <div class="meta-box">
                                <span class="meta-label">Uploader</span>
                                <strong><%= item.doc.uploaded_by || "—" %></strong>
                            </div>

                            <div class="meta-box">
                                <span class="meta-label">Year</span>
                                <strong><%= item.doc.year || "—" %></strong>
                            </div>

                            <div class="meta-box">
                                <span class="meta-label">Likes</span>
                                <strong><%= item.doc.likes || 0 %></strong>
                            </div>

                            <div class="meta-box">
                                <span class="meta-label">Comments</span>
                                <strong><%= item.doc.commentCount || 0 %></strong>
                            </div>
                        </div>

                        <div class="report-actions">

                            <% if (item.doc.file_url) { %>
                            <a href="<%= item.doc.file_url %>" target="_blank" class="btn btn-secondary">
                                Open PDF
                            </a>
                            <% } %>

                            <form action="/dev/docs/<%= item.doc._id %>/<%= item.doc.reviewed ? 'unreview' : 'review' %>" method="POST">
                                <button type="submit" class="btn <%= item.doc.reviewed ? 'btn-secondary' : 'btn-primary' %>">
                                    <%= item.doc.reviewed ? 'Unreview' : 'Review' %>
                                </button>
                            </form>

                            <form action="/dev/reports/<%= item._id %>/delete" method="POST">
                                <button class="btn btn-secondary">Dismiss</button>
                            </form>

                            <form action="/dev/reports/<%= item._id %>/delete-doc" method="POST"
                                  onsubmit="return confirm('Delete full doc?')">
                                <button class="btn btn-danger">Delete Doc</button>
                            </form>

                        </div>

                    </div>

                    <% } %>

                </div>

                <% }) %>

            </div>
            <% } else { %>

            <div class="empty-state">
                <h3>No data found</h3>
                <p>No reports or contact messages yet.</p>
            </div>

            <% } %>

        </section>
    </main>
</div>

<!-- FILTER SCRIPT -->
<script>
    const searchInput = document.getElementById("reportSearch");
    const filterBtns = document.querySelectorAll(".filter-btn");
    const cards = document.querySelectorAll(".report-card");

    let activeFilter = "all";

    searchInput?.addEventListener("input", applyFilters);

    filterBtns.forEach(btn => {
        btn.addEventListener("click", () => {
            filterBtns.forEach(b => b.classList.remove("active"));
            btn.classList.add("active");
            activeFilter = btn.dataset.filter;
            applyFilters();
        });
    });

    function applyFilters() {
        const search = searchInput.value.toLowerCase();

        cards.forEach(card => {
            const text = card.dataset.search;
            const type = card.dataset.type;
            const reviewed = card.dataset.reviewed === "true";
            const missing = card.dataset.missing === "true";

            let visible = true;

            if (!text.includes(search)) visible = false;

            if (activeFilter === "report" && type !== "report") visible = false;
            if (activeFilter === "contact" && type !== "contact") visible = false;
            if (activeFilter === "reviewed" && !reviewed) visible = false;
            if (activeFilter === "unreviewed" && (reviewed || missing)) visible = false;
            if (activeFilter === "missing" && !missing) visible = false;

            card.style.display = visible ? "block" : "none";
        });
    }
</script>
<%- include('partials/page-loader') %>
</body>
</html>