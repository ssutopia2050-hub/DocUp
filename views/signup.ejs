<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="shortcut icon" href="/images/favicon-32x32.png" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="/signup_style.css" rel="stylesheet">
    <meta charset="UTF-8">
    <title>DocUp |  SignUp</title>
</head>
<body>
<div class="box">
    <h1>DocUp</h1>
    <form method="post" action="/signup">
        <input type="text" placeholder="Name" name="name" required>
        <input type="text" placeholder="Email Address" name="email" required autocomplete="on">
        <input type="text" placeholder="Create Password" name="password" required minlength="6" maxlength="10">
        <% if(err){ %>
        <p style="color:red"><%= err.message %></p>
        <% } %>
        <button type="submit">Sign Up</button>
        <a href="/signin">Already a Member ? Sign In</a>
        <a href="/privacy_policy">Terms and Conditions</a>
        <p style="color: rgba(255,255,255,0.15)">You are currently on version 1.0.0 of DocUp</p>
    </form>
</div>
</body>
</html>