<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/signup_style.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DocUp | Forgot Password</title>
</head>
<body>

<a href="/" class="auth-wordmark">DocUp</a>

<div class="auth-card">

    <div class="auth-card-header">
        <img src="/images/android-chrome-192x192.png" alt="DocUp" style="width:48px;height:48px;border-radius:12px;margin-bottom:4px;">
        <h1 class="auth-card-title">Forgot password?</h1>
        <p class="auth-card-sub">Enter your email and we'll send your password to your inbox.</p>
    </div>

    <form class="auth-form" method="post" action="/forgot_password">

        <p id="timer" class="auth-timer"></p>

        <div class="input-group">
            <label for="email">Email Address</label>
            <input
                class="auth-input"
                type="text"
                id="email"
                placeholder="you@example.com"
                name="email"
                required
                autocomplete="email"
                spellcheck="false"
            >
        </div>

        <% if(err){ %>
        <p class="auth-warn"><%= err.message %></p>
        <% } %>

        <button
            class="auth-btn-primary"
            id="resendBtn"
            type="submit"
            formnovalidate
        >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Send Password to Mail
        </button>

        <button
            class="auth-btn-secondary"
            type="button"
            onclick="window.location.href='/signin'"
        >
            Back to Sign In
        </button>

    </form>

    <div class="auth-links">
        <p class="auth-version">© 2026 DocUp. All rights reserved.</p>
        <p class="auth-version">DocUp v<%= process.env.VERSION %></p>

    </div>

</div>

<script>
    const resendAllowedAt = Number("<%= typeof resendAllowedAt !== 'undefined' ? resendAllowedAt : 0 %>");
    const timerEl  = document.getElementById("timer");
    const resendBtn = document.getElementById("resendBtn");

    function updateTimers() {
        const now = Date.now();
        const resendRemaining = Math.floor((resendAllowedAt - now) / 1000);

        if (resendRemaining > 0) {
            const mins = Math.floor(resendRemaining / 60);
            const secs = String(resendRemaining % 60).padStart(2, '0');

            resendBtn.disabled = true;
            resendBtn.style.opacity = "0.55";
            resendBtn.style.cursor = "not-allowed";
            resendBtn.innerHTML = `Resend Email (${mins}m ${secs}s)`;

            timerEl.style.display = "block";
            timerEl.innerText = `You can request another email in ${mins}m ${secs}s`;
        } else {
            resendBtn.disabled = false;
            resendBtn.style.opacity = "1";
            resendBtn.style.cursor = "pointer";
            resendBtn.innerHTML = `
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Send Password to Mail`;
            timerEl.style.display = "none";
        }
    }

    setInterval(updateTimers, 1000);
    updateTimers();
</script>

</body>
</html>
