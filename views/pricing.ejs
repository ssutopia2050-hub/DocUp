<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/pricing.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recharge | DocUp</title>
</head>
<body>

<div class="topbar">
    <div class="logo-text-container">
        DocUp
    </div>

    <div class="pg-links">
        <a href="/profile"><span>Profile</span></a>
        <a href="/dashboard"><span>FindDocs</span></a>
        <a href="/pricing"><span class="active-link">Recharge</span></a>
    </div>
</div>

<section class="hero-section">
    <div class="hero-content">
        <p class="hero-tag">DocScore Recharge</p>
        <h1>Unlock More Document Access</h1>
        <p class="hero-subtext">
            Recharge your DocScore and continue exploring premium notes, study material, and useful academic resources on DocUp.
        </p>
    </div>
</section>

<section class="pricing-section">
    <div class="pricing-card starter">
        <p class="plan-tag">Basic</p>
        <h2>Starter Recharge</h2>
        <div class="price-row">
            <span class="currency">₹</span>
            <span class="price">19</span>
        </div>
        <p class="docscore-count">+10 DocScore</p>

        <div class="features">
            <div class="feature">Access more protected documents</div>
            <div class="feature">Low-cost quick recharge</div>
            <div class="feature">Perfect for casual users</div>
        </div>

        <button type="button" class="buy-btn recharge-btn" data-plan="starter">
            Recharge Now
        </button>
    </div>

    <div class="pricing-card popular">
        <div class="popular-badge">Most Popular</div>
        <p class="plan-tag">Value</p>
        <h2>Standard Recharge</h2>
        <div class="price-row">
            <span class="currency">₹</span>
            <span class="price">49</span>
        </div>
        <p class="docscore-count">+30 DocScore</p>

        <div class="features">
            <div class="feature">Better value than single recharge</div>
            <div class="feature">Great for regular usage</div>
            <div class="feature">Balanced price and access</div>
        </div>

        <button type="button" class="buy-btn featured-btn recharge-btn" data-plan="standard">
            Recharge Now
        </button>
    </div>

    <div class="pricing-card premium">
        <p class="plan-tag">Pro</p>
        <h2>Unlimited Study Pack</h2>
        <div class="price-row">
            <span class="currency">₹</span>
            <span class="price">99</span>
        </div>
        <p class="docscore-count">+100 DocScore</p>

        <div class="features">
            <div class="feature">Best value overall</div>
            <div class="feature">Ideal for heavy users</div>
            <div class="feature">Longer uninterrupted access</div>
        </div>

        <button type="button" class="buy-btn recharge-btn" data-plan="pro">
            Recharge Now
        </button>
    </div>
</section>

<section class="comparison-section">
    <div class="comparison-card">
        <h2>Why Recharge DocScore?</h2>
        <p>
            Every time you open a protected document on DocUp, DocScore is used. Recharging lets you keep discovering notes without interruption.
        </p>

        <div class="comparison-points">
            <div class="comparison-point">Fast access to more study resources</div>
            <div class="comparison-point">Flexible plans for every kind of student</div>
            <div class="comparison-point">Secure payment flow</div>
        </div>
    </div>
</section>

<section class="faq-section">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-grid">
        <div class="faq-card">
            <h3>What is DocScore?</h3>
            <p>DocScore is the access credit used when opening protected documents on DocUp.</p>
        </div>

        <div class="faq-card">
            <h3>Does recharge expire?</h3>
            <p>No, they don't expire unless you use all recharged DocScores.</p>
        </div>

        <div class="faq-card">
            <h3>When is score added?</h3>
            <p>Instantly after payment is verified successfully.</p>
        </div>
    </div>
</section>

<div class="footer">
    <div class="footer-left">DocUp</div>
    <div class="footer-right">
        <a href="/dashboard">FindDocs</a>
        <a href="/profile">Profile</a>
        <a href="/pricing">Recharge</a>
    </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    const buttons = document.querySelectorAll(".recharge-btn");

    buttons.forEach((btn) => {
        btn.addEventListener("click", async () => {
            const originalText = btn.innerText;

            try {
                btn.disabled = true;
                btn.innerText = "Please wait...";

                const plan = btn.dataset.plan;

                const response = await fetch("/buy-recharge", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ plan })
                });

                const data = await response.json();

                if (!data.success) {
                    alert(data.message || "Could not start payment");
                    btn.disabled = false;
                    btn.innerText = originalText;
                    return;
                }

                const options = {
                    key: data.key,
                    amount: data.amount,
                    currency: data.currency,
                    name: "DocUp",
                    description: "DocScore Recharge",
                    order_id: data.orderId,
                    prefill: {
                        email: data.userEmail
                    },
                    theme: {
                        color: "#ff5e00"
                    },
                    handler: async function (paymentResponse) {
                        try {
                            const verifyRes = await fetch("/payment/verify", {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify(paymentResponse)
                            });

                            const verifyData = await verifyRes.json();

                            if (verifyData.success) {
                                window.location.href = verifyData.redirectUrl;
                            } else {
                                btn.disabled = false;
                                btn.innerText = originalText;
                                alert(verifyData.message || "Payment verification failed");
                            }
                        } catch (err) {
                            console.error(err);
                            btn.disabled = false;
                            btn.innerText = originalText;
                            alert("Payment verification failed");
                        }
                    },
                    modal: {
                        ondismiss: function () {
                            btn.disabled = false;
                            btn.innerText = originalText;
                        }
                    }
                };

                const rzp = new Razorpay(options);

                rzp.on("payment.failed", function () {
                    btn.disabled = false;
                    btn.innerText = originalText;
                    alert("Payment failed. Please try again.");
                });

                rzp.open();

            } catch (err) {
                console.error(err);
                alert("Something went wrong");
                btn.disabled = false;
                btn.innerText = originalText;
            }
        });
    });
</script>

</body>
</html>