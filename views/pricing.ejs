            </svg>
        </button>

        <div class="cr-eyebrow">Custom Recharge</div>

        <div class="cr-amount-display">
            <span style="color:orangered" class="cr-rupee">₹</span><span id="cr-amount-num">100</span>
        </div>

        <div class="cr-score-pill">
            <span id="cr-score-num">50</span>&nbsp;DocScore
        </div>

        <div class="cr-slider-wrap">
            <input type="range" id="cr-slider" class="cr-slider" min="10" max="500" step="2" value="100">
        </div>

        <div class="cr-range-labels">
            <span>₹10</span><span>₹500</span>
        </div>

        <div class="cr-divider"></div>

        <div class="cr-chips">
            <button class="cr-chip" data-val="50">₹50</button>
            <button class="cr-chip" data-val="100">₹100</button>
            <button class="cr-chip" data-val="200">₹200</button>
            <button class="cr-chip" data-val="500">₹500</button>
        </div>

        <div class="cr-rate-note"> No refund · No expiry </div>

        <button type="button" class="cr-pay-btn" id="cr-pay-btn">
            Pay ₹<span id="cr-btn-amount">100</span>
        </button>
    </div>
</div>

<section class="comparison-section">
