<script src="/dashboard2.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>
    const buttons = document.querySelectorAll(".recharge-btn");

    buttons.forEach((btn) => {
        btn.addEventListener("click", async () => {
            const originalText = btn.innerText;

            try {
                btn.disabled = true;
                btn.innerText = "Please wait...";

                const plan = btn.dataset.plan;

                const response = await fetch("/buy-recharge", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ plan })
                });

                const data = await response.json();

                if (!data.success) {
                    alert(data.message || "Could not start payment");
                    btn.disabled = false;
                    btn.innerText = originalText;
                    return;
                }

                const options = {
                    key: data.key,
                    amount: data.amount,
                    currency: data.currency,
                    name: "DocUp",
                    description: "DocScore Recharge",
                    order_id: data.orderId,
                    prefill: {
                        email: data.userEmail
                    },
                    theme: {
                        color: "#ff5e00"
                    },
                    handler: async function (paymentResponse) {
                        try {
                            const verifyRes = await fetch("/payment/verify", {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json"
                                },
                                body: JSON.stringify(paymentResponse)
                            });

                            const verifyData = await verifyRes.json();

                            if (verifyData.success) {
                                window.location.href = verifyData.redirectUrl;
                            } else {
                                btn.disabled = false;
                                btn.innerText = originalText;
                                alert(verifyData.message || "Payment verification failed");
                            }
                        } catch (err) {
                            console.error(err);
                            btn.disabled = false;
                            btn.innerText = originalText;
                            alert("Payment verification failed");
                        }
                    },
                    modal: {
                        ondismiss: function () {
                            btn.disabled = false;
                            btn.innerText = originalText;
                        }
                    }
                };

                const rzp = new Razorpay(options);

                rzp.on("payment.failed", function () {
                    btn.disabled = false;
                    btn.innerText = originalText;
                    alert("Payment failed. Please try again.");
                });

                rzp.open();

            } catch (err) {
                console.error(err);
                alert("Something went wrong");
                btn.disabled = false;
                btn.innerText = originalText;
            }
        });
    });
</script>

<script>
    /* ===== CUSTOM RECHARGE OVERLAY ===== */
    const RATE = 1;

    const overlay   = document.getElementById("cr-overlay");
    const backdrop  = document.getElementById("cr-backdrop");
    const closeBtn  = document.getElementById("cr-close");
    const openBtn   = document.getElementById("open-custom-modal");
    const slider    = document.getElementById("cr-slider");
    const amountNum = document.getElementById("cr-amount-num");
    const scoreNum  = document.getElementById("cr-score-num");
    const btnAmount = document.getElementById("cr-btn-amount");
    const payBtn    = document.getElementById("cr-pay-btn");
    const chips     = document.querySelectorAll(".cr-chip");

    function syncSliderFill(val) {
        const pct = ((val - 10) / (500 - 10)) * 100;
        slider.style.background = `linear-gradient(to right,#ff5e00 ${pct}%,rgba(255,255,255,0.1) ${pct}%)`;
    }

    function updateUI(val) {
        val = Math.max(10, Math.min(500, Math.round(val / 2) * 2));
        slider.value = val;
        amountNum.textContent = val;
        scoreNum.textContent  = Math.floor(val / RATE);
        btnAmount.textContent = val;
        syncSliderFill(val);
    }

    slider.addEventListener("input", () => updateUI(+slider.value));

    chips.forEach(chip => {
        chip.addEventListener("click", () => {
            chips.forEach(c => c.classList.remove("active"));
            chip.classList.add("active");
            updateUI(+chip.dataset.val);
        });
    });

    function openModal() {
        overlay.classList.add("active");
        document.body.style.overflow = "hidden";
    }

    function closeModal() {
        overlay.classList.remove("active");
        document.body.style.overflow = "";
    }

    openBtn.addEventListener("click", openModal);
    closeBtn.addEventListener("click", closeModal);
    backdrop.addEventListener("click", closeModal);

    document.addEventListener("keydown", e => {
        if (e.key === "Escape") closeModal();
    });

    updateUI(100);

    payBtn.addEventListener("click", async () => {
        const amount = Math.max(10, Math.min(500, Math.round(+slider.value / 2) * 2));
        const orig   = payBtn.innerHTML;

        payBtn.disabled = true;
        payBtn.textContent = "Please wait…";

        try {
            const res  = await fetch("/buy-recharge", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ plan: "custom", customAmount: amount })
            });
            const data = await res.json();

            if (!data.success) {
                alert(data.message || "Could not start payment");
                payBtn.disabled = false;
                payBtn.innerHTML = orig;
                return;
            }

            const options = {
                key: data.key,
                amount: data.amount,
                currency: data.currency,
                name: "DocUp",
                description: `Custom DocScore — ${data.docscoreToAdd} pts`,
                order_id: data.orderId,
                prefill: { email: data.userEmail },
                theme: { color: "#ff5e00" },
                handler: async function(pr) {
                    try {
                        const vr   = await fetch("/payment/verify", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify(pr)
                        });
                        const vd   = await vr.json();
                        if (vd.success) { window.location.href = vd.redirectUrl; }
                        else {
                            payBtn.disabled = false;
                            payBtn.innerHTML = orig;
                            alert(vd.message || "Verification failed");
                        }
                    } catch(err) {
                        payBtn.disabled = false;
                        payBtn.innerHTML = orig;
                    }
                },
                modal: { ondismiss: () => { payBtn.disabled = false; payBtn.innerHTML = orig; } }
            };

            const rzp = new Razorpay(options);
            rzp.on("payment.failed", () => { payBtn.disabled = false; payBtn.innerHTML = orig; });
            rzp.open();
        } catch(err) {
            alert("Something went wrong");
            payBtn.disabled = false;
            payBtn.innerHTML = orig;
        }
    });
</script>
<%- include('partials/page-loader') %>
</body>
</html>