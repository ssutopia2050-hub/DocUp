<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/pricing.css">
    <link rel="stylesheet" href="/page-loader.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <title>Recharge | DocUp</title>

    <style>

    /* ══════════════════════════════════════════════════════════
       PAGE REDESIGN — Trust-First Pricing
    ══════════════════════════════════════════════════════════ */

    /* Sale Banner */
    .sale-banner {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: linear-gradient(90deg, #ff5e00, #ff8c00);
        color: #fff;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.92rem;
        font-weight: 600;
        padding: 10px 20px;
        text-align: center;
        letter-spacing: 0.02em;
    }
    .sale-banner .sale-badge {
        background: rgba(255,255,255,0.25);
        border-radius: 20px;
        padding: 2px 10px;
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    /* Coupon Bar */
    .coupon-bar {
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        gap: 0;
        max-width: 480px;
        margin: 0 auto 8px;
        background: rgba(255,255,255,0.04);
        border: 1.5px solid rgba(255,255,255,0.1);
        border-radius: 14px;
        overflow: hidden;
        transition: border-color 0.2s, background 0.2s;
    }
    .coupon-bar:focus-within {
        border-color: rgba(255,94,0,0.5);
        background: rgba(255,94,0,0.03);
    }
    .coupon-bar input {
        flex: 1;
        background: transparent;
        border: none;
        color: #fff;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.95rem;
        font-weight: 500;
        padding: 10px;
        outline: none;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        min-width: 0;
    }
    .coupon-bar input::placeholder { color: rgba(255,255,255,0.28); text-transform: none; letter-spacing: 0; font-weight: 400; }
    .coupon-apply-btn {
        background: transparent;
        color: #ff5e00;
        border: none;
        border-left: 1.5px solid rgba(255,255,255,0.08);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.82rem;
        font-weight: 700;
        padding: 14px 20px;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
        white-space: nowrap;
        letter-spacing: 0.05em;
        text-transform: uppercase;
    }
    .coupon-apply-btn:hover:not(:disabled) { background: rgba(255,94,0,0.1); color: #ff7a2e; }
    .coupon-apply-btn:disabled { opacity: 0.45; cursor: not-allowed; }
    .coupon-apply-btn.applied { color: #4ade80; }
    .coupon-result {
        text-align: center;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.82rem;
        margin-bottom: 6px;
        min-height: 20px;
        letter-spacing: 0.01em;
    }
    .coupon-result.success { color: #4ade80; }
    .coupon-result.error   { color: #ff6b6b; }
    .price-original {
        font-size: 1rem;
        color: rgba(255,255,255,0.38);
        text-decoration: line-through;
        margin-right: 6px;
        font-family: 'DM Sans', sans-serif;
    }
    .price-row { position: relative; }
    .price-coupon-original {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.35);
        font-family: 'DM Sans', sans-serif;
        margin-right: 4px;
        display: inline-block;
        position: relative;
    }
    .price-coupon-original::after {
        content: '';
        position: absolute;
        left: -2px; right: -2px; top: 50%;
        height: 2px;
        background: #ff5e00;
        border-radius: 1px;
        transform: rotate(-6deg) translateY(-50%);
    }
    .price-coupon-new {
        color: #4ade80;
        font-family: 'Raleway', sans-serif;
        font-weight: 800;
        font-size: 3.8rem;
        line-height: 1;
        animation: coupon-pop 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
    }
    @keyframes coupon-pop {
        0%   { transform: scale(0.7) translateY(6px); opacity: 0; }
        100% { transform: scale(1)   translateY(0);   opacity: 1; }
    }
    .coupon-saving-tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(74,222,128,0.08);
        border: 1px solid rgba(74,222,128,0.2);
        color: #4ade80;
        border-radius: 8px;
        padding: 4px 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.75rem;
        font-weight: 600;
        margin-top: 6px;
        animation: coupon-pop 0.35s cubic-bezier(0.34,1.56,0.64,1) both;
        animation-delay: 0.05s;
        letter-spacing: 0.02em;
    }
    .coupon-saving-tag.bonus-tag {
        background: rgba(255,173,100,0.08);
        border-color: rgba(255,173,100,0.2);
        color: #ffad64;
    }
    .ds-doc-hint {
        font-size: 0.72rem;
        font-family: 'DM Sans', sans-serif;
        font-weight: 500;
        color: rgba(255,255,255,0.35);
        letter-spacing: 0.02em;
        margin-left: 4px;
    }

    /* ══════════════════════════════════════════════════════════
       TRUST TICKER — top scrolling bar
    ══════════════════════════════════════════════════════════ */
    .trust-ticker {
        width: 100%;
        overflow: hidden;
        background: rgba(255,94,0,0.04);
        border-bottom: 1px solid rgba(255,94,0,0.12);
        padding: 9px 0;
        position: relative;
    }
    .trust-ticker::before,
    .trust-ticker::after {
        content: '';
        position: absolute;
        top: 0; bottom: 0;
        width: 60px;
        z-index: 2;
        pointer-events: none;
    }
    .trust-ticker::before { left: 0; background: linear-gradient(to right, #001219, transparent); }
    .trust-ticker::after  { right: 0; background: linear-gradient(to left, #001219, transparent); }
    .trust-ticker-track {
        display: flex;
        gap: 0;
        animation: ticker-scroll 30s linear infinite;
        width: max-content;
    }
    .trust-ticker-track:hover { animation-play-state: paused; }
    @keyframes ticker-scroll {
        0%   { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    .ticker-item {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 0 28px;
        border-right: 1px solid rgba(255,255,255,0.05);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.79rem;
        color: rgba(255,255,255,0.45);
        white-space: nowrap;
        letter-spacing: 0.01em;
    }
    .ticker-item .tick-icon { color: #ff7a30; flex-shrink: 0; }
    .ticker-item strong { color: rgba(255,255,255,0.78); font-weight: 600; }

    /* ══════════════════════════════════════════════════════════
       HERO — SPLIT LAYOUT (bold left text + floating card right)
    ══════════════════════════════════════════════════════════ */
    .pricing-hero {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 72px 5% 56px;
        display: grid;
        grid-template-columns: 1fr 420px;
        gap: 64px;
        align-items: center;
    }

    /* Left column */
    .hero-left { display: flex; flex-direction: column; gap: 0; }
    .hero-eyebrow-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,94,0,0.08);
        border: 1px solid rgba(255,94,0,0.22);
        border-radius: 999px;
        padding: 5px 14px 5px 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.76rem;
        font-weight: 700;
        color: #ff9458;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        margin-bottom: 24px;
        width: fit-content;
    }
    .eyebrow-pulse {
        width: 7px; height: 7px;
        border-radius: 50%;
        background: #ff5e00;
        box-shadow: 0 0 0 0 rgba(255,94,0,0.6);
        animation: pulse-ring 2s ease infinite;
    }
    @keyframes pulse-ring {
        0%   { box-shadow: 0 0 0 0 rgba(255,94,0,0.5); }
        70%  { box-shadow: 0 0 0 7px rgba(255,94,0,0); }
        100% { box-shadow: 0 0 0 0 rgba(255,94,0,0); }
    }
    .hero-heading {
        font-family: 'Bricolage Grotesque', 'Raleway', sans-serif;
        font-size: clamp(2.6rem, 4.2vw, 4rem);
        font-weight: 800;
        line-height: 1.08;
        letter-spacing: -0.03em;
        margin-bottom: 20px;
        color: white;
    }
    .hero-heading .accent {
        background: linear-gradient(135deg, #ff5e00 0%, #ffb347 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .hero-subline {
        font-family: 'Saira', sans-serif;
        font-size: 1.05rem;
        line-height: 1.9;
        color: rgba(255,255,255,0.55);
        max-width: 480px;
        margin-bottom: 32px;
    }

    /* Stat row */
    .hero-stats {
        display: flex;
        gap: 0;
        margin-bottom: 36px;
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 16px;
        overflow: hidden;
        width: fit-content;
    }
    .hero-stat {
        padding: 16px 28px;
        display: flex;
        flex-direction: column;
        gap: 3px;
        border-right: 1px solid rgba(255,255,255,0.07);
    }
    .hero-stat:last-child { border-right: none; }
    .stat-num {
        font-family: 'Bricolage Grotesque', 'Raleway', sans-serif;
        font-size: 1.9rem;
        font-weight: 800;
        color: white;
        letter-spacing: -0.03em;
        line-height: 1;
    }
    .stat-num span { color: #ff7a30; }
    .stat-label {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.72rem;
        color: rgba(255,255,255,0.38);
        font-weight: 500;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    /* Trust badges row */
    .hero-trust-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .htb {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 13px;
        border-radius: 999px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.09);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.77rem;
        font-weight: 500;
        color: rgba(255,255,255,0.5);
        transition: 0.2s ease;
    }
    .htb:hover { border-color: rgba(255,94,0,0.3); color: rgba(255,255,255,0.75); }
    .htb .htb-icon { color: #4ade80; }
    .htb.warn .htb-icon { color: #ff9458; }

    /* Right column — floating "exchange" card */
    .hero-exchange-card {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 28px;
        padding: 36px 30px 28px;
        display: flex;
        flex-direction: column;
        gap: 0;
        backdrop-filter: blur(20px);
        box-shadow: 0 32px 80px rgba(0,0,0,0.35), 0 0 0 1px rgba(255,94,0,0.06) inset;
        position: relative;
        overflow: hidden;
    }
    .hero-exchange-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,94,0,0.5), transparent);
    }
    .hero-exchange-card::after {
        content: '';
        position: absolute;
        top: -60px; left: 50%;
        transform: translateX(-50%);
        width: 200px; height: 200px;
        background: radial-gradient(ellipse, rgba(255,94,0,0.08), transparent 70%);
        pointer-events: none;
    }
    .exchange-label {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.3);
        margin-bottom: 20px;
        text-align: center;
    }
    .exchange-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        margin-bottom: 16px;
    }
    .exchange-pill {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        background: rgba(255,94,0,0.08);
        border: 1px solid rgba(255,94,0,0.25);
        border-radius: 16px;
        padding: 16px 22px;
        min-width: 110px;
    }
    .exchange-pill.doc-pill {
        background: rgba(255,255,255,0.04);
        border-color: rgba(255,255,255,0.12);
    }
    .exchange-pill-icon { color: #ff7a30; }
    .exchange-pill.doc-pill .exchange-pill-icon { color: rgba(255,255,255,0.5); }
    .exchange-pill-num {
        font-family: 'Bricolage Grotesque', 'Raleway', sans-serif;
        font-size: 2.4rem;
        font-weight: 800;
        color: white;
        letter-spacing: -0.04em;
        line-height: 1;
    }
    .exchange-pill-label {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.72rem;
        font-weight: 600;
        color: rgba(255,255,255,0.45);
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }
    .exchange-equals {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        color: rgba(255,255,255,0.2);
    }
    .exchange-equals-line { width: 1px; height: 14px; background: rgba(255,255,255,0.12); }
    .exchange-equals-sym {
        font-family: 'Raleway', sans-serif;
        font-weight: 700;
        font-size: 1.1rem;
        color: rgba(255,255,255,0.35);
    }
    .exchange-subtext {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.3);
        text-align: center;
        line-height: 1.6;
        margin-bottom: 24px;
    }
    /* mini coupon in card */
    .card-coupon-section { width: 100%; }
    .card-coupon-label {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.25);
        margin-bottom: 8px;
        text-align: center;
    }

    /* ══════════════════════════════════════════════════════════
       PRICING SECTION HEADER
    ══════════════════════════════════════════════════════════ */
    .pricing-section-wrap {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 5% 16px;
    }
    .section-eyebrow {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }
    .section-eyebrow-line { flex: 1; height: 1px; background: rgba(255,255,255,0.06); }
    .section-eyebrow-text {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.25);
        white-space: nowrap;
    }
    .section-heading {
        font-family: 'Bricolage Grotesque', 'Raleway', sans-serif;
        font-size: 1.6rem;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: white;
        margin-bottom: 6px;
    }
    .section-subheading {
        font-family: 'Saira', sans-serif;
        font-size: 0.9rem;
        color: rgba(255,255,255,0.4);
        line-height: 1.7;
    }

    /* ══════════════════════════════════════════════════════════
       PRICING GRID
    ══════════════════════════════════════════════════════════ */
    .pricing-grid-wrap {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 5% 12px;
    }
    .pricing-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        align-items: start;
    }

    /* Card */
    .pc {
        position: relative;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 24px;
        padding: 0;
        overflow: hidden;
        transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .pc:hover {
        transform: translateY(-5px);
        border-color: rgba(255,94,0,0.35);
        box-shadow: 0 24px 60px rgba(0,0,0,0.3);
    }
    .pc.pc-featured {
        border-color: rgba(255,115,0,0.45);
        box-shadow: 0 20px 55px rgba(255,94,0,0.12);
        transform: translateY(-8px);
    }
    .pc.pc-featured:hover { transform: translateY(-13px); }

    /* Card top color bar */
    .pc-bar {
        height: 3px;
        background: rgba(255,255,255,0.06);
    }
    .pc-featured .pc-bar {
        background: linear-gradient(90deg, #ff5e00, #ffb347);
    }
    .pc-premium .pc-bar {
        background: linear-gradient(90deg, rgba(255,94,0,0.4), rgba(255,179,71,0.4));
    }

    .pc-inner { padding: 28px 26px 24px; display: flex; flex-direction: column; }

    /* Badge */
    .pc-badge {
        position: absolute;
        top: 18px; right: 18px;
        background: linear-gradient(135deg, #ff5e00, #ff8c00);
        color: white;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 999px;
    }

    .pc-plan-tag {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: rgba(255,160,80,0.8);
        margin-bottom: 5px;
    }
    .pc-name {
        font-family: 'Bricolage Grotesque', 'Raleway', sans-serif;
        font-size: 1.65rem;
        font-weight: 800;
        color: white;
        letter-spacing: -0.02em;
        margin-bottom: 20px;
    }

    /* Price display */
    .pc-price-row {
        display: flex;
        align-items: flex-start;
        gap: 3px;
        margin-bottom: 4px;
    }
    .pc-currency {
        font-family: 'Saira', sans-serif;
        font-size: 1.3rem;
        color: #ff7a30;
        margin-top: 9px;
    }
    .pc-amount {
        font-family: 'Bricolage Grotesque', 'Raleway', sans-serif;
        font-size: 3.6rem;
        font-weight: 800;
        color: white;
        line-height: 1;
        letter-spacing: -0.04em;
    }
    .pc-score {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.9rem;
        color: #ffb17a;
        font-weight: 600;
        margin-bottom: 10px;
    }
    .pc-per-doc {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 7px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        margin-bottom: 20px;
        background: rgba(255,94,0,0.07);
        border: 1px solid rgba(255,94,0,0.16);
        color: rgba(255,160,100,0.85);
    }
    .pc-per-doc.best {
        background: rgba(74,222,128,0.06);
        border-color: rgba(74,222,128,0.2);
        color: #6ee7a3;
    }

    /* Feature list */
    .pc-features {
        display: flex;
        flex-direction: column;
        gap: 9px;
        margin-bottom: 22px;
        flex: 1;
    }
    .pc-feature {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        font-family: 'Saira', sans-serif;
        font-size: 0.88rem;
        color: rgba(255,255,255,0.68);
        line-height: 1.5;
    }
    .pc-check {
        width: 15px; height: 15px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 2px;
        background: rgba(74,222,128,0.08);
        border: 1px solid rgba(74,222,128,0.22);
    }
    .pc-check svg { color: #4ade80; }
    .pc-featured .pc-check {
        background: rgba(255,94,0,0.08);
        border-color: rgba(255,94,0,0.25);
    }
    .pc-featured .pc-check svg { color: #ff7a30; }

    .pc-divider { height: 1px; background: rgba(255,255,255,0.06); margin-bottom: 18px; }

    /* CTA */
    .pc-cta {
        width: 100%;
        height: 50px;
        border-radius: 14px;
        border: 1px solid rgba(255,69,0,0.5);
        background: transparent;
        color: #ff7a30;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.93rem;
        font-weight: 700;
        cursor: pointer;
        transition: 0.25s ease;
        letter-spacing: 0.02em;
    }
    .pc-cta:hover { background: rgba(255,94,0,0.08); color: #ff9458; }
    .pc-cta.pc-cta-featured {
        background: linear-gradient(135deg, #ff5e00, #ff8c00);
        color: white;
        border: none;
        box-shadow: 0 8px 24px rgba(255,94,0,0.28);
    }
    .pc-cta.pc-cta-featured:hover { opacity: 0.9; transform: scale(1.01); }

    /* Trust micro-note */
    .pc-trust-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        margin-top: 10px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.69rem;
        color: rgba(255,255,255,0.26);
    }

    /* ══════════════════════════════════════════════════════════
       CUSTOM AMOUNT TRIGGER
    ══════════════════════════════════════════════════════════ */
    .custom-trigger-wrap {
        width: 100%;
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 5% 48px;
    }
    .custom-trigger-btn {
        width: 100%;
        min-height: 62px;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 0 22px;
        background: rgba(255,255,255,0.02);
        border: 1.5px dashed rgba(255,106,0,0.25);
        border-radius: 16px;
        cursor: pointer;
        transition: 0.25s ease;
        text-align: left;
        color: rgba(255,255,255,0.55);
        font-family: 'Saira', sans-serif;
        font-size: 1rem;
    }
    .custom-trigger-btn:hover {
        background: rgba(255,106,0,0.04);
        border-color: rgba(255,106,0,0.45);
        color: white;
    }
    .custom-trigger-icon {
        width: 34px; height: 34px;
        border-radius: 50%;
        background: rgba(255,94,0,0.1);
        border: 1px solid rgba(255,94,0,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ff7a30;
        flex-shrink: 0;
    }
    .custom-trigger-label { flex: 1; }
    .custom-trigger-hint {
        font-size: 0.83rem;
        color: #ff7a2e;
        font-family: 'DM Sans', sans-serif;
    }

    /* ══════════════════════════════════════════════════════════
       TRUST PILLARS — 3 columns
    ══════════════════════════════════════════════════════════ */
    .trust-pillars-wrap {
        width: 100%;
        padding: 0 5% 48px;
    }
    .trust-pillars-inner {
        max-width: 1240px;
        margin: 0 auto;
    }
    .trust-pillars-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-top: 32px;
    }
    .trust-pillar {
        background: rgba(255,255,255,0.025);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 20px;
        padding: 26px 22px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        transition: 0.25s ease;
        position: relative;
        overflow: hidden;
    }
    .trust-pillar::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at top left, rgba(255,94,0,0.04), transparent 60%);
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s;
    }
    .trust-pillar:hover { border-color: rgba(255,94,0,0.22); }
    .trust-pillar:hover::before { opacity: 1; }

    .tp-icon-wrap {
        width: 46px; height: 46px;
        border-radius: 14px;
        background: rgba(255,94,0,0.08);
        border: 1px solid rgba(255,94,0,0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ff7a30;
        flex-shrink: 0;
    }
    .tp-title {
        font-family: 'Bricolage Grotesque', 'Raleway', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: white;
        letter-spacing: -0.01em;
    }
    .tp-body {
        font-family: 'Saira', sans-serif;
        font-size: 0.87rem;
        color: rgba(255,255,255,0.5);
        line-height: 1.75;
        flex: 1;
    }
    .tp-checklist {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 4px;
    }
    .tp-check {
        display: flex;
        align-items: center;
        gap: 9px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.82rem;
        color: rgba(255,255,255,0.58);
    }
    .tp-check svg { color: #4ade80; flex-shrink: 0; }
    .tp-payment-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-top: 4px;
    }
    .pp {
        padding: 5px 11px;
        border-radius: 8px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.09);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.73rem;
        font-weight: 700;
        color: rgba(255,255,255,0.55);
        letter-spacing: 0.03em;
    }
    .pp.razorpay {
        background: rgba(32,125,232,0.07);
        border-color: rgba(32,125,232,0.2);
        color: #6eb2f5;
    }

    /* ══════════════════════════════════════════════════════════
       VALUE COMPARISON SECTION
    ══════════════════════════════════════════════════════════ */
    .value-section-wrap {
        width: 100%;
        padding: 0 5% 48px;
    }
    .value-section-inner {
        max-width: 1240px;
        margin: 0 auto;
        background: rgba(255,255,255,0.025);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 28px;
        padding: 48px 44px;
        position: relative;
        overflow: hidden;
    }
    .value-section-inner::before {
        content: '';
        position: absolute;
        top: -80px; right: -80px;
        width: 280px; height: 280px;
        background: radial-gradient(ellipse, rgba(255,94,0,0.06), transparent 70%);
        pointer-events: none;
    }
    .value-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
        align-items: center;
    }
    .value-left h2 {
        font-family: 'Bricolage Grotesque', 'Raleway', sans-serif;
        font-size: 2rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: white;
        margin-bottom: 14px;
        line-height: 1.15;
    }
    .value-left h2 em {
        font-style: normal;
        background: linear-gradient(135deg, #ff5e00, #ffb347);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .value-left p {
        font-family: 'Saira', sans-serif;
        font-size: 0.94rem;
        color: rgba(255,255,255,0.52);
        line-height: 1.85;
    }
    .value-points {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .value-point {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 16px 18px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 14px;
        transition: 0.2s ease;
    }
    .value-point:hover { border-color: rgba(255,94,0,0.22); background: rgba(255,94,0,0.03); }
    .vp-icon {
        width: 34px; height: 34px;
        border-radius: 10px;
        background: rgba(255,94,0,0.09);
        border: 1px solid rgba(255,94,0,0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ff7a30;
        flex-shrink: 0;
    }
    .vp-text strong {
        display: block;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.89rem;
        font-weight: 700;
        color: white;
        margin-bottom: 2px;
    }
    .vp-text span {
        font-family: 'Saira', sans-serif;
        font-size: 0.81rem;
        color: rgba(255,255,255,0.45);
        line-height: 1.5;
    }

    /* ══════════════════════════════════════════════════════════
       FAQ
    ══════════════════════════════════════════════════════════ */
    .faq-wrap {
        width: 100%;
        padding: 0 5% 60px;
    }
    .faq-inner {
        max-width: 1240px;
        margin: 0 auto;
    }
    .faq-list-new {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 32px;
    }
    .faq-item {
        background: rgba(255,255,255,0.025);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 16px;
        overflow: hidden;
        transition: border-color 0.2s;
    }
    .faq-item:hover { border-color: rgba(255,94,0,0.2); }
    .faq-item.open { border-color: rgba(255,94,0,0.28); }
    .faq-q {
        width: 100%;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: transparent;
        border: none;
        cursor: pointer;
        text-align: left;
        color: white;
        font-family: 'Raleway', sans-serif;
        font-size: 1rem;
        font-weight: 600;
    }
    .faq-chevron {
        flex-shrink: 0;
        width: 22px; height: 22px;
        border-radius: 50%;
        background: rgba(255,255,255,0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s ease;
        color: rgba(255,255,255,0.4);
    }
    .faq-item.open .faq-chevron { transform: rotate(180deg); color: #ff7a30; }
    .faq-a {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.35s cubic-bezier(0.4,0,0.2,1), padding 0.2s ease;
        font-family: 'Saira', sans-serif;
        font-size: 0.92rem;
        color: rgba(255,255,255,0.55);
        line-height: 1.75;
        padding: 0 22px;
    }
    .faq-item.open .faq-a { max-height: 200px; padding: 0 22px 18px; }

    /* ══════════════════════════════════════════════════════════
       BOTTOM TRUST ASSURANCE BAR
    ══════════════════════════════════════════════════════════ */
    .assurance-bar {
        width: 100%;
        padding: 0 5% 48px;
    }
    .assurance-inner {
        max-width: 1240px;
        margin: 0 auto;
        background: linear-gradient(135deg, rgba(255,94,0,0.06), rgba(255,140,0,0.03));
        border: 1px solid rgba(255,94,0,0.15);
        border-radius: 20px;
        padding: 24px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
    }
    .assurance-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .assurance-shield {
        width: 44px; height: 44px;
        border-radius: 12px;
        background: rgba(255,94,0,0.1);
        border: 1px solid rgba(255,94,0,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ff7a30;
        flex-shrink: 0;
    }
    .assurance-text-main {
        font-family: 'Bricolage Grotesque', 'Raleway', sans-serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: white;
    }
    .assurance-text-sub {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.77rem;
        color: rgba(255,255,255,0.4);
        margin-top: 2px;
    }
    .assurance-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .assurance-pill {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 7px 13px;
        border-radius: 999px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.09);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.75rem;
        font-weight: 600;
        color: rgba(255,255,255,0.5);
    }
    .assurance-pill svg { color: #4ade80; }

    /* ══════════════════════════════════════════════════════════
       OVERLAY (preserved exactly)
    ══════════════════════════════════════════════════════════ */
    .cr-overlay {
        position: fixed; inset: 0; z-index: 9000;
        display: flex; align-items: center; justify-content: center;
        opacity: 0; pointer-events: none;
        transition: opacity 0.28s cubic-bezier(0.32,0,0.67,0);
    }
    .cr-overlay.active { opacity: 1; pointer-events: auto; transition: opacity 0.22s cubic-bezier(0.33,1,0.68,1); }
    .cr-backdrop {
        position: absolute; inset: 0;
        background: rgba(0,6,10,0.72);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
    }
    .cr-modal {
        position: relative; z-index: 1;
        width: min(420px, 92vw);
        background: rgba(12,20,26,0.95);
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 28px;
        padding: 38px 32px 32px;
        display: flex; flex-direction: column; align-items: center; gap: 0;
        box-shadow: 0 40px 80px rgba(0,0,0,0.6), 0 0 0 0.5px rgba(255,255,255,0.05) inset;
        transform: translateY(16px) scale(0.97);
        transition: transform 0.28s cubic-bezier(0.33,1,0.68,1);
    }
    .cr-overlay.active .cr-modal { transform: translateY(0) scale(1); }
    .cr-close {
        position: absolute; top: 18px; right: 18px;
        width: 30px; height: 30px; border-radius: 50%;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.05);
        color: rgba(255,255,255,0.45);
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; transition: 0.7s ease;
    }
    .cr-close:hover { background: rgba(255,255,255,0.1); color: white; transform: rotateZ(180deg); }
    .cr-eyebrow { font-family: 'Saira', sans-serif; font-size: 0.75rem; letter-spacing: 1.5px; text-transform: uppercase; color: rgba(255,140,80,0.7); margin-bottom: 24px; }
    .cr-amount-display { display: flex; align-items: flex-start; gap: 4px; line-height: 1; margin-bottom: 14px; }
    .cr-rupee { font-family: 'Raleway', sans-serif; font-size: 2rem; font-weight: 700; color: rgba(255,255,255,0.5); margin-top: 10px; }
    #cr-amount-num { font-family: 'Raleway', sans-serif; font-size: 5rem; font-weight: 800; color: white; transition: 0.12s ease; letter-spacing: -2px; }
    .cr-score-pill { background: rgba(255,94,0,0.1); border: 1px solid rgba(255,94,0,0.22); border-radius: 999px; padding: 7px 18px; font-family: 'Saira', sans-serif; font-size: 0.9rem; color: #ff9d59; margin-bottom: 32px; transition: 0.12s ease; }
    .cr-slider-wrap { width: 100%; margin-bottom: 10px; }
    .cr-slider { -webkit-appearance: none; appearance: none; width: 100%; height: 4px; border-radius: 999px; outline: none; cursor: pointer; background: rgba(255,255,255,0.1); transition: background 0.1s; }
    .cr-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 24px; height: 24px; border-radius: 50%; background: white; cursor: pointer; box-shadow: 0 2px 12px rgba(0,0,0,0.5); transition: transform 0.15s ease; }
    .cr-slider::-webkit-slider-thumb:hover { transform: scale(1.15); }
    .cr-slider::-moz-range-thumb { width: 24px; height: 24px; border-radius: 50%; background: white; border: none; cursor: pointer; }
    .cr-range-labels { width: 100%; display: flex; justify-content: space-between; font-family: 'DM Sans', sans-serif; font-size: 0.75rem; color: rgba(255,255,255,0.25); margin-bottom: 24px; }
    .cr-divider { width: 100%; height: 1px; background: rgba(255,255,255,0.06); margin-bottom: 20px; }
    .cr-chips { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-bottom: 20px; }
    .cr-chip { padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.04); color: rgba(255,255,255,0.6); font-family: 'Saira', sans-serif; font-size: 0.85rem; cursor: pointer; transition: 0.18s ease; }
    .cr-chip:hover, .cr-chip.active { background: rgba(255,94,0,0.12); border-color: rgba(255,94,0,0.4); color: #ff9d59; }
    .cr-rate-note { font-family: 'DM Sans', sans-serif; font-size: 0.75rem; color: rgba(255,255,255,0.22); margin-bottom: 24px; text-align: center; }
    .cr-pay-btn { width: 100%; height: 56px; border-radius: 18px; border: none; background: linear-gradient(135deg, #ff5e00, #ff8c00); color: white; font-family: 'Saira', sans-serif; font-size: 1.05rem; font-weight: 600; letter-spacing: 0.3px; cursor: pointer; transition: 0.22s ease; }
    .cr-pay-btn:hover { opacity: 0.88; transform: scale(1.01); }
    .cr-pay-btn:disabled { opacity: 0.55; transform: none; cursor: not-allowed; }

    /* ══════════════════════════════════════════════════════════
       RESPONSIVE
    ══════════════════════════════════════════════════════════ */
    @media (max-width: 1100px) {
        .pricing-hero { grid-template-columns: 1fr; gap: 40px; }
        .hero-exchange-card { max-width: 480px; }
        .pricing-grid { grid-template-columns: 1fr; max-width: 480px; margin: 0 auto; }
        .pc.pc-featured { transform: none; }
        .trust-pillars-grid { grid-template-columns: 1fr; }
        .value-grid { grid-template-columns: 1fr; gap: 28px; }
    }
    @media (max-width: 700px) {
        .pricing-hero { padding: 48px 5% 36px; }
        .hero-heading { font-size: 2.1rem; }
        .hero-stats { display: none; }
        .value-section-inner { padding: 32px 22px; }
        .assurance-inner { flex-direction: column; align-items: flex-start; }
        .hero-exchange-card { display: none; }
        .pricing-hero { grid-template-columns: 1fr; }
    }
    </style>
</head>
