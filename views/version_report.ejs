<!DOCTYPE html>
<html lang="en">
<head>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="shortcut icon" href="/images/favicon-32x32.png" type="image/x-icon">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DocUp | Version Report</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Archivo Black',sans-serif;
        }

        body{
            background:
                    radial-gradient(circle at top left, rgba(255,102,0,.08), transparent 22%),
                    radial-gradient(circle at bottom right, rgba(255,170,0,.06), transparent 20%),
                    #001219;
            min-height:100vh;
            display:flex;
            flex-direction:column;
            color:white;
        }

        /* ===== TOPBAR ===== */

        .topbar{
            width:100%;
            height:100px;
            border-bottom:1px solid rgba(255,255,255,.08);
            display:flex;
            align-items:center;
            justify-content:space-between;
            padding:0 3%;
            position:sticky;
            top:0;
            z-index:1000;
            backdrop-filter:blur(10px);
            background:rgba(0,18,25,.45);
        }

        .logo-text-container{
            font-size:3.5rem;
            cursor:pointer;
        }

        .pg-links{
            display:flex;
            gap:40px;
            align-items:center;
        }

        .pg-links a{
            display:flex;
            gap:8px;
            align-items:center;
            font-size:1rem;
            color:white;
            text-decoration:none;
        }

        /* ===== PAGE WRAP ===== */

        .page-wrap{
            width:100%;
            max-width:1100px;
            margin:50px auto;
            padding:0 20px;
            display:flex;
            flex-direction:column;
            gap:28px;
        }

        /* ===== HEADER ===== */

        .page-header{
            display:flex;
            flex-direction:column;
            gap:10px;
        }

        .page-header h1{
            font-size:2.5rem;
            font-family:'Raleway',sans-serif;
        }

        .page-header p{
            font-family:'Saira',sans-serif;
            color:rgba(255,255,255,.65);
        }

        /* ===== VERSION CARD ===== */

        .version-card{
            background:rgba(255,255,255,.045);
            border:1px solid rgba(255,255,255,.08);
            border-radius:22px;
            padding:26px;
            display:flex;
            flex-direction:column;
            gap:16px;
            backdrop-filter:blur(18px);
            box-shadow:0 12px 40px rgba(0,0,0,.25);
        }

        .version-top{
            display:flex;
            justify-content:space-between;
            align-items:center;
            flex-wrap:wrap;
            gap:10px;
        }

        .version-tag{
            background:rgba(255,94,0,.15);
            border:1px solid rgba(255,94,0,.35);
            padding:6px 14px;
            border-radius:999px;
            font-size:.8rem;
            font-family:'Saira',sans-serif;
            color:#ffb17a;
        }

        .version-date{
            font-family:'Saira',sans-serif;
            font-size:.85rem;
            color:rgba(255,255,255,.55);
        }

        .version-title{
            font-size:1.4rem;
            font-family:'Raleway',sans-serif;
        }

        .changelog{
            display:flex;
            flex-direction:column;
            gap:10px;
            padding-left:18px;
        }

        .changelog li{
            font-family:'Saira',sans-serif;
            color:rgba(255,255,255,.78);
        }

        /* ===== FOOTER ===== */

        footer{
            margin-top:auto;
            width:100%;
            min-height:90px;
            border-top:1px solid rgba(255,255,255,.08);
            display:flex;
            align-items:center;
            justify-content:space-between;
            padding:0 5%;
        }

        .footer-left{
            font-size:2rem;
        }

        .footer-right{
            display:flex;
            gap:24px;
            flex-wrap:wrap;
        }

        .footer-right a{
            color:rgba(255,255,255,.62);
            font-family:"Saira",sans-serif;
            text-decoration:none;
        }

        .footer-right a:hover{
            color:white;
        }

    </style>
</head>

<body>

<div class="topbar">
    <div class="logo-text-container" onclick="window.location='/dashboard'">DocUp</div>

    <div class="pg-links">
        <a href="/dashboard">FindDocs</a>
        <a href="/profile">Profile</a>
    </div>
</div>

<div class="page-wrap">

    <div class="page-header">
        <h1>Version Report</h1>
        <p>Track all major updates, improvements and new features added to DocUp.</p>
    </div>

    <!-- VERSION BLOCK -->

    <div class="version-card">
        <div class="version-top">
            <div class="version-tag">Latest Stable Version</div>
            <div class="version-date">March 2026</div>
        </div>

        <div class="version-title">Version 1.0.2 — Payment & Subscription System</div>

        <ul class="changelog">
            <li>Razorpay recharge integration</li>
            <li>Automatic DocScore credit after successful payment</li>
            <li>User payment history tracking</li>
            <li>Subscription auto-upgrade to Paid Tier</li>
            <li>Improved DocScore protection logic</li>
            <li>Better dashboard UI feedback</li>
        </ul>
    </div>

    <div class="version-card">
        <div class="version-top">
            <div class="version-tag">First Stable Version</div>
            <div class="version-date">February 2026</div>
        </div>

        <div class="version-title">Version 1.0.1 — Search Engine Upgrade</div>

        <ul class="changelog">
            <li>Weighted smart search ranking</li>
            <li>College suggestion dropdown</li>
            <li>Improved filter system</li>
            <li>Faster Mongo query performance</li>
            <li>Better mobile responsiveness</li>
        </ul>
    </div>

    <div class="version-card">
        <div class="version-top">
            <div class="version-tag">Initial Release</div>
            <div class="version-date">January 2026</div>
        </div>

        <div class="version-title">Version 1.0.0 — Core Launch</div>

        <ul class="changelog">
            <li>User authentication system</li>
            <li>Document upload system</li>
            <li>DocScore access control model</li>
            <li>College-wise document storage</li>
            <li>Cloudinary document hosting</li>
        </ul>
    </div>

</div>

<footer>

        <div style="display: flex;flex-direction: row;justify-content: flex-end;align-items: flex-end" class="footer-left">
            DocUp
            <a href="/version_report" style="text-decoration: none;font-size: 0.8rem ; color:rgba(255,255,255,0.22)"> v1.0.2</a>
        </div>
        <div class="footer-right">
            <a href="/dashboard">FindDocs</a>
            <a href="/uploads">Uploads</a>
            <a href="/profile">Profile</a>
            <a href="/contact">ContactUs</a>
            <a href="/privacy_policy">Privacy Policy</a>
            <a href="/logout">Logout</a>
        </div>
</footer>

</body>
</html>