<script src="/dashboard2.js"></script>
<script>
    const backToTopBtn = document.getElementById("backToTopBtn");
    const ring = backToTopBtn ? backToTopBtn.querySelector(".progress-ring-circle") : null;
    const circumference = 2 * Math.PI * 26;

    window.addEventListener("scroll", () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? scrollTop / docHeight : 0;
        if (backToTopBtn) backToTopBtn.classList.toggle("show", scrollTop > 200);
        if (ring) ring.style.strokeDashoffset = circumference - progress * circumference;
    });

    if (backToTopBtn) {
        backToTopBtn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
    }
</script>
