<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DocUp Dev | Coupon Manager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@500;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/dev_dashboard.css">
    <link rel="stylesheet" href="/page-loader.css">

    <style>
        /* ── Coupon-manager-specific styles ── */
        :root {
            --accent:       #ff5e00;
            --accent-dim:   rgba(255,94,0,0.15);
            --success:      #22c55e;
            --success-dim:  rgba(34,197,94,0.12);
            --danger:       #ef4444;
            --danger-dim:   rgba(239,68,68,0.12);
            --warn:         #f59e0b;
            --warn-dim:     rgba(245,158,11,0.12);
            --surface:      rgba(255,255,255,0.04);
            --border:       rgba(255,255,255,0.08);
            --text:         #e2e8f0;
            --text-muted:   rgba(255,255,255,0.4);
        }

        /* ── Top toolbar ── */
        .cm-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 28px;
        }
        .cm-toolbar-left { display: flex; align-items: center; gap: 10px; }
        .cm-search-input {
            background: var(--surface);
            border: 1.5px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.88rem;
            padding: 9px 14px;
            outline: none;
            width: 220px;
            transition: border 0.2s;
        }
        .cm-search-input:focus { border-color: var(--accent); }
        .cm-search-input::placeholder { color: var(--text-muted); }

        .cm-filter-select {
            background: var(--surface);
            border: 1.5px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.88rem;
            padding: 9px 14px;
            outline: none;
            cursor: pointer;
            transition: border 0.2s;
        }
        .cm-filter-select:focus { border-color: var(--accent); }

        /* ── Primary action button ── */
        .btn-primary {
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.88rem;
            font-weight: 600;
            padding: 9px 18px;
            cursor: pointer;
            transition: background 0.2s, transform 0.15s;
            white-space: nowrap;
        }
        .btn-primary:hover { background: #e05500; transform: translateY(-1px); }
        .btn-primary:active { transform: translateY(0); }

        /* ── Stats row ── */
        .cm-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 14px;
            margin-bottom: 28px;
        }
        @media (max-width: 900px) { .cm-stats { grid-template-columns: repeat(2,1fr); } }
        .cm-stat-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px 20px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .cm-stat-label {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.75rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        .cm-stat-value {
            font-family: 'Syne', sans-serif;
            font-size: 1.7rem;
            font-weight: 700;
            color: var(--text);
        }
        .cm-stat-card.accent-card .cm-stat-value { color: var(--accent); }
        .cm-stat-card.success-card .cm-stat-value { color: var(--success); }
        .cm-stat-card.warn-card .cm-stat-value { color: var(--warn); }

        /* ── Coupon table ── */
        .cm-table-wrap {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
        }
        .cm-table {
            width: 100%;
            border-collapse: collapse;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.86rem;
        }
        .cm-table thead tr {
            background: rgba(255,255,255,0.03);
            border-bottom: 1px solid var(--border);
        }
        .cm-table th {
            padding: 12px 16px;
            text-align: left;
            font-weight: 600;
            color: var(--text-muted);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            white-space: nowrap;
        }
        .cm-table td {
            padding: 13px 16px;
            color: var(--text);
            border-bottom: 1px solid rgba(255,255,255,0.04);
            vertical-align: middle;
        }
        .cm-table tr:last-child td { border-bottom: none; }
        .cm-table tbody tr { transition: background 0.15s; }
        .cm-table tbody tr:hover { background: rgba(255,255,255,0.02); }

        /* ── Badges ── */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 20px;
            font-size: 0.73rem;
            font-weight: 600;
            letter-spacing: 0.03em;
        }
        .badge-active   { background: var(--success-dim); color: var(--success); }
        .badge-inactive { background: var(--danger-dim); color: var(--danger); }
        .badge-flat     { background: var(--accent-dim); color: var(--accent); }
        .badge-docscore { background: rgba(139,92,246,0.15); color: #a78bfa; }
        .badge-both     { background: rgba(255,255,255,0.07); color: var(--text-muted); }
        .badge-recharge  { background: rgba(6,182,212,0.12); color: #22d3ee; }
        .badge-sub       { background: rgba(245,158,11,0.15); color: var(--warn); }

        /* ── Code pill ── */
        .code-pill {
            font-family: 'Saira', monospace;
            font-size: 0.88rem;
            font-weight: 600;
            letter-spacing: 0.06em;
            color: var(--accent);
            background: var(--accent-dim);
            padding: 3px 9px;
            border-radius: 6px;
        }

        /* ── Progress bar for usage ── */
        .usage-bar-wrap { display: flex; align-items: center; gap: 8px; }
        .usage-bar-outer {
            flex: 1;
            height: 5px;
            background: rgba(255,255,255,0.07);
            border-radius: 99px;
            overflow: hidden;
            min-width: 60px;
        }
        .usage-bar-inner {
            height: 100%;
            border-radius: 99px;
            background: var(--accent);
            transition: width 0.4s;
        }
        .usage-bar-inner.full { background: var(--danger); }
        .usage-text {
            font-size: 0.75rem;
            color: var(--text-muted);
            white-space: nowrap;
        }

        /* ── Row action buttons ── */
        .row-actions { display: flex; align-items: center; gap: 8px; }
        .btn-icon {
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 7px;
            color: var(--text-muted);
            font-size: 0.8rem;
            font-family: 'DM Sans', sans-serif;
            padding: 5px 10px;
            cursor: pointer;
            transition: all 0.15s;
            white-space: nowrap;
        }
        .btn-icon:hover { border-color: var(--accent); color: var(--accent); }
        .btn-icon.danger:hover { border-color: var(--danger); color: var(--danger); }
        .btn-icon.toggle-on  { border-color: var(--success); color: var(--success); }
        .btn-icon.toggle-off { border-color: var(--danger); color: var(--danger); }

        /* ── Empty state ── */
        .cm-empty {
            text-align: center;
            padding: 52px 20px;
            color: var(--text-muted);
            font-family: 'DM Sans', sans-serif;
        }
        .cm-empty svg { opacity: 0.3; margin-bottom: 12px; }

        /* ── Modal overlay ── */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.65);
            backdrop-filter: blur(6px);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s;
        }
        .modal-overlay.open { opacity: 1; pointer-events: all; }

        .modal-box {
            background: #0f1420;
            border: 1px solid var(--border);
            border-radius: 16px;
            width: 100%;
            max-width: 540px;
            padding: 28px 32px;
            transform: translateY(12px);
            transition: transform 0.25s;
            max-height: 90vh;
            overflow-y: auto;
        }
        .modal-overlay.open .modal-box { transform: translateY(0); }

        .modal-title {
            font-family: 'Syne', sans-serif;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .modal-close {
            background: none;
            border: none;
            color: var(--text-muted);
            font-size: 1.2rem;
            cursor: pointer;
            line-height: 1;
            padding: 2px 6px;
            border-radius: 5px;
        }
        .modal-close:hover { color: var(--text); }

        /* ── Form fields ── */
        .form-group { margin-bottom: 16px; }
        .form-label {
            display: block;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 6px;
        }
        .form-input, .form-select, .form-textarea {
            width: 100%;
            background: rgba(255,255,255,0.05);
            border: 1.5px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            padding: 10px 14px;
            outline: none;
            box-sizing: border-box;
            transition: border 0.2s;
        }
        .form-input:focus, .form-select:focus, .form-textarea:focus { border-color: var(--accent); }
        .form-textarea { resize: vertical; min-height: 70px; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        .form-hint {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 4px;
        }

        /* ── Conditional field visibility ── */
        .cond-flat, .cond-docscore, .cond-users { display: none; }

        /* ── Modal footer ── */
        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 24px;
            padding-top: 18px;
            border-top: 1px solid var(--border);
        }
        .btn-cancel {
            background: transparent;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            color: var(--text-muted);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.88rem;
            font-weight: 600;
            padding: 9px 18px;
            cursor: pointer;
            transition: all 0.15s;
        }
        .btn-cancel:hover { border-color: rgba(255,255,255,0.2); color: var(--text); }

        /* ── Toast notification ── */
        #toast {
            position: fixed;
            bottom: 28px;
            right: 28px;
            background: #1e2737;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 12px 18px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.88rem;
            color: var(--text);
            z-index: 9999;
            transform: translateY(20px);
            opacity: 0;
            transition: all 0.25s;
            pointer-events: none;
            max-width: 320px;
        }
        #toast.show { transform: translateY(0); opacity: 1; }
        #toast.success { border-left: 3px solid var(--success); }
        #toast.error   { border-left: 3px solid var(--danger); }

        /* ── Expiry warn color ── */
        .expiry-expired { color: var(--danger); }
        .expiry-soon    { color: var(--warn); }

        /* ══ Sale Banner Manager ══ */
        .sale-manager {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 28px;
        }
        .sale-manager-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 24px;
            border-bottom: 1px solid var(--border);
            gap: 12px;
            flex-wrap: wrap;
        }
        .sale-manager-title {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .sale-manager-title h3 {
            font-family: 'Syne', sans-serif;
            font-size: 1rem;
            font-weight: 700;
            color: var(--text);
            margin: 0;
        }
        .sale-live-dot {
            width: 8px; height: 8px;
            background: var(--success);
            border-radius: 50%;
            box-shadow: 0 0 0 3px var(--success-dim);
            animation: pulse-dot 1.8s infinite;
            flex-shrink: 0;
        }
        .sale-dead-dot {
            width: 8px; height: 8px;
            background: var(--text-muted);
            border-radius: 50%;
            flex-shrink: 0;
        }
        @keyframes pulse-dot {
            0%,100% { box-shadow: 0 0 0 3px var(--success-dim); }
            50%      { box-shadow: 0 0 0 6px rgba(34,197,94,0.05); }
        }
        .sale-manager-body {
            padding: 20px 24px;
        }

        /* ── Active sale preview card ── */
        .sale-preview {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
        }
        .sale-preview-left { flex: 1; min-width: 200px; }
        .sale-preview-label {
            font-family: 'Syne', sans-serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 6px;
        }
        .sale-preview-label .sale-pct {
            color: var(--accent);
        }
        .sale-preview-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 8px;
        }
        .sale-meta-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 3px 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.76rem;
            color: var(--text-muted);
        }
        .sale-countdown {
            font-family: 'Saira', monospace;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--warn);
            letter-spacing: 0.04em;
            margin-top: 4px;
        }
        .sale-countdown-label {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.72rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }
        .sale-preview-actions {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            flex-shrink: 0;
            flex-wrap: wrap;
        }

        /* ── Banner preview strip ── */
        .sale-banner-preview {
            margin-top: 16px;
            border-radius: 10px;
            overflow: hidden;
        }
        .sale-banner-strip {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: linear-gradient(90deg, #ff5e00, #ff8c00);
            color: #fff;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.88rem;
            font-weight: 600;
            padding: 10px 20px;
            text-align: center;
            letter-spacing: 0.02em;
        }
        .sale-banner-strip .sbadge {
            background: rgba(255,255,255,0.25);
            border-radius: 20px;
            padding: 2px 10px;
            font-size: 0.73rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }
        .sale-banner-preview-label {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.72rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 6px;
        }

        /* ── No sale state ── */
        .sale-empty {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 32px 20px;
            gap: 12px;
            text-align: center;
        }
        .sale-empty-icon {
            width: 48px; height: 48px;
            background: var(--accent-dim);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }
        .sale-empty h4 {
            font-family: 'Syne', sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text);
            margin: 0;
        }
        .sale-empty p {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.82rem;
            color: var(--text-muted);
            margin: 0;
            max-width: 300px;
        }

        /* ── Sale form inside modal ── */
        .sale-scope-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }
        .sale-scope-opt {
            position: relative;
        }
        .sale-scope-opt input[type="radio"] {
            position: absolute;
            opacity: 0;
            width: 0; height: 0;
        }
        .sale-scope-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding: 10px 8px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.78rem;
            color: var(--text-muted);
            text-align: center;
            transition: all 0.15s;
            background: rgba(255,255,255,0.03);
        }
        .sale-scope-label .scope-icon { font-size: 1.1rem; }
        .sale-scope-opt input:checked + .sale-scope-label {
            border-color: var(--accent);
            color: var(--accent);
            background: var(--accent-dim);
        }
        .sale-scope-label:hover { border-color: rgba(255,255,255,0.2); color: var(--text); }

        /* pct input with % suffix */
        .pct-input-wrap {
            position: relative;
        }
        .pct-input-wrap input {
            padding-right: 36px;
        }
        .pct-suffix {
            position: absolute;
            right: 13px;
            top: 50%;
            transform: translateY(-50%);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.9rem;
            color: var(--text-muted);
            pointer-events: none;
        }

        /* Danger btn */
        .btn-danger {
            background: transparent;
            border: 1.5px solid var(--danger);
            border-radius: 10px;
            color: var(--danger);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            padding: 8px 16px;
            cursor: pointer;
            transition: all 0.15s;
            white-space: nowrap;
        }
        .btn-danger:hover { background: var(--danger-dim); }

        .btn-edit {
            background: transparent;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            color: var(--text-muted);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.84rem;
            font-weight: 600;
            padding: 8px 16px;
            cursor: pointer;
            transition: all 0.15s;
            white-space: nowrap;
        }
        .btn-edit:hover { border-color: var(--accent); color: var(--accent); }

        /* ── Section header with count ── */
        .cm-header {
            display: flex;
            align-items: baseline;
            gap: 10px;
            margin-bottom: 14px;
        }
        .cm-header h3 {
            font-family: 'Syne', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--text);
            margin: 0;
        }
        .cm-count {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.78rem;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
<div class="mod-shell">

    <!-- ══ Sidebar ══ -->
    <aside class="mod-sidebar">
        <div style="display:flex;align-items:flex-end;justify-content:center;flex-direction:row;padding-bottom:20px;" class="box">
            <h1 style="font-size:3rem;font-family:'Archivo Black',sans-serif;">DocUp</h1>
            <h3 style="color:orangered;">Dev</h3>
        </div>
        <nav class="mod-nav">
            <a href="/dev/dashboard">Dashboard</a>
            <a href="/dev/users">Users</a>
            <a href="/dev/docs">Docs</a>
            <a href="/dev/reports">Reports</a>
            <a href="/dev/activity">Activity</a>
            <a href="/dev/coupons" class="active">Coupons</a>
        </nav>
    </aside>

    <!-- ══ Main ══ -->
    <main class="mod-main">

        <header class="mod-topbar">
            <div class="top-left">
                <h2>Coupon Manager</h2>
                <p class="subtitle">Create, toggle, and delete discount codes</p>
            </div>
            <div class="top-right">
                <div class="status-pill">Live</div>
            </div>
        </header>

        <section class="mod-content">

            <!-- ── Stats ── -->
            <div class="cm-stats" id="statsRow">
                <div class="cm-stat-card accent-card">
                    <span class="cm-stat-label">Total Coupons</span>
                    <span class="cm-stat-value" id="statTotal">—</span>
                </div>
                <div class="cm-stat-card success-card">
                    <span class="cm-stat-label">Active</span>
                    <span class="cm-stat-value" id="statActive">—</span>
                </div>
                <div class="cm-stat-card warn-card">
                    <span class="cm-stat-label">Total Redemptions</span>
                    <span class="cm-stat-value" id="statRedemptions">—</span>
                </div>
                <div class="cm-stat-card">
                    <span class="cm-stat-label">Inactive</span>
                    <span class="cm-stat-value" id="statInactive">—</span>
                </div>
            </div>

            <!-- ══ Sale Banner Manager ══ -->
            <div class="sale-manager" id="saleMgr">
                <div class="sale-manager-header">
                    <div class="sale-manager-title">
                        <span class="sale-dead-dot" id="saleDot"></span>
