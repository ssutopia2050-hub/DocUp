<!-- ══ Create Coupon Modal ══ -->
<div class="modal-overlay" id="createModal">
    <div class="modal-box">
        <div class="modal-title">
            New Coupon
            <button class="modal-close" id="closeCreateModal">&times;</button>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Code *</label>
                <input class="form-input" type="text" id="f-code" placeholder="e.g. DOCUP50" maxlength="30" style="text-transform:uppercase" />
                <p class="form-hint">Auto-uppercased. Must be unique.</p>
            </div>
            <div class="form-group">
                <label class="form-label">Type *</label>
                <select class="form-select" id="f-type">
                    <option value="">— Select —</option>
                    <option value="flat">Flat Discount (₹ off price)</option>
                    <option value="docscore">DocScore Bonus (after payment)</option>
                </select>
            </div>
        </div>

        <div class="cond-flat form-group" id="condFlat">
            <label class="form-label">Flat Discount (₹) *</label>
            <input class="form-input" type="number" id="f-flat" placeholder="e.g. 50" min="1" />
        </div>
        <div class="cond-docscore form-group" id="condDocscore">
            <label class="form-label">DocScore Bonus *</label>
            <input class="form-input" type="number" id="f-docscore" placeholder="e.g. 100" min="1" />
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Max Uses *</label>
                <input class="form-input" type="number" id="f-max-uses" placeholder="e.g. 200" min="1" />
            </div>
            <div class="form-group">
                <label class="form-label">Applies To</label>
                <select class="form-select" id="f-applies-to">
                    <option value="both">Both (Recharge + Subscription)</option>
                    <option value="recharge">Recharge only</option>
                    <option value="subscription">Subscription only</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Applicable To</label>
                <select class="form-select" id="f-applicable-to">
                    <option value="all">All Users</option>
                    <option value="specific_users">Specific Users Only</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Expires At</label>
                <input class="form-input" type="datetime-local" id="f-expires" />
                <p class="form-hint">Leave blank for no expiry.</p>
            </div>
        </div>

        <div class="cond-users form-group" id="condUsers">
            <label class="form-label">Allowed User Emails *</label>
            <textarea class="form-textarea" id="f-allowed-users" placeholder="One email per line&#10;e.g.&#10;user@example.com&#10;other@example.com"></textarea>
            <p class="form-hint">One email per line. Only these users can redeem.</p>
        </div>

        <div class="form-group">
            <label class="form-label">Description</label>
            <input class="form-input" type="text" id="f-description" placeholder="e.g. Launch promo for new users" maxlength="120" />
        </div>

        <div class="modal-footer">
            <button class="btn-cancel" id="cancelCreate">Cancel</button>
            <button class="btn-primary" id="submitCreate">Create Coupon</button>
        </div>
    </div>
</div>

<!-- ══ Toast ══ -->
<div id="toast"></div>

<script>
// ── Admin secret injected server-side (dev session already verified by the route)
const ADMIN_SECRET = "<%- adminSecret %>";

function getSecret() {
    return ADMIN_SECRET;
}

// ── State
let allCoupons = [];

// ── Fetch and render
async function loadCoupons() {
    try {
        const res  = await fetch("/admin/discount/coupons", {
            headers: { "x-admin-secret": ADMIN_SECRET }
        });
        const data = await res.json();
        if (!data.success) { showToast(data.message || "Failed to load", "error"); return; }
        allCoupons = data.coupons || [];
        renderStats();
        renderTable();
    } catch (err) {
        showToast("Network error loading coupons", "error");
    }
}

function renderStats() {
    const total       = allCoupons.length;
    const active      = allCoupons.filter(c => c.active).length;
    const redemptions = allCoupons.reduce((s, c) => s + (c.used_count || 0), 0);
    document.getElementById("statTotal").textContent       = total;
    document.getElementById("statActive").textContent      = active;
    document.getElementById("statRedemptions").textContent = redemptions;
    document.getElementById("statInactive").textContent    = total - active;
}

function applyFilters() {
    const search     = document.getElementById("searchInput").value.trim().toLowerCase();
    const typeF      = document.getElementById("filterType").value;
    const appliesToF = document.getElementById("filterAppliesTo").value;
    const statusF    = document.getElementById("filterStatus").value;

    return allCoupons.filter(c => {
        if (search && !c.code.toLowerCase().includes(search) && !(c.description || "").toLowerCase().includes(search)) return false;
        if (typeF      && c.type       !== typeF)      return false;
        if (appliesToF && c.applies_to !== appliesToF) return false;
        if (statusF === "active"   && !c.active) return false;
        if (statusF === "inactive" &&  c.active) return false;
        return true;
    });
}

function formatExpiry(dateStr) {
    if (!dateStr) return '<span style="color:var(--text-muted)">Never</span>';
    const d   = new Date(dateStr);
    const now = new Date();
    const diffMs = d - now;
    const fmt = d.toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" });

    if (diffMs < 0)          return `<span class="expiry-expired">${fmt} (expired)</span>`;
    if (diffMs < 86400000*3) return `<span class="expiry-soon">${fmt}</span>`;
    return fmt;
}

function usagePct(c) {
    if (!c.max_uses) return 0;
    return Math.min(100, Math.round((c.used_count / c.max_uses) * 100));
}

function renderTable() {
    const filtered = applyFilters();
    const tbody    = document.getElementById("couponTableBody");
    document.getElementById("tableCount").textContent = `${filtered.length} coupon${filtered.length !== 1 ? "s" : ""}`;

    if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8"><div class="cm-empty">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none"><path d="M9 14l6-6M9.5 9a.5.5 0 110-1 .5.5 0 010 1zm5 5a.5.5 0 110-1 .5.5 0 010 1z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10S2 17.523 2 12z" stroke="currentColor" stroke-width="1.5"/></svg>
            <p>No coupons match your filters.</p>
        </div></td></tr>`;
        return;
    }

    tbody.innerHTML = filtered.map(c => {
        const pct  = usagePct(c);
        const full = c.used_count >= c.max_uses;
        const benefit = c.type === "flat"
            ? `<span style="color:var(--accent)">₹${c.flat_discount} off</span>`
            : `<span style="color:#a78bfa">+${c.docscore_bonus} DS</span>`;

        const scopeMap = { recharge: "badge-recharge", subscription: "badge-sub", both: "badge-both" };
        const scopeLabel = { recharge: "Recharge", subscription: "Sub", both: "Both" };

        const toggleClass = c.active ? "toggle-on" : "toggle-off";
        const toggleLabel = c.active ? "Disable" : "Enable";

        return `<tr data-code="${c.code}">
            <td><span class="code-pill">${c.code}</span>
                ${c.description ? `<div style="font-size:0.74rem;color:var(--text-muted);margin-top:3px">${c.description}</div>` : ""}
            </td>
            <td><span class="badge ${c.type === 'flat' ? 'badge-flat' : 'badge-docscore'}">${c.type === 'flat' ? 'Flat ₹' : 'DocScore'}</span></td>
            <td>${benefit}</td>
            <td><span class="badge ${scopeMap[c.applies_to] || 'badge-both'}">${scopeLabel[c.applies_to] || c.applies_to}</span></td>
            <td>
                <div class="usage-bar-wrap">
                    <div class="usage-bar-outer">
                        <div class="usage-bar-inner${full ? ' full' : ''}" style="width:${pct}%"></div>
                    </div>
                    <span class="usage-text">${c.used_count}/${c.max_uses}</span>
                </div>
            </td>
            <td>${formatExpiry(c.expires_at)}</td>
            <td><span class="badge ${c.active ? 'badge-active' : 'badge-inactive'}">${c.active ? 'Active' : 'Inactive'}</span></td>
            <td>
                <div class="row-actions">
                    <button class="btn-icon ${toggleClass}" onclick="toggleCoupon('${c.code}')">${toggleLabel}</button>
                    <button class="btn-icon danger" onclick="deleteCoupon('${c.code}')">Delete</button>
                </div>
            </td>
        </tr>`;
    }).join("");
}

// ── Toggle
async function toggleCoupon(code) {
    try {
        const res  = await fetch(`/admin/discount/coupon/${code}/toggle`, {
            method:  "PATCH",
            headers: { "x-admin-secret": ADMIN_SECRET }
        });
        const data = await res.json();
        if (!data.success) { showToast(data.message || "Toggle failed", "error"); return; }
        // Patch local state
        const idx = allCoupons.findIndex(c => c.code === code);
        if (idx !== -1) allCoupons[idx].active = data.active;
        renderStats();
        renderTable();
        showToast(`${code} ${data.active ? "enabled" : "disabled"}`, "success");
    } catch (err) {
        showToast("Network error", "error");
    }
}

// ── Delete
async function deleteCoupon(code) {
    if (!confirm(`Permanently delete coupon "${code}"? This cannot be undone.`)) return;
    try {
        const res  = await fetch(`/admin/discount/coupon/${code}`, {
            method:  "DELETE",
            headers: { "x-admin-secret": ADMIN_SECRET }
        });
        const data = await res.json();
        if (!data.success) { showToast(data.message || "Delete failed", "error"); return; }
        allCoupons = allCoupons.filter(c => c.code !== code);
        renderStats();
        renderTable();
        showToast(`${code} deleted`, "success");
    } catch (err) {
        showToast("Network error", "error");
    }
}

// ── Create modal
const modal         = document.getElementById("createModal");
const openBtn       = document.getElementById("openCreateModal");
const closeBtn      = document.getElementById("closeCreateModal");
const cancelBtn     = document.getElementById("cancelCreate");
const submitBtn     = document.getElementById("submitCreate");

openBtn.addEventListener("click",  () => modal.classList.add("open"));
closeBtn.addEventListener("click", () => modal.classList.remove("open"));
cancelBtn.addEventListener("click",() => modal.classList.remove("open"));
modal.addEventListener("click", e => { if (e.target === modal) modal.classList.remove("open"); });

// ── Conditional fields
const typeSelect = document.getElementById("f-type");
const appToSelect = document.getElementById("f-applicable-to");

typeSelect.addEventListener("change", () => {
    document.getElementById("condFlat").style.display     = typeSelect.value === "flat"     ? "block" : "none";
    document.getElementById("condDocscore").style.display = typeSelect.value === "docscore" ? "block" : "none";
});
appToSelect.addEventListener("change", () => {
    document.getElementById("condUsers").style.display = appToSelect.value === "specific_users" ? "block" : "none";
});

// ── Create submit
submitBtn.addEventListener("click", async () => {

    const code        = document.getElementById("f-code").value.trim().toUpperCase();
    const type        = document.getElementById("f-type").value;
    const maxUses     = parseInt(document.getElementById("f-max-uses").value) || 0;
    const appliesTo   = document.getElementById("f-applies-to").value;
    const applicableTo= document.getElementById("f-applicable-to").value;
    const expiresRaw  = document.getElementById("f-expires").value;
    const description = document.getElementById("f-description").value.trim();

    if (!code)     { showToast("Code is required", "error"); return; }
    if (!type)     { showToast("Type is required", "error"); return; }
    if (!maxUses)  { showToast("Max uses must be > 0", "error"); return; }

    const body = { code, type, max_uses: maxUses, applies_to: appliesTo, applicable_to: applicableTo, description };

    if (type === "flat") {
        const fd = parseInt(document.getElementById("f-flat").value) || 0;
        if (!fd) { showToast("Flat discount must be > 0", "error"); return; }
        body.flat_discount = fd;
    }
    if (type === "docscore") {
        const db = parseInt(document.getElementById("f-docscore").value) || 0;
        if (!db) { showToast("DocScore bonus must be > 0", "error"); return; }
        body.docscore_bonus = db;
    }
    if (applicableTo === "specific_users") {
        const raw = document.getElementById("f-allowed-users").value;
        const emails = raw.split("\n").map(e => e.trim()).filter(Boolean);
        if (!emails.length) { showToast("Enter at least one email for specific_users scope", "error"); return; }
        body.allowed_users = emails;
    }
    if (expiresRaw) body.expires_at = new Date(expiresRaw).toISOString();

    submitBtn.disabled  = true;
    submitBtn.textContent = "Creating…";

    try {
        const res  = await fetch("/admin/discount/coupon/create", {
            method:  "POST",
            headers: { "Content-Type": "application/json", "x-admin-secret": ADMIN_SECRET },
            body:    JSON.stringify(body)
        });
        const data = await res.json();
        if (!data.success) {
            showToast(data.message || "Create failed", "error");
            return;
        }
        allCoupons.unshift(data.coupon);
        renderStats();
        renderTable();
        modal.classList.remove("open");
        resetForm();
        showToast(`Coupon ${data.coupon.code} created!`, "success");
    } catch (err) {
        showToast("Network error", "error");
    } finally {
        submitBtn.disabled   = false;
        submitBtn.textContent = "Create Coupon";
    }
});

function resetForm() {
    ["f-code","f-flat","f-docscore","f-max-uses","f-expires","f-description","f-allowed-users"].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = "";
    });
    document.getElementById("f-type").value           = "";
    document.getElementById("f-applies-to").value     = "both";
    document.getElementById("f-applicable-to").value  = "all";
    document.getElementById("condFlat").style.display     = "none";
    document.getElementById("condDocscore").style.display = "none";
    document.getElementById("condUsers").style.display    = "none";
}

// ── Filters
["searchInput","filterType","filterAppliesTo","filterStatus"].forEach(id =>
    document.getElementById(id).addEventListener("input", renderTable)
);

// ── Toast
function showToast(msg, type = "success") {
    const t = document.getElementById("toast");
    t.textContent = msg;
    t.className   = `show ${type}`;
    clearTimeout(t._timer);
    t._timer = setTimeout(() => { t.className = ""; }, 3200);
}

// ══════════════════════════════════════════════════
// SALE BANNER MANAGER
// ══════════════════════════════════════════════════

let currentSale = null;
let saleCountdownTimer = null;

const saleModal    = document.getElementById("saleModal");
const openSaleBtn  = document.getElementById("openSaleModal");
const closeSaleBtn = document.getElementById("closeSaleModal");
const cancelSaleBtn= document.getElementById("cancelSale");
const submitSaleBtn= document.getElementById("submitSale");

openSaleBtn.addEventListener("click",   () => saleModal.classList.add("open"));
closeSaleBtn.addEventListener("click",  () => saleModal.classList.remove("open"));
cancelSaleBtn.addEventListener("click", () => saleModal.classList.remove("open"));
saleModal.addEventListener("click", e => { if (e.target === saleModal) saleModal.classList.remove("open"); });

// Live preview in modal
const sLabelInput = document.getElementById("s-label");
const sPctInput   = document.getElementById("s-pct");
const sPreviewText= document.getElementById("sPreviewText");
const sPreviewStrip = document.getElementById("salePreviewStrip");

function updateSalePreview() {
    const label = sLabelInput.value.trim() || "Limited Time Offer";
    const pct   = parseInt(sPctInput.value) || 0;
    const scope = document.querySelector('input[name="s-scope"]:checked')?.value || "both";
    const scopeStr = scope === "recharge" ? "all recharges" : scope === "subscription" ? "all subscriptions" : "all plans";
    sPreviewText.innerHTML = `${label} — <strong>${pct}% off</strong> ${scopeStr}`;
}

[sLabelInput, sPctInput].forEach(el => el.addEventListener("input", updateSalePreview));
document.querySelectorAll('input[name="s-scope"]').forEach(r => r.addEventListener("change", updateSalePreview));

// Load active sale from server
async function loadActiveSale() {
    try {
        const res  = await fetch("/admin/discount/sale/get", {
            headers: { "x-admin-secret": ADMIN_SECRET }
        });
        const data = await res.json();
        if (!data.success) { renderSaleState(null, false); return; }
        currentSale = data.sale;
        renderSaleState(currentSale, !!currentSale);
    } catch(e) {
        renderSaleState(null, false);
    }
}

function renderSaleState(sale, isLive) {
    const dot   = document.getElementById("saleDot");
    const label = document.getElementById("saleStatusLabel");
    const body  = document.getElementById("saleManagerBody");

    clearInterval(saleCountdownTimer);

    if (!sale || !isLive) {
        dot.className = "sale-dead-dot";
        label.textContent = "No active sale";
        body.innerHTML = `
            <div class="sale-empty">
                <div class="sale-empty-icon">🏷️</div>
                <h4>No sale is currently live</h4>
                <p>Click "Set New Sale" to configure a sitewide discount banner on the pricing &amp; upgrade pages.</p>
            </div>`;
        return;
    }

    dot.className = "sale-live-dot";
    const scopeLabels = { recharge: "Recharge only", subscription: "Subscription only", both: "All plans" };
    const scopeColors = { recharge: "#22d3ee", subscription: "#f59e0b", both: "#4ade80" };
    const scopeStr = scopeLabels[sale.applies_to] || sale.applies_to;
    const scopeColor = scopeColors[sale.applies_to] || "#4ade80";
    const endDate = new Date(sale.ends_at);
    const startDate = new Date(sale.starts_at);
    const endFmt = endDate.toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" });
    const startFmt = startDate.toLocaleDateString("en-IN", { day:"numeric", month:"short" });

    label.textContent = `${sale.discount_percent}% off · live`;

    body.innerHTML = `
        <div class="sale-preview">
            <div class="sale-preview-left">
                <div class="sale-preview-label">${sale.sale_label} <span class="sale-pct">— ${sale.discount_percent}% off</span></div>
                <div class="sale-preview-meta">
                    <span class="sale-meta-chip">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        Scope: <strong style="color:${scopeColor}">${scopeStr}</strong>
                    </span>
                    <span class="sale-meta-chip">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.6"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                        Started ${startFmt} · Ends ${endFmt}
                    </span>
                </div>
                <div style="margin-top:12px">
                    <div class="sale-countdown-label">Time remaining</div>
                    <div class="sale-countdown" id="saleCountdown">—</div>
                </div>
            </div>
            <div class="sale-preview-actions">
                <button class="btn-edit" onclick="openEditSale()">✏️ Edit</button>
                <button class="btn-danger" onclick="clearActiveSale()">✕ End Sale</button>
            </div>
        </div>
        <div class="sale-banner-preview" style="margin-top:20px">
            <div class="sale-banner-preview-label">Live preview — visible to users on pricing page</div>
            <div class="sale-banner-strip">
                <span class="sbadge">Sale</span>
                <span>${sale.sale_label} — <strong>${sale.discount_percent}% off</strong> ${sale.applies_to === "recharge" ? "all recharges" : sale.applies_to === "subscription" ? "all subscriptions" : "all plans"}</span>
                <span style="opacity:0.7;font-size:0.8rem;">Ends ${endFmt}</span>
            </div>
        </div>`;

    // Countdown ticker
    function tickCountdown() {
        const now = new Date();
        const diff = endDate - now;
        if (diff <= 0) {
            document.getElementById("saleCountdown").textContent = "Expired";
            clearInterval(saleCountdownTimer);
            return;
        }
        const h = Math.floor(diff / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        const el = document.getElementById("saleCountdown");
        if (el) el.textContent = `${h}h ${String(m).padStart(2,"0")}m ${String(s).padStart(2,"0")}s`;
    }
    tickCountdown();
    saleCountdownTimer = setInterval(tickCountdown, 1000);
}

function openEditSale() {
    if (currentSale) {
        document.getElementById("s-label").value = currentSale.sale_label || "";
        document.getElementById("s-pct").value   = currentSale.discount_percent || "";
        const scope = currentSale.applies_to || "both";
        const radio = document.getElementById(
            scope === "recharge" ? "s-scope-recharge" :
            scope === "subscription" ? "s-scope-sub" : "s-scope-both"
        );
        if (radio) radio.checked = true;
        // Pre-fill dates
        const toLocalInput = (d) => {
            const dt = new Date(d);
            dt.setMinutes(dt.getMinutes() - dt.getTimezoneOffset());
            return dt.toISOString().slice(0,16);
        };
        if (currentSale.ends_at) document.getElementById("s-ends").value = toLocalInput(currentSale.ends_at);
        if (currentSale.starts_at) document.getElementById("s-starts").value = toLocalInput(currentSale.starts_at);
        updateSalePreview();
    }
    saleModal.classList.add("open");
}

async function clearActiveSale() {
    if (!confirm("End the active sale immediately? Users will no longer see the banner.")) return;
    try {
        const res  = await fetch("/admin/discount/sale/clear", {
            method:  "DELETE",
            headers: { "x-admin-secret": ADMIN_SECRET }
        });
        const data = await res.json();
        if (!data.success) { showToast(data.message || "Failed to clear sale", "error"); return; }
        currentSale = null;
        renderSaleState(null, false);
        showToast("Sale ended. Banner removed from pricing pages.", "success");
    } catch(e) {
        showToast("Network error", "error");
    }
}

submitSaleBtn.addEventListener("click", async () => {
    const label   = document.getElementById("s-label").value.trim() || "Limited Time Offer";
    const pct     = parseInt(document.getElementById("s-pct").value) || 0;
    const endsRaw = document.getElementById("s-ends").value;
    const startRaw= document.getElementById("s-starts").value;
    const scope   = document.querySelector('input[name="s-scope"]:checked')?.value || "both";

    if (!pct || pct < 1 || pct > 99) { showToast("Discount must be 1–99%", "error"); return; }
    if (!endsRaw)                     { showToast("End date is required", "error"); return; }

    const ends   = new Date(endsRaw);
    const starts = startRaw ? new Date(startRaw) : new Date();

    if (ends <= new Date()) { showToast("End date must be in the future", "error"); return; }
    if (starts >= ends)     { showToast("Start must be before end date", "error"); return; }

    submitSaleBtn.disabled  = true;
    submitSaleBtn.textContent = "Launching…";

    try {
        const res  = await fetch("/admin/discount/sale/set", {
            method:  "POST",
            headers: { "Content-Type": "application/json", "x-admin-secret": ADMIN_SECRET },
            body:    JSON.stringify({
                sale_label:       label,
                discount_percent: pct,
                applies_to:       scope,
                starts_at:        starts.toISOString(),
                ends_at:          ends.toISOString()
            })
        });
        const data = await res.json();
        if (!data.success) { showToast(data.message || "Failed to launch sale", "error"); return; }
        currentSale = data.sale;
        renderSaleState(currentSale, true);
        saleModal.classList.remove("open");
        showToast(`🔥 Sale launched! ${pct}% off is now live.`, "success");
    } catch(e) {
        showToast("Network error", "error");
    } finally {
        submitSaleBtn.disabled  = false;
        submitSaleBtn.textContent = "🚀 Launch Sale";
    }
});

// ── Init
loadActiveSale();
loadCoupons();
</script>

<%- include('partials/page-loader') %>
</body>
</html>
