<button id="backToTopBtn" class="back-to-top-btn">
    <svg class="progress-ring" width="60" height="60">
        <circle class="progress-ring-bg" cx="30" cy="30" r="26"/>
        <circle class="progress-ring-circle" cx="30" cy="30" r="26"/>
    </svg>
    <div class="btn-center-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M12 19V5M12 5L5 12M12 5L19 12"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"/>
        </svg>
    </div>
</button>

<script src="/dashboard2.js"></script>
<script>
    const backToTopBtn = document.getElementById("backToTopBtn");
    const ring = backToTopBtn ? backToTopBtn.querySelector(".progress-ring-circle") : null;
    const circumference = 2 * Math.PI * 26;

    window.addEventListener("scroll", () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? scrollTop / docHeight : 0;
        if (backToTopBtn) {
            backToTopBtn.classList.toggle("show", scrollTop > 200);
        }
        if (ring) {
            ring.style.strokeDashoffset = circumference - progress * circumference;
        }
    });

    if (backToTopBtn) {
        backToTopBtn.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
        });
    }
</script>
<%- include('partials/page-loader') %>
</body>
</html>