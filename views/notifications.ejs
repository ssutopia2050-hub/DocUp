                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"/>
                <path d="M5 18.5h14"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"/>
            </svg>
            <span>Upload</span>
        </a>

        <!-- Notifications -->
        <div class="notification-wrap">
            <button type="button" class="icon-btn notification-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M9 17H15M6.5 17H17.5C16.9 16.35 16.5 15.48 16.5 14.5V10.5C16.5 8.01 14.49 6 12 6C9.51 6 7.5 8.01 7.5 10.5V14.5C7.5 15.48 7.1 16.35 6.5 17Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>
                    <path d="M10.5 20C10.74 20.62 11.32 21 12 21C12.68 21 13.26 20.62 13.5 20"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>
                </svg>

                <% const unreadCount = (user.notifications || []).filter(n => !n.isRead).length; %>
                <% if (unreadCount > 0) { %>
                <span class="notif-badge"><%= unreadCount > 9 ? "9+" : unreadCount %></span>
                <% } %>
            </button>

            <div style="background: #000407" class="notification-dropdown">
                <div class="nd-header">
                    <span class="nd-title">Notifications</span>
                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <a href="/notifications" class="nd-view-all">View all</a>
                    <% } %>
                </div>

                <div class="nd-list">
                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <% user.notifications.slice().reverse().forEach((item) => { %>
                    <div class="nd-item <%= item.isRead ? '' : 'unread' %>">
                        <div class="nd-item-row">
                            <span class="nd-dot"></span>
                            <span class="nd-when">
                                <%= item.createdAt
                                    ? new Date(item.createdAt).toLocaleString("en-IN", {
                                        dateStyle: "medium",
                                        timeStyle: "short"
                                    })
                                    : "Just now" %>
                            </span>
                        </div>
                        <p class="nd-text"><%= item.content %></p>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="nd-empty">No notifications yet.</div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Avatar -->
        <div class="avatar-btn">
            <% if (user.avatar_img_path) { %>
            <img src="<%= user.avatar_img_path %>" alt="">
            <% } else { %>
            <%= user.name ? user.name.charAt(0).toUpperCase() : "U" %>
            <% } %>
        </div>

    </div>
</header>

<!-- Avatar Dropdown -->
