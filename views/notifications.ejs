<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>DocUp | Notifications</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/page-loader.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg: #00141c;
            --bg-2: #001820;
            --surface: #061219;
            --surface-2: #0b1c26;
            --surface-3: #0f2230;

            --border: rgba(255,255,255,0.07);
            --border-warm: rgba(255,106,0,0.16);
            --border-warm-hi: rgba(255,106,0,0.28);

            --accent: #ff6a00;
            --accent-2: #ff9a00;
            --accent-glow: rgba(255,106,0,0.18);

            --text: #f0f4f7;
            --text-2: rgba(240,244,247,0.65);
            --text-3: rgba(240,244,247,0.38);

            --r-xs: 8px;
            --r-sm: 12px;
            --r-md: 18px;
            --r-lg: 24px;
            --r-xl: 32px;

            --shadow-sm: 0 4px 16px rgba(0,0,0,0.2);
            --shadow-md: 0 8px 32px rgba(0,0,0,0.28);
            --shadow-lg: 0 16px 56px rgba(0,0,0,0.38);
            --shadow-card: 0 20px 60px rgba(0,0,0,0.32);

            --t: 0.2s cubic-bezier(0.4,0,0.2,1);
        }

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            user-select:none;
        }

        body{
            background:
                radial-gradient(ellipse 80% 50% at 10% 0%, rgba(255,106,0,0.10) 0%, transparent 55%),
                radial-gradient(ellipse 60% 40% at 90% 5%, rgba(75,146,255,0.07) 0%, transparent 45%),
                radial-gradient(ellipse 50% 60% at 50% 100%, rgba(255,106,0,0.05) 0%, transparent 60%),
                linear-gradient(160deg, #00141c 0%, #000f17 60%, #001018 100%);
            min-height:100vh;
            display:flex;
            flex-direction:column;
            color:white;
            font-family:'Saira', sans-serif;
        }
        /* ===== TOPBAR ===== */
        .topbar {
            position: sticky;
            top: 0;
            z-index: 1400;
            width: 100%;
            height: 68px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            background: rgba(0, 16, 22, 0.32);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-bottom: 1px solid var(--border);
        }

        .topbar-left,
        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo-wordmark {
            font-family: 'Archivo Black', sans-serif;
            font-size: 2.55rem;
            font-weight: 800;
            color: var(--text);
            letter-spacing: -0.3px;
            white-space: nowrap;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: row;

        }
        .logo-wordmark img{
            height: 50px;
        }

        .topbar-divider {
            width: 1px;
            height: 20px;
            background: var(--border);
            margin: 0 16px;
        }

        .topbar-breadcrumb {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.85rem;
            color: var(--text-3);
            font-family: 'DM Sans', sans-serif;
        }

        .topbar-breadcrumb a {
            color: var(--text-2);
            transition: color var(--t);
        }

        .topbar-breadcrumb a:hover {
            color: var(--accent);
        }

        .breadcrumb-current {
            color: var(--text-2);
        }

        .topbar-pill {
            height: 40px;
            padding: 0 14px;
            border-radius: 999px;
            border: 1px solid var(--border);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--text-2);
            background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02));
            transition: var(--t);
            font-size: 0.88rem;
            font-weight: 600;
            font-family: 'DM Sans', sans-serif;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
        }

        .topbar-pill:hover {
            color: var(--text);
            border-color: var(--border-warm);
            background: rgba(255,255,255,0.06);
        }

        .docscore-pill {
            height: 40px;
            padding: 0 14px;
            border-radius: 999px;
            border: 1px solid var(--border-warm);
            background: linear-gradient(180deg, rgba(255,106,0,0.09), rgba(255,106,0,0.04));
            display: inline-flex;
            align-items: center;
            gap: 8px;
            color: var(--text);
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 8px 24px rgba(0,0,0,0.12);
        }

        .docscore-label {
            color: var(--accent);
            font-size: 0.82rem;
            font-weight: 700;
            font-family: 'DM Sans', sans-serif;
        }

        .docscore-value {
            color: white;
            font-weight: 700;
            font-family: 'DM Sans', sans-serif;
        }

        .docscore-pill img {
            height: 16px;
            width: auto;
        }

        .icon-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-2);
            border: 1px solid var(--border);
            background: rgba(255,255,255,0.03);
            transition: var(--t);
        }

        .icon-btn:hover {
            /*color: var(--text);*/
            /*background: rgba(255,255,255,0.07);*/
            /*border-color: var(--border-warm);*/
        }
        /* ===== PROFILE / AVATAR DROPDOWN ===== */
        .avatar-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, #ff5e00, #ff9b45);
            color: white;
            font-family: 'DM Sans', sans-serif;
            font-size: 1.1rem;
            font-weight: 800;
            cursor: pointer;
            border: 2px solid rgba(255,94,0,0.3);
            box-shadow: 0 4px 16px rgba(255,94,0,0.2);
            transition: var(--t);
            flex-shrink: 0;
        }

        .avatar-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 24px rgba(255,94,0,0.32);
        }

        .avatar-btn img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .avatar-dropdown {
            position: fixed;
            z-index: 9999;
            top: 78px;
            right: 28px;
            width: 200px;
            padding: 6px;
            display: none;
            flex-direction: column;
            gap: 2px;
            border-radius: var(--r-md);
            border: 1px solid var(--border);
            background: rgba(6,14,20,0.96);
            backdrop-filter: blur(32px);
            -webkit-backdrop-filter: blur(32px);
            box-shadow: var(--shadow-lg);
            opacity: 0;
            transform: translateY(-6px) scale(0.97);
            pointer-events: none;
            transition: opacity 0.16s ease, transform 0.16s ease;
        }

        .avatar-dropdown.active {
            display: flex;
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
        }

        .avatar-dropdown a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            border-radius: 10px;
            color: var(--text-2);
            font-size: 0.88rem;
            transition: var(--t);
            font-family: 'DM Sans', sans-serif;
        }

        .avatar-dropdown a:hover {
            color: var(--text);
            background: rgba(255,255,255,0.06);
        }

        .avatar-dropdown a svg {
            color: var(--text-3);
            transition: color var(--t);
        }

        .avatar-dropdown a:hover svg {
            color: var(--accent);
        }

        @media (max-width: 768px) {
            .topbar {
                padding: 0 16px;
            }

            .topbar-breadcrumb,
            .docscore-label,
            .topbar-search-link span {
                display: none;
            }

            .topbar-divider {
                display: none;
            }

            .logo-wordmark {
                font-size: 3.1rem;
            }

            .topbar-right {
                gap: 8px;
            }

            .docscore-pill,
            .topbar-pill {
                padding: 0 10px;
            }

            .avatar-dropdown {
                right: 14px;
                top: 72px;
                width: calc(100vw - 28px);
                max-width: 260px;
                border-radius: 16px;
            }

            .avatar-dropdown a {
                min-height: 48px;
                font-size: 0.9rem;
            }
        }
        .notification-wrap {
            position: relative;
        }

        .notification-btn {
            position: relative;
        }

        .notif-badge {
            position: absolute;
            top: -3px;
            right: -3px;
            min-width: 18px;
            height: 18px;
            padding: 0 4px;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            color: #fff;
            font-size: 0.68rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid var(--bg);
            font-family: 'DM Sans', sans-serif;
        }

        .notification-dropdown {
            position: absolute;
            top: calc(100% + 14px);
            right: 0;
            width: 360px;
            max-height: 440px;
            border-radius: var(--r-lg);
            border: 1px solid rgba(255,255,255,0.07);
            background: linear-gradient(160deg, rgba(8,20,28,0.98) 0%, rgba(4,12,18,0.98) 100%);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            box-shadow:
                    0 32px 70px rgba(0,0,0,0.55),
                    inset 0 1px 0 rgba(255,255,255,0.05),
                    0 0 0 1px rgba(255,255,255,0.02);
            overflow: hidden;
            display: none;
            flex-direction: column;
            opacity: 0;
            transform: translateY(-10px) scale(0.97);
            pointer-events: none;
            transition: opacity 0.20s ease, transform 0.20s cubic-bezier(0.22,1,0.36,1);
            z-index: 99999;
        }

        .notification-dropdown.active {
            display: flex;
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
        }

        .nd-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 18px 14px;
            border-bottom: 1px solid var(--border);
        }

        .nd-title {
            font-family: 'Archivo Black', sans-serif;
            font-size: 0.95rem;
            color: white;
        }

        .nd-view-all {
            font-size: 0.8rem;
            color: var(--accent);
            padding: 5px 10px;
            border-radius: 999px;
            background: var(--accent-glow);
            border: 1px solid var(--border-warm);
            font-family: 'DM Sans', sans-serif;
        }

        .nd-view-all:hover {
            background: rgba(255,106,0,0.24);
        }

        .nd-list {
            overflow-y: auto;
            max-height: 370px;
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nd-item {
            padding: 14px 15px;
            border-radius: 14px;
            border: 1px solid rgba(255,255,255,0.05);
            background: rgba(255,255,255,0.022);
            transition: var(--t);
        }

        .nd-item:hover {
            border-color: var(--border-warm);
            background: rgba(255,255,255,0.038);
            transform: translateY(-1px);
        }

        .nd-item.unread {
            border-color: rgba(255,106,0,0.16);
            background: radial-gradient(ellipse at top right, rgba(255,106,0,0.10) 0%, transparent 65%), rgba(255,255,255,0.03);
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
        }

        .nd-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 7px;
        }

        .nd-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            box-shadow: 0 0 10px rgba(255,106,0,0.5);
            flex-shrink: 0;
        }

        .nd-item:not(.unread) .nd-dot {
            opacity: 0.18;
            box-shadow: none;
        }

        .nd-when {
            font-size: 0.72rem;
            color: var(--text-3);
            font-family: 'DM Sans', sans-serif;
        }

        .nd-text {
            font-size: 0.88rem;
            color: var(--text-2);
            line-height: 1.55;
            font-family: 'DM Sans', sans-serif;
        }

        .nd-empty {
            padding: 40px 20px;
            text-align: center;
            color: var(--text-3);
            font-size: 0.88rem;
            font-family: 'DM Sans', sans-serif;
        }


        .notification-view-all{
            color:#ff9b66;
            font-family:'Saira', sans-serif;
            font-size:0.82rem;
            padding:6px 10px;
            border-radius:999px;
            background:rgba(255,94,0,0.08);
            border:1px solid rgba(255,94,0,0.12);
            transition:0.2s ease;
        }

        .notification-view-all:hover{
            color:white;
            background:rgba(255,94,0,0.14);
            border-color:rgba(255,94,0,0.22);
        }

        .notification-list{
            display:flex;
            flex-direction:column;
            gap:10px;
            max-height:378px;
            overflow-y:auto;
            padding:4px 2px 2px 2px;
        }

        .notification-list::-webkit-scrollbar{
            width:7px;
        }

        .notification-list::-webkit-scrollbar-track{
            background:transparent;
        }

        .notification-list::-webkit-scrollbar-thumb{
            background:rgba(255,94,0,0.24);
            border-radius:999px;
        }

        .notification-item{
            width:100%;
            display:flex;
            flex-direction:column;
            gap:10px;
            padding:14px 14px 13px 14px;
            border-radius:16px;
            border:1px solid rgba(255,255,255,0.05);
            background:
                    linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.02));
            transition:
                    transform 0.18s ease,
                    border-color 0.18s ease,
                    background 0.18s ease,
                    box-shadow 0.18s ease;
        }

        .notification-item:hover{
            transform:translateY(-2px);
            border-color:rgba(255,118,55,0.16);
            background:
                    linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.024));
            box-shadow:0 10px 24px rgba(0,0,0,0.2);
        }

        .notification-item.unread{
            border-color:rgba(255,110,45,0.16);
            background:
                    radial-gradient(circle at top right, rgba(255,94,0,0.12), transparent 42%),
                    linear-gradient(180deg, rgba(255,255,255,0.055), rgba(255,255,255,0.022));
        }

        .notification-item-top{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:12px;
        }

        .notification-item-top-left{
            display:flex;
            align-items:center;
            gap:9px;
            min-width:0;
        }

        .notification-dot{
            width:9px;
            height:9px;
            min-width:9px;
            border-radius:50%;
            background:linear-gradient(135deg, #ff5e00, #ff9b45);
            box-shadow:0 0 14px rgba(255,94,0,0.5);
        }

        .notification-item:not(.unread) .notification-dot{
            opacity:0.18;
            box-shadow:none;
        }

        .notification-label{
            font-family:'Saira', sans-serif;
            font-size:0.76rem;
            letter-spacing:0.8px;
            text-transform:uppercase;
            color:rgba(255,150,110,0.8);
        }

        .notification-meta{
            font-family:'Saira', sans-serif;
            font-size:0.73rem;
            color:rgba(255,255,255,0.42);
            white-space:nowrap;
        }

        .notification-content{
            font-family:'Saira', sans-serif;
            font-size:0.93rem;
            line-height:1.6;
            color:rgba(255,255,255,0.88);
            word-break:break-word;
        }

        .notification-content strong{
            color:white;
            font-weight:600;
        }

        .notifications-page{
            width:100%;
            max-width:980px;
            margin:34px auto;
            padding:0 20px 40px 20px;
            display:flex;
            flex-direction:column;
            gap:20px;
        }

        .page-hero{
            border:1px solid rgba(255,255,255,0.08);
            background:linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.015));
            border-radius:28px;
            padding:28px 28px 24px 28px;
            backdrop-filter:blur(10px);
        }

        .page-kicker{
            font-family:'Saira', sans-serif;
            text-transform:uppercase;
            letter-spacing:1.5px;
            font-size:0.82rem;
            color:rgba(255,94,0,0.88);
            margin-bottom:10px;
        }

        .page-hero h1{
            font-family:'Archivo Black', sans-serif;
            font-size:2rem;
            color:white;
            margin-bottom:10px;
        }

        .page-subtext{
            font-family:'Saira', sans-serif;
            color:rgba(255,255,255,0.58);
            line-height:1.7;
        }

        .notifications-shell{
            border:1px solid rgba(255,255,255,0.08);
            background:linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.015));
            border-radius:28px;
            padding:18px;
            display:flex;
            flex-direction:column;
            gap:14px;
            backdrop-filter:blur(10px);
        }

        .notifications-topbar{
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:14px;
            padding:4px 6px 10px 6px;
            border-bottom:1px solid rgba(255,255,255,0.06);
        }

        .notifications-topbar h2{
            font-family:'Archivo Black', sans-serif;
            font-size:1.1rem;
            color:white;
        }

        .notifications-count{
            font-family:'Saira', sans-serif;
            font-size:0.82rem;
            color:#ffb07c;
            padding:8px 12px;
            border-radius:999px;
            border:1px solid rgba(255,110,45,0.16);
            background:rgba(255,110,45,0.08);
        }

        .notification-card{
            border-radius:20px;
            border:1px solid rgba(255,255,255,0.06);
            background:
                    radial-gradient(circle at top right, rgba(255,94,0,0.10), transparent 35%),
                    linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.02));
            padding:18px 18px 16px 18px;
            transition:transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .notification-card:hover{
            transform:translateY(-2px);
            border-color:rgba(255,110,45,0.18);
            box-shadow:0 14px 28px rgba(0,0,0,0.18);
        }

        .notification-card.unread{
            border-color:rgba(255,110,45,0.22);
            box-shadow:0 0 0 1px rgba(255,110,45,0.05) inset;
        }

        .notification-meta-row{
            display:flex;
            align-items:center;
            justify-content:space-between;
            gap:14px;
            margin-bottom:12px;
        }

        .notification-meta-left{
            display:flex;
            align-items:center;
            gap:10px;
            min-width:0;
        }

        .notification-state{
            font-family:'Saira', sans-serif;
            font-size:0.76rem;
            text-transform:uppercase;
            letter-spacing:1px;
            color:rgba(255,145,92,0.82);
        }

        .notification-time{
            font-family:'Saira', sans-serif;
            font-size:0.78rem;
            color:rgba(255,255,255,0.45);
            white-space:nowrap;
        }

        .empty-state{
            min-height:260px;
            display:flex;
            flex-direction:column;
            align-items:center;
            justify-content:center;
            gap:14px;
            text-align:center;
            border:1px dashed rgba(255,255,255,0.08);
            border-radius:22px;
            background:rgba(255,255,255,0.02);
            padding:30px;
        }

        .empty-state p{
            font-family:'Saira', sans-serif;
            color:rgba(255,255,255,0.52);
            line-height:1.7;
            max-width:420px;
        }

        .empty-btn{
            text-decoration:none;
            color:#ffd1bb;
            font-family:'Saira', sans-serif;
            padding:10px 18px;
            border-radius:999px;
            border:1px solid rgba(255,110,45,0.16);
            background-color:rgba(255,110,45,0.08);
            transition:0.25s ease;
        }

        .empty-btn:hover{
            color:white;
            background-color:rgba(255,110,45,0.14);
            border-color:rgba(255,110,45,0.26);
        }

        @media (max-width: 768px){
            .logo-text-container{
                font-size:2.3rem;
            }

            .page-hero h1{
                font-size:1.55rem;
            }

            .notifications-page{
                margin:22px auto;
            }

            .notification-meta-row{
                flex-direction:column;
                align-items:flex-start;
            }

            .notification-time{
                white-space:normal;
            }

            .profile-btn-dropdown{
                right:14px;
                top:72px;
                width:calc(100vw - 28px);
                max-width:260px;
            }
        }
        a,
        a:visited {
            text-decoration: none;
            color: inherit;
        }

        button {
            cursor: pointer;
            border: none;
            background: none;
            font-family: inherit;
        }

        /* ===== FOOTER ===== */
        .footer {
            margin-top: auto;
            width: 100%;
            min-height: 90px;
            border-top: 1px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 5%;
        }

        .footer-left {
            font-size: 2rem;
            color: white;
            font-family: 'Archivo Black', sans-serif;
            display: flex;
            flex-direction: row;
            justify-content: flex-end;
            align-items: flex-end;
            gap: 6px;
        }

        .footer-left a {
            font-size: 0.8rem;
            color: rgba(255,255,255,0.22);
        }

        .footer-right {
            display: flex;
            gap: 24px;
            flex-wrap: wrap;
        }

        .footer-right a {
            color: rgba(255,255,255,0.62);
            font-family: 'Saira', sans-serif;
            text-decoration: none;
        }

        .footer-right a:hover {
            color: white;
        }

        /* ===== BACK TO TOP ===== */
        .back-to-top-btn {
            position: fixed;
            bottom: 28px;
            right: 28px;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            background:
                radial-gradient(circle at 30% 30%, #ff9a00 0%, #ff6a00 35%, #ff3d00 75%),
                linear-gradient(160deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
            color: white;
            border: 1px solid rgba(255,106,0,0.35);
            box-shadow:
                0 10px 30px rgba(255,106,0,0.35),
                0 0 0 6px rgba(255,106,0,0.10),
                inset 0 1px 0 rgba(255,255,255,0.12);
            backdrop-filter: blur(12px);
            opacity: 0;
            pointer-events: none;
            transform: translateY(12px) scale(0.9);
            transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
            z-index: 1500;
        }

        .back-to-top-btn.show {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0) scale(1);
        }

        .back-to-top-btn:hover {
            background:
                radial-gradient(circle at 30% 30%, #ffb347 0%, #ff7a1a 40%, #ff4d00 80%),
                linear-gradient(160deg, rgba(255,255,255,0.10), rgba(255,255,255,0.03));
            box-shadow:
                0 18px 55px rgba(255,106,0,0.5),
                0 0 0 10px rgba(255,106,0,0.14),
                inset 0 1px 0 rgba(255,255,255,0.18);
        }

        .btn-center-icon {
            position: absolute;
            z-index: 2;
        }

        .progress-ring {
            position: absolute;
            transform: rotate(-90deg);
        }

        .progress-ring-bg {
            fill: transparent;
            stroke: rgba(255,255,255,0.12);
            stroke-width: 3;
        }

        .progress-ring-circle {
            fill: transparent;
            stroke: white;
            stroke-width: 3;
            stroke-linecap: round;
            stroke-dasharray: 163;
            stroke-dashoffset: 163;
            transition: stroke-dashoffset 0.2s linear;
        }

    </style>
</head>
<body>

<%
const dropdownUnreadCount = (user.notifications || []).filter(n => !n.isRead).length;
const pageUnreadCount = (notifications || []).filter(n => !n.isRead).length;
%>

<header class="topbar">
