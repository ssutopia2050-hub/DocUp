<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/pricing.css">
    <link rel="stylesheet" href="/page-loader.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <title>Recharge | DocUp</title>

    <style>
        /* ── Sale Banner ── */
        .sale-banner {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background: linear-gradient(90deg, #ff5e00, #ff8c00);
            color: #fff;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.92rem;
            font-weight: 600;
            padding: 10px 20px;
            text-align: center;
            letter-spacing: 0.02em;
        }
        .sale-banner .sale-badge {
            background: rgba(255,255,255,0.25);
            border-radius: 20px;
            padding: 2px 10px;
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        /* ── Coupon Bar ── */
        .coupon-bar {
            display: flex;
            align-items: stretch;
            justify-content: space-between;
            gap: 0;
            max-width: 480px;
            margin: 0 auto 8px;
            background: rgba(255,255,255,0.04);
            border: 1.5px solid rgba(255,255,255,0.1);
            border-radius: 14px;
            overflow: hidden;
            transition: border-color 0.2s, background 0.2s;
        }
        .coupon-bar:focus-within {
            border-color: rgba(255,94,0,0.5);
            background: rgba(255,94,0,0.03);
        }
        .coupon-bar input {
            flex: 1;
            background: transparent;
            border: none;
            color: #fff;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.95rem;
            font-weight: 500;
            padding: 10px;
            outline: none;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            min-width: 0;
        }
        .coupon-bar input::placeholder { color: rgba(255,255,255,0.28); text-transform: none; letter-spacing: 0; font-weight: 400; }
        .coupon-apply-btn {
            background: transparent;
            color: #ff5e00;
            border: none;
            border-left: 1.5px solid rgba(255,255,255,0.08);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.82rem;
            font-weight: 700;
            padding: 14px 20px;
            cursor: pointer;
            transition: background 0.15s, color 0.15s;
            white-space: nowrap;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }
        .coupon-apply-btn:hover:not(:disabled) { background: rgba(255,94,0,0.1); color: #ff7a2e; }
        .coupon-apply-btn:disabled { opacity: 0.45; cursor: not-allowed; }
        .coupon-apply-btn.applied { color: #4ade80; }

        /* ── Coupon Result ── */
        .coupon-result {
            text-align: center;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.82rem;
            margin-bottom: 6px;
            min-height: 20px;
            letter-spacing: 0.01em;
        }
        .coupon-result.success { color: #4ade80; }
        .coupon-result.error   { color: #ff6b6b; }

        /* ── Strike-through original price when sale active ── */
        .price-original {
            font-size: 1rem;
            color: rgba(255,255,255,0.38);
            text-decoration: line-through;
            margin-right: 6px;
            font-family: 'DM Sans', sans-serif;
        }
        .price-row { position: relative; }

        .price-coupon-original {
            font-size: 1.1rem;
            color: rgba(255,255,255,0.35);
            font-family: 'DM Sans', sans-serif;
            margin-right: 4px;
            display: inline-block;
            position: relative;
        }
        .price-coupon-original::after {
            content: '';
            position: absolute;
            left: -2px; right: -2px; top: 50%;
            height: 2px;
            background: #ff5e00;
            border-radius: 1px;
            transform: rotate(-6deg) translateY(-50%);
        }
        .price-coupon-new {
            color: #4ade80;
            font-family: 'Raleway', sans-serif;
            font-weight: 800;
            font-size: 3.8rem;
            line-height: 1;
            animation: coupon-pop 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
        }
        @keyframes coupon-pop {
            0%   { transform: scale(0.7) translateY(6px); opacity: 0; }
            100% { transform: scale(1)   translateY(0);   opacity: 1; }
        }
        .coupon-saving-tag {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(74,222,128,0.08);
            border: 1px solid rgba(74,222,128,0.2);
            color: #4ade80;
            border-radius: 8px;
            padding: 4px 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.75rem;
            font-weight: 600;
            margin-top: 6px;
            animation: coupon-pop 0.35s cubic-bezier(0.34,1.56,0.64,1) both;
            animation-delay: 0.05s;
            letter-spacing: 0.02em;
        }
        .coupon-saving-tag.bonus-tag {
            background: rgba(255,173,100,0.08);
            border-color: rgba(255,173,100,0.2);
            color: #ffad64;
        }
        .ds-doc-hint {
            font-size: 0.72rem;
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            color: rgba(255,255,255,0.35);
            letter-spacing: 0.02em;
            margin-left: 4px;
        }

        /* ═══════════════════════════════════════════
           TRUST STRIP — scrolling social proof bar
        ═══════════════════════════════════════════ */
        .trust-strip {
            width: 100%;
            overflow: hidden;
            border-top: 1px solid rgba(255,255,255,0.05);
            border-bottom: 1px solid rgba(255,255,255,0.05);
            background: rgba(255,255,255,0.015);
            padding: 12px 0;
            position: relative;
        }
        .trust-strip::before,
        .trust-strip::after {
            content: '';
            position: absolute;
            top: 0; bottom: 0;
            width: 80px;
            z-index: 2;
            pointer-events: none;
        }
        .trust-strip::before { left: 0; background: linear-gradient(to right, #001219, transparent); }
        .trust-strip::after  { right: 0; background: linear-gradient(to left,  #001219, transparent); }
        .trust-strip-track {
            display: flex;
            gap: 0;
            animation: trust-scroll 28s linear infinite;
            width: max-content;
        }
        .trust-strip-track:hover { animation-play-state: paused; }
        @keyframes trust-scroll {
            0%   { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        .trust-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0 32px;
            border-right: 1px solid rgba(255,255,255,0.07);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.82rem;
            color: rgba(255,255,255,0.52);
            white-space: nowrap;
            letter-spacing: 0.01em;
        }
        .trust-item svg { color: #ff7a30; flex-shrink: 0; }
        .trust-item strong { color: rgba(255,255,255,0.82); font-weight: 600; }

        /* ═══════════════════════════════════════════
           HERO REDESIGN
        ═══════════════════════════════════════════ */
        .hero-section-new {
            width: 100%;
            padding: 64px 6% 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 0;
        }
        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            background: rgba(255,94,0,0.09);
            border: 1px solid rgba(255,94,0,0.28);
            border-radius: 999px;
            padding: 5px 14px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.78rem;
            font-weight: 600;
            color: #ff9458;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            margin-bottom: 22px;
        }
        .hero-eyebrow-dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: #ff5e00;
            animation: pulse-dot 2s ease infinite;
        }
        @keyframes pulse-dot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(0.7); }
        }
        .hero-section-new h1 {
            font-size: clamp(2.4rem, 5vw, 3.8rem);
            font-family: 'Raleway', sans-serif;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -0.02em;
            margin-bottom: 18px;
        }
        .hero-section-new h1 .h1-accent {
            background: linear-gradient(135deg, #ff5e00, #ff9b45);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .hero-subtext-new {
            max-width: 600px;
            color: rgba(255,255,255,0.58);
            font-family: 'Saira', sans-serif;
            font-size: 1.05rem;
            line-height: 1.85;
            margin-bottom: 32px;
        }

        /* ── Razor-sharp guarantee badges under hero ── */
        .hero-badges {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 48px;
        }
        .hero-badge {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 8px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.78rem;
            font-weight: 500;
            color: rgba(255,255,255,0.55);
        }
        .hero-badge svg { color: #4ade80; }
        .hero-badge.orange svg { color: #ff9458; }

        /* ═══════════════════════════════════════════
           DS EXCHANGE STRIP (preserved, re-styled)
        ═══════════════════════════════════════════ */
        .ds-exchange-strip {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            padding: 22px 20px 18px;
            margin: 0 auto 8px;
            max-width: 520px;
            background: linear-gradient(135deg, rgba(255,94,0,0.07) 0%, rgba(255,140,0,0.04) 100%);
            border: 1px solid rgba(255,94,0,0.22);
            border-radius: 18px;
            position: relative;
            overflow: hidden;
        }
        .ds-exchange-strip::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at 50% 0%, rgba(255,94,0,0.09) 0%, transparent 70%);
            pointer-events: none;
        }
        .ds-exchange-inner { display: flex; align-items: center; gap: 16px; }
        .ds-exchange-pill {
            display: flex;
            align-items: center;
            gap: 7px;
            background: rgba(255,94,0,0.12);
            border: 1px solid rgba(255,94,0,0.3);
            border-radius: 40px;
            padding: 8px 18px 8px 12px;
            color: #ff7a2e;
            font-family: 'DM Sans', sans-serif;
        }
        .ds-access-pill {
            background: rgba(255,255,255,0.05);
            border-color: rgba(255,255,255,0.15);
            color: rgba(255,255,255,0.85);
        }
        .ds-pill-num {
            font-family: 'Raleway', sans-serif;
            font-weight: 800;
            font-size: 1.35rem;
            line-height: 1;
            letter-spacing: -0.02em;
        }
        .ds-pill-label { font-size: 0.82rem; font-weight: 600; letter-spacing: 0.03em; white-space: nowrap; }
        .ds-exchange-eq { display: flex; align-items: center; gap: 6px; color: rgba(255,255,255,0.25); }
        .ds-eq-line { width: 18px; height: 1px; background: rgba(255,255,255,0.15); border-radius: 1px; }
        .ds-eq-symbol { font-family: 'Raleway', sans-serif; font-weight: 700; font-size: 1.1rem; color: rgba(255,255,255,0.4); line-height: 1; }
        .ds-exchange-sub { font-family: 'DM Sans', sans-serif; font-size: 0.78rem; color: rgba(255,255,255,0.38); text-align: center; margin: 0; letter-spacing: 0.01em; line-height: 1.5; }

        /* ═══════════════════════════════════════════
           COUPON SECTION WRAPPER (clean card)
        ═══════════════════════════════════════════ */
        .coupon-section {
            max-width: 520px;
            margin: 0 auto 28px;
            padding: 0 5%;
            width: 100%;
        }
        .coupon-label {
            font-family: 'DM Sans', sans-serif;
            font-size: 0.75rem;
            font-weight: 600;
            color: rgba(255,255,255,0.3);
            letter-spacing: 0.06em;
            text-transform: uppercase;
            text-align: center;
            margin-bottom: 10px;
        }

        /* ═══════════════════════════════════════════
           PRICING LAYOUT — with comparison anchors
        ═══════════════════════════════════════════ */
        .pricing-wrapper {
            width: 100%;
            padding: 0 5% 40px;
        }
        .pricing-section-new {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            max-width: 1100px;
            margin: 0 auto;
        }

        /* Card base */
        .pricing-card {
            position: relative;
            border: 1px solid rgba(255,69,0,0.22);
            background: rgba(255,255,255,0.035);
            border-radius: 24px;
            padding: 32px 26px 28px;
            display: flex;
            flex-direction: column;
            gap: 0;
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            box-shadow: 0 18px 45px rgba(0,0,0,0.24);
            transition: 0.35s ease;
        }
        .pricing-card:hover {
            transform: translateY(-6px);
            border-color: rgba(255,69,0,0.45);
        }
        .pricing-card.popular {
            border: 1px solid rgba(255,115,0,0.55);
            box-shadow: 0 18px 50px rgba(255,94,0,0.15);
        }

        /* Popular badge */
        .popular-badge {
            position: absolute;
            top: -14px; right: 20px;
            background: linear-gradient(135deg, #ff5e00, #ff8c00);
            color: white;
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 0.72rem;
            font-family: 'DM Sans', sans-serif;
            font-weight: 700;
            letter-spacing: 0.04em;
        }

        /* Plan header */
        .plan-tag {
            color: rgba(255,140,80,0.9);
            font-family: 'DM Sans', sans-serif;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: 6px;
        }
        .pricing-card h2 {
            font-size: 1.75rem;
            font-family: 'Raleway', sans-serif;
            font-weight: 700;
            margin-bottom: 18px;
        }

        /* Price */
        .price-row {
            display: flex;
            align-items: flex-start;
            gap: 4px;
            margin-bottom: 4px;
        }
        .currency {
            color: orangered;
            font-size: 1.4rem;
            font-family: 'Saira', sans-serif;
            margin-top: 10px;
        }
        .price {
            color: white;
            font-size: 3.8rem;
            line-height: 1;
            font-family: 'Raleway', sans-serif;
            font-weight: 800;
        }
        .docscore-count {
            color: #ffb17a;
            font-size: 0.95rem;
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            margin-bottom: 20px;
        }

        /* Per-doc cost — trust signal */
        .per-doc-rate {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: rgba(255,94,0,0.07);
            border: 1px solid rgba(255,94,0,0.18);
            border-radius: 8px;
            padding: 4px 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            color: rgba(255,160,100,0.85);
            margin-bottom: 18px;
            letter-spacing: 0.02em;
        }
        .per-doc-rate.best-rate {
            background: rgba(74,222,128,0.06);
            border-color: rgba(74,222,128,0.2);
            color: #6ee7a3;
        }

        /* Feature list */
        .features {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin-bottom: 24px;
            flex: 1;
        }
        .feature {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            color: rgba(255,255,255,0.72);
            font-size: 0.9rem;
            line-height: 1.55;
            font-family: 'Saira', sans-serif;
        }
        .feature-check {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: rgba(74,222,128,0.1);
            border: 1px solid rgba(74,222,128,0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 2px;
        }
        .feature-check svg { color: #4ade80; }
        .popular .feature-check {
            background: rgba(255,94,0,0.1);
            border-color: rgba(255,94,0,0.3);
        }
        .popular .feature-check svg { color: #ff7a30; }

        /* Divider */
        .card-divider {
            width: 100%;
            height: 1px;
            background: rgba(255,255,255,0.06);
            margin-bottom: 20px;
        }

        /* CTA buttons */
        .buy-btn {
            width: 100%;
            height: 52px;
            border: 1px solid rgba(255,69,0,0.55);
            background: transparent;
            color: #ff7a30;
            border-radius: 16px;
            cursor: pointer;
            font-size: 0.95rem;
            font-family: 'DM Sans', sans-serif;
            font-weight: 600;
            transition: 0.3s ease;
            letter-spacing: 0.02em;
        }
        .buy-btn:hover { background: rgba(255,94,0,0.08); color: #ff9458; }
        .featured-btn {
            background: linear-gradient(135deg, #ff5e00, #ff8c00);
            color: white;
            border: none;
            box-shadow: 0 8px 24px rgba(255,94,0,0.3);
        }
        .featured-btn:hover { opacity: 0.9; transform: scale(1.01); box-shadow: 0 12px 32px rgba(255,94,0,0.4); }

        /* Payment trust note under each CTA */
        .card-trust-note {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            margin-top: 10px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.71rem;
            color: rgba(255,255,255,0.28);
            letter-spacing: 0.01em;
        }
        .card-trust-note svg { color: rgba(255,255,255,0.28); }

        /* ═══════════════════════════════════════════
           CUSTOM TRIGGER
        ═══════════════════════════════════════════ */
        .custom-trigger-section {
            width: 100%;
            padding: 0 5% 24px;
            max-width: 1100px;
            margin: 0 auto;
            box-sizing: border-box;
        }
        .custom-trigger-btn {
            width: 100%;
            min-height: 64px;
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 0 24px;
            background: rgba(255,255,255,0.025);
            border: 1px dashed rgba(255,106,0,0.28);
            border-radius: 18px;
            cursor: pointer;
            color: rgba(255,255,255,0.6);
            font-family: 'Saira', sans-serif;
            font-size: 1rem;
            transition: 0.25s ease;
            text-align: left;
        }
        .custom-trigger-btn:hover {
            background: rgba(255,106,0,0.05);
            border-color: rgba(255,106,0,0.5);
            color: white;
        }
        .custom-trigger-icon {
            width: 36px; height: 36px;
            border-radius: 50%;
            background: rgba(255,94,0,0.1);
            border: 1px solid rgba(255,94,0,0.22);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ff7a30;
            flex-shrink: 0;
        }
        .custom-trigger-sub {
            margin-left: auto;
            font-size: 0.85rem;
            color: #ff7a2e;
            font-family: 'DM Sans', sans-serif;
        }

        /* ═══════════════════════════════════════════
           TRUST PROOF SECTION — big companies do this
        ═══════════════════════════════════════════ */
        .trust-proof-section {
            width: 100%;
            padding: 0 5% 40px;
        }
        .trust-proof-inner {
            max-width: 1100px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        /* Security & Payment card */
        .trust-block {
            background: rgba(255,255,255,0.025);
            border: 1px solid rgba(255,255,255,0.07);
            border-radius: 20px;
            padding: 28px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .trust-block-header {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .trust-block-icon {
            width: 42px; height: 42px;
            border-radius: 12px;
            background: rgba(255,94,0,0.1);
            border: 1px solid rgba(255,94,0,0.22);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ff7a30;
            flex-shrink: 0;
        }
        .trust-block-title {
            font-family: 'Raleway', sans-serif;
            font-size: 1.1rem;
            font-weight: 700;
            color: white;
        }
        .trust-block-desc {
            font-family: 'Saira', sans-serif;
            font-size: 0.9rem;
            color: rgba(255,255,255,0.55);
            line-height: 1.7;
        }
        .trust-payment-logos {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 4px;
        }
        .payment-logo-pill {
            display: flex;
            align-items: center;
            gap: 5px;
            padding: 6px 12px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            font-family: 'DM Sans', sans-serif;
            font-size: 0.76rem;
            font-weight: 700;
