<script>
/* ── FAQ ACCORDION ─────────────────────────────────────────── */
document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
        const item = btn.closest('.faq-item');
        const isOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
        if (!isOpen) item.classList.add('open');
    });
});

/* ── COUPON LOGIC ──────────────────────────────────────────── */
let appliedCoupon = null;

const couponInput    = document.getElementById("coupon-input");
const couponApplyBtn = document.getElementById("coupon-apply-btn");
const couponResult   = document.getElementById("coupon-result");

async function applyCoupon() {
    const code = couponInput.value.trim().toUpperCase();
    if (!code) { showCouponResult("Please enter a coupon code.", "error"); return; }
    couponApplyBtn.disabled = true;
    couponApplyBtn.textContent = "Checking…";
    couponResult.className = "coupon-result";
    couponResult.textContent = "";
    try {
        const res  = await fetch("/coupon/validate", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ code, context: "recharge" }) });
        const data = await res.json();
        if (data.valid) {
            appliedCoupon = { code, ...data };
            showCouponResult("✓ " + data.message, "success");
            updateCouponPrices(appliedCoupon);
            couponApplyBtn.textContent = "✓ Applied";
            couponApplyBtn.classList.add("applied");
        } else {
            appliedCoupon = null;
            showCouponResult(data.reason || "Invalid coupon.", "error");
            resetCouponPrices();
            couponApplyBtn.textContent = "Apply";
            couponApplyBtn.classList.remove("applied");
        }
    } catch (err) {
        appliedCoupon = null;
        showCouponResult("Could not validate coupon. Try again.", "error");
        resetCouponPrices();
        couponApplyBtn.textContent = "Apply";
        couponApplyBtn.classList.remove("applied");
    } finally { couponApplyBtn.disabled = false; }
}

function updateCouponPrices(coupon) {
    resetCouponPrices();
    if (coupon.type !== "flat" || !coupon.flat_discount) {
        document.querySelectorAll(".recharge-btn").forEach(btn => {
            const priceEl = document.getElementById("price-" + btn.dataset.plan);
            if (!priceEl) return;
            const tag = document.createElement("div");
            tag.className = "coupon-saving-tag bonus-tag coupon-injected";
            tag.textContent = "＋" + coupon.docscore_bonus + " Bonus DocScore on purchase";
            priceEl.closest(".price-row").after(tag);
        });
        return;
    }
    document.querySelectorAll(".recharge-btn").forEach(btn => {
        const plan = btn.dataset.plan;
        const priceEl = document.getElementById("price-" + plan);
        if (!priceEl) return;
        const priceRow = priceEl.closest(".price-row");
        if (!priceRow) return;
        const trueOriginal = parseInt(btn.dataset.original, 10);
        if (!trueOriginal) return;
        const discounted = Math.max(1, trueOriginal - coupon.flat_discount);
        const saving     = trueOriginal - discounted;
        priceRow.querySelectorAll("span").forEach(s => { s.dataset.couponHidden = "1"; s.style.display = "none"; });
        const strikeEl = document.createElement("span");
        strikeEl.className = "price-coupon-original coupon-injected";
        strikeEl.textContent = "₹" + trueOriginal;
        const newWrap = document.createElement("span");
        newWrap.className = "coupon-injected";
        newWrap.style.cssText = "display:flex;align-items:flex-start;gap:0";
        newWrap.innerHTML = '<span class="price-coupon-new">₹' + discounted + '</span>';
        priceRow.appendChild(strikeEl);
        priceRow.appendChild(newWrap);
        if (saving > 0) {
            const tag = document.createElement("div");
            tag.className = "coupon-saving-tag coupon-injected";
            tag.textContent = "Save ₹" + saving;
            priceRow.after(tag);
        }
    });
}

function resetCouponPrices() {
    document.querySelectorAll(".coupon-injected").forEach(e => e.remove());
    document.querySelectorAll(".price-row span[data-coupon-hidden]").forEach(s => { s.style.display = ""; delete s.dataset.couponHidden; });
}
function showCouponResult(msg, type) { couponResult.textContent = msg; couponResult.className = "coupon-result " + type; }
couponApplyBtn.addEventListener("click", () => applyCoupon());
couponInput.addEventListener("keydown", e => {
    if (e.key === "Enter") { applyCoupon(); return; }
    if (appliedCoupon) {
        appliedCoupon = null;
        couponApplyBtn.textContent = "Apply";
        couponApplyBtn.classList.remove("applied");
        couponResult.className = "coupon-result";
        couponResult.textContent = "";
        resetCouponPrices();
    }
});

/* ── RECHARGE BUTTONS ──────────────────────────────────────── */
const buttons = document.querySelectorAll(".recharge-btn");
buttons.forEach((btn) => {
    btn.addEventListener("click", async () => {
        const originalText = btn.innerText;
        try {
            btn.disabled = true;
            btn.innerText = "Please wait...";
            const plan       = btn.dataset.plan;
            const baseAmount = parseInt(btn.dataset.base, 10) || 0;
            if (appliedCoupon && appliedCoupon.code) {
                const recheck = await fetch("/coupon/validate", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ code: appliedCoupon.code, context: "recharge", baseAmount }) });
                const recheckData = await recheck.json();
                if (!recheckData.valid) {
                    showCouponResult(recheckData.reason || "Coupon no longer valid.", "error");
                    appliedCoupon = null;
                    couponApplyBtn.textContent = "Apply";
                    btn.disabled = false;
                    btn.innerText = originalText;
                    return;
                }
                appliedCoupon = { ...appliedCoupon, ...recheckData };
            }
            const response = await fetch("/buy-recharge", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ plan, couponCode: appliedCoupon ? appliedCoupon.code : null }) });
            const data = await response.json();
            if (!data.success) { alert(data.message || "Could not start payment"); btn.disabled = false; btn.innerText = originalText; return; }
            const description = data.bonusDocscore ? `DocScore Recharge + ${data.bonusDocscore} Bonus DocScore` : "DocScore Recharge";
            const options = {
                key: data.key, amount: data.amount, currency: data.currency,
                name: "DocUp", description, order_id: data.orderId,
                prefill: { email: data.userEmail }, theme: { color: "#ff5e00" },
                handler: async function (paymentResponse) {
                    try {
                        const verifyRes = await fetch("/payment/verify", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(paymentResponse) });
                        const verifyData = await verifyRes.json();
                        if (verifyData.success) { window.location.href = verifyData.redirectUrl; }
                        else { btn.disabled = false; btn.innerText = originalText; alert(verifyData.message || "Payment verification failed"); }
                    } catch (err) { console.error(err); btn.disabled = false; btn.innerText = originalText; alert("Payment verification failed"); }
                },
                modal: { ondismiss: function () { btn.disabled = false; btn.innerText = originalText; } }
            };
            const rzp = new Razorpay(options);
            rzp.on("payment.failed", function () { btn.disabled = false; btn.innerText = originalText; alert("Payment failed. Please try again."); });
            rzp.open();
        } catch (err) { console.error(err); alert("Something went wrong"); btn.disabled = false; btn.innerText = originalText; }
    });
});

/* ── CUSTOM RECHARGE OVERLAY ───────────────────────────────── */
const RATE = 1;
const overlay   = document.getElementById("cr-overlay");
const backdrop  = document.getElementById("cr-backdrop");
const closeBtn  = document.getElementById("cr-close");
const openBtn   = document.getElementById("open-custom-modal");
const slider    = document.getElementById("cr-slider");
const amountNum = document.getElementById("cr-amount-num");
const scoreNum  = document.getElementById("cr-score-num");
const btnAmount = document.getElementById("cr-btn-amount");
const payBtn    = document.getElementById("cr-pay-btn");
const chips     = document.querySelectorAll(".cr-chip");

function syncSliderFill(val) {
    const pct = ((val - 20) / (500 - 20)) * 100;
    slider.style.background = `linear-gradient(to right,#ff5e00 ${pct}%,rgba(255,255,255,0.1) ${pct}%)`;
}
function updateUI(val) {
    val = Math.max(20, Math.min(500, Math.round(val / 2) * 2));
    slider.value = val;
    amountNum.textContent = val;
    scoreNum.textContent  = Math.floor(val / RATE);
    btnAmount.textContent = val;
    syncSliderFill(val);
}
slider.addEventListener("input", () => updateUI(+slider.value));
chips.forEach(chip => {
    chip.addEventListener("click", () => {
        chips.forEach(c => c.classList.remove("active"));
        chip.classList.add("active");
        updateUI(+chip.dataset.val);
    });
});
function openModal()  { overlay.classList.add("active");    document.body.style.overflow = "hidden"; }
function closeModal() { overlay.classList.remove("active"); document.body.style.overflow = "";       }
openBtn.addEventListener("click", openModal);
closeBtn.addEventListener("click", closeModal);
backdrop.addEventListener("click", closeModal);
document.addEventListener("keydown", e => { if (e.key === "Escape") closeModal(); });
updateUI(100);

payBtn.addEventListener("click", async () => {
    const amount = Math.max(20, Math.min(500, Math.round(+slider.value / 2) * 2));
    const orig = payBtn.innerHTML;
    payBtn.disabled = true;
    payBtn.textContent = "Please wait…";
    try {
        const res  = await fetch("/buy-recharge", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ plan: "custom", customAmount: amount }) });
        const data = await res.json();
        if (!data.success) { alert(data.message || "Could not start payment"); payBtn.disabled = false; payBtn.innerHTML = orig; return; }
        const options = {
            key: data.key, amount: data.amount, currency: data.currency,
            name: "DocUp", description: `Custom DocScore — ${data.docscoreToAdd} pts`,
            order_id: data.orderId, prefill: { email: data.userEmail }, theme: { color: "#ff5e00" },
            handler: async function (pr) {
                try {
                    const vr = await fetch("/payment/verify", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(pr) });
                    const vd = await vr.json();
                    if (vd.success) { window.location.href = vd.redirectUrl; }
                    else { payBtn.disabled = false; payBtn.innerHTML = orig; alert(vd.message || "Verification failed"); }
                } catch (err) { payBtn.disabled = false; payBtn.innerHTML = orig; }
            },
            modal: { ondismiss: () => { payBtn.disabled = false; payBtn.innerHTML = orig; } }
        };
        const rzp = new Razorpay(options);
        rzp.on("payment.failed", () => { payBtn.disabled = false; payBtn.innerHTML = orig; });
        rzp.open();
    } catch (err) { alert("Something went wrong"); payBtn.disabled = false; payBtn.innerHTML = orig; }
});
</script>

<%- include('partials/page-loader') %>
</body>
