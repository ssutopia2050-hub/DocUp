<script src="/doc_ai.js"></script>
<script>
(function () {
    /* ── toast using existing docup-popup ───────────────────── */
    function showToast(msg, type) {
        const popup   = document.getElementById("docup-popup");
        const title   = document.getElementById("docup-popup-title");
        const message = document.getElementById("docup-popup-message");
        const ok      = document.getElementById("docup-popup-ok");
        if (!popup) return;
        if (title)   title.textContent   = type === "error" ? "Oops!" : "DocUp";
        if (message) message.textContent = msg;
        popup.classList.add("active");
        ok?.addEventListener("click", () => popup.classList.remove("active"), { once: true });
    }

    async function postJSON(url) {
        const res = await fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" }
        });
        return res.json();
    }

    /* ── LIKE ───────────────────────────────────────────────── */
    const likeBtn = document.getElementById("like-btn");
    likeBtn?.addEventListener("click", async () => {
        const docId = likeBtn.dataset.docId;
        likeBtn.disabled = true;
        try {
            const data = await postJSON(`/api/like/${docId}`);
            if (data.success) {
                document.getElementById("like-count").textContent    = data.likes;
                document.getElementById("dislike-count").textContent = data.dislikes;
                likeBtn.classList.add("active");
                if (data.alreadyLiked) showToast("You already liked this document.");
            } else {
                showToast(data.message || "Could not like. Try again.", "error");
            }
        } catch {
            showToast("Network error. Try again.", "error");
        } finally {
            likeBtn.disabled = false;
        }
    });

    /* ── DISLIKE ────────────────────────────────────────────── */
    const dislikeBtn = document.getElementById("dislike-btn");
    dislikeBtn?.addEventListener("click", async () => {
        const docId = dislikeBtn.dataset.docId;
        dislikeBtn.disabled = true;
        try {
            const data = await postJSON(`/api/dislike/${docId}`);
            if (data.success) {
                document.getElementById("like-count").textContent    = data.likes;
                document.getElementById("dislike-count").textContent = data.dislikes;
                dislikeBtn.classList.add("active");
                if (data.alreadyDisliked) showToast("You already disliked this document.");
            } else {
                showToast(data.message || "Could not dislike. Try again.", "error");
            }
        } catch {
            showToast("Network error. Try again.", "error");
        } finally {
            dislikeBtn.disabled = false;
        }
    });

    /* ── SAVE ───────────────────────────────────────────────── */
    const saveBtn = document.getElementById("save-btn");
    saveBtn?.addEventListener("click", async () => {
        const docId = saveBtn.dataset.docId;
        saveBtn.disabled = true;
        try {
            const data = await postJSON(`/api/save/${docId}`);
            if (data.success) {
                const label = document.getElementById("save-btn-label");
                if (data.alreadySaved) {
                    showToast("Already in your saved docs!");
                    saveBtn.disabled = false;
                } else {
                    if (label) label.textContent = "Saved ✓";
                    saveBtn.classList.add("active");
                }
            } else {
                showToast(data.message || "Could not save. Try again.", "error");
                saveBtn.disabled = false;
            }
        } catch {
            showToast("Network error. Try again.", "error");
            saveBtn.disabled = false;
        }
    });

    /* ── COMMENT ────────────────────────────────────────────── */
    const commentInput     = document.querySelector(".comment-input-container");
    const commentSendBtn   = document.querySelector(".comment-send-btn");
    const commentsList     = document.getElementById("comments-list");
    const commentCountChip = document.getElementById("comment-count-chip");

    async function submitComment() {
        const docId = "<%= doc._id %>";
        const text  = commentInput?.value?.trim();
        if (!text) return;

        commentSendBtn.disabled = true;
        commentInput.disabled   = true;

        try {
            const res = await fetch(`/add_comment/${docId}`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ comment: text })
            });
            const data = await res.json();

            if (data.success) {
                commentInput.value = "";

                // Remove "no comments yet" placeholder if present
                const empty = commentsList?.querySelector(".cmt-empty");
                if (empty) empty.remove();

                // Build new comment card and prepend it
                const now = new Date().toLocaleString();
                const div = document.createElement("div");
                div.className = "cmt";
                div.innerHTML = `
                    <div class="cmt-avatar">
                        <img src="<%= user.avatar_img_path ? user.avatar_img_path : '/images/default-avatar.png' %>" alt="avatar">
                    </div>
                    <div class="cmt-body">
                        <div class="cmt-top">
                            <span class="cmt-name"><%= user.name || 'DocUp User' %></span>
                            <span class="cmt-time">${now}</span>
                        </div>
                        <p class="cmt-text">${text.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")}</p>
                    </div>`;
                commentsList?.prepend(div);

                // Bump count chip
                if (commentCountChip) {
                    const current = parseInt(commentCountChip.textContent, 10) || 0;
                    commentCountChip.textContent = current + 1;
                }
            } else {
                showToast(data.message || "Could not post comment.", "error");
            }
        } catch {
            showToast("Network error. Try again.", "error");
        } finally {
            commentSendBtn.disabled = false;
            commentInput.disabled   = false;
            commentInput.focus();
        }
    }

    commentSendBtn?.addEventListener("click", submitComment);
    commentInput?.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) {
            e.preventDefault();
            submitComment();
        }
    });
})();
</script>

<script>
    // Scroll to top
    const scrollBtn = document.getElementById("scrollTopBtn");
    window.addEventListener("scroll", () => {
        scrollBtn.classList.toggle("visible", window.scrollY > 400);
    });
    scrollBtn.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));

    // PDF URL
    const pdfUrl = "<%= doc.file_url %>";

    // Expose pdfDoc globally so thumbnail sidebar and zen mode can access it
    // We patch pdfjsLib.getDocument to intercept the loaded PDF
    (function patchPdfjs() {
        const origGetDocument = pdfjsLib.getDocument.bind(pdfjsLib);
        pdfjsLib.getDocument = function (...args) {
            const task = origGetDocument(...args);
            task.promise.then(pdf => {
                window.__pdfDoc = pdf;
                // Notify thumbnail sidebar if it's already open
                if (window.__thumbSidebar && pdf) {
                    const countEl = document.getElementById('thumb-page-count');
                    if (countEl) countEl.textContent = pdf.numPages + ' pages';
                    const sidebar = document.getElementById('thumb-sidebar');
                    if (sidebar && sidebar.classList.contains('thumb-sidebar--open')) {
                        window.__thumbSidebar.renderAllThumbnails(pdf);
                    }
                }
            }).catch(() => {});
            return task;
        };
    })();

    // Back/forward cache
    window.addEventListener("pageshow", e => { if (e.persisted) window.location.reload(); });
    window.addEventListener("popstate", () => window.location.reload());

    // Mouse tracking
    document.addEventListener("mousemove", e => {
        document.documentElement.style.setProperty("--mx", `${e.clientX}px`);
        document.documentElement.style.setProperty("--my", `${e.clientY}px`);
    });
</script>

<script>
    document.addEventListener("contextmenu", e => {
        e.preventDefault();
        showDocupPopup("Action Blocked", "Printing, saving, and right-click actions are disabled for this page on DocUp");
    });

    document.addEventListener("keydown", e => {
        const ctrl = e.ctrlKey || e.metaKey;
        const key = e.key.toLowerCase();

        const blockedBrowserShortcuts =
            (ctrl && ["s", "p", "u"].includes(key)) ||
            (ctrl && e.shiftKey && key === "i") ||
            e.key === "F12";

        const screenshotShortcuts =
            (e.metaKey && e.shiftKey && (key === "3" || key === "4")) ||
            (e.ctrlKey && e.shiftKey && key === "s") ||
            (key === "printscreen");

        if (blockedBrowserShortcuts) {
            e.preventDefault();
            showDocupPopup("Action Blocked", "Printing, saving, and developer shortcuts are disabled on DocUp.");
            return;
        }

        if (screenshotShortcuts) {
            e.preventDefault();
            showDocupPopup("Screenshot Shortcut Detected", "System screenshot shortcuts cannot be fully blocked on web pages.");
        }
    });


</script>
