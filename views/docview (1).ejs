<script>
    const docupPopup = document.getElementById("docup-popup");
    const docupPopupTitle = document.getElementById("docup-popup-title");
    const docupPopupMessage = document.getElementById("docup-popup-message");
    const docupPopupClose = document.getElementById("docup-popup-close");
    const docupPopupOk = document.getElementById("docup-popup-ok");

    function showDocupPopup(title, message) {
        docupPopupTitle.textContent = title || "Notice";
        docupPopupMessage.textContent = message || "This action is disabled on DocUp.";
        docupPopup.classList.add("active");
        document.body.classList.add("report-modal-open");
    }

    function hideDocupPopup() {
        docupPopup.classList.remove("active");
        document.body.classList.remove("report-modal-open");
    }

    docupPopupClose?.addEventListener("click", hideDocupPopup);
    docupPopupOk?.addEventListener("click", hideDocupPopup);

    docupPopup?.addEventListener("click", (e) => {
        if (e.target === docupPopup) hideDocupPopup();
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && docupPopup.classList.contains("active")) {
            hideDocupPopup();
        }
    });
</script>

