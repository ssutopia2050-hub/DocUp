<script>
    const DOCUP_THEMES = ["theme-dark", "theme-light", "theme-sepia", "theme-contrast"];
    const THEME_LABELS = {
        "theme-dark": "Midnight",
        "theme-light": "Light",
        "theme-sepia": "Paper",
        "theme-contrast": "Contrast"
    };

    const themeMenu = document.getElementById("theme-menu");
    const themeMenuBtn = document.getElementById("theme-menu-btn");
    const themePopover = document.getElementById("theme-popover");
    const themeCurrentChip = document.getElementById("theme-current-chip");
    const themeSwatches = document.querySelectorAll(".theme-swatch");
    const readingModeBtn = document.getElementById("reading-mode-btn");
    const readingModeText = document.getElementById("reading-mode-text");
    const themeTransitionOverlay = document.getElementById("theme-transition-overlay");

    function setThemeClasses(themeName) {
        document.body.classList.remove(...DOCUP_THEMES);
        document.body.classList.add(themeName);
        document.body.classList.toggle("light-mode", themeName !== "theme-dark");
    }

    function syncThemeUi(themeName) {
        const themeLabel = THEME_LABELS[themeName] || "Theme";

        if (themeCurrentChip) {
            themeCurrentChip.textContent = themeLabel;
        }

        themeSwatches.forEach((btn) => {
            const active = btn.dataset.theme === themeName;
            btn.classList.toggle("active", active);
            btn.setAttribute("aria-pressed", active ? "true" : "false");
        });
    }

    function animateThemeTransition(callback) {
        if (!themeTransitionOverlay) {
            callback();
            return;
        }

        themeTransitionOverlay.classList.remove("animate");
        void themeTransitionOverlay.offsetWidth;
        themeTransitionOverlay.classList.add("animate");

        callback();

        window.setTimeout(() => {
            themeTransitionOverlay.classList.remove("animate");
        }, 520);
    }

    function applyTheme(themeName, options = {}) {
        const { persist = true, animated = false } = options;

        const run = () => {
            setThemeClasses(themeName);
            syncThemeUi(themeName);

            if (persist) {
                localStorage.setItem("docup-theme", themeName);
            }
        };

        if (animated) {
            animateThemeTransition(run);
        } else {
            run();
        }
    }

    function closeThemePopover() {
        themePopover?.classList.remove("active");
        themeMenuBtn?.setAttribute("aria-expanded", "false");
    }

    function positionThemePopover() {
        if (!themePopover || !themeMenuBtn) return;

        themePopover.classList.remove("shift-left", "shift-right");

        const rect = themePopover.getBoundingClientRect();
        const gap = 14;

        if (rect.right > window.innerWidth - gap) {
            themePopover.classList.add("shift-right");
        }

        if (rect.left < gap) {
            themePopover.classList.remove("shift-right");
            themePopover.classList.add("shift-left");
        }
    }
    window.addEventListener("resize", () => {
        if (themePopover?.classList.contains("active")) {
            positionThemePopover();
        }
    });

    function openThemePopover() {
        if (!themePopover) return;

        themePopover.classList.add("active");
        themeMenuBtn?.setAttribute("aria-expanded", "true");

        requestAnimationFrame(() => {
            positionThemePopover();
        });
    }

    function updateReadingModeUi() {
        const active = document.body.classList.contains("reading-mode");
        readingModeBtn?.classList.toggle("active", active);

        if (readingModeText) {
            readingModeText.textContent = active ? "Exit Reading" : "Reading Mode";
        }
    }

    function enableReadingMode() {
        document.body.classList.add("reading-mode");
        localStorage.setItem("docup-reading-mode", "true");
        updateReadingModeUi();
    }

    function disableReadingMode() {
        document.body.classList.remove("reading-mode");
        localStorage.setItem("docup-reading-mode", "false");
        updateReadingModeUi();
    }

    function toggleReadingMode() {
        if (document.body.classList.contains("reading-mode")) {
            disableReadingMode();
        } else {
            enableReadingMode();
        }
    }

    (function initDocThemes() {
        const savedTheme = localStorage.getItem("docup-theme") || "theme-dark";
        applyTheme(savedTheme, { persist: false, animated: false });

        if (localStorage.getItem("docup-reading-mode") === "true") {
            document.body.classList.add("reading-mode");
        }

        updateReadingModeUi();
    })();

    themeMenuBtn?.addEventListener("click", (event) => {
        event.stopPropagation();

        if (themePopover?.classList.contains("active")) {
            closeThemePopover();
        } else {
            openThemePopover();
        }
    });

    themeSwatches.forEach((btn) => {
        btn.addEventListener("click", () => {
            const selectedTheme = btn.dataset.theme;
            applyTheme(selectedTheme, { persist: true, animated: true });
            closeThemePopover();
        });
    });

    readingModeBtn?.addEventListener("click", () => {
        toggleReadingMode();
        closeThemePopover();
    });

    document.addEventListener("click", (event) => {
        if (!themeMenu?.contains(event.target)) {
            closeThemePopover();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            closeThemePopover();
        }
    });
</script>
<script>
    const shareDocToggle = document.getElementById("share-doc-toggle");
    const shareDocDropdown = document.getElementById("share-doc-dropdown");
    const shareDocLinkInput = document.getElementById("share-doc-link-input");
    const copyShareDocLinkBtn = document.getElementById("copy-share-doc-link");
    const copyToast = document.getElementById("copy-toast");

    let copyToastTimer;

    function closeShareDocDropdown() {
        shareDocDropdown?.classList.remove("active");
    }

    function showCopyToast(message = "Link copied!") {
        if (!copyToast) return;

        copyToast.textContent = message;
        copyToast.classList.add("show");

        clearTimeout(copyToastTimer);
        copyToastTimer = setTimeout(() => {
            copyToast.classList.remove("show");
        }, 1600);
    }

    function setCopiedState() {
        if (!copyShareDocLinkBtn) return;

        copyShareDocLinkBtn.textContent = "Copied!";
        copyShareDocLinkBtn.classList.add("copied");

        setTimeout(() => {
            copyShareDocLinkBtn.textContent = "Copy Link";
            copyShareDocLinkBtn.classList.remove("copied");
        }, 1400);
    }

    shareDocToggle?.addEventListener("click", (event) => {
        event.stopPropagation();
        shareDocDropdown?.classList.toggle("active");
    });

    copyShareDocLinkBtn?.addEventListener("click", async () => {
        const link = shareDocLinkInput?.value || "";
        if (!link) return;

        try {
            await navigator.clipboard.writeText(link);
            setCopiedState();
            showCopyToast("Link copied!");
        } catch (err) {
            try {
                shareDocLinkInput.focus();
                shareDocLinkInput.select();
                document.execCommand("copy");
                setCopiedState();
                showCopyToast("Link copied!");
            } catch (fallbackErr) {
                showCopyToast("Copy failed");
            }
        }
    });

    document.addEventListener("click", (event) => {
        if (!event.target.closest(".share-doc-wrap")) {
            closeShareDocDropdown();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            closeShareDocDropdown();
        }
    });
</script>
<script>
/* ═══════════════════════════════════════════════
   PAGE THUMBNAIL SIDEBAR  (Apple Preview style)
═══════════════════════════════════════════════ */
(function () {
    const thumbToggleBtn = document.getElementById('thumb-toggle-btn');
    const thumbSidebar   = document.getElementById('thumb-sidebar');
    const thumbList      = document.getElementById('thumb-list');
    const thumbPageCount = document.getElementById('thumb-page-count');
    const workspace      = document.getElementById('main-workspace');

    let thumbsRendered = false;
    let sidebarOpen    = false;

    // Track current visible page from the main viewer
    let currentVisiblePage = 1;

    function openThumbSidebar() {
        sidebarOpen = true;
        thumbSidebar.classList.add('thumb-sidebar--open');
        workspace.classList.add('workspace--thumb-open');
        thumbToggleBtn.setAttribute('aria-expanded', 'true');
        thumbToggleBtn.classList.add('active');
        localStorage.setItem('docup-thumb-sidebar', 'open');

        if (!thumbsRendered && window.__pdfDoc) {
            renderAllThumbnails(window.__pdfDoc);
        }
    }

    function closeThumbSidebar() {
        sidebarOpen = false;
        thumbSidebar.classList.remove('thumb-sidebar--open');
        workspace.classList.remove('workspace--thumb-open');
        thumbToggleBtn.setAttribute('aria-expanded', 'false');
        thumbToggleBtn.classList.remove('active');
        localStorage.setItem('docup-thumb-sidebar', 'closed');
    }

    function toggleThumbSidebar() {
        if (sidebarOpen) closeThumbSidebar();
        else openThumbSidebar();
    }

    thumbToggleBtn?.addEventListener('click', toggleThumbSidebar);

    // Restore state
    if (localStorage.getItem('docup-thumb-sidebar') === 'open') {
        openThumbSidebar();
    }

    // Render thumbnails once PDF is loaded
    async function renderAllThumbnails(pdfDoc) {
        if (thumbsRendered) return;
        thumbsRendered = true;

        const total = pdfDoc.numPages;
        thumbPageCount.textContent = total + (total === 1 ? ' page' : ' pages');

        for (let i = 1; i <= total; i++) {
            const item = document.createElement('div');
            item.className = 'thumb-item';
            item.dataset.page = i;
            item.title = 'Go to page ' + i;
            item.setAttribute('role', 'button');
            item.setAttribute('tabindex', '0');

            const canvasWrap = document.createElement('div');
            canvasWrap.className = 'thumb-canvas-wrap';

            const canvas = document.createElement('canvas');
            canvas.className = 'thumb-canvas';
            canvasWrap.appendChild(canvas);

            const label = document.createElement('span');
            label.className = 'thumb-label';
            label.textContent = i;

            item.appendChild(canvasWrap);
            item.appendChild(label);
            thumbList.appendChild(item);

            // Render thumbnail in background
            pdfDoc.getPage(i).then(page => {
                const viewport = page.getViewport({ scale: 0.22 });
                canvas.width  = viewport.width;
                canvas.height = viewport.height;
                const ctx = canvas.getContext('2d');
                page.render({ canvasContext: ctx, viewport });
            });

            // Click to jump
            item.addEventListener('click', () => jumpToPage(i));
            item.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); jumpToPage(i); } });
        }

        // Highlight initial page
        highlightThumb(currentVisiblePage);
    }

    function jumpToPage(pageNum) {
        // Use the main viewer's page jump
        const input = document.getElementById('page-jump-input');
        if (input) {
            input.value = pageNum;
            input.dispatchEvent(new Event('change'));
        }
        // Scroll the main pdf container to that page
        const pageDivs = document.querySelectorAll('.pdf-page-wrap');
        if (pageDivs[pageNum - 1]) {
            pageDivs[pageNum - 1].scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        highlightThumb(pageNum);
    }

    function highlightThumb(pageNum) {
        currentVisiblePage = pageNum;
        document.querySelectorAll('.thumb-item').forEach(el => {
            el.classList.toggle('thumb-item--active', parseInt(el.dataset.page) === pageNum);
        });
        // scroll thumb into view inside sidebar
        const activeThumb = thumbList.querySelector('.thumb-item--active');
        if (activeThumb) {
            activeThumb.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
    }

    // Listen for page changes from the main reader
    // The existing viewer updates #current-page-number — we watch it
    const pageNumEl = document.getElementById('current-page-number');
    if (pageNumEl) {
        const obs = new MutationObserver(() => {
            const p = parseInt(pageNumEl.textContent);
            if (p && p !== currentVisiblePage) highlightThumb(p);
        });
        obs.observe(pageNumEl, { childList: true, characterData: true, subtree: true });
    }

    // Also sync when page-jump input changes
    document.getElementById('page-jump-input')?.addEventListener('change', function () {
        const p = parseInt(this.value);
        if (p) setTimeout(() => highlightThumb(p), 120);
    });

    // Hook into PDF load — wait for window.__pdfDoc to be set
    const pdfReadyInterval = setInterval(() => {
        if (window.__pdfDoc) {
            clearInterval(pdfReadyInterval);
            thumbPageCount.textContent = window.__pdfDoc.numPages + ' pages';
            if (sidebarOpen) renderAllThumbnails(window.__pdfDoc);
            // Also render on first open even if sidebar isn't open yet
        }
    }, 300);

    // Expose to global so other scripts can trigger thumbnail render
    window.__thumbSidebar = { renderAllThumbnails, highlightThumb, open: openThumbSidebar, close: closeThumbSidebar };
})();
</script>

<script>
/* ═══════════════════════════════════════════════
   ZEN MODE  —  distraction-free, anti-download
═══════════════════════════════════════════════ */
(function () {
    const zenOverlay     = document.getElementById('zen-overlay');
    const zenContainer   = document.getElementById('zen-pdf-container');
    const zenCurrentPage = document.getElementById('zen-current-page');
    const zenTotalPages  = document.getElementById('zen-total-pages');
    const zenZoomLabel   = document.getElementById('zen-zoom-label');
    const zenHint        = document.getElementById('zen-hint');
    const zenModeBtn     = document.getElementById('zen-mode-btn');
    const zenExitBtn     = document.getElementById('zen-exit-btn');
    const zenPrevBtn     = document.getElementById('zen-prev-btn');
    const zenNextBtn     = document.getElementById('zen-next-btn');
    const zenZoomIn      = document.getElementById('zen-zoom-in');
    const zenZoomOut     = document.getElementById('zen-zoom-out');

    let zenPdf        = null;
    let zenTotalCount = 0;
    let zenPage       = 1;
    let zenScale      = 1.0;
    let zenRendering  = false;
    let zenHintTimer  = null;
    let zenActive     = false;

    /* ─── Render a single page into zen canvas ─── */
    async function zenRenderPage(num) {
        if (!zenPdf || zenRendering) return;
        zenRendering = true;

        zenContainer.innerHTML = '';

        const page     = await zenPdf.getPage(num);
        const vp0      = page.getViewport({ scale: 1 });
        const availW   = zenOverlay.clientWidth  * 0.90;
        const availH   = (zenOverlay.clientHeight - 80) * 0.96;
        const autoScale = Math.min(availW / vp0.width, availH / vp0.height);
        const finalScale = autoScale * zenScale;

        const viewport = page.getViewport({ scale: finalScale });

        const wrap = document.createElement('div');
        wrap.className = 'zen-page-wrap';
        wrap.style.cssText = `
            position:relative; display:inline-block;
            border-radius:10px; overflow:hidden;
            box-shadow: 0 24px 64px rgba(0,0,0,0.6);
        `;

        const canvas = document.createElement('canvas');
        canvas.width  = viewport.width;
        canvas.height = viewport.height;
        canvas.style.cssText = 'display:block; border-radius:10px;';

        /* Anti-download hardening: no pointer events, no drag, no right-click */
        canvas.style.pointerEvents = 'none';
        canvas.draggable = false;
        canvas.oncontextmenu = e => e.preventDefault();

        await page.render({ canvasContext: canvas.getContext('2d'), viewport }).promise;

        /* Watermark overlay inside zen */
        const wm = document.createElement('div');
        wm.setAttribute('aria-hidden', 'true');
        wm.style.cssText = `
            position:absolute; inset:0; pointer-events:none; z-index:10;
            display:flex; align-items:center; justify-content:center;
        `;
        const wmText = document.createElement('span');
        wmText.textContent = 'DocUp \u2022 Private View';
        wmText.style.cssText = `
            font-family:'DM Sans',sans-serif; font-size:clamp(11px,1.4vw,15px);
            color:rgba(255,100,0,0.18); transform:rotate(-32deg);
            white-space:nowrap; user-select:none; -webkit-user-select:none;
            letter-spacing:0.12em; font-weight:600;
        `;
        wm.appendChild(wmText);

        wrap.appendChild(canvas);
        wrap.appendChild(wm);
        zenContainer.appendChild(wrap);

        zenCurrentPage.textContent = num;
        if (window.__thumbSidebar) window.__thumbSidebar.highlightThumb(num);
        zenRendering = false;
    }

    function zenSetPage(n) {
        const clamped = Math.max(1, Math.min(n, zenTotalCount));
        zenPage = clamped;
        zenRenderPage(clamped);
    }

    /* ─── Open zen mode ─── */
    async function openZen() {
        if (!window.__pdfDoc) {
            alert('Please wait for the PDF to finish loading.');
            return;
        }
        zenPdf        = window.__pdfDoc;
        zenTotalCount = zenPdf.numPages;
        zenTotalPages.textContent = zenTotalCount;

        // Start from whatever page the main reader is on
        const mainPage = parseInt(document.getElementById('current-page-number')?.textContent || '1');
        zenPage = mainPage || 1;

        zenActive = true;
        zenOverlay.classList.add('zen-overlay--active');
        zenOverlay.setAttribute('aria-hidden', 'false');
        document.body.classList.add('zen-mode-active');

        await zenRenderPage(zenPage);

        // Show hint, then fade
        zenHint.classList.add('zen-hint--visible');
        clearTimeout(zenHintTimer);
        zenHintTimer = setTimeout(() => zenHint.classList.remove('zen-hint--visible'), 3200);
    }

    /* ─── Close zen mode ─── */
    function closeZen() {
        zenActive = false;
        zenOverlay.classList.remove('zen-overlay--active');
        zenOverlay.setAttribute('aria-hidden', 'true');
        document.body.classList.remove('zen-mode-active');
        zenContainer.innerHTML = '';
        clearTimeout(zenHintTimer);
    }

    /* ─── Controls ─── */
    zenModeBtn?.addEventListener('click', openZen);
    zenExitBtn?.addEventListener('click', closeZen);
    zenPrevBtn?.addEventListener('click', () => zenSetPage(zenPage - 1));
    zenNextBtn?.addEventListener('click', () => zenSetPage(zenPage + 1));

    zenZoomIn?.addEventListener('click', () => {
        zenScale = Math.min(zenScale + 0.15, 2.5);
        zenZoomLabel.textContent = Math.round(zenScale * 100) + '%';
        zenRenderPage(zenPage);
    });
    zenZoomOut?.addEventListener('click', () => {
        zenScale = Math.max(zenScale - 0.15, 0.4);
        zenZoomLabel.textContent = Math.round(zenScale * 100) + '%';
        zenRenderPage(zenPage);
    });

    /* ─── Keyboard ─── */
    document.addEventListener('keydown', e => {
        if (!zenActive) return;
        if (e.key === 'Escape')      closeZen();
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown')  { e.preventDefault(); zenSetPage(zenPage + 1); }
        if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')    { e.preventDefault(); zenSetPage(zenPage - 1); }
        if (e.key === '+' || e.key === '=')  { zenScale = Math.min(zenScale + 0.15, 2.5); zenZoomLabel.textContent = Math.round(zenScale*100)+'%'; zenRenderPage(zenPage); }
        if (e.key === '-')  { zenScale = Math.max(zenScale - 0.15, 0.4); zenZoomLabel.textContent = Math.round(zenScale*100)+'%'; zenRenderPage(zenPage); }
    });

    /* ─── Touch swipe in zen ─── */
    let touchStartX = 0;
    zenOverlay?.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
    zenOverlay?.addEventListener('touchend', e => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 50) {
            if (dx < 0) zenSetPage(zenPage + 1);
            else        zenSetPage(zenPage - 1);
        }
    });

    /* ─── Anti-download on the zen overlay itself ─── */
    zenOverlay?.addEventListener('contextmenu', e => e.preventDefault());
    zenOverlay?.addEventListener('dragstart',   e => e.preventDefault());

    /* ─── Resize: re-render current page ─── */
    let resizeTimer;
    window.addEventListener('resize', () => {
        if (!zenActive) return;
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => zenRenderPage(zenPage), 200);
    });
})();
</script>
<script src="/dashboard3.js"></script>
<script src="/docview.js"></script>
</body>
