<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/profile.css">
    <meta charset="UTF-8">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DocUp | Profile</title>
</head>
<body>

<%
const maxDocScore = 500;
const rawDocScore = Number(user.Doc_score || 0);
const safeDocScore = Math.max(0, Math.min(rawDocScore, maxDocScore));
const safeDisplayDocScore = Math.max(0, rawDocScore);
const progressDeg = (safeDocScore / maxDocScore) * 360;

let ringColor1 = "#ff6a00";
let ringColor2 = "#ff9b45";
let scoreStatus = "Healthy";

if (safeDocScore <= 100) {
ringColor1 = "#ff3b30";
ringColor2 = "#ff6b6b";
scoreStatus = "Low";
} else if (safeDocScore <= 250) {
ringColor1 = "#ff9500";
ringColor2 = "#ffb74d";
scoreStatus = "Medium";
} else {
ringColor1 = "#00c853";
ringColor2 = "#69f0ae";
scoreStatus = "Healthy";
}

const savedCount = Array.isArray(user.saved_documents) ? user.saved_documents.length : 0;
const uploadCount = Array.isArray(user.uploads) ? user.uploads.length : 0;
const viewHistoryCount = Array.isArray(user.doc_view_history) ? user.doc_view_history.length : 0;
const paymentCount = Array.isArray(user.payment_history) ? user.payment_history.length : 0;
const savedProfileCount = Array.isArray(savedProfilesData) ? savedProfilesData.length : 0;

function profileInitials(name) {
if (!name) return "U";
return name.trim().charAt(0).toUpperCase();
}

function buildDocTitle(doc) {
if (!doc) return "Document";
if (doc.chapter && doc.subject) return doc.chapter + " , " + doc.subject;
if (doc.chapter) return doc.chapter;
if (doc.subject) return doc.subject;
return "Document";
}

%>

<header class="topbar">
    <div class="topbar-left">
        <a href="/dashboard" class="logo-wordmark">DocUp</a>

        <!--        <div class="topbar-divider"></div>-->

        <!--        <span class="topbar-breadcrumb">-->
        <!--            <a href="/dashboard">Dashboard</a>-->
        <!--            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">-->
        <!--                <path d="M4.5 2.5L7.5 6L4.5 9.5"-->
        <!--                      stroke="currentColor"-->
        <!--                      stroke-width="1.4"-->
        <!--                      stroke-linecap="round"-->
        <!--                      stroke-linejoin="round"/>-->
        <!--            </svg>-->
        <!--            <span class="breadcrumb-current">FindDocs</span>-->
        <!--        </span>-->
    </div>

    <div class="topbar-right">

        <!-- FindDocs -->
        <a href="/dashboard" class="topbar-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none">
                <path d="M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"/>
            </svg>
            <span>FindDocs</span>
        </a>

        <!-- DocScore -->
        <div class="docscore-pill">
            <span class="docscore-label">DocScore</span>
            <span class="docscore-value"><%= user.Doc_score %></span>
            <img src="/fire.png" alt="">
        </div>

        <!-- Upload -->
        <a href="/uploads" class="topbar-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none">
                <path d="M12 16V4M12 4l-4 4M12 4l4 4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"/>
                <path d="M5 18.5h14"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"/>
            </svg>
            <span>Upload</span>
        </a>

        <!-- Notifications -->
        <div class="notification-wrap">
            <button type="button" class="icon-btn notification-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M9 17H15M6.5 17H17.5C16.9 16.35 16.5 15.48 16.5 14.5V10.5C16.5 8.01 14.49 6 12 6C9.51 6 7.5 8.01 7.5 10.5V14.5C7.5 15.48 7.1 16.35 6.5 17Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>
                    <path d="M10.5 20C10.74 20.62 11.32 21 12 21C12.68 21 13.26 20.62 13.5 20"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>
                </svg>

                <% const unreadCount = (user.notifications || []).filter(n => !n.isRead).length; %>
                <% if (unreadCount > 0) { %>
                <span class="notif-badge"><%= unreadCount > 9 ? "9+" : unreadCount %></span>
                <% } %>
            </button>

            <div style="background: #000407" class="notification-dropdown">
                <div class="nd-header">
                    <span class="nd-title">Notifications</span>
                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <a href="/notifications" class="nd-view-all">View all</a>
                    <% } %>
                </div>

                <div class="nd-list">
                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <% user.notifications.slice().reverse().forEach((item) => { %>
                    <div class="nd-item <%= item.isRead ? '' : 'unread' %>">
                        <div class="nd-item-row">
                            <span class="nd-dot"></span>
                            <span class="nd-when">
                                <%= item.createdAt
                                    ? new Date(item.createdAt).toLocaleString("en-IN", {
                                        dateStyle: "medium",
                                        timeStyle: "short"
                                    })
                                    : "Just now" %>
                            </span>
                        </div>
                        <p class="nd-text"><%= item.content %></p>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="nd-empty">No notifications yet.</div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Avatar -->
        <div class="avatar-btn">
            <% if (user.avatar_img_path) { %>
            <img src="<%= user.avatar_img_path %>" alt="">
            <% } else { %>
            <%= user.name ? user.name.charAt(0).toUpperCase() : "U" %>
            <% } %>
        </div>

    </div>
</header>

<!-- Avatar Dropdown -->
<div class="avatar-dropdown">
    <a href="/profile">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"/>
        </svg>
        Profile
    </a>

    <a href="/pricing">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"/>
        </svg>
        Recharge DocScore
    </a>
    <a href="/upgrade-plans">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                  stroke-width="1.6"/>
        </svg>
        Upgrade Plans
    </a>
</div>
<div class="profile-page">

    <div class="left-section">

        <div class="profile-container glass-card">
            <div class="profile-header">
                <div class="avatar <%= user.avatar_img_path ? 'has-image' : '' %>">
                    <% if (user.avatar_img_path) { %>
                    <img src="<%= user.avatar_img_path %>" alt="avatar">
                    <% } else { %>
                    <%= user.name ? user.name.charAt(0).toUpperCase() : "U" %>
                    <% } %>
                </div>
                <div class="avatar-container">
                </div>

                <div class="profile-main-info">
                    <h1><%= user.name || "User" %></h1>
                    <p class="email-text"><%= user.email || "No Email" %></p>

                    <div class="badge-row">
                        <span class="profile-badge orange-badge"><%= user.subscription || "Free Tier" %></span>
                        <span class="profile-badge neutral-badge"><%= user.user_type || "DocUp Member" %></span>
                    </div>
                </div>
            </div>

            <div class="divider"></div>

            <div class="info-grid">
                <div class="info-box">
                    <span class="info-label">Full Name</span>
                    <span class="info-value"><%= user.name || "Not Available" %></span>
                </div>

                <div class="info-box">
                    <span class="info-label">Email Address</span>
                    <span class="info-value"><%= user.email || "Not Available" %></span>
                </div>

                <div class="info-box">
                    <span class="info-label">Subscription</span>
                    <a href="/upgrade-plans"><span class="info-value"><%= user.subscription || "Free Tier" %></span></a>
                </div>

                <div class="info-box">
                    <span class="info-label">Doc Score</span>
                    <span class="info-value"><%= safeDocScore %> / <%= maxDocScore %></span>
                </div>

                <div class="info-box">
                    <span class="info-label">Saved Documents</span>
                    <span class="info-value"><%= savedCount %></span>
                </div>

                <div class="info-box">
                    <span class="info-label">Total Uploads</span>
                    <span class="info-value"><%= uploadCount %></span>
                </div>
            </div>

            <div class="action-row">
                <a href="/dashboard" class="action-btn primary-btn">Explore Documents</a>

                <% if ((user.user_type === 'DocUp Admin') || (user.user_type === 'DocUp Developer')) { %>
                <a  href="/dev/signin" class="action-btn secondary-btn">DocUp Developer's Portal</a>
                <% }  %>
                <a href="/all_uploads_view_second_pov_profile/<%= user._id %>" class="action-btn secondary-btn">View All your Uploads</a>
                <a style="border-color:rgba(255,0,0,0.32)" href="/logout" class="action-btn secondary-btn">Logout</a>

            </div>
        </div>
        <div class="view-history-card glass-card">
            <div class="section-header">
                <h2>Recently Viewed</h2>
                <span class="mini-tag"><%= viewHistoryCount %> Viewed</span>
            </div>

            <% if (viewHistoryCount > 0) { %>
            <div class="view-history-list">
                <% user.doc_view_history.slice(0, 5).forEach(doc => { %>
                <div class="view-history-item">
                    <div class="view-history-left">
                        <div class="view-history-icon">↗</div>
                        <div class="view-history-info">
                            <p class="view-history-title"><%= buildDocTitle(doc) %></p>
                            <p class="view-history-meta"><%= (doc && doc.college) || "Unknown College" %></p>
                        </div>
                    </div>
                    <div class="doc-action-group">
                        <% if (doc && doc.reviewed) { %>
                        <span class="review-badge verified-badge">Verified</span>
                        <% } else { %>
                        <span class="review-badge pending-badge">To be Reviewed</span>
                        <% } %>

                        <% if (doc && doc._id) { %>
                        <a href="/view/<%= doc._id %>" class="view-history-btn">View</a>
                        <% } else { %>
                        <span class="disabled-upload-btn">Unavailable</span>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } else { %>
            <div class="empty-state">
                <p>No viewed documents yet.</p>
                <a href="/dashboard" class="empty-btn">Start Exploring</a>
            </div>
            <% } %>
        </div>
        <div class="saved-docs-card glass-card">
            <div class="section-header">
                <h2>Saved Documents</h2>
                <span class="mini-tag"><%= savedCount %> Saved</span>
            </div>

            <% if (savedCount > 0) { %>
            <div class="saved-docs-list">
                <% user.saved_documents.forEach(doc => { %>
                <div class="saved-doc-item">
                    <div class="saved-doc-left">
                        <div class="saved-doc-icon">★</div>
                        <div class="saved-doc-info">
                            <p class="saved-doc-title"><%= buildDocTitle(doc) %></p>
                            <p class="saved-doc-meta"><%= (doc && doc.college) || "Unknown College" %></p>
                        </div>
                    </div>

                    <div class="doc-action-group">
                        <% if (doc && doc.reviewed) { %>
                        <span class="review-badge verified-badge">Verified</span>
                        <% } else { %>
                        <span class="review-badge pending-badge">To be Reviewed</span>
                        <% } %>

                        <% if (doc && doc._id) { %>
                        <a href="/view/<%= doc._id %>" class="view-history-btn">View</a>
                        <% } else { %>
                        <span class="disabled-upload-btn">Unavailable</span>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } else { %>
            <div class="empty-state">
                <p>No saved documents yet.</p>
                <a href="/dashboard" class="empty-btn">Find Documents</a>
            </div>
            <% } %>
        </div>
        <div class="recent-uploads-card glass-card">
            <div class="section-header">
                <h2>Recent Uploads</h2>
                <span class="mini-tag"><%= uploadCount %> Uploads</span>
            </div>

            <% if (uploadCount > 0) { %>
            <div class="uploads-list">
                <% user.uploads.slice().reverse().forEach(upload => { %>
                <div class="upload-item">
                    <div class="upload-left">
                        <div class="upload-icon">↑</div>
                        <div class="upload-details">
                            <p class="upload-subject"><%= upload.chapter || upload.subject || "Uploaded Document" %></p>
                            <p class="upload-meta">
                                <%= upload.college || "Unknown College" %>
                                <% if (upload.uploadedAt) { %>
                                • <%= new Date(upload.uploadedAt).toLocaleDateString() %>
                                <% } %>
                            </p>
                        </div>
                    </div>

                    <div class="doc-action-group">
                        <% if (upload && upload.doc_id && upload.doc_id.reviewed) { %>
                        <span class="review-badge verified-badge">Verified</span>
                        <% } else { %>
                        <span class="review-badge pending-badge">To be Reviewed</span>
                        <% } %>

                        <% if (upload.doc_id && upload.doc_id._id) { %>
                        <a href="/view/<%= upload.doc_id._id %>" class="open-upload-btn">Open</a>
                        <% } else { %>
                        <span class="disabled-upload-btn">Unavailable</span>
                        <% } %>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } else { %>
            <div class="empty-state">
                <p>No uploads yet.</p>
                <a href="/uploads" class="empty-btn">Upload First File</a>
            </div>
            <% } %>
        </div>





        <div class="payment-history-card glass-card">
            <div class="section-header">
                <h2>Payment History</h2>
                <span class="mini-tag"><%= paymentCount %> Payments</span>
            </div>

            <% if (paymentCount > 0) { %>
            <div class="payment-history-list">
                <% user.payment_history.slice(0, 5).forEach(payment => { %>
                <div class="payment-item">
                    <div class="payment-left">
                        <div class="payment-icon">₹</div>

                        <div class="payment-details">
                            <p class="payment-plan"><%= payment.plan || "Recharge" %></p>
                            <p class="payment-meta">
                                +<%= payment.docscore_added || 0 %> DocScore
                                • ₹<%= payment.amount || 0 %>
                                <% if (payment.date) { %>
                                • <%= new Date(payment.date).toLocaleDateString() %>
                                <% } %>
                            </p>

                            <% if (payment.order_id || payment.payment_id) { %>
                            <p class="payment-id">
                                <% if (payment.order_id) { %>
                                Order: <%= payment.order_id %>
                                <% } %>
                                <% if (payment.order_id && payment.payment_id) { %>
                                •
                                <% } %>
                                <% if (payment.payment_id) { %>
                                Payment: <%= payment.payment_id %>
                                <% } %>
                            </p>
                            <% } %>
                        </div>
                    </div>

                    <div class="payment-status <%= (payment.status || '').toLowerCase() %>">
                        <%= payment.status || "SUCCESS" %>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } else { %>
            <div class="empty-state">
                <p>No payments yet.</p>
                <a href="/pricing" class="empty-btn">Recharge Now</a>
            </div>
            <% } %>
        </div>
    </div>


    <div class="right-section">

        <div class="doc-score-display-container glass-card">
            <div class="score-top">
                <p class="small-heading">Your Doc Score</p>
<!--                <h2><%= safeDocScore %>/<%= maxDocScore %></h2>-->
            </div>

            <div
                    class="score-ring"
                    style="background: conic-gradient(<%= ringColor1 %> 0deg, <%= ringColor2 %> <%= progressDeg %>deg, rgba(255,255,255,0.08) <%= progressDeg %>deg 360deg);"
            >
                <div class="score-ring-inner">
                    <span><%= safeDocScore %></span>
                </div>
            </div>

            <div class="score-status-wrap">
                <span class="score-status-label">Status</span>
                <span class="score-status-value"><%= scoreStatus %></span>
            </div>

            <p class="score-desc">
                Each time you open a protected document, 1 DocScore is used. Recharge or Upload documents to continue accessing more files without interruption.
            </p>

            <div class="score-action-row">
                <a href="/pricing" class="recharge-btn">Recharge DocScore</a>
                <a href="/upgrade-plans" class="upgrade-btn">Upgrade Plan</a>
            </div>
        </div>
        <div class="saved-profiles-card glass-card">
            <div class="section-header">
                <h2>Saved Profiles</h2>
                <span class="mini-tag"><%= savedProfileCount %> Saved</span>
            </div>

            <% if (savedProfileCount > 0) { %>
            <div class="saved-profiles-list">
                <% savedProfilesData.forEach(profile => { %>
                <div class="saved-profile-item">
                    <div class="saved-profile-top">
                        <div class="saved-profile-left">
                            <div class="saved-profile-avatar <%= profile.avatar_img_path ? 'has-image' : '' %>">
                                <% if (profile.avatar_img_path) { %>
                                <img src="<%= profile.avatar_img_path %>" alt="avatar">
                                <% } else { %>
                                <%= profileInitials(profile.name) %>
                                <% } %>
                            </div>

                            <div class="saved-profile-info">
                                <p class="saved-profile-name"><%= profile.name || "DocUp User" %></p>
                                <p class="saved-profile-email"><%= profile.email || "No Email" %></p>

                                <div class="saved-profile-badges">
                            <span class="saved-profile-badge orange-badge">
                                <%= profile.subscription || "Free Tier" %>
                            </span>
                                    <span class="saved-profile-badge neutral-badge">
                                <%= profile.user_type || "DocUp Member" %>
                            </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="saved-profile-stats-row">
                        <div class="saved-profile-mini-stat">
                            <span>Uploads</span>
                            <strong><%= Array.isArray(profile.uploads) ? profile.uploads.length : 0 %></strong>
                        </div>
                        <a href="/all_uploads_view_second_pov_profile/<%= profile._id %>" class="visit-profile-btn">
                            View Uploads
                        </a>
                        <a href="/show_other_user_profile/<%= encodeURIComponent(profile.email) %>" class="visit-profile-btn">
                            Visit Profile
                        </a>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } else { %>
            <div class="empty-state saved-profiles-empty">
                <p>No saved profiles yet.</p>
                <a href="/dashboard" class="empty-btn">Explore Contributors</a>
            </div>
            <% } %>
        </div>
        <div class="stats-card glass-card">
            <h2>Quick Stats</h2>

            <div class="stat-box">
                <div>
                    <p class="stat-title">Saved Docs</p>
                    <span class="stat-subtext">Your bookmarked documents</span>
                </div>
                <h3><%= savedCount %></h3>
            </div>

            <a href="/all_uploads_view_second_pov_profile/<%= user._id %>">
                <div class="stat-box">
                    <div>
                        <p class="stat-title">Uploads</p>
                        <span class="stat-subtext">Your contributions on DocUp</span>
                    </div>
                    <h3><%= uploadCount %></h3>
                </div>
            </a>

            <div class="stat-box">
                <div>
                    <p class="stat-title">Viewed Docs</p>
                    <span class="stat-subtext">Recently opened documents</span>
                </div>
                <h3><%= viewHistoryCount %></h3>
            </div>

            <a href="/upgrade-plans">
                <div class="stat-box">
                    <div>
                        <p class="stat-title">Subscription</p>
                        <span class="stat-subtext">Current account plan</span>
                    </div>
                    <h3 class="plan-text"><%= user.subscription || "Free Tier" %></h3>
                </div>
            </a>
        </div>

        <div class="membership-card glass-card">
            <h2>Membership</h2>
            <p class="membership-desc">
                Your current plan controls your access level on DocUp. Premium plans can later unlock higher limits, faster access, and DocScore benefits.
            </p>

            <div class="membership-plan-box">
                <span>Current Plan</span>
                <strong><%= user.subscription || "Free Tier" %></strong>
            </div>

            <a href="/upgrade-plans" class="upgrade-btn">Upgrade Plan</a>
        </div>

        <div class="tips-card glass-card">
            <h2>Profile Tips</h2>

            <div class="tips-list">
                <div class="tip-item">Upload organized notes regularly</div>
                <div class="tip-item">Save useful study resources</div>
                <div class="tip-item">Recharge before DocScore reaches zero</div>
            </div>
        </div>

    </div>

</div>

</body>
<script src="/dashboard2.js"></script>
<script src="/profile.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const viewLinks = document.querySelectorAll('a[href^="/view/"]');

        function resetViewLinks() {
            document.querySelectorAll('a[href^="/view/"]').forEach(link => {
                link.dataset.clicked = "false";
                link.style.pointerEvents = "";
                link.style.opacity = "";
            });
        }

        viewLinks.forEach(link => {
            link.addEventListener("click", function(e) {
                if (this.dataset.clicked === "true") {
                    e.preventDefault();
                    return;
                }

                this.dataset.clicked = "true";
                this.style.pointerEvents = "none";
                this.style.opacity = "0.6";

                setTimeout(() => {
                    if (!document.hidden) {
                        this.dataset.clicked = "false";
                        this.style.pointerEvents = "";
                        this.style.opacity = "";
                    }
                }, 3000);
            });
        });

        window.addEventListener("pageshow", resetViewLinks);
    });
</script>
</html>