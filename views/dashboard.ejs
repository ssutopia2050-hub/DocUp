<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/dashboard.css">
    <link rel="shortcut icon" href="/images/favicon-32x32.png" type="image/x-icon">
    <meta charset="UTF-8">
    <title>DocUp | Dashboard</title>
</head>
<body>
<header class="topbar">
    <div class="topbar-left">
        <a href="/dashboard" class="logo-wordmark">DocUp</a>

<!--        <div class="topbar-divider"></div>-->

<!--        <span class="topbar-breadcrumb">-->
<!--            <a href="/dashboard">Dashboard</a>-->
<!--            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">-->
<!--                <path d="M4.5 2.5L7.5 6L4.5 9.5"-->
<!--                      stroke="currentColor"-->
<!--                      stroke-width="1.4"-->
<!--                      stroke-linecap="round"-->
<!--                      stroke-linejoin="round"/>-->
<!--            </svg>-->
<!--            <span class="breadcrumb-current">FindDocs</span>-->
<!--        </span>-->
    </div>

    <div class="topbar-right">

        <!-- FindDocs -->
        <a href="/dashboard" class="topbar-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none">
                <path d="M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"/>
            </svg>
            <span>FindDocs</span>
        </a>

        <!-- DocScore -->
        <div class="docscore-pill">
            <span class="docscore-label">DocScore</span>
            <span class="docscore-value"><%= data.Doc_score %></span>
            <img src="/fire.png" alt="">
        </div>

        <!-- Upload -->
        <a href="/uploads" class="topbar-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none">
                <path d="M12 16V4M12 4l-4 4M12 4l4 4"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"/>
                <path d="M5 18.5h14"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"/>
            </svg>
            <span>Upload</span>
        </a>

        <!-- Notifications -->
        <div class="notification-wrap">
            <button type="button" class="icon-btn notification-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M9 17H15M6.5 17H17.5C16.9 16.35 16.5 15.48 16.5 14.5V10.5C16.5 8.01 14.49 6 12 6C9.51 6 7.5 8.01 7.5 10.5V14.5C7.5 15.48 7.1 16.35 6.5 17Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>
                    <path d="M10.5 20C10.74 20.62 11.32 21 12 21C12.68 21 13.26 20.62 13.5 20"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>
                </svg>

                <% const unreadCount = (data.notifications || []).filter(n => !n.isRead).length; %>
                <% if (unreadCount > 0) { %>
                <span class="notif-badge"><%= unreadCount > 9 ? "9+" : unreadCount %></span>
                <% } %>
            </button>

            <div class="notification-dropdown">
                <div class="nd-header">
                    <span class="nd-title">Notifications</span>
                    <% if (data.notifications && data.notifications.length > 0) { %>
                    <a href="/notifications" class="nd-view-all">View all</a>
                    <% } %>
                </div>

                <div class="nd-list">
                    <% if (data.notifications && data.notifications.length > 0) { %>
                    <% data.notifications.slice().reverse().forEach((item) => { %>
                    <div class="nd-item <%= item.isRead ? '' : 'unread' %>">
                        <div class="nd-item-row">
                            <span class="nd-dot"></span>
                            <span class="nd-when">
                                <%= item.createdAt
                                    ? new Date(item.createdAt).toLocaleString("en-IN", {
                                        dateStyle: "medium",
                                        timeStyle: "short"
                                    })
                                    : "Just now" %>
                            </span>
                        </div>
                        <p class="nd-text"><%= item.content %></p>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="nd-empty">No notifications yet.</div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Avatar -->
        <div class="avatar-btn">
            <% if (data.avatar_img_path) { %>
            <img src="<%= data.avatar_img_path %>" alt="">
            <% } else { %>
            <%= data.name ? data.name.charAt(0).toUpperCase() : "U" %>
            <% } %>
        </div>

    </div>
</header>

<!-- Avatar Dropdown -->
<div class="avatar-dropdown">
    <a href="/profile">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"/>
        </svg>
        Profile
    </a>

    <a href="/pricing">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"/>
        </svg>
        Recharge DocScore
    </a>
</div>
<div class="search-param-container">
    <form class="search-form">

        <div class="search-input-wrapper">
            <input
                    type="text"
                    placeholder="Search Docs . . ."
                    name="search_parameter_text"
                    id="search_parameter_text"
                    required
                    spellcheck="false"
                    autocomplete="off"
            >
            <span id="clear-search" style="
position:absolute;
right:15px;
top:50%;
transform:translateY(-50%);
cursor:pointer;
font-size:18px;
color:rgba(255,255,255,0.4);
display:none;
user-select:none;
">✕</span>
            <div id="college-suggestions" class="suggestions-box"></div>
        </div>

        <button type="submit" class="search-btn">Search</button>

        <div class="filter-wrapper">
            <button type="button" id="filter-toggle" class="filter-btn">
                <svg width="30px" height="30px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g id="SVGRepo_iconCarrier">
                        <path d="M4 5L10 5M10 5C10 6.10457 10.8954 7 12 7C13.1046 7 14 6.10457 14 5M10 5C10 3.89543 10.8954 3 12 3C13.1046 3 14 3.89543 14 5M14 5L20 5M4 12L16 12M16 12C16 13.1046 16.8954 14 18 14C19.1046 14 20 13.1046 20 12C20 10.8954 19.1046 10 18 10C16.8954 10 16 10.8954 16 12ZM8 19L20 19M8 19C8 17.8954 7.10457 17 6 17C4.89543 17 4 17.8954 4 19C4 20.1046 4.89543 21 6 21C7.10457 21 8 20.1046 8 19Z" stroke="#FF4500FF" stroke-width="1.5" stroke-linecap="round"></path>
                    </g>
                </svg>
            </button>

            <div id="filter-dropdown" class="filter-dropdown">
                <label>Year</label>
                <select name="year">
                    <option value="all">All Years</option>
                    <option value="year1">Year 1</option>
                    <option value="year2">Year 2</option>
                    <option value="year3">Year 3</option>
                    <option value="year4">Year 4</option>
                </select>

                <label>Stream</label>
                <select name="stream" id="stream">
                    <option value="all">All Streams</option>
                    <option value="engineering">Engineering</option>
                    <option value="mbbs">MBBS</option>
                    <option value="bpharma">BPharma</option>
                    <option value="mba">MBA</option>
                    <option value="bba">BBA</option>
                    <option value="bcom">BCom</option>
                </select>

                <label>Branch</label>
                <select name="branch" id="branch">
                    <option value="all">All Branches</option>
                </select>
            </div>
        </div>
    </form>

</div>
<div id="search-suggestion-bar" class="search-suggestion-bar" style="display:none;">
    <span class="search-suggestion-label">Did you mean  :</span>
    <button type="button" id="search-suggestion-btn" class="search-suggestion-btn"></button>
</div>
<div class="college-results-strip" id="college-results-strip" style="display:none;">
    <div class="college-results-strip-inner" id="college-results-strip-inner"></div>
</div>
<div class="search-results-container" id="search-results-container">
    <div class="empty-results-state" id="empty-results-state">
        <div class="empty-results-glow"></div>

        <p class="empty-results-label">Find smarter with DocUp</p>
        <h2 STYLE="font-family: 'DM Sans',sans-serif">Search notes, PYQs, docs and semester material</h2>
<!--        <p class="empty-results-subtext">-->
<!--            Use smart tags to search faster and get cleaner results.-->
<!--        </p>-->
        <p class="empty-results-subtext">
            New Docs are being added every second on DocUp . . .
        </p>

        <div class="search-shortcuts">
            <div class="shortcut-chip"><span style="font-family: Saira, sans-serif;color:orangered">/c</span> College Name</div>
            <div class="shortcut-chip"><span style="font-family: Saira, sans-serif;color:orangered">/s</span> Subject Name</div>
            <div class="shortcut-chip"><span style="font-family: Saira, sans-serif;color:orangered">/ch</span> Chapter Name</div>
        </div>

        <div class="empty-preview-grid">
            <div class="preview-card">
                <span class="preview-card-top">College</span>
                <p>University of Petroleum and Energy Studies</p>
            </div>
            <div class="preview-card">
                <span class="preview-card-top">Subject</span>
                <p>Advanced Engineering Mathematics</p>
            </div>
            <div class="preview-card">
                <span class="preview-card-top">Chapter</span>
                <p>Cloud Computing</p>
            </div>
        </div>
    </div>
</div>
<div id="upload-loader" class="upload-loader-overlay" aria-hidden="true">
    <div class="upload-loader-box" role="dialog" aria-modal="true" aria-labelledby="docscore-overlay-title">
        <button type="button" class="upload-loader-close" id="docscore-overlay-close" aria-label="Close overlay">
            ×
        </button>

        <div class="upload-loader-icon">
            <img src="/fire.png" alt="DocScore">
        </div>

        <p id="docscore-overlay-title" class="upload-loader-title">Insufficient DocScore</p>
        <p class="upload-loader-subtext">
            You need at least <span>1 DocScore</span> to view this document.
            Recharge your DocScore or upload a valid document to increase it by <span>+1</span>.
        </p>

        <div class="upload-loader-actions">
            <a class="overlay-cta overlay-cta-primary" href="/pricing">Recharge DocScore</a>
            <a class="overlay-cta overlay-cta-secondary" href="/uploads">Upload a Document</a>
        </div>
    </div>
</div>
<div class="footer">
    <div style="font-family: 'Archivo Black',sans-serif;display: flex;flex-direction: row;justify-content: flex-end;align-items: flex-end" class="footer-left">
        DocUp
        <a href="/version_report" style="font-size: 0.8rem ; color:rgba(255,255,255,0.22)">v<%= process.env.VERSION %></a>
    </div>
    <div class="footer-right">
        <a href="/dashboard">FindDocs</a>
        <a href="/uploads">Upload</a>
        <a href="/profile">Profile</a>
        <a href="/contact">ContactUs</a>
        <a href="/privacy_policy">Privacy Policy</a>
        <a href="/logout">Logout</a>
    </div>
</div>
</body>
<script src="/dashboard2.js"></script>
<script src="/dashboard.js"></script>
<script id="colleges-data" type="application/json">
    <%- JSON.stringify(colleges || []) %>
</script>

<script id="college-specific-data" type="application/json">
    <%- JSON.stringify(college_specific_data || []) %>
</script>

<script>
    const msg = <%- JSON.stringify(msg || null) %>;

    const homeBtn = document.querySelector(".logo-wordmark");
    if (homeBtn) {
        homeBtn.addEventListener("click", () => {
            window.location.href = "/dashboard";
        });
    }

    const overlay = document.getElementById("upload-loader");
    const box = document.querySelector(".upload-loader-box");
    const closeBtn = document.getElementById("docscore-overlay-close");

    function openDocscoreOverlay() {
        if (!overlay) return;
        overlay.classList.add("active");
        overlay.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
    }

    function closeDocscoreOverlay() {
        if (!overlay) return;
        overlay.classList.remove("active");
        overlay.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    }

    if (msg && msg.err === "Insufficient DocScore") {
        openDocscoreOverlay();
    }

    if (overlay && box) {
        overlay.addEventListener("click", function (e) {
            if (!box.contains(e.target)) {
                closeDocscoreOverlay();
            }
        });
    }

    if (closeBtn) {
        closeBtn.addEventListener("click", closeDocscoreOverlay);
    }

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay && overlay.classList.contains("active")) {
            closeDocscoreOverlay();
        }
    });

    const searchInput = document.getElementById("search_parameter_text");
    const clearBtn = document.getElementById("clear-search");

    if (searchInput && clearBtn) {
        searchInput.addEventListener("input", () => {
            clearBtn.style.display = searchInput.value.length ? "block" : "none";
        });

        clearBtn.addEventListener("click", () => {
            searchInput.value = "";
            clearBtn.style.display = "none";
            searchInput.focus();
        });
    }
</script>
</html>