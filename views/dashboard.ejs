<script>
    const msg = <%- JSON.stringify(msg || null) %>;

    const homeBtn = document.querySelector(".logo-wordmark");
    if (homeBtn) {
        homeBtn.addEventListener("click", () => {
            window.location.href = "/dashboard";
        });
    }

    const overlay = document.getElementById("upload-loader");
    const box = document.querySelector(".upload-loader-box");
    const closeBtn = document.getElementById("docscore-overlay-close");

    function openDocscoreOverlay() {
        if (!overlay) return;
        overlay.classList.add("active");
        overlay.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
    }

    function closeDocscoreOverlay() {
        if (!overlay) return;
        overlay.classList.remove("active");
        overlay.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    }

    if (msg && msg.err === "Insufficient DocScore") {
        // Clear any cached search state so restoreDashboardState() doesn't
        // overwrite the initial college grid with stale search results
        sessionStorage.removeItem("dashboardState");
        const requiredEl = document.getElementById("docscore-required");
        if (requiredEl && msg.requiredScore) {
            requiredEl.textContent = msg.requiredScore + " DocScore";
        }
        openDocscoreOverlay();
    }

    if (overlay && box) {
        overlay.addEventListener("click", function (e) {
            if (!box.contains(e.target)) {
                closeDocscoreOverlay();
            }
        });
    }

    if (closeBtn) {
        closeBtn.addEventListener("click", closeDocscoreOverlay);
    }

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay && overlay.classList.contains("active")) {
            closeDocscoreOverlay();
        }
    });

    const searchInput = document.getElementById("search_parameter_text");
    const clearBtn = document.getElementById("clear-search");

    if (searchInput && clearBtn) {
        searchInput.addEventListener("input", () => {
            clearBtn.style.display = searchInput.value.length ? "block" : "none";
        });

        clearBtn.addEventListener("click", () => {
            searchInput.value = "";
            clearBtn.style.display = "none";
            searchInput.focus();
        });
    }
</script>
