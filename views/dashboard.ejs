<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/dashboard.css">
    <link rel="shortcut icon" href="/images/favicon-32x32.png" type="image/x-icon">
    <meta charset="UTF-8">
    <title>DocUp | Dashboard</title>
</head>
<body>
<div class="topbar">
    <div class="logo-text-container">
        DocUp
    </div>
    <div class="pg-links">
        <a href="">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 2a8 8 0 105.293 14.293l4.707 4.707 1.414-1.414-4.707-4.707A8 8 0 0010 2zm0 2a6 6 0 110 12 6 6 0 010-12z"/>
            </svg>
            <span style="border-bottom:2px solid rgba(255,69,0,0.59);padding-bottom: 2px;">FindDocs</span>
        </a>

        <p style="border:1px solid orangered;
               padding:15px 25px;
               border-radius:30px;
               display:flex;
               gap:10px;
               align-items:center;
               white-space:nowrap;
               cursor:crosshair;">
            <span style="color:orangered">DocScore :</span>
            <span id="docscore-value" style="color:white"><%= data.Doc_score %></span>
            <img style="height:20px;" src="/fire.png" alt="">
        </p>

        <a href="/uploads">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M5 20h14v-2H5v2zM12 2l5 5h-3v6h-4V7H7l5-5z"/>
            </svg>
            Upload
        </a>

        <div class="profile-btn">
            <% if (data.avatar_img_path) { %>
            <img src="<%= data.avatar_img_path %>" alt="">
            <% } else { %>
            <%= data.name ? data.name.charAt(0).toUpperCase() : "U" %>
            <% } %>

        </div>
    </div>
</div>
<div class="profile-btn-dropdown">
    <a style="border-bottom:1px solid orangered;width:100%;display: flex;justify-content: center;align-items: center;padding-bottom:20px" href="/profile">Profile</a>
    <a href="/pricing">Recharge DocScore</a>
</div>
<div class="search-param-container">
    <form class="search-form">

        <div class="search-input-wrapper">
            <input
                    type="text"
                    placeholder="Search Docs . . ."
                    name="search_parameter_text"
                    id="search_parameter_text"
                    required
                    spellcheck="false"
                    autocomplete="off"
            >
            <span id="clear-search" style="
position:absolute;
right:15px;
top:50%;
transform:translateY(-50%);
cursor:pointer;
font-size:18px;
color:rgba(255,255,255,0.4);
display:none;
user-select:none;
">✕</span>
            <div id="college-suggestions" class="suggestions-box"></div>
        </div>

        <button type="submit" class="search-btn">Search</button>

        <div class="filter-wrapper">
            <button type="button" id="filter-toggle" class="filter-btn">
                <svg width="30px" height="30px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g id="SVGRepo_iconCarrier">
                        <path d="M4 5L10 5M10 5C10 6.10457 10.8954 7 12 7C13.1046 7 14 6.10457 14 5M10 5C10 3.89543 10.8954 3 12 3C13.1046 3 14 3.89543 14 5M14 5L20 5M4 12L16 12M16 12C16 13.1046 16.8954 14 18 14C19.1046 14 20 13.1046 20 12C20 10.8954 19.1046 10 18 10C16.8954 10 16 10.8954 16 12ZM8 19L20 19M8 19C8 17.8954 7.10457 17 6 17C4.89543 17 4 17.8954 4 19C4 20.1046 4.89543 21 6 21C7.10457 21 8 20.1046 8 19Z" stroke="#FF4500FF" stroke-width="1.5" stroke-linecap="round"></path>
                    </g>
                </svg>
            </button>

            <div id="filter-dropdown" class="filter-dropdown">
                <label>Year</label>
                <select name="year">
                    <option value="all">All Years</option>
                    <option value="year1">Year 1</option>
                    <option value="year2">Year 2</option>
                    <option value="year3">Year 3</option>
                    <option value="year4">Year 4</option>
                </select>

                <label>Stream</label>
                <select name="stream" id="stream">
                    <option value="all">All Streams</option>
                    <option value="engineering">Engineering</option>
                    <option value="mbbs">MBBS</option>
                    <option value="bpharma">BPharma</option>
                    <option value="mba">MBA</option>
                    <option value="bba">BBA</option>
                    <option value="bcom">BCom</option>
                </select>

                <label>Branch</label>
                <select name="branch" id="branch">
                    <option value="all">All Branches</option>
                </select>
            </div>
        </div>
    </form>
</div>
<div class="college-results-strip" id="college-results-strip" style="display:none;">
    <div class="college-results-strip-inner" id="college-results-strip-inner"></div>
</div>
<div class="search-results-container" id="search-results-container">
    <div class="empty-results-state" id="empty-results-state">
        <div class="empty-results-glow"></div>

        <p class="empty-results-label">Find smarter with DocUp</p>
        <h2>Search notes, PYQs, docs and semester material</h2>
        <p class="empty-results-subtext">
            Use smart tags to search faster and get cleaner results.
        </p>

        <div class="search-shortcuts">
            <div class="shortcut-chip"><span style="font-family: Saira, sans-serif;color:orangered">/c</span> College Name</div>
            <div class="shortcut-chip"><span style="font-family: Saira, sans-serif;color:orangered">/s</span> Subject Name</div>
            <div class="shortcut-chip"><span style="font-family: Saira, sans-serif;color:orangered">/ch</span> Chapter Name</div>
        </div>

        <div class="empty-preview-grid">
            <div class="preview-card">
                <span class="preview-card-top">College</span>
                <p>University of Petroleum and Energy Studies</p>
            </div>
            <div class="preview-card">
                <span class="preview-card-top">Subject</span>
                <p>Advanced Engineering Mathematics</p>
            </div>
            <div class="preview-card">
                <span class="preview-card-top">Chapter</span>
                <p>Cloud Computing</p>
            </div>
        </div>
    </div>
</div>
<div id="upload-loader" class="upload-loader-overlay">
    <div class="upload-loader-box">
        <p style="color:orangered;font-size: 1.5rem">Insufficient DocScore</p>
        <a class="overlay-anchor-tags" style="color:#457b9d;font-family:Saira, sans-serif" href="/pricing">Buy DocScores or</a>
        <a class="overlay-anchor-tags" style="color:#457b9d;font-family:Saira, sans-serif" href="/uploads">Upload a Valid Document</a>
    </div>
</div>
<div class="footer">
    <div style="display: flex;flex-direction: row;justify-content: flex-end;align-items: flex-end" class="footer-left">
        DocUp
        <a href="/version_report" style="font-size: 0.8rem ; color:rgba(255,255,255,0.22)">v<%= process.env.VERSION %></a>
    </div>
    <div class="footer-right">
        <a href="/dashboard">FindDocs</a>
        <a href="/uploads">Upload</a>
        <a href="/profile">Profile</a>
        <a href="/contact">ContactUs</a>
        <a href="/privacy_policy">Privacy Policy</a>
        <a href="/logout">Logout</a>
    </div>
</div>
</body>
<script src="/dashboard2.js"></script>
<script src="/dashboard.js"></script>
<script id="colleges-data" type="application/json">
    <%- JSON.stringify(colleges || []) %>
</script>

<script id="college-specific-data" type="application/json">
    <%- JSON.stringify(college_specific_data || []) %>
</script>

<script>
    const msg = <%- JSON.stringify(msg || null) %>;
    const homeBtn  = document.querySelector(".logo-text-container");
    homeBtn.addEventListener("click", () => {
        window.location.href="/dashboard";
    })
    if (msg && msg.err) {
        const overlay = document.getElementById("upload-loader");
        if (overlay) {
            overlay.style.display = "flex";
        }
    }
    const overlay = document.getElementById("upload-loader");
    const box = document.querySelector(".upload-loader-box");

    overlay.addEventListener("click", function (e) {

        // if clicked element is NOT inside the box → close overlay
        if (!box.contains(e.target)) {
            overlay.style.display = "none";
        }

    });
    const searchInput = document.getElementById("search_parameter_text");
    const clearBtn = document.getElementById("clear-search");

    searchInput.addEventListener("input", () => {
        clearBtn.style.display = searchInput.value.length ? "block" : "none";
    });

    clearBtn.addEventListener("click", () => {
        searchInput.value = "";
        clearBtn.style.display = "none";
        searchInput.focus();
    });
</script>
</html>