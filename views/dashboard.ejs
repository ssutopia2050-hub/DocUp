               display:flex;
               gap:10px;
               align-items:center;
               white-space:nowrap;">
               <span style="color:orangered">DocScore :</span>
               <span style="color:white"><%= data.Doc_score %></span>
               <img style="height:20px;" src="/fire.png" alt="">
           </p>
           <a href="/uploads">
               <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                   <path d="M5 20h14v-2H5v2zM12 2l5 5h-3v6h-4V7H7l5-5z"/>
               </svg>
               Uploads
           </a>
           <a href="">
               <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                   <path d="M19.14 12.94a7.43 7.43 0 000-1.88l2.03-1.58a.5.5 0 00.12-.64l-1.92-3.32a.5.5 0 00-.6-.22l-2.39.96a7.28 7.28 0 00-1.63-.95l-.36-2.54A.5.5 0 0014.9 2h-3.8a.5.5 0 00-.49.41l-.36 2.54a7.28 7.28 0 00-1.63.95l-2.39-.96a.5.5 0 00-.6.22L3.71 8.48a.5.5 0 00.12.64l2.03 1.58a7.43 7.43 0 000 1.88L3.83 14.16a.5.5 0 00-.12.64l1.92 3.32a.5.5 0 00.6.22l2.39-.96c.5.38 1.05.7 1.63.95l.36 2.54a.5.5 0 00.49.41h3.8a.5.5 0 00.49-.41l.36-2.54c.58-.25 1.13-.57 1.63-.95l2.39.96a.5.5 0 00.6-.22l1.92-3.32a.5.5 0 00-.12-.64l-2.03-1.58zM12 15.5A3.5 3.5 0 1112 8a3.5 3.5 0 010 7.5z"/>
               </svg>
               Settings
           </a>
       </div>
   </div>
   <div class="search-param-container">
       <form action="/dashboard" method="POST" class="search-form">

           <div class="search-input-wrapper" style="position:relative; width:100%;">
               <input
                       type="text"
                       placeholder="Start With /c for College Name or /s for Subject Name"
                       name="search_parameter_text"
                       id="search_parameter_text"
                       required
                       spellcheck="false"
                       autocomplete="off"
               >

               <div
                       id="college-suggestions"
                       style="
            display:none;
            position:absolute;
            top:110%;
            left:0;
            width:100%;
            max-height:250px;
            overflow-y:auto;
            background:rgb(10,18,35);
            border:1px solid rgba(255,255,255,0.12);
            border-radius:16px;
            box-shadow:0 10px 30px rgba(0,0,0,0.35);
            z-index:1000;
        "
               ></div>
           </div>

           <select name="year" required>
               <option value="all">All Years</option>
               <option value="year1">Year 1</option>
               <option value="year2">Year 2</option>
               <option value="year3">Year 3</option>
               <option value="year4">Year 4</option>
           </select>

           <select name="stream" id="stream" required>
               <option value="all">All Streams</option>
               <option value="engineering">Engineering</option>
               <option value="mbbs">MBBS</option>
               <option value="bpharma">BPharma</option>
               <option value="mba">MBA</option>
               <option value="bba">BBA</option>
               <option value="bcom">BCom</option>
           </select>

           <select name="branch" id="branch" required>
               <option value="all">All Branches</option>
           </select>

           <button type="submit">Search</button>

       </form>
   </div>
<!--   <div class="search-results-container">-->
<!--       <div class="result-tab-container">-->
<!--           <div class="result-tab">-->
<!--               <div class="top-result-tab">-->
<!--                   Thapar Institute Of Engineering and Technology-->
<!--                   <div>-->

<!--                   </div>-->
<!--               </div>-->
