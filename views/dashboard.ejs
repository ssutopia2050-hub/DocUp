                        <span class="dash-col-emoji"><%- _renderIcon(col.emoji, 18) %></span>
                        <div class="dash-col-badges">
                            <% if (col.pinned) { %>
                            <span class="dash-col-badge dash-col-badge-pin" title="Pinned">
                                <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M16 3a1 1 0 0 1 1 1v1l1.5 6H18a1 1 0 0 0-1 1v4l-4 4-4-4v-4a1 1 0 0 0-1-1H6.5L8 5V4a1 1 0 0 1 1-1h7z"/></svg>
                            </span>
                            <% } %>
                            <% if (col.isPublic) { %>
                            <span class="dash-col-badge dash-col-badge-pub" title="Public">
                                <svg width="9" height="9" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 3C10 7 10 17 12 21M12 3C14 7 14 17 12 21M3 12h18" stroke="currentColor" stroke-width="1.6"/></svg>
                            </span>
                            <% } %>
                        </div>
                    </div>

                    <div class="dash-col-card-body">
                        <span class="dash-col-name"><%= col.name %></span>
                        <% if (col.description) { %>
                        <span class="dash-col-desc"><%= col.description %></span>
                        <% } %>
                    </div>

                    <div class="dash-col-docs">
                        <% if (col.previewDocs.length === 0) { %>
                            <span class="dash-col-empty-hint">No docs yet</span>
                        <% } else { %>
                            <% col.previewDocs.forEach(doc => { %>
                            <div class="dash-col-doc-chip">
                                <span class="dash-col-chip-dot"></span>
                                <span class="dash-col-chip-text"><%= doc.subject %></span>
                            </div>
                            <% }) %>
                        <% } %>
                    </div>

                    <div class="dash-col-footer">
                        <span class="dash-col-count">
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" stroke="currentColor" stroke-width="1.8"/></svg>
                            <%= col.docCount %> doc<%= col.docCount !== 1 ? 's' : '' %>
                        </span>
                        <span class="dash-col-arrow">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M7 17L17 7M17 7H7M17 7v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                    </div>
                </a>
                <% }) %>

                <!-- Create new collection CTA -->
                <a href="/collections" class="dash-col-card dash-col-new-card">
                    <div class="dash-col-new-inner">
                        <div class="dash-col-new-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        </div>
                        <span class="dash-col-new-label">New collection</span>
                    </div>
                </a>
            </div>
        </section>
        <% } else { %>
            <!-- ── MY COLLECTIONS — EMPTY STATE ──
         Previously this section rendered nothing when the user had no
         collections. That silence is what made the feature feel absent
         from the dashboard entirely. ── -->
            <section class="discovery-section dash-collections-section">
                <div class="discovery-section-header">
                    <h2 class="discovery-section-title">My Collections</h2>
                    <p class="discovery-section-sub">Group notes, PYQs and references into playlists you can revisit anytime</p>
                </div>

                <a href="/collections" class="dash-col-empty-cta">
                    <div class="dash-col-empty-glow"></div>
                    <div class="dash-col-empty-icon"><%- _renderIcon('folder', 26) %></div>
                    <div class="dash-col-empty-text">
                        <span class="dash-col-empty-title">Create your first collection</span>
                        <span class="dash-col-empty-sub">Bundle related docs — a subject's full syllabus, an exam's PYQs, or your own study set — into one place you can share or come back to.</span>
                    </div>
                    <span class="dash-col-empty-arrow">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
                </a>
            </section>
        <% } %>

    </div>
</div>
<%
const activePopups = (data.popup || []).filter(p => {
    if (!p.startDate && !p.endDate) return true;
    const now = new Date();
    const start = p.startDate ? new Date(p.startDate) : null;
    const end   = p.endDate   ? new Date(p.endDate)   : null;
    if (start && now < start) return false;
    if (end   && now > end)   return false;
    return true;
});
%>
<% if (activePopups && activePopups.length > 0) { %>
    <div id="popup-overlay" class="popup-overlay" aria-modal="true" role="dialog" aria-label="Announcements">
        <div class="popup-box">

            <!-- close -->
            <button type="button" class="popup-close" id="popup-close-btn" aria-label="Close">×</button>

            <!-- progress dots -->
            <div class="popup-dots" id="popup-dots">
                <% activePopups.forEach((_, i) => { %>
                    <span class="popup-dot <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>"></span>
                <% }) %>
            </div>

            <!-- slides -->
            <div class="popup-slides" id="popup-slides">
                <% activePopups.forEach((p, i) => { %>
                    <div class="popup-slide <%= i === 0 ? 'active' : '' %>" data-index="<%= i %>">

                        <% if (p.image) { %>
                            <div class="popup-img-wrap">
                                <img src="<%= p.image %>" alt="<%= p.title || 'Announcement' %>">
                            </div>
                        <% } %>

                        <% if (p.subject || p.college) { %>
                            <div class="popup-meta">
                                <% if (p.subject) { %><span class="popup-tag"><%= p.subject %></span><% } %>
                                <% if (p.college) { %><span class="popup-tag popup-tag-college"><%= p.college %></span><% } %>
                            </div>
                        <% } %>

                        <% if (p.title) { %>
                            <h2 class="popup-title"><%= p.title %></h2>
                        <% } %>

                        <% if (p.body) { %>
                            <p class="popup-body"><%= p.body %></p>
                        <% } %>

                        <% if (p.url) { %>
                            <a href="<%= p.url %>" class="popup-cta overlay-cta overlay-cta-primary" target="_blank" rel="noopener">
                                <%= p.button_text || 'Learn More' %>
                            </a>
                        <% } %>

                    </div>
                <% }) %>
            </div>

            <!-- nav arrows (only when >1 popup) -->
            <% if (activePopups.length > 1) { %>
                <div class="popup-nav">
                    <button type="button" class="popup-arrow" id="popup-prev" aria-label="Previous">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                            <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                    <span class="popup-counter" id="popup-counter">1 / <%= activePopups.length %></span>
                    <button type="button" class="popup-arrow" id="popup-next" aria-label="Next">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                            <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </button>
                </div>
            <% } %>

        </div>
    </div>

    <script>
        (function () {
            const overlay  = document.getElementById("popup-overlay");
            const closeBtn = document.getElementById("popup-close-btn");
            const slides   = Array.from(document.querySelectorAll(".popup-slide"));
            const dots     = Array.from(document.querySelectorAll(".popup-dot"));
            const prevBtn  = document.getElementById("popup-prev");
            const nextBtn  = document.getElementById("popup-next");
            const counter  = document.getElementById("popup-counter");
            const total    = slides.length;
            let   current  = 0;

            function goTo(idx) {
                slides[current].classList.remove("active");
                dots[current] && dots[current].classList.remove("active");
                current = (idx + total) % total;
                slides[current].classList.add("active");
                dots[current] && dots[current].classList.add("active");
                if (counter) counter.textContent = `${current + 1} / ${total}`;
            }

            function closePopup() {
                overlay.classList.remove("active");
                overlay.setAttribute("aria-hidden", "true");
                document.body.style.overflow = "";
            }

            // open on load
            overlay.classList.add("active");
            overlay.setAttribute("aria-hidden", "false");
            document.body.style.overflow = "hidden";

            closeBtn && closeBtn.addEventListener("click", closePopup);
            prevBtn  && prevBtn.addEventListener("click",  () => goTo(current - 1));
            nextBtn  && nextBtn.addEventListener("click",  () => goTo(current + 1));

            dots.forEach(dot => dot.addEventListener("click", () => goTo(+dot.dataset.index)));

            overlay.addEventListener("click", e => {
                if (!e.target.closest(".popup-box")) closePopup();
            });

            document.addEventListener("keydown", e => {
                if (!overlay.classList.contains("active")) return;
                if (e.key === "Escape")     closePopup();
                if (e.key === "ArrowRight") goTo(current + 1);
                if (e.key === "ArrowLeft")  goTo(current - 1);
            });
        })();
    </script>
<% } %>
