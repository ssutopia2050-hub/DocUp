<script>
    const msg = <%- JSON.stringify(msg || null) %>;

    const homeBtn = document.querySelector(".logo-wordmark");
    if (homeBtn) {
        homeBtn.addEventListener("click", () => {
            window.location.href = "/dashboard";
        });
    }

    const overlay = document.getElementById("upload-loader");
    const box = document.querySelector(".upload-loader-box");
    const closeBtn = document.getElementById("docscore-overlay-close");

    function openDocscoreOverlay() {
        if (!overlay) return;
        overlay.classList.add("active");
        overlay.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
    }

    function closeDocscoreOverlay() {
        if (!overlay) return;
        overlay.classList.remove("active");
        overlay.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
    }

    if (msg && msg.err === "Insufficient DocScore") {
        openDocscoreOverlay();
    }

    if (overlay && box) {
        overlay.addEventListener("click", function (e) {
            if (!box.contains(e.target)) {
                closeDocscoreOverlay();
            }
        });
    }

    if (closeBtn) {
        closeBtn.addEventListener("click", closeDocscoreOverlay);
    }

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && overlay && overlay.classList.contains("active")) {
            closeDocscoreOverlay();
        }
    });

    const searchInput = document.getElementById("search_parameter_text");
    const clearBtn = document.getElementById("clear-search");

    if (searchInput && clearBtn) {
        searchInput.addEventListener("input", () => {
            clearBtn.style.display = searchInput.value.length ? "block" : "none";
        });

        clearBtn.addEventListener("click", () => {
            searchInput.value = "";
            clearBtn.style.display = "none";
            searchInput.focus();
        });
    }
</script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const dashboardViewLocks = new Set();

        function resetDashboardViewLinks() {
            document.querySelectorAll('a[href^="/view/"]').forEach(link => {
                link.classList.remove("is-opening");
            });
        }

        document.addEventListener("click", (e) => {
            const link = e.target.closest('a[href^="/view/"]');
            if (!link) return;

            const href = link.getAttribute("href");
            if (!href) return;

            if (dashboardViewLocks.has(href)) {
                e.preventDefault();
                return;
            }

            dashboardViewLocks.add(href);

            link.classList.add("is-opening");

            setTimeout(() => {
                dashboardViewLocks.delete(href);
                link.classList.remove("is-opening");
            }, 20000);
        });

        // 🔥 VERY IMPORTANT
        window.addEventListener("pageshow", () => {
            resetDashboardViewLinks();
            dashboardViewLocks.clear();
        });
    });
</script>
