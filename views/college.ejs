<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= collegeInfo.name %> | DocUp</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <script defer src="https://cloud.umami.is/script.js" data-website-id="fb0fa4fe-2b54-4d33-8482-1efac75331d2"></script>
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/college.css">
</head>

<body>

<header class="topbar">
    <div class="topbar-left">
        <a href="/dashboard" class="logo-wordmark">DocUp</a>
    </div>

    <div class="topbar-right">
        <a href="/dashboard" class="topbar-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none">
                <path d="M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span>FindDocs</span>
        </a>

        <div class="docscore-pill">
            <span class="docscore-label">DocScore</span>
            <span class="docscore-value"><%= user.Doc_score %></span>
            <img src="/fire.png" alt="">
        </div>

        <a href="/uploads" class="topbar-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none">
                <path d="M12 16V4M12 4l-4 4M12 4l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M5 18.5h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span>Upload</span>
        </a>

        <div class="notification-wrap">
            <button type="button" class="icon-btn notification-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M9 17H15M6.5 17H17.5C16.9 16.35 16.5 15.48 16.5 14.5V10.5C16.5 8.01 14.49 6 12 6C9.51 6 7.5 8.01 7.5 10.5V14.5C7.5 15.48 7.1 16.35 6.5 17Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M10.5 20C10.74 20.62 11.32 21 12 21C12.68 21 13.26 20.62 13.5 20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

                <% const unreadCount = (user.notifications || []).filter(n => !n.isRead).length; %>
                <% if (unreadCount > 0) { %>
                <span class="notif-badge"><%= unreadCount > 9 ? "9+" : unreadCount %></span>
                <% } %>
            </button>

            <div class="notification-dropdown">
                <div class="nd-header">
                    <span class="nd-title">Notifications</span>
                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <a href="/notifications" class="nd-view-all">View all</a>
                    <% } %>
                </div>

                <div class="nd-list">
                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <% user.notifications.slice().reverse().forEach((item) => { %>
                    <div class="nd-item <%= item.isRead ? '' : 'unread' %>">
                        <div class="nd-item-row">
                            <span class="nd-dot"></span>
                            <span class="nd-when">
                                <%= item.createdAt ? new Date(item.createdAt).toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" }) : "Just now" %>
                            </span>
                        </div>
                        <p class="nd-text"><%= item.content %></p>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="nd-empty">No notifications yet.</div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="avatar-btn">
            <% if (user.avatar_img_path) { %>
            <img src="<%= user.avatar_img_path %>" alt="">
            <% } else { %>
            <%= user.name ? user.name.charAt(0).toUpperCase() : "U" %>
            <% } %>
        </div>

    </div>
</header>

<div class="avatar-dropdown">
    <a href="/profile">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        Profile
    </a>

    <a href="/pricing">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Recharge DocScore
    </a>
    <a href="/upgrade-plans">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/>
        </svg>
        Upgrade Plans
    </a>
    <a href="/contact">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67 A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 c.12.89.32 1.76.6 2.6 a2 2 0 0 1-.45 2.11L8.09 9.91 a16 16 0 0 0 6 6l1.48-1.17 a2 2 0 0 1 2.11-.45 c.84.28 1.71.48 2.6.6 a2 2 0 0 1 1.72 2z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Contact Us / Feedback
    </a>
</div>

<div class="college-container">

    <div class="college-hero">
        <div class="college-logo-box">
            <img src="<%= collegeInfo.image %>" />
        </div>

        <div class="college-info">
            <p class="college-label"><%= (typeof isExam !== 'undefined' && isExam) ? "Entrance Exam Hub" : "College Page" %></p>
            <h1><%= collegeInfo.name %></h1>

            <div class="stats-row">
                <div class="stat">
                    <span><%= totalDocs %></span>
                    Documents
                </div>

                <div class="stat">
                    <span><%= (typeof isExam !== 'undefined' && isExam) ? Object.keys(groupedDocs).length : 4 %></span>
                    <%= (typeof isExam !== 'undefined' && isExam) ? "Classes" : "Years" %>
                </div>

                <a href="/college_chat/<%= encodeURIComponent(collegeInfo.name) %>" class="college-chat-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                        <path d="M8 10h8M8 14h5M21 12c0 4.418-4.03 8-9 8a9.94 9.94 0 0 1-4.2-.9L3 20l1.1-3.3A7.7 7.7 0 0 1 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span><%= (typeof isExam !== 'undefined' && isExam) ? "Exam Discussion" : "College Chat" %></span>
                </a>
            </div>
        </div>
    </div>

    <div class="college-controls">
        <div class="college-search-box">
            <input
                    type="text"
                    id="college-search"
                    placeholder="<%= (typeof isExam !== 'undefined' && isExam) ? 'Search by document name, subject, or topic' : 'Search by subject, chapter, or branch' %>"
            >
        </div>

        <div class="college-filter-box">
            <select id="branch-filter">
                <option value="all"><%= (typeof isExam !== 'undefined' && isExam) ? 'All Subjects' : 'All Branches' %></option>
                <% if (allBranches && allBranches.length > 0) { %>
                <% allBranches.forEach(branch => { %>
                <option value="<%= branch %>"><%= branch %></option>
                <% }) %>
                <% } %>
            </select>
        </div>

        <div class="college-sort-box">
            <select id="sort-docs">
                <option value="default">Sort By</option>
                <option value="likes">Most Liked</option>
                <option value="comments">Most Commented</option>
                <option value="newest">Newest</option>
            </select>
        </div>
    </div>

    <div id="no-docs-found" class="no-docs-found">
        No matching documents found.
    </div>

    <% if (typeof isExam !== 'undefined' && isExam) { %>
    <% Object.keys(groupedDocs).sort().forEach(className => { %>
    <div class="year-block">
        <div class="year-title">
            Class: <%= className %>
        </div>

        <% Object.keys(groupedDocs[className]).sort().forEach(subject => { %>
        <div class="branch-block" data-branch-block="<%= subject.toLowerCase() %>">
            <div class="branch-title">
                <span class="branch-title-dot"></span>
                <%= subject %>
            </div>

            <div class="docs-grid">
                <% groupedDocs[className][subject].forEach(doc => { %>
                <a
                        href="/view/<%= doc._id %>"
                        class="doc-card"
                        data-subject="<%= (doc.subject || '').toLowerCase() %>"
                        data-chapter="<%= (doc.chapter || '').toLowerCase() %>"
                        data-branch="<%= (doc.branch || 'general').toLowerCase() %>"
                        data-likes="<%= doc.likes || 0 %>"
                        data-comments="<%= doc.comment_section ? doc.comment_section.length : 0 %>"
                        data-id="<%= doc._id %>"
                >
                    <div class="doc-top">
                        <div class="doc-icon" style="background: #2563eb;">ED</div>

                        <div class="doc-meta">
                            <div class="doc-subject">
                                <%= doc.subject || "Untitled Document" %>
                            </div>
                            <div class="doc-chapter">
                                Topic: <%= doc.chapter %>
                            </div>
                            <div class="doc-branch">
                                <%= doc.branch || "General" %>
                            </div>
                        </div>
                    </div>

                    <div class="doc-bottom">
                        <div class="doc-tags">
                            <%= doc.year %>
                        </div>

                        <div style="margin-left:-35%">
                            <% if (doc.reviewed) { %>
                            <span class="verif-status verified">Verified</span>
                            <% } else { %>
                            <span class="verif-status not-verified">To be reviewed</span>
                            <% } %>
                        </div>

                        <div style="display:flex;flex-direction:row;gap:10px" class="doc-stats">
                            <div style="display:flex;justify-content:center;align-items:center;flex-direction:row">
                                <svg width="22px" height="22px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#FF4500FF"><g><path fill-rule="evenodd" clip-rule="evenodd" d="M15.9 4.5C15.9 3 14.418 2 13.26 2c-.806 0-.869.612-.993 1.82-.055.53-.121 1.174-.267 1.93-.386 2.002-1.72 4.56-2.996 5.325V17C9 19.25 9.75 20 13 20h3.773c2.176 0 2.703-1.433 2.899-1.964l.013-.036c.114-.306.358-.547.638-.82.31-.306.664-.653.927-1.18.311-.623.27-1.177.233-1.67-.023-.299-.044-.575.017-.83.064-.27.146-.475.225-.671.143-.356.275-.686.275-1.329 0-1.5-.748-2.498-2.315-2.498H15.5S15.9 6 15.9 4.5zM5.5 10A1.5 1.5 0 0 0 4 11.5v7a1.5 1.5 0 0 0 3 0v-7A1.5 1.5 0 0 0 5.5 10z" fill="#FF4500FF"></path></g></svg>
                                <%= doc.likes %>
                            </div>
                            <div style="display:flex;justify-content:center;align-items:center;flex-direction:row">
                                <svg width="15px" height="15px" viewBox="0 -0.5 21 21" xmlns="http://www.w3.org/2000/svg" fill="#FF4500FF" stroke="#FF4500FF"><g><path d="M101.900089,600 L99.8000892,600 L99.8000892,611.987622 L101.900089,611.987622 C103.060339,611.987622 104.000088,611.093545 104.000088,609.989685 L104.000088,601.997937 C104.000088,600.894077 103.060339,600 101.900089,600 M87.6977917,600 L97.7000896,600 L97.7000896,611.987622 L95.89514,618.176232 C95.6819901,619.491874 94.2455904,620.374962 92.7902907,619.842512 C91.9198408,619.52484 91.400091,618.66273 91.400091,617.774647 L91.400091,612.986591 C91.400091,612.43516 90.9296911,611.987622 90.3500912,611.987622 L85.8728921,611.987622 C84.0259425,611.987622 82.6598928,610.35331 83.0746427,608.641078 L84.8995423,602.117813 C85.1998423,600.878093 86.360092,600 87.6977917,600" transform="translate(-83 -600)"></path></g></svg>
                                <%= doc.dislikes %>
                            </div>
                        </div>
                    </div>
                </a>
                <% }) %>
            </div>
        </div>
        <% }) %>
    </div>
    <% }) %>

    <% } else { %>
    <% Object.keys(groupedDocs).forEach(year => { %>
    <div class="year-block">

        <div class="year-title">
            Year <%= year %>
        </div>

        <% Object.keys(groupedDocs[year]).forEach(sem => { %>
        <% if (groupedDocs[year][sem] && groupedDocs[year][sem].length > 0) { %>

        <div class="semester-block">
            <div class="semester-title">
                Semester <%= sem %>
            </div>

            <%
            const docsByBranch = {};
            groupedDocs[year][sem].forEach(doc => {
            const branchName = (doc.branch && doc.branch.trim()) ? doc.branch.trim() : "General";
            if (!docsByBranch[branchName]) docsByBranch[branchName] = [];
            docsByBranch[branchName].push(doc);
            });
            %>

            <% Object.keys(docsByBranch).sort((a, b) => a.localeCompare(b)).forEach(branch => { %>
            <div class="branch-block" data-branch-block="<%= branch.toLowerCase() %>">
                <div class="branch-title">
                    <span class="branch-title-dot"></span>
                    <%= branch %>
                </div>

                <div class="docs-grid">
                    <% docsByBranch[branch].forEach(doc => { %>
                    <a
                            href="/view/<%= doc._id %>"
                            class="doc-card"
                            data-subject="<%= (doc.subject || '').toLowerCase() %>"
                            data-chapter="<%= (doc.chapter || '').toLowerCase() %>"
                            data-branch="<%= (doc.branch || 'general').toLowerCase() %>"
                            data-likes="<%= doc.likes || 0 %>"
                            data-comments="<%= doc.comment_section ? doc.comment_section.length : 0 %>"
                            data-id="<%= doc._id %>"
                    >
                        <div class="doc-top">
                            <div class="doc-icon">PDF</div>

                            <div class="doc-meta">
                                <div class="doc-subject">
                                    <%= doc.subject || "Untitled Subject" %>
                                </div>
                                <div class="doc-chapter">
                                    Chapter: <%= doc.chapter %>
                                </div>
                                <div class="doc-branch">
                                    <%= doc.branch || "General" %>
                                </div>
                            </div>
                        </div>

                        <div class="doc-bottom">
                            <div class="doc-tags">
                                <%= doc.semester %>
                            </div>
                            <div style="margin-left:-35%">
                                <% if (doc.reviewed) { %>
                                <span class="verif-status verified">Verified</span>
                                <% } else { %>
                                <span class="verif-status not-verified">To be reviewed</span>
                                <% } %>
                            </div>

                            <div style="display:flex;flex-direction:row;gap:10px" class="doc-stats">
                                <div style="display:flex;justify-content:center;align-items:center;flex-direction:row">
                                    <svg width="22px" height="22px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#FF4500FF"><g><path fill-rule="evenodd" clip-rule="evenodd" d="M15.9 4.5C15.9 3 14.418 2 13.26 2c-.806 0-.869.612-.993 1.82-.055.53-.121 1.174-.267 1.93-.386 2.002-1.72 4.56-2.996 5.325V17C9 19.25 9.75 20 13 20h3.773c2.176 0 2.703-1.433 2.899-1.964l.013-.036c.114-.306.358-.547.638-.82.31-.306.664-.653.927-1.18.311-.623.27-1.177.233-1.67-.023-.299-.044-.575.017-.83.064-.27.146-.475.225-.671.143-.356.275-.686.275-1.329 0-1.5-.748-2.498-2.315-2.498H15.5S15.9 6 15.9 4.5zM5.5 10A1.5 1.5 0 0 0 4 11.5v7a1.5 1.5 0 0 0 3 0v-7A1.5 1.5 0 0 0 5.5 10z" fill="#FF4500FF"></path></g></svg>
                                    <%= doc.likes %>
                                </div>

                                <div style="display:flex;justify-content:center;align-items:center;flex-direction:row">
                                    <svg width="15px" height="15px" viewBox="0 -0.5 21 21" xmlns="http://www.w3.org/2000/svg" fill="#FF4500FF" stroke="#FF4500FF"><g><path d="M101.900089,600 L99.8000892,600 L99.8000892,611.987622 L101.900089,611.987622 C103.060339,611.987622 104.000088,611.093545 104.000088,609.989685 L104.000088,601.997937 C104.000088,600.894077 103.060339,600 101.900089,600 M87.6977917,600 L97.7000896,600 L97.7000896,611.987622 L95.89514,618.176232 C95.6819901,619.491874 94.2455904,620.374962 92.7902907,619.842512 C91.9198408,619.52484 91.400091,618.66273 91.400091,617.774647 L91.400091,612.986591 C91.400091,612.43516 90.9296911,611.987622 90.3500912,611.987622 L85.8728921,611.987622 C84.0259425,611.987622 82.6598928,610.35331 83.0746427,608.641078 L84.8995423,602.117813 C85.1998423,600.878093 86.360092,600 87.6977917,600" transform="translate(-83 -600)"></path></g></svg>
                                    <%= doc.dislikes %>
                                </div>
                            </div>
                        </div>
                    </a>
                    <% }) %>
                </div>
            </div>
            <% }) %>

        </div>

        <% } %>
        <% }) %>

    </div>
    <% }) %>
    <% } %>

</div>

<div class="footer">
    <div style="display: flex;flex-direction: row;justify-content: flex-end;align-items: flex-end" class="footer-left">
        DocUp
        <a href="/version_report" style="font-size: 0.8rem ; color:rgba(255,255,255,0.22)">v<%= process.env.VERSION %></a>
    </div>
    <div class="footer-right">
        <a href="/dashboard">FindDocs</a>
        <a href="/uploads">Upload</a>
        <a href="/profile">Profile</a>
        <a href="/contact">ContactUs</a>
        <a href="/privacy_policy">Privacy Policy</a>
        <a href="/logout">Logout</a>
    </div>
</div>

</body>

<script src="/dashboard2.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const searchInput = document.getElementById("college-search");
        const branchFilter = document.getElementById("branch-filter");
        const sortSelect = document.getElementById("sort-docs");
        const noDocsFound = document.getElementById("no-docs-found");

        const yearBlocks = document.querySelectorAll(".year-block");

        function applyControls() {
            const searchValue = (searchInput.value || "").trim().toLowerCase();
            const branchValue = (branchFilter.value || "all").trim().toLowerCase();
            const sortValue = sortSelect.value;

            let totalVisibleCards = 0;

            yearBlocks.forEach(yearBlock => {
                // Find all branch blocks inside the year block (works for both exam and college layouts)
                const branchBlocks = yearBlock.querySelectorAll(".branch-block");
                let yearHasVisibleDocs = false;

                branchBlocks.forEach(branchBlock => {
                    const grid = branchBlock.querySelector(".docs-grid");
                    const cards = Array.from(grid.querySelectorAll(".doc-card"));
                    let branchHasVisibleDocs = false;

                    cards.forEach(card => {
                        const subject = card.dataset.subject || "";
                        const chapter = card.dataset.chapter || "";
                        const branch = card.dataset.branch || "";

                        const matchesSearch =
                            !searchValue ||
                            subject.includes(searchValue) ||
                            chapter.includes(searchValue) ||
                            branch.includes(searchValue);

                        const matchesBranch =
                            branchValue === "all" ||
                            branch === branchValue;

                        const shouldShow = matchesSearch && matchesBranch;
                        card.style.display = shouldShow ? "flex" : "none";

                        if (shouldShow) branchHasVisibleDocs = true;
                    });

                    let visibleCards = cards.filter(card => card.style.display !== "none");

                    if (sortValue === "likes") {
                        visibleCards.sort((a, b) => Number(b.dataset.likes || 0) - Number(a.dataset.likes || 0));
                    } else if (sortValue === "comments") {
                        visibleCards.sort((a, b) => Number(b.dataset.comments || 0) - Number(a.dataset.comments || 0));
                    } else if (sortValue === "newest") {
                        visibleCards.sort((a, b) => String(b.dataset.id || "").localeCompare(String(a.dataset.id || "")));
                    }

                    visibleCards.forEach(card => grid.appendChild(card));

                    branchBlock.style.display = branchHasVisibleDocs ? "block" : "none";
                    if (branchHasVisibleDocs) {
                        yearHasVisibleDocs = true;
                        totalVisibleCards += visibleCards.length;
                    }
                });

                // Manage Semester blocks (Only exists in College layout)
                const semesterBlocks = yearBlock.querySelectorAll(".semester-block");
                if (semesterBlocks.length > 0) {
                    semesterBlocks.forEach(semesterBlock => {
                        const visibleBranchBlocks = Array.from(semesterBlock.querySelectorAll(".branch-block")).some(
                            block => block.style.display !== "none"
                        );
                        semesterBlock.style.display = visibleBranchBlocks ? "block" : "none";

                        const semesterTitle = semesterBlock.querySelector(".semester-title");
                        if (semesterTitle) {
                            semesterTitle.style.display = visibleBranchBlocks ? "block" : "none";
                        }
                    });
                }

                // Manage Year block visibility
                yearBlock.style.display = yearHasVisibleDocs ? "block" : "none";
                const yearTitle = yearBlock.querySelector(".year-title");
                if (yearTitle) {
                    yearTitle.style.display = yearHasVisibleDocs ? "block" : "none";
                }
            });

            noDocsFound.style.display = totalVisibleCards > 0 ? "none" : "block";
        }

        searchInput.addEventListener("input", applyControls);
        branchFilter.addEventListener("change", applyControls);
        sortSelect.addEventListener("change", applyControls);

        applyControls();
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const viewLinks = document.querySelectorAll('a[href^="/view/"]');

        function resetViewLinks() {
            document.querySelectorAll('a[href^="/view/"]').forEach(link => {
                link.dataset.clicked = "false";
                link.style.pointerEvents = "";
                link.style.opacity = "";
            });
        }

        viewLinks.forEach(link => {
            link.addEventListener("click", function(e) {
                if (this.dataset.clicked === "true") {
                    e.preventDefault();
                    return;
                }

                this.dataset.clicked = "true";
                this.style.pointerEvents = "none";
                this.style.opacity = "0.6";

                setTimeout(() => {
                    if (!document.hidden) {
                        this.dataset.clicked = "false";
                        this.style.pointerEvents = "";
                        this.style.opacity = "";
                    }
                }, 20000);
            });
        });
        window.addEventListener("pageshow", resetViewLinks);
    });
</script>
