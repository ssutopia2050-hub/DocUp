<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title><%= collegeInfo.name %> | DocUp</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <script defer src="https://cloud.umami.is/script.js" data-website-id="fb0fa4fe-2b54-4d33-8482-1efac75331d2"></script>
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/college.css">
</head>

<body>

<header class="topbar">
    <div class="topbar-left">
        <a href="/dashboard" class="logo-wordmark">DocUp</a>
    </div>

    <div class="topbar-right">
        <a href="/dashboard" class="topbar-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none">
                <path d="M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span>FindDocs</span>
        </a>

        <div class="docscore-pill">
            <span class="docscore-label">DocScore</span>
            <span class="docscore-value"><%= user.Doc_score %></span>
            <img src="/fire.png" alt="">
        </div>

        <a href="/uploads" class="topbar-pill">
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none">
                <path d="M12 16V4M12 4l-4 4M12 4l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M5 18.5h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span>Upload</span>
        </a>

        <div class="notification-wrap">
            <button type="button" class="icon-btn notification-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <path d="M9 17H15M6.5 17H17.5C16.9 16.35 16.5 15.48 16.5 14.5V10.5C16.5 8.01 14.49 6 12 6C9.51 6 7.5 8.01 7.5 10.5V14.5C7.5 15.48 7.1 16.35 6.5 17Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M10.5 20C10.74 20.62 11.32 21 12 21C12.68 21 13.26 20.62 13.5 20" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <% const unreadCount = (user.notifications || []).filter(n => !n.isRead).length; %>
                <% if (unreadCount > 0) { %>
                <span class="notif-badge"><%= unreadCount > 9 ? "9+" : unreadCount %></span>
                <% } %>
            </button>

            <div class="notification-dropdown">
                <div class="nd-header">
                    <span class="nd-title">Notifications</span>
                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <a href="/notifications" class="nd-view-all">View all</a>
                    <% } %>
                </div>
                <div class="nd-list">
                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <% user.notifications.slice().reverse().forEach((item) => { %>
                    <div class="nd-item <%= item.isRead ? '' : 'unread' %>">
                        <div class="nd-item-row">
                            <span class="nd-dot"></span>
                            <span class="nd-when">
                                <%= item.createdAt ? new Date(item.createdAt).toLocaleString("en-IN", { dateStyle: "medium", timeStyle: "short" }) : "Just now" %>
                            </span>
                        </div>
                        <p class="nd-text"><%= item.content %></p>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="nd-empty">No notifications yet.</div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="avatar-btn">
            <% if (user.avatar_img_path) { %>
            <img src="<%= user.avatar_img_path %>" alt="">
            <% } else { %>
            <%= user.name ? user.name.charAt(0).toUpperCase() : "U" %>
            <% } %>
        </div>
    </div>
</header>

<div class="avatar-dropdown">
    <a href="/profile">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        Profile
    </a>
    <a href="/pricing">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Recharge DocScore
    </a>
    <a href="/upgrade-plans">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/>
        </svg>
        Upgrade Plans
    </a>
    <a href="/contact">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67 A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 c.12.89.32 1.76.6 2.6 a2 2 0 0 1-.45 2.11L8.09 9.91 a16 16 0 0 0 6 6l1.48-1.17 a2 2 0 0 1 2.11-.45 c.84.28 1.71.48 2.6.6 a2 2 0 0 1 1.72 2z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Contact Us / Feedback
    </a>
</div>

<div class="page-shell">

    <aside class="sidebar-nav" id="sidebarNav">
        <div class="sidebar-inner">
            <div class="sidebar-header">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M3 9h18M3 15h18M9 3v18M15 3v18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
                Navigator
            </div>
            <div class="sidebar-tree" id="sidebarTree">
            </div>
        </div>
    </aside>

    <main class="main-content">

        <div class="college-hero">
            <div class="college-logo-box">
                <img src="<%= collegeInfo.image %>" />
            </div>
            <div class="college-info">
                <p class="college-label">
                    <span class="label-dot"></span>
                    <%= (typeof isExam !== 'undefined' && isExam) ? "Entrance Exam Hub" : "College Page" %>
                </p>
                <h1><%= collegeInfo.name %></h1>
                <div class="stats-row">
                    <div class="stat">
                        <span class="stat-num"><%= totalDocs %></span>
                        <span class="stat-label">Documents</span>
                    </div>
                    <div class="stat">
                        <span class="stat-num"><%= (typeof isExam !== 'undefined' && isExam) ? Object.keys(groupedDocs).length : 4 %></span>
                        <span class="stat-label"><%= (typeof isExam !== 'undefined' && isExam) ? "Classes" : "Years" %></span>
                    </div>
                    <a href="/college_chat/<%= encodeURIComponent(collegeInfo.name) %>" class="college-chat-btn">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                            <path d="M8 10h8M8 14h5M21 12c0 4.418-4.03 8-9 8a9.94 9.94 0 0 1-4.2-.9L3 20l1.1-3.3A7.7 7.7 0 0 1 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span><%= (typeof isExam !== 'undefined' && isExam) ? "Exam Discussion" : "College Chat" %></span>
                    </a>
                </div>
            </div>
        </div>

        <div class="controls-bar">
            <div class="search-wrap">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                    <path d="M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
                <input
                        type="text"
                        id="college-search"
                        class="search-input"
                        placeholder="<%= (typeof isExam !== 'undefined' && isExam) ? 'Search documents, subjects, topics…' : 'Search subjects, chapters, branches…' %>"
                >
            </div>
            <div class="filter-group">
                <div class="select-wrap">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                        <path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                    <select id="branch-filter">
                        <option value="all"><%= (typeof isExam !== 'undefined' && isExam) ? 'All Subjects' : 'All Branches' %></option>
                        <% if (allBranches && allBranches.length > 0) { %>
                        <% allBranches.forEach(branch => { %>
                        <option value="<%= branch %>"><%= branch %></option>
                        <% }) %>
                        <% } %>
                    </select>
                </div>
                <div class="select-wrap">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                        <path d="M3 6l9 6 9-6M3 18l9-6 9 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                    </svg>
                    <select id="sort-docs">
                        <option value="default">Sort By</option>
                        <option value="likes">Most Liked</option>
                        <option value="comments">Most Commented</option>
                        <option value="newest">Newest</option>
                    </select>
                </div>
            </div>
        </div>

        <% if (typeof isExam === 'undefined' || !isExam) { %>
        <div class="year-tab-rail" id="yearTabRail">
            <% Object.keys(groupedDocs).forEach((year, idx) => { %>
            <button class="year-tab <%= idx === 0 ? 'active' : '' %>" data-year="<%= year %>">
                <span class="year-tab-num"><%= year %></span>
                <span class="year-tab-label">Year</span>
            </button>
            <% }) %>
        </div>
        <% } %>

        <div id="no-docs-found" class="no-docs-found" style="display:none;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
                <path d="M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            No matching documents found.
        </div>

        <% if (typeof isExam !== 'undefined' && isExam) { %>
        <% Object.keys(groupedDocs).sort().forEach((className, ci) => { %>
        <div class="year-block" id="year-<%= className.replace(/\s+/g,'_') %>" data-year-key="<%= className %>">

            <div class="year-banner">
                <div class="year-banner-left">
                    <span class="year-banner-badge">Class</span>
                    <h2 class="year-banner-title"><%= className %></h2>
                </div>
                <span class="year-banner-count">
                    <% let examYearCount = 0; Object.values(groupedDocs[className]).forEach(arr => examYearCount += arr.length); %>
                    <%= examYearCount %> docs
                </span>
            </div>

            <% Object.keys(groupedDocs[className]).sort().forEach(subject => { %>
            <div class="branch-block" data-branch-block="<%= subject.toLowerCase() %>">
                <div class="branch-header">
                    <div class="branch-title">
                        <span class="branch-title-dot"></span>
                        <%= subject %>
                    </div>
                    <span class="branch-count"><%= groupedDocs[className][subject].length %> docs</span>
                </div>

                <div class="docs-grid">
                    <% groupedDocs[className][subject].forEach(doc => { %>
                    <a
                            href="/view/<%= doc._id %>"
                            class="doc-card"
                            data-subject="<%= (doc.subject || '').toLowerCase() %>"
                            data-chapter="<%= (doc.chapter || '').toLowerCase() %>"
                            data-branch="<%= (doc.branch || 'general').toLowerCase() %>"
                            data-likes="<%= doc.likes || 0 %>"
                            data-comments="<%= doc.comment_section ? doc.comment_section.length : 0 %>"
                            data-id="<%= doc._id %>"
                    >
                        <div class="doc-card-accent"></div>
                        <div class="doc-top">
                            <div class="doc-icon exam-icon">ED</div>
                            <div class="doc-meta">
                                <div class="doc-subject"><%= doc.subject || "Untitled Document" %></div>
                                <div class="doc-chapter">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h10M4 18h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                    <%= doc.chapter %>
                                </div>
                                <div class="doc-branch">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M3 7c0-1.1.9-2 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" stroke="currentColor" stroke-width="1.7"/></svg>
                                    <%= doc.branch || "General" %>
                                </div>
                            </div>
                        </div>
                        <div class="doc-bottom">
                            <div class="doc-tags"><%= doc.year %></div>
                            <% if (doc.reviewed) { %>
                            <span class="verif-status verified">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
                                Verified
                            </span>
                            <% } else { %>
                            <span class="verif-status not-verified">Pending</span>
                            <% } %>
                            <div class="doc-stats">
                                <span class="stat-chip like-chip">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M15.9 4.5C15.9 3 14.418 2 13.26 2c-.806 0-.869.612-.993 1.82-.055.53-.121 1.174-.267 1.93-.386 2.002-1.72 4.56-2.996 5.325V17C9 19.25 9.75 20 13 20h3.773c2.176 0 2.703-1.433 2.899-1.964l.013-.036c.114-.306.358-.547.638-.82.31-.306.664-.653.927-1.18.311-.623.27-1.177.233-1.67-.023-.299-.044-.575.017-.83.064-.27.146-.475.225-.671.143-.356.275-.686.275-1.329 0-1.5-.748-2.498-2.315-2.498H15.5S15.9 6 15.9 4.5zM5.5 10A1.5 1.5 0 0 0 4 11.5v7a1.5 1.5 0 0 0 3 0v-7A1.5 1.5 0 0 0 5.5 10z" fill="currentColor"/></svg>
                                    <%= doc.likes %>
                                </span>
                            </div>
                        </div>
                    </a>
                    <% }) %>
                </div>
            </div>
            <% }) %>
        </div>
        <% }) %>

        <% } else { %>

        <% Object.keys(groupedDocs).forEach((year, yearIdx) => { %>
        <div class="year-block <%= yearIdx === 0 ? 'active-year' : '' %>" id="year-<%= year %>" data-year-key="<%= year %>">

            <div class="sem-tab-rail" id="semRail-<%= year %>">
                <% let firstSem = true; %>
                <% Object.keys(groupedDocs[year]).forEach(sem => { %>
                <% if (groupedDocs[year][sem] && groupedDocs[year][sem].length > 0) { %>
                <button class="sem-tab <%= firstSem ? 'active' : '' %>" data-sem="<%= sem %>" data-year="<%= year %>">
                    Sem <strong><%= sem %></strong>
                </button>
                <% firstSem = false; %>
                <% } %>
                <% }) %>
            </div>

            <% Object.keys(groupedDocs[year]).forEach((sem, semIdx) => { %>
            <% if (groupedDocs[year][sem] && groupedDocs[year][sem].length > 0) { %>
            <%
            const docsByBranch = {};
            groupedDocs[year][sem].forEach(doc => {
            const branchName = (doc.branch && doc.branch.trim()) ? doc.branch.trim() : "General";
            if (!docsByBranch[branchName]) docsByBranch[branchName] = [];
            docsByBranch[branchName].push(doc);
            });
            %>

            <div class="semester-block <%= semIdx === 0 ? 'active-sem' : '' %>" id="sem-<%= year %>-<%= sem %>" data-sem-key="<%= sem %>" data-year-key="<%= year %>">

                <div class="branch-pill-rail">
                    <button class="branch-pill active" data-target-branch="all">All Branches</button>
                    <% Object.keys(docsByBranch).sort((a,b) => a.localeCompare(b)).forEach(branch => { %>
                    <button class="branch-pill" data-target-branch="<%= branch.toLowerCase() %>"><%= branch %></button>
                    <% }) %>
                </div>

                <% Object.keys(docsByBranch).sort((a, b) => a.localeCompare(b)).forEach((branch, branchIdx) => { %>
                <div class="branch-block" data-branch-block="<%= branch.toLowerCase() %>" data-branch-color="<%= branchIdx % 8 %>">
                    <div class="branch-header">
                        <div class="branch-title">
                            <span class="branch-title-dot"></span>
                            <%= branch %>
                        </div>
                        <span class="branch-count"><%= docsByBranch[branch].length %> docs</span>
                    </div>

                    <div class="docs-grid">
                        <% docsByBranch[branch].forEach(doc => { %>
                        <a
                                href="/view/<%= doc._id %>"
                                class="doc-card"
                                data-subject="<%= (doc.subject || '').toLowerCase() %>"
                                data-chapter="<%= (doc.chapter || '').toLowerCase() %>"
                                data-branch="<%= (doc.branch || 'general').toLowerCase() %>"
                                data-likes="<%= doc.likes || 0 %>"
                                data-comments="<%= doc.comment_section ? doc.comment_section.length : 0 %>"
                                data-id="<%= doc._id %>"
                        >
                            <div class="doc-card-accent"></div>
                            <div class="doc-top">
                                <div class="doc-icon">PDF</div>
                                <div class="doc-meta">
                                    <div class="doc-subject"><%= doc.subject || "Untitled Subject" %></div>
                                    <div class="doc-chapter">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h10M4 18h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                                        <%= doc.chapter %>
                                    </div>
                                    <div class="doc-branch">
                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none"><path d="M3 7c0-1.1.9-2 2-2h14a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" stroke="currentColor" stroke-width="1.7"/></svg>
                                        <%= branch %>
                                    </div>
                                </div>
                            </div>
                            <div class="doc-bottom">
                                <div class="doc-tags"> <%= doc.semester %></div>
                                <% if (doc.reviewed) { %>
                                <span class="verif-status verified">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
                                    Verified
                                </span>
                                <% } else { %>
                                <span class="verif-status not-verified">Pending</span>
                                <% } %>
                                <div class="doc-stats">
                                    <span class="stat-chip like-chip">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path fill-rule="evenodd" clip-rule="evenodd" d="M15.9 4.5C15.9 3 14.418 2 13.26 2c-.806 0-.869.612-.993 1.82-.055.53-.121 1.174-.267 1.93-.386 2.002-1.72 4.56-2.996 5.325V17C9 19.25 9.75 20 13 20h3.773c2.176 0 2.703-1.433 2.899-1.964l.013-.036c.114-.306.358-.547.638-.82.31-.306.664-.653.927-1.18.311-.623.27-1.177.233-1.67-.023-.299-.044-.575.017-.83.064-.27.146-.475.225-.671.143-.356.275-.686.275-1.329 0-1.5-.748-2.498-2.315-2.498H15.5S15.9 6 15.9 4.5zM5.5 10A1.5 1.5 0 0 0 4 11.5v7a1.5 1.5 0 0 0 3 0v-7A1.5 1.5 0 0 0 5.5 10z" fill="currentColor"/></svg>
                                        <%= doc.likes %>
                                    </span>
                                    <span class="stat-chip comment-chip">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                                        <%= doc.comment_section ? doc.comment_section.length : 0 %>
                                    </span>
                                </div>
                            </div>
                        </a>
                        <% }) %>
                    </div>

                    <div class="branch-empty" style="display:none;">
                        <svg width="38" height="38" viewBox="0 0 24 24" fill="none">
                            <path d="M9 12h6M9 15h4M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                            <circle cx="12" cy="8.5" r="1" fill="currentColor"/>
                        </svg>
                        <div class="branch-empty-text">
                            <strong>No docs match your search</strong>
                            <span>Try a different keyword, or <a href="/uploads">upload one</a> for this branch.</span>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
            <% } %>
            <% }) %>
        </div>
        <% }) %>
        <% } %>

    </main>
</div>

<div class="footer">
    <div class="footer-left">
        DocUp
        <a href="/version_report" style="font-size: 0.8rem; color:rgba(255,255,255,0.22)">v<%= process.env.VERSION %></a>
    </div>
    <div class="footer-right">
        <a href="/dashboard">FindDocs</a>
        <a href="/uploads">Upload</a>
        <a href="/profile">Profile</a>
        <a href="/contact">ContactUs</a>
        <a href="/privacy_policy">Privacy Policy</a>
        <a href="/logout">Logout</a>
    </div>
</div>

</body>

<script src="/dashboard2.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        // 1. Core DOM elements
        const searchInput   = document.getElementById("college-search");
        const branchFilter  = document.getElementById("branch-filter");
        const sortSelect    = document.getElementById("sort-docs");
        const noDocsFound   = document.getElementById("no-docs-found");
        const isExam        = !!document.querySelector('.year-block[data-year-key]') && !document.getElementById('yearTabRail');
        const yearTabRail   = document.getElementById("yearTabRail");
        const yearTabs      = yearTabRail ? yearTabRail.querySelectorAll(".year-tab") : [];
        const yearBlocks    = document.querySelectorAll(".year-block");

        // 2. Branch Colors Definition (Moved to top to prevent ReferenceError)
        const BRANCH_COLORS = [
            { h: '24',  s: '100%', l: '55%', bg: 'rgba(255,106,0,0.08)',   border: 'rgba(255,106,0,0.18)',   dot: '#ff6a00' },
            { h: '186', s: '85%',  l: '47%', bg: 'rgba(14,188,188,0.08)',   border: 'rgba(14,188,188,0.18)',  dot: '#0ebcbc' },
            { h: '263', s: '75%',  l: '60%', bg: 'rgba(124,58,237,0.08)',   border: 'rgba(124,58,237,0.18)',  dot: '#7c3aed' },
            { h: '152', s: '76%',  l: '42%', bg: 'rgba(16,185,129,0.08)',   border: 'rgba(16,185,129,0.18)',  dot: '#10b981' },
            { h: '346', s: '87%',  l: '60%', bg: 'rgba(244,63,94,0.08)',    border: 'rgba(244,63,94,0.18)',   dot: '#f43f5e' },
            { h: '43',  s: '96%',  l: '56%', bg: 'rgba(245,158,11,0.08)',   border: 'rgba(245,158,11,0.18)',  dot: '#f59e0b' },
            { h: '199', s: '89%',  l: '48%', bg: 'rgba(14,165,233,0.08)',   border: 'rgba(14,165,233,0.18)',  dot: '#0ea5e9' },
            { h: '292', s: '84%',  l: '61%', bg: 'rgba(217,70,239,0.08)',   border: 'rgba(217,70,239,0.18)',  dot: '#d946ef' },
        ];

        function applyBranchColors() {
            document.querySelectorAll('.branch-block[data-branch-color]').forEach(bb => {
                const idx = parseInt(bb.dataset.branchColor, 10) || 0;
                const c   = BRANCH_COLORS[idx % BRANCH_COLORS.length];
                bb.style.setProperty('--bc-bg',     c.bg);
                bb.style.setProperty('--bc-border', c.border);
                bb.style.setProperty('--bc-dot',    c.dot);

                const dot = bb.querySelector('.branch-title-dot');
                if (dot) { dot.style.background = c.dot; dot.style.boxShadow = `0 0 14px ${c.dot}66`; }

                const cnt = bb.querySelector('.branch-count');
                if (cnt) { cnt.style.color = c.dot; cnt.style.background = c.bg; }

                const key = bb.dataset.branchBlock;
                const pill = document.querySelector(`.branch-pill[data-target-branch="${key}"]`);
                if (pill) {
                    pill.style.setProperty('--bp-color', c.dot);
                    pill.style.setProperty('--bp-bg', c.bg);
                    pill.style.setProperty('--bp-border', c.border);
                }
            });
        }

        // 3. Apply Colors Initial
        applyBranchColors();

        // 4. Update Sidebar Helper
        function updateSidebar() {
            const tree = document.getElementById("sidebarTree");
            if (!tree) return;
            tree.innerHTML = "";

            const allYears = document.querySelectorAll(".year-block");
            allYears.forEach(yb => {
                if (yb.style.display === "none") return;

                const semBlocks = yb.querySelectorAll(".semester-block");
                if (semBlocks.length > 0) {
                    semBlocks.forEach(sb => {
                        const yearKey = sb.dataset.yearKey;
                        const semKey  = sb.dataset.semKey;

                        const semNode = document.createElement("div");
                        semNode.className = "stree-sem";
                        semNode.innerHTML = `<span class="stree-sem-label">Year ${yearKey} · Sem ${semKey}</span>`;
                        tree.appendChild(semNode);

                        sb.querySelectorAll(".branch-block").forEach(bb => {
                            const bTitle = bb.querySelector(".branch-title");
                            if (!bTitle) return;
                            const bName = bTitle.textContent.trim();
                            const bCount = bb.querySelectorAll(".doc-card").length;

                            const bbColor = parseInt(bb.dataset.branchColor || '0', 10);
                            const dotColor = BRANCH_COLORS[bbColor % BRANCH_COLORS.length]?.dot || '#ff6a00';
                            const branchNode = document.createElement("div");
                            branchNode.className = "stree-branch";
                            branchNode.innerHTML = `
                            <span class="stree-dot" style="background:${dotColor};box-shadow:0 0 8px ${dotColor}55;"></span>
                            <span class="stree-branch-name">${bName}</span>
                            <span class="stree-count">${bCount}</span>
                        `;
                            branchNode.addEventListener("click", () => {
                                const yearTab = document.querySelector(`.year-tab[data-year="${yearKey}"]`);
                                if (yearTab) yearTab.click();
                                setTimeout(() => {
                                    const semTab = document.querySelector(`.sem-tab[data-sem="${semKey}"][data-year="${yearKey}"]`);
                                    if (semTab) semTab.click();
                                    setTimeout(() => {
                                        bb.scrollIntoView({ behavior: "smooth", block: "start" });
                                        bb.classList.add("branch-highlight");
                                        setTimeout(() => bb.classList.remove("branch-highlight"), 1500);
                                    }, 100);
                                }, 100);
                            });
                            tree.appendChild(branchNode);
                        });
                    });
                }
            });
        }

        // 5. Apply Controls Helper
        function applyControls() {
            const searchVal = (searchInput?.value || "").trim().toLowerCase();
            const branchVal = (branchFilter?.value || "all").trim().toLowerCase();
            const sortVal   = sortSelect?.value || "default";

            let totalVisible = 0;
            document.querySelectorAll(".year-block").forEach(yearBlock => {
                if (yearBlock.style.display === "none") return;

                yearBlock.querySelectorAll(".branch-block").forEach(branchBlock => {
                    const grid  = branchBlock.querySelector(".docs-grid");
                    if(!grid) return;

                    const cards = Array.from(grid.querySelectorAll(".doc-card"));
                    let branchVisible = false;

                    cards.forEach(card => {
                        const subject = card.dataset.subject || "";
                        const chapter = card.dataset.chapter || "";
                        const branch  = card.dataset.branch  || "";

                        const matchSearch = !searchVal || subject.includes(searchVal) || chapter.includes(searchVal) || branch.includes(searchVal);
                        const matchBranch = branchVal === "all" || branch === branchVal;
                        const show = matchSearch && matchBranch;

                        card.style.display = show ? "flex" : "none";
                        if (show) branchVisible = true;
                    });

                    // Sort visible cards
                    const visible = cards.filter(c => c.style.display !== "none");
                    if (sortVal === "likes")    visible.sort((a,b) => +b.dataset.likes - +a.dataset.likes);
                    if (sortVal === "comments") visible.sort((a,b) => +b.dataset.comments - +a.dataset.comments);
                    if (sortVal === "newest")   visible.sort((a,b) => String(b.dataset.id).localeCompare(String(a.dataset.id)));
                    visible.forEach(c => grid.appendChild(c));

                    // Show/hide per-branch empty state
                    const branchEmptyEl = branchBlock.querySelector('.branch-empty');
                    const hasAnyCards   = cards.length > 0;
                    if (branchEmptyEl) {
                        branchEmptyEl.style.display = (hasAnyCards && !branchVisible) ? 'flex' : 'none';
                    }

                    branchBlock.style.display = (branchVisible || (hasAnyCards && !branchVisible)) ? "block" : "none";
                    if (branchVisible) totalVisible += visible.length;
                });

                // Hide semester blocks with no visible content
                yearBlock.querySelectorAll(".semester-block").forEach(sem => {
                    const anyVisible = Array.from(sem.querySelectorAll(".branch-block")).some(b => b.style.display !== "none");
                    if (!sem.classList.contains("active-sem")) return;
                    sem.style.display = anyVisible ? "block" : "none";
                });
            });

            if (noDocsFound) noDocsFound.style.display = totalVisible > 0 ? "none" : "flex";
        }

        // 6. Year Tab Switching Logic
        function activateYear(yearKey) {
            yearTabs.forEach(t => t.classList.toggle("active", t.dataset.year === yearKey));
            yearBlocks.forEach(b => {
                const isTarget = b.dataset.yearKey === yearKey;
                b.style.display = isTarget ? "block" : "none";
                if (isTarget) b.classList.add("active-year");
                else b.classList.remove("active-year");
            });
            applyControls();
            updateSidebar();
        }

        if (yearTabRail) {
            yearTabs.forEach(tab => {
                tab.addEventListener("click", () => activateYear(tab.dataset.year));
            });
            if (yearTabs.length > 0) {
                activateYear(yearTabs[0].dataset.year);
            }
        }

        // 7. Semester Tab Switching Logic
        document.querySelectorAll(".sem-tab").forEach(tab => {
            tab.addEventListener("click", function() {
                const year = this.dataset.year;
                const sem  = this.dataset.sem;

                // Switch active tab styling
                document.querySelectorAll(".sem-tab").forEach(t => {
                    if (t.dataset.year === year) {
                        t.classList.toggle("active", t.dataset.sem === sem);
                    }
                });

                // Show/hide semester blocks safely
                document.querySelectorAll(".semester-block").forEach(b => {
                    if (b.dataset.yearKey === year) {
                        const isTarget = b.dataset.semKey === sem;
                        b.style.display = isTarget ? "block" : "none";
                        b.classList.toggle("active-sem", isTarget);
                    }
                });

                applyControls();
                updateSidebar();
            });
        });

        // 8. Branch Pill Filtering
        document.querySelectorAll(".branch-pill").forEach(pill => {
            pill.addEventListener("click", function() {
                const rail   = this.closest(".branch-pill-rail");
                const semBlock = this.closest(".semester-block");
                const target = this.dataset.targetBranch;

                rail.querySelectorAll(".branch-pill").forEach(p => p.classList.remove("active"));
                this.classList.add("active");

                semBlock.querySelectorAll(".branch-block").forEach(bb => {
                    const bKey = bb.dataset.branchBlock;
                    bb.style.display = (target === "all" || bKey === target) ? "block" : "none";
                });
            });
        });

        // 9. Attach Listeners to Controls
        if (searchInput)  searchInput.addEventListener("input",  applyControls);
        if (branchFilter) branchFilter.addEventListener("change", applyControls);
        if (sortSelect)   sortSelect.addEventListener("change",   applyControls);

        // Initial Execution
        applyControls();
        updateSidebar();

        // 10. Sidebar Toggle (Mobile)
        const sidebar = document.getElementById("sidebarNav");
        const toggleBtn = document.getElementById("sidebarToggle");
        if (toggleBtn && sidebar) {
            toggleBtn.addEventListener("click", () => {
                sidebar.classList.toggle("sidebar-open");
            });
        }

        // 11. Prevent Double Click
        function resetViewLinks() {
            document.querySelectorAll('a[href^="/view/"]').forEach(link => {
                link.dataset.clicked = "false";
                link.style.pointerEvents = "";
                link.style.opacity = "";
            });
        }
        document.querySelectorAll('a[href^="/view/"]').forEach(link => {
            link.addEventListener("click", function(e) {
                if (this.dataset.clicked === "true") { e.preventDefault(); return; }
                this.dataset.clicked = "true";
                this.style.pointerEvents = "none";
                this.style.opacity = "0.6";
                setTimeout(() => {
                    if (!document.hidden) {
                        this.dataset.clicked = "false";
                        this.style.pointerEvents = "";
                        this.style.opacity = "";
                    }
                }, 20000);
            });
        });
        window.addEventListener("pageshow", resetViewLinks);

    });
</script>
</html>