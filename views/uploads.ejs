<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/uploads.css">
    <link rel="shortcut icon" href="/images/favicon-32x32.png" type="image/x-icon">
    <meta charset="UTF-8">
    <title>DocUp |  Upload</title>
</head>
<body>
<div class="topbar">
    <div class="logo-text-container">
        DocUp
    </div>
    <div class="pg-links">
        <a href="/dashboard">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 2a8 8 0 105.293 14.293l4.707 4.707 1.414-1.414-4.707-4.707A8 8 0 0010 2zm0 2a6 6 0 110 12 6 6 0 010-12z"/>
            </svg>
            <span>FindDocs</span>
        </a>
        <p style="border:1px solid orangered;
               padding:15px 25px;
               border-radius:30px;
               display:flex;
               gap:10px;
               align-items:center;
               white-space:nowrap;
cursor:crosshair;">
            <span style="color:orangered">DocScore :</span>
            <span style="color:white"><%= data.Doc_score %></span>
            <img style="height:20px;" src="/fire.png" alt="">
        </p>
        <a href="/uploads">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M5 20h14v-2H5v2zM12 2l5 5h-3v6h-4V7H7l5-5z"/>
            </svg>
            <span style="border-bottom:2px solid rgba(255,69,0,0.59);padding-bottom: 2px;">Upload</span>
        </a>
        <div class="notification-wrap">
            <div class="notification-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none">
                    <path d="M9 17H15M6.5 17H17.5C16.9 16.35 16.5 15.48 16.5 14.5V10.5C16.5 8.01 14.49 6 12 6C9.51 6 7.5 8.01 7.5 10.5V14.5C7.5 15.48 7.1 16.35 6.5 17Z"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>
                    <path d="M10.5 20C10.74 20.62 11.32 21 12 21C12.68 21 13.26 20.62 13.5 20"
                          stroke="currentColor"
                          stroke-width="1.7"
                          stroke-linecap="round"
                          stroke-linejoin="round"/>
                </svg>

                <% const unreadCount = (data.notifications || []).filter(n => !n.isRead).length; %>
                <% if (unreadCount > 0) { %>
                <span class="notification-badge">
                <%= unreadCount > 9 ? "9+" : unreadCount %>
            </span>
                <% } %>
            </div>

            <div class="notification-dropdown">
                <div class="notification-dropdown-header">
                    <span>Notifications</span>
                    <% if (data.notifications && data.notifications.length > 0) { %>
                    <a href="/notifications" class="notification-view-all">View all</a>
                    <% } %>
                </div>

                <div class="notification-list">
                    <% if (data.notifications && data.notifications.length > 0) { %>
                    <% data.notifications.slice().reverse().forEach((item) => { %>
                    <div class="notification-item <%= item.isRead ? '' : 'unread' %>">
                        <div class="notification-item-top">
                            <div class="notification-item-top-left">
                                <span class="notification-dot"></span>
                                <span class="notification-label"><%= item.isRead ? "Seen" : "New" %></span>
                            </div>

                            <span class="notification-meta">
            <%= item.createdAt
                ? new Date(item.createdAt).toLocaleString("en-IN", {
                    dateStyle: "medium",
                    timeStyle: "short"
                })
                : "Just now" %>
        </span>
                        </div>

                        <div class="notification-content">
                            <%= item.content %>
                        </div>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="notification-empty">
                        No notifications yet.
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="profile-btn">
            <% if (data.avatar_img_path) { %>
            <img src="<%= data.avatar_img_path %>" alt="">
            <% } else { %>
            <%= data.name ? data.name.charAt(0).toUpperCase() : "U" %>
            <% } %>
        </div>
    </div>
</div>
<div class="profile-btn-dropdown">
    <a style="border-bottom:1px solid orangered;width:100%;display: flex;justify-content: center;align-items: center;padding-bottom:20px" href="/profile">Profile</a>
    <a href="/pricing">Recharge DocScore</a>
</div>
<div class="upload-wrapper">

    <div class="upload-drop-area" id="drop-area">

        <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="rgba(255, 69, 0, 0.48)" viewBox="0 0 24 24">
            <path d="M5 20h14v-2H5v2zM12 2l5 5h-3v6h-4V7H7l5-5z"/>
        </svg>

        <p>Drag & Drop File Here</p>
        <p>or</p>

        <input type="file" id="file-input" hidden>
        <button type="button" id="choose-btn">Choose File</button>
        <p style="color:orangered;font-size: 1.2rem">Uploading One Doc Will increase your DocScore by +1</p>
        <p style="color:rgba(128,128,128,0.53);font-size: 1rem">All Files uploaded will be reviewed for authenticity....This is not A personal Storage app </p>
        <p style="color:rgba(128,128,128,0.53);font-size: 1rem">Any attempt to Spam upload or duplicate upload one file or Invalid Branch or Stream information might lead to <span style="color:rgba(255,69,0,0.68);font-family: Saira, sans-serif">permanent banning</span> of your account</p>
        <p style="color:orangered;font-size: 1rem">File Upload Criteria: File Type : <span style="color:rgb(255,210,12);font-family: Saira, sans-serif" >pdf </span> | Max-File size : <span style="color:rgb(255,210,12);font-family: Saira, sans-serif" >50 MB</span> <span style="color:rgba(255,69,0,0.44);font-family:Saira, sans-serif">[We are requesting more funds from sponsors to increase storage capacity very soon]</span> </p>
        <a style="color:rgba(128,128,128,0.78);font-size: 1rem;font-family:Saira , sans-serif" href="/privacy_policy" target="_blank">Terms and Conditions*</a></p>

    </div>

    <!-- File name -->
    <div id="file-preview"></div>

    <!-- Metadata form -->
    <div class="doc-form" id="doc-form">

        <div class="college-autocomplete">
            <input
                    type="text"
                    id="college"
                    placeholder="Type college name"
                    autocomplete="off"
                    required
            >
            <div id="college-suggestions" class="college-suggestions"></div>
        </div>

        <select id="year" required>
            <option value="">Year</option>
            <option>year1</option>
            <option>year2</option>
            <option>year3</option>
            <option>year4</option>
        </select>

        <select id="semester" required>
            <option value="">Semester</option>
            <option>Sem 1</option>
            <option>Sem 2</option>
            <option>Sem 3</option>
            <option>Sem 4</option>
            <option>Sem 5</option>
            <option>Sem 6</option>
            <option>Sem 7</option>
            <option>Sem 8</option>
        </select>

        <input type="text" placeholder="Branch" id="branch" required>

        <input type="text" placeholder="Subject" id="subject" required>

        <input type="text" placeholder="Chapter Name" id="chapter" required>

    </div>

    <button class="upload-btn" id="upload-btn">Upload File</button>

</div>
<div id="upload-loader" class="upload-loader-overlay">
    <div class="upload-loader-box">
        <div class="upload-spinner"></div>
        <p>Uploading file, please wait...</p>
    </div>
</div>
<div id="upload-status-popup" class="upload-status-popup">
    <div class="upload-status-card">
        <div id="upload-status-icon" class="upload-status-icon success">
            ✓
        </div>

        <h3 id="upload-status-title">Upload Complete</h3>
        <p id="upload-status-message">Your document was uploaded successfully.</p>

        <div class="upload-status-actions">
            <button type="button" id="upload-status-close" class="upload-status-btn primary">
                Okay
            </button>
        </div>
    </div>
</div>
<div class="footer">
    <div style="display: flex;flex-direction: row;justify-content: flex-end;align-items: flex-end" class="footer-left">
        DocUp
        <a href="/version_report" style="font-size: 0.8rem ; color:rgba(255,255,255,0.22)">v<%= process.env.VERSION %></a>
    </div>
    <div class="footer-right">
        <a href="/dashboard">FindDocs</a>
        <a href="/uploads">Upload</a>
        <a href="/profile">Profile</a>
        <a href="/contact">ContactUs</a> 
        <a href="/privacy_policy">Privacy Policy</a>
        <a href="/logout">Logout</a>
    </div>
</div>
</body>
<script src="/dashboard2.js"></script>
<script>
    const colleges = <%- JSON.stringify(colleges) %>;

    const dropArea = document.getElementById("drop-area");
    const fileInput = document.getElementById("file-input");
    const chooseBtn = document.getElementById("choose-btn");
    const preview = document.getElementById("file-preview");
    const form = document.getElementById("doc-form");
    const uploadBtn = document.getElementById("upload-btn");
    const uploadLoader = document.getElementById("upload-loader");
    const homeBtn = document.querySelector(".logo-text-container");

    const collegeInput = document.getElementById("college");
    const suggestionsBox = document.getElementById("college-suggestions");
    const uploadStatusPopup = document.getElementById("upload-status-popup");
    const uploadStatusIcon = document.getElementById("upload-status-icon");
    const uploadStatusTitle = document.getElementById("upload-status-title");
    const uploadStatusMessage = document.getElementById("upload-status-message");
    const uploadStatusClose = document.getElementById("upload-status-close");

    function showUploadPopup(type, title, message) {
        uploadStatusIcon.className = "upload-status-icon " + type;
        uploadStatusIcon.textContent = type === "success" ? "✓" : "!";
        uploadStatusTitle.textContent = title;
        uploadStatusMessage.textContent = message;
        uploadStatusPopup.classList.add("active");
    }

    function hideUploadPopup() {
        uploadStatusPopup.classList.remove("active");
    }

    uploadStatusClose.addEventListener("click", hideUploadPopup);

    uploadStatusPopup.addEventListener("click", (e) => {
        if (e.target === uploadStatusPopup) {
            hideUploadPopup();
        }
    });
    let selectedFile = null;
    let activeSuggestionIndex = -1;

    homeBtn.addEventListener("click", () => {
        window.location.href = "/dashboard";
    });

    function showLoader() {
        uploadLoader.classList.add("active");
    }

    function hideLoader() {
        uploadLoader.classList.remove("active");
    }

    function normalizeText(text) {
        return String(text || "")
            .toLowerCase()
            .replace(/\s+/g, " ")
            .trim();
    }

    function escapeHTML(str) {
        const div = document.createElement("div");
        div.textContent = str;
        return div.innerHTML;
    }

    function scoreCollegeMatch(input, collegeName) {
        const q = normalizeText(input);
        const c = normalizeText(collegeName);

        if (!q) return 0;
        if (c === q) return 1000;
        if (c.startsWith(q)) return 900;
        if (c.includes(q)) return 700;

        const inputWords = q.split(" ");
        let score = 0;

        inputWords.forEach(word => {
            if (!word) return;
            if (c.startsWith(word)) score += 120;
            else if (c.includes(word)) score += 70;
        });

        return score;
    }

    function getMatchingColleges(query) {
        const cleanedQuery = normalizeText(query);

        if (!cleanedQuery) {
            return colleges.slice(0, 8);
        }

        return colleges
            .map(college => ({
                name: college,
                score: scoreCollegeMatch(cleanedQuery, college)
            }))
            .filter(item => item.score > 0)
            .sort((a, b) => {
                if (b.score !== a.score) return b.score - a.score;
                return a.name.localeCompare(b.name);
            })
            .slice(0, 8)
            .map(item => item.name);
    }

    function closeSuggestions() {
        suggestionsBox.innerHTML = "";
        suggestionsBox.style.display = "none";
        activeSuggestionIndex = -1;
    }

    function selectCollege(collegeName) {
        collegeInput.value = collegeName;
        collegeInput.dataset.selected = "true";
        collegeInput.classList.remove("college-invalid");
        closeSuggestions();
    }

    function renderSuggestions(matches) {
        suggestionsBox.innerHTML = "";
        activeSuggestionIndex = -1;

        if (!matches.length) {
            suggestionsBox.style.display = "none";
            return;
        }

        matches.forEach((college, index) => {
            const item = document.createElement("div");
            item.className = "college-suggestion-item";
            item.innerHTML = escapeHTML(college);

            item.addEventListener("mousedown", (e) => {
                e.preventDefault();
                selectCollege(college);
            });

            suggestionsBox.appendChild(item);
        });

        suggestionsBox.style.display = "block";
    }

    function updateActiveSuggestion(items) {
        items.forEach(item => item.classList.remove("active"));

        if (activeSuggestionIndex >= 0 && items[activeSuggestionIndex]) {
            items[activeSuggestionIndex].classList.add("active");
            items[activeSuggestionIndex].scrollIntoView({
                block: "nearest"
            });
        }
    }

    function isValidCollege(value) {
        const normalizedValue = normalizeText(value);
        return colleges.some(college => normalizeText(college) === normalizedValue);
    }

    function getCanonicalCollege(value) {
        const normalizedValue = normalizeText(value);
        return colleges.find(college => normalizeText(college) === normalizedValue) || "";
    }

    chooseBtn.onclick = () => fileInput.click();

    fileInput.addEventListener("change", (e) => {
        if (!e.target.files[0]) return;
        handleFile(e.target.files[0]);
    });

    dropArea.addEventListener("dragover", (e) => {
        e.preventDefault();
    });

    dropArea.addEventListener("drop", (e) => {
        e.preventDefault();
        if (!e.dataTransfer.files[0]) return;
        handleFile(e.dataTransfer.files[0]);
    });

    collegeInput.addEventListener("input", () => {
        collegeInput.dataset.selected = "false";
        collegeInput.classList.remove("college-invalid");

        const query = collegeInput.value;
        const matches = getMatchingColleges(query);
        renderSuggestions(matches);
    });

    collegeInput.addEventListener("focus", () => {
        const matches = getMatchingColleges(collegeInput.value);
        renderSuggestions(matches);
    });

    collegeInput.addEventListener("keydown", (e) => {
        const items = suggestionsBox.querySelectorAll(".college-suggestion-item");

        if (e.key === "ArrowDown") {
            if (suggestionsBox.style.display === "none") {
                const matches = getMatchingColleges(collegeInput.value);
                renderSuggestions(matches);
            }

            const refreshedItems = suggestionsBox.querySelectorAll(".college-suggestion-item");
            if (!refreshedItems.length) return;

            e.preventDefault();
            activeSuggestionIndex = (activeSuggestionIndex + 1) % refreshedItems.length;
            updateActiveSuggestion(refreshedItems);
        } else if (e.key === "ArrowUp") {
            const refreshedItems = suggestionsBox.querySelectorAll(".college-suggestion-item");
            if (!refreshedItems.length) return;

            e.preventDefault();
            activeSuggestionIndex =
                (activeSuggestionIndex - 1 + refreshedItems.length) % refreshedItems.length;
            updateActiveSuggestion(refreshedItems);
        } else if (e.key === "Enter") {
            const refreshedItems = suggestionsBox.querySelectorAll(".college-suggestion-item");

            if (suggestionsBox.style.display !== "none" && activeSuggestionIndex >= 0 && refreshedItems[activeSuggestionIndex]) {
                e.preventDefault();
                selectCollege(refreshedItems[activeSuggestionIndex].textContent);
            } else if (!isValidCollege(collegeInput.value)) {
                e.preventDefault();
            }
        } else if (e.key === "Escape") {
            closeSuggestions();
        }
    });

    collegeInput.addEventListener("blur", () => {
        setTimeout(() => {
            if (!isValidCollege(collegeInput.value)) {
                collegeInput.dataset.selected = "false";
            }
            closeSuggestions();
        }, 120);
    });

    document.addEventListener("click", (e) => {
        if (!e.target.closest(".college-autocomplete")) {
            closeSuggestions();
        }
    });

    function handleFile(file) {
        selectedFile = file;
        preview.textContent = file.name;

        collegeInput.value = "";
        collegeInput.dataset.selected = "false";
        collegeInput.classList.remove("college-invalid");

        document.getElementById("year").value = "";
        document.getElementById("semester").value = "";
        document.getElementById("branch").value = "";
        document.getElementById("subject").value = "";
        document.getElementById("chapter").value = "";

        closeSuggestions();

        form.style.display = "flex";
        uploadBtn.style.display = "block";

        setTimeout(() => {
            preview.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
        }, 100);
    }
//TODO:Moderator
    uploadBtn.addEventListener("click", async () => {
        const collegeRaw = collegeInput.value.trim();
        const year = document.getElementById("year").value;
        const semester = document.getElementById("semester").value;
        const branch = document.getElementById("branch").value.trim();
        const subject = document.getElementById("subject").value.trim();
        const chapter = document.getElementById("chapter").value.trim();

        if (!selectedFile) {
            showUploadPopup("error", "No File Selected", "Please choose a file before uploading.");
            return;
        }

        if (!collegeRaw || !isValidCollege(collegeRaw)) {
            collegeInput.classList.add("college-invalid");
            collegeInput.focus();
            showUploadPopup("error", "Invalid College", "Please select a valid college from the suggestions.");
            return;
        }

        if (!year || !semester || !branch || !subject || !chapter) {
            showUploadPopup("error", "Missing Details", "Please fill all metadata fields before uploading.");
            return;
        }

        const college = getCanonicalCollege(collegeRaw);

        uploadBtn.disabled = true;
        showLoader();

        const extension = selectedFile.name.split(".").pop();
        const timestamp = Date.now();

        const newFileName =
            `${college}_${branch}_${subject}_${chapter}_${semester}_${timestamp}.${extension}`;

        const renamedFile = new File(
            [selectedFile],
            newFileName,
            { type: selectedFile.type }
        );

        const formData = new FormData();
        formData.append("file", renamedFile);
        formData.append("college", college);
        formData.append("year", year);
        formData.append("semester", semester);
        formData.append("branch", branch);
        formData.append("subject", subject);
        formData.append("chapter", chapter);

        try {
            const res = await fetch("/upload_docs", {
                method: "POST",
                body: formData
            });

            const data = await res.json().catch(() => ({}));

            hideLoader();
            uploadBtn.disabled = false;

            if (res.ok && data.success) {
                collegeInput.value = "";
                collegeInput.dataset.selected = "false";
                collegeInput.classList.remove("college-invalid");

                document.getElementById("year").value = "";
                document.getElementById("semester").value = "";
                document.getElementById("branch").value = "";
                document.getElementById("subject").value = "";
                document.getElementById("chapter").value = "";

                selectedFile = null;
                fileInput.value = "";
                preview.textContent = "";

                closeSuggestions();

                form.style.display = "none";
                uploadBtn.style.display = "none";

                showUploadPopup(
                    "success",
                    "Upload Complete",
                    "Your document has been uploaded successfully and is now under review."
                );
            } else {
                showUploadPopup(
                    "error",
                    "Upload Failed",
                    data.message || "Something went wrong while uploading your document."
                );
            }
        } catch (err) {
            hideLoader();
            uploadBtn.disabled = false;

            showUploadPopup(
                "error",
                "Network Error",
                "Could not connect to the server. Please try again."
            );
        }
    });
</script>
</html>