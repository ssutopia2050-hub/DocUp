<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DocUp Dev | Doc Price Manager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Saira:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link rel="stylesheet" href="/dev_doc_price.css">
    <link rel="stylesheet" href="/page-loader.css">
</head>
<body>
<div class="price-shell">

    <!-- ======== SIDEBAR ======== -->
    <aside class="price-sidebar">
        <div class="box" style="display:flex;align-items:flex-end;justify-content:center;flex-direction:row;padding-bottom:20px;">
            <h1 style="font-size:3rem;font-family:'Archivo Black',sans-serif;">DocUp</h1>
            <h3 style="color:orangered;">Dev</h3>
        </div>
        <nav class="price-nav">
            <a href="/dev/dashboard">Dashboard</a>
            <a href="/dev/users">Users</a>
            <a href="/dev/docs">Docs</a>
            <a href="/dev/reports">Reports</a>
            <a href="/dev/activity">Activity</a>
            <a href="/dev/coupons">Coupon Manager</a>
            <a href="/dev/exam-tracker">Exam Tracker</a>
            <a href="/dev/doc-price" class="active">Doc Price</a>
        </nav>
    </aside>

    <!-- ======== MAIN ======== -->
    <main class="price-main">

        <!-- TOP BAR -->
        <header class="price-topbar">
            <div class="topbar-left">
                <h2>Doc Price Manager</h2>
                <p class="subtitle">Set and adjust pricing for any document</p>
            </div>
            <div class="topbar-right">
                <div class="stats-pill">
                    <span>Total Docs</span>
                    <strong><%= total %></strong>
                </div>
                <% if (page && totalPages) { %>
                <div class="stats-pill">
                    <span>Page</span>
                    <strong><%= page %> / <%= totalPages %></strong>
                </div>
                <% } %>
            </div>
        </header>

        <!-- CONTENT -->
        <section class="price-content">

            <!-- FLASH MESSAGES -->
            <% if (successMsg) { %>
            <div class="flash flash-good" id="flashMsg">
                <span class="flash-icon">✓</span>
                <%= successMsg %>
                <button class="flash-close" onclick="document.getElementById('flashMsg').remove()">×</button>
            </div>
            <% } %>
            <% if (errorMsg) { %>
            <div class="flash flash-danger" id="flashMsg">
                <span class="flash-icon">!</span>
                <%= errorMsg %>
                <button class="flash-close" onclick="document.getElementById('flashMsg').remove()">×</button>
            </div>
            <% } %>

            <!-- SEARCH BAR -->
            <div class="search-bar-wrap">
                <form method="GET" action="/dev/doc-price" class="search-form">
                    <div class="search-box">
                        <svg class="search-icon" viewBox="0 0 20 20" fill="none">
                            <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.8"/>
                            <path d="M14 14l3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                        <input
                            type="text"
                            name="search"
                            value="<%= search %>"
                            placeholder="Search by subject, chapter, college, type…"
                            class="search-input"
                            autocomplete="off"
                        >
                        <% if (search) { %>
                        <a href="/dev/doc-price" class="search-clear">×</a>
                        <% } %>
                    </div>
                    <button type="submit" class="btn btn-primary">Search</button>
                </form>
            </div>

            <!-- FILTER PILLS -->
            <div class="filter-row" id="filterRow">
                <button class="filter-pill active" data-filter="all">All</button>
                <button class="filter-pill" data-filter="college_doc">College</button>
                <button class="filter-pill" data-filter="ed_doc">Education</button>
                <button class="filter-pill" data-filter="research_doc">Research</button>
                <button class="filter-pill" data-filter="random_doc">Random</button>
                <div class="filter-divider"></div>
                <button class="filter-pill" data-filter="protected">🔒 Protected</button>
                <button class="filter-pill" data-filter="reviewed">✓ Reviewed</button>
            </div>

            <!-- BULK ACTION BAR (shows when rows selected) -->
            <div class="bulk-bar" id="bulkBar">
                <span class="bulk-info"><span id="selectedCount">0</span> selected</span>
                <div class="bulk-controls">
                    <label class="bulk-label">Set all to</label>
                    <input type="number" id="bulkPrice" min="1" class="bulk-input" placeholder="e.g. 5">
                    <button class="btn btn-primary btn-sm" id="bulkApplyBtn">Apply to Selected</button>
                </div>
                <button class="bulk-deselect" id="deselectAll">Deselect all</button>
            </div>

            <!-- DOCS TABLE -->
            <% if (docs && docs.length > 0) { %>

            <!-- GROUP HEADERS rendered server-side: group by college+year+branch -->
            <%
            // Build grouped structure
            const groups = {};
            docs.forEach(doc => {
                const college = doc.college || "Unknown College";
                const docType = doc.doc_type || "unknown";
                const key = college + "||" + docType;
                if (!groups[key]) groups[key] = { college, docType, docs: [] };
                groups[key].docs.push(doc);
            });
            const groupKeys = Object.keys(groups);
            %>

            <div class="groups-wrap">
            <% groupKeys.forEach(key => {
                const g = groups[key];
                const typeLabel = {
                    college_doc: "College",
                    ed_doc: "Education",
                    research_doc: "Research",
                    random_doc: "Random"
                }[g.docType] || g.docType;
                const typeClass = {
                    college_doc: "type-college",
                    ed_doc: "type-ed",
                    research_doc: "type-research",
                    random_doc: "type-random"
                }[g.docType] || "";
            %>

            <div class="group-block" data-group-type="<%= g.docType %>">
                <div class="group-head">
                    <div class="group-head-left">
                        <span class="group-type-badge <%= typeClass %>"><%= typeLabel %></span>
                        <h3 class="group-college"><%= g.college %></h3>
                        <span class="group-count"><%= g.docs.length %> doc<%= g.docs.length !== 1 ? 's' : '' %></span>
                    </div>
                    <div class="group-head-right">
                        <label class="group-select-all-label">
                            <input type="checkbox" class="group-select-all" data-group="<%= key %>"> Select all
                        </label>
                    </div>
                </div>

                <div class="doc-table-wrap">
                    <table class="doc-table">
                        <thead>
                            <tr>
                                <th class="col-check"></th>
                                <th class="col-subject">Subject / Chapter</th>
                                <th class="col-meta">Year &amp; Semester</th>
                                <th class="col-tags">Tags</th>
                                <th class="col-price">Current Price</th>
                                <th class="col-action">Set Price</th>
                            </tr>
                        </thead>
                        <tbody>
                        <% g.docs.forEach(doc => { %>
                        <tr class="doc-row"
                            data-doc-type="<%= doc.doc_type || '' %>"
                            data-protected="<%= doc.protected %>"
                            data-reviewed="<%= doc.reviewed %>"
                            data-id="<%= doc._id %>">
                            <td class="col-check">
                                <input type="checkbox" class="row-check" data-id="<%= doc._id %>">
                            </td>
                            <td class="col-subject">
                                <div class="doc-subject"><%= doc.subject || '—' %></div>
                                <div class="doc-chapter"><%= doc.chapter || '' %></div>
                            </td>
                            <td class="col-meta">
                                <% if (doc.year || doc.semester) { %>
                                <div class="meta-chip-row">
                                    <% if (doc.year) { %><span class="meta-chip">Yr <%= doc.year %></span><% } %>
                                    <% if (doc.semester) { %><span class="meta-chip">Sem <%= doc.semester %></span><% } %>
                                </div>
                                <% } else { %>
                                <span class="muted-text">—</span>
                                <% } %>
                            </td>
                            <td class="col-tags">
                                <div class="tag-row">
                                    <% if (doc.protected) { %><span class="tag tag-lock">🔒 Protected</span><% } %>
                                    <% if (doc.reviewed) { %><span class="tag tag-good">✓ Reviewed</span><% } else { %><span class="tag tag-warn">Unreviewed</span><% } %>
                                </div>
                            </td>
                            <td class="col-price">
                                <span class="price-badge" id="price-badge-<%= doc._id %>">
                                    ₹<%= doc.price || 1 %>
                                </span>
                            </td>
                            <td class="col-action">
                                <form class="price-form inline-form"
                                      action="/dev/doc-price/<%= doc._id %>"
                                      method="POST">
                                    <input type="hidden" name="page" value="<%= page %>">
                                    <input type="hidden" name="search" value="<%= search %>">
                                    <div class="inline-price-wrap">
                                        <span class="rupee-prefix">₹</span>
                                        <input
                                            type="number"
                                            name="price"
                                            class="price-input"
                                            value="<%= doc.price || 1 %>"
                                            min="1"
                                            required
                                        >
                                        <button type="submit" class="btn btn-update">Save</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

            <% }) %>
            </div>

            <!-- PAGINATION -->
            <% if (totalPages > 1) { %>
            <div class="pagination">
                <% if (page > 1) { %>
                <a href="/dev/doc-price?page=<%= page - 1 %>&search=<%= encodeURIComponent(search) %>" class="page-btn">← Prev</a>
                <% } else { %>
                <span class="page-btn page-disabled">← Prev</span>
                <% } %>

                <%
                const windowSize = 5;
                let startPage = Math.max(1, page - Math.floor(windowSize / 2));
                let endPage   = Math.min(totalPages, startPage + windowSize - 1);
                if (endPage - startPage < windowSize - 1) startPage = Math.max(1, endPage - windowSize + 1);
                %>
                <% if (startPage > 1) { %>
                <a href="/dev/doc-price?page=1&search=<%= encodeURIComponent(search) %>" class="page-btn">1</a>
                <% if (startPage > 2) { %><span class="page-ellipsis">…</span><% } %>
                <% } %>

                <% for (let p = startPage; p <= endPage; p++) { %>
                <a href="/dev/doc-price?page=<%= p %>&search=<%= encodeURIComponent(search) %>"
                   class="page-btn <%= p === page ? 'page-active' : '' %>"><%= p %></a>
                <% } %>

                <% if (endPage < totalPages) { %>
                <% if (endPage < totalPages - 1) { %><span class="page-ellipsis">…</span><% } %>
                <a href="/dev/doc-price?page=<%= totalPages %>&search=<%= encodeURIComponent(search) %>" class="page-btn"><%= totalPages %></a>
                <% } %>

                <% if (page < totalPages) { %>
                <a href="/dev/doc-price?page=<%= page + 1 %>&search=<%= encodeURIComponent(search) %>" class="page-btn">Next →</a>
                <% } else { %>
                <span class="page-btn page-disabled">Next →</span>
                <% } %>
            </div>
            <% } %>

            <% } else { %>
            <div class="empty-state">
                <div class="empty-icon">₹</div>
                <h3>No docs found</h3>
                <p>Try a different search term or <a href="/dev/doc-price">clear the search</a>.</p>
            </div>
            <% } %>

        </section>
    </main>
</div>

<!-- BULK UPDATE MODAL (hidden, triggered by bulk apply) -->
<div class="modal-overlay" id="bulkModal">
    <div class="modal">
        <h3 class="modal-title">Confirm Bulk Price Update</h3>
        <p class="modal-body">You are about to update <strong id="modalCount">0</strong> docs to ₹<strong id="modalPrice">—</strong>. This action will make individual POST requests for each selected doc.</p>
        <div class="modal-actions">
            <button class="btn btn-secondary" id="modalCancel">Cancel</button>
            <button class="btn btn-primary" id="modalConfirm">Confirm &amp; Update</button>
        </div>
        <div class="modal-progress" id="modalProgress" style="display:none;">
            <div class="progress-bar-wrap">
                <div class="progress-bar-fill" id="progressFill"></div>
            </div>
            <p class="progress-label" id="progressLabel">Updating…</p>
        </div>
    </div>
</div>

<script>
/* ===================================================
   FILTER PILLS — client-side filtering on loaded rows
=================================================== */
const filterPills = document.querySelectorAll(".filter-pill");
const groupBlocks = document.querySelectorAll(".group-block");
const docRows = document.querySelectorAll(".doc-row");

let activeFilter = "all";

filterPills.forEach(pill => {
    pill.addEventListener("click", () => {
        filterPills.forEach(p => p.classList.remove("active"));
        pill.classList.add("active");
        activeFilter = pill.dataset.filter;
        applyClientFilter();
    });
});

function applyClientFilter() {
    docRows.forEach(row => {
        let show = true;
        if (activeFilter === "all") {
            show = true;
        } else if (activeFilter === "protected") {
            show = row.dataset.protected === "true";
        } else if (activeFilter === "reviewed") {
            show = row.dataset.reviewed === "true";
        } else {
            show = row.dataset.docType === activeFilter;
        }
        row.style.display = show ? "" : "none";
    });

    // Hide empty group blocks
    groupBlocks.forEach(gb => {
        const visibleRows = gb.querySelectorAll(".doc-row:not([style*='display: none'])");
        gb.style.display = visibleRows.length === 0 ? "none" : "";
    });
}

/* ===================================================
   CHECKBOX SELECTION
=================================================== */
const bulkBar      = document.getElementById("bulkBar");
const selectedCount = document.getElementById("selectedCount");
const deselectBtn  = document.getElementById("deselectAll");

function updateBulkBar() {
    const checked = document.querySelectorAll(".row-check:checked");
    selectedCount.textContent = checked.length;
    bulkBar.classList.toggle("visible", checked.length > 0);
}

document.querySelectorAll(".row-check").forEach(cb => {
    cb.addEventListener("change", updateBulkBar);
});

document.querySelectorAll(".group-select-all").forEach(cb => {
    cb.addEventListener("change", e => {
        const groupKey = e.target.dataset.group;
        const rows = document.querySelectorAll(`.doc-row`);
        // Select all visible rows within this group block
        const groupBlock = e.target.closest(".group-block");
        groupBlock.querySelectorAll(".row-check").forEach(r => {
            const tr = r.closest(".doc-row");
            if (tr.style.display !== "none") r.checked = e.target.checked;
        });
        updateBulkBar();
    });
});

deselectBtn.addEventListener("click", () => {
    document.querySelectorAll(".row-check").forEach(cb => cb.checked = false);
    document.querySelectorAll(".group-select-all").forEach(cb => cb.checked = false);
    updateBulkBar();
});

/* ===================================================
   BULK PRICE UPDATE with modal + progress
=================================================== */
const bulkApplyBtn = document.getElementById("bulkApplyBtn");
const bulkModal    = document.getElementById("bulkModal");
const modalCancel  = document.getElementById("modalCancel");
const modalConfirm = document.getElementById("modalConfirm");
const modalCount   = document.getElementById("modalCount");
const modalPrice   = document.getElementById("modalPrice");
const modalProgress= document.getElementById("modalProgress");
const progressFill = document.getElementById("progressFill");
const progressLabel= document.getElementById("progressLabel");

bulkApplyBtn.addEventListener("click", () => {
    const price = parseInt(document.getElementById("bulkPrice").value);
    if (!price || price < 1) {
        alert("Enter a valid price (minimum 1).");
        return;
    }
    const checked = document.querySelectorAll(".row-check:checked");
    if (checked.length === 0) return;
    modalCount.textContent = checked.length;
    modalPrice.textContent = price;
    bulkModal.classList.add("open");
});

modalCancel.addEventListener("click", () => {
    bulkModal.classList.remove("open");
});

modalConfirm.addEventListener("click", async () => {
    const price = parseInt(document.getElementById("bulkPrice").value);
    const checked = Array.from(document.querySelectorAll(".row-check:checked"));
    const total   = checked.length;

    modalConfirm.disabled = true;
    modalCancel.disabled  = true;
    modalProgress.style.display = "";

    let done = 0;
    const errors = [];

    for (const cb of checked) {
        const docId = cb.dataset.id;
        try {
            const form = new FormData();
            form.append("price", price);
            form.append("page", "<%= page %>");
            form.append("search", "<%= search %>");

            const res = await fetch(`/dev/doc-price/${docId}`, {
                method: "POST",
                body: new URLSearchParams({ price, page: "<%= page %>", search: "<%= search %>" })
            });

            if (res.ok || res.redirected) {
                // Update badge in UI immediately
                const badge = document.getElementById(`price-badge-${docId}`);
                if (badge) badge.textContent = `₹${price}`;
                // Update the row input too
                const row = cb.closest(".doc-row");
                if (row) {
                    const inp = row.querySelector(".price-input");
                    if (inp) inp.value = price;
                }
            } else {
                errors.push(docId);
            }
        } catch (e) {
            errors.push(docId);
        }

        done++;
        const pct = Math.round((done / total) * 100);
        progressFill.style.width = pct + "%";
        progressLabel.textContent = `Updated ${done} / ${total}…`;
    }

    if (errors.length > 0) {
        progressLabel.textContent = `Done! ${done - errors.length} updated, ${errors.length} failed.`;
    } else {
        progressLabel.textContent = `✓ All ${done} docs updated to ₹${price}!`;
    }

    setTimeout(() => {
        bulkModal.classList.remove("open");
        modalProgress.style.display = "none";
        progressFill.style.width = "0%";
        modalConfirm.disabled = false;
        modalCancel.disabled  = false;
        // Deselect all
        document.querySelectorAll(".row-check").forEach(c => c.checked = false);
        document.querySelectorAll(".group-select-all").forEach(c => c.checked = false);
        updateBulkBar();
    }, 1800);
});

// Close modal on overlay click
bulkModal.addEventListener("click", e => {
    if (e.target === bulkModal) bulkModal.classList.remove("open");
});

/* ===================================================
   AUTO-DISMISS flash after 4s
=================================================== */
const flash = document.getElementById("flashMsg");
if (flash) setTimeout(() => flash.remove(), 4000);
</script>

<%- include('partials/page-loader') %>
</body>
</html>
