<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>DocUp | ViewDoc</title>
    <link rel="shortcut icon" href="/images/favicon.ico" type="image/x-icon">
    <link href="/docview.css" rel="stylesheet">
    <script defer src="https://cloud.umami.is/script.js" data-website-id="fb0fa4fe-2b54-4d33-8482-1efac75331d2"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
          rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
</head>
<body>

<!-- ═══════════════ TOPBAR ═══════════════ -->
<header class="topbar">
    <div class="topbar-left">
        <a class="logo-wordmark" href="/dashboard">Doc<span>Up</span></a>
        <div class="topbar-divider"></div>
        <span class="topbar-breadcrumb">
            <a href="/college/<%= encodeURIComponent(doc.college) %>"><%= doc.college %></a>
            <svg fill="none" height="12" viewBox="0 0 12 12" width="12"><path d="M4.5 2.5L7.5 6L4.5 9.5"
                                                                              stroke="currentColor" stroke-linecap="round"
                                                                              stroke-linejoin="round"
                                                                              stroke-width="1.4"/></svg>
            <span class="breadcrumb-current"><%= doc.subject %></span>
        </span>
    </div>

    <div class="topbar-right">
        <!-- Search -->
        <button aria-label="Search" class="icon-btn">
            <svg fill="none" height="18" viewBox="0 0 24 24" width="18">
                <path d="M11 19a8 8 0 100-16 8 8 0 000 16zM21 21l-4.35-4.35" stroke="currentColor" stroke-linecap="round"
                      stroke-width="1.8"/>
            </svg>
        </button>

        <!-- Notifications -->
        <div class="notification-wrap">
            <button aria-label="Notifications" class="icon-btn notification-btn">
                <svg fill="none" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 17H15M6.5 17H17.5C16.9 16.35 16.5 15.48 16.5 14.5V10.5C16.5 8.01 14.49 6 12 6C9.51 6 7.5 8.01 7.5 10.5V14.5C7.5 15.48 7.1 16.35 6.5 17Z"
                          stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/>
                    <path d="M10.5 20C10.74 20.62 11.32 21 12 21C12.68 21 13.26 20.62 13.5 20" stroke="currentColor"
                          stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/>
                </svg>
                <% const unreadCount = (user.notifications || []).filter(n => !n.isRead).length; %>
                <% if (unreadCount > 0) { %>
                <span class="notif-badge"><%= unreadCount > 9 ? "9+" : unreadCount %></span>
                <% } %>
            </button>

            <div class="notification-dropdown">
                <div class="nd-header">
                    <span class="nd-title">Notifications</span>
                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <a class="nd-view-all" href="/notifications">See all</a>
                    <% } %>
                </div>
                <div class="nd-list">
                    <% if (user.notifications && user.notifications.length > 0) { %>
                    <% user.notifications.slice().reverse().forEach((item) => { %>
                    <div class="nd-item <%= item.isRead ? '' : 'unread' %>">
                        <div class="nd-item-row">
                            <span class="nd-dot"></span>
                            <span class="nd-when">
                                <%= item.createdAt ? new Date(item.createdAt).toLocaleString("en-IN",{dateStyle:"medium",timeStyle:"short"}) : "Just now" %>
                            </span>
                        </div>
                        <p class="nd-text"><%= item.content %></p>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="nd-empty">No notifications yet.</div>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Avatar -->
        <div class="avatar-btn">
            <% if (user.avatar_img_path) { %>
            <img alt="" src="<%= user.avatar_img_path %>">
            <% } else { %>
            <%= user.name ? user.name.charAt(0).toUpperCase() : "U" %>
            <% } %>
        </div>
    </div>
</header>

<!-- Avatar dropdown -->
<div class="avatar-dropdown">
    <a href="/profile">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/>
            <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" stroke="currentColor" stroke-linecap="round" stroke-width="1.6"/>
        </svg>
        Profile
    </a>
    <a href="/pricing">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                  stroke-width="1.6"/>
        </svg>
        Recharge DocScore
    </a>

    <a href="/upgrade-plans">
        <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                  stroke-width="1.6"/>
        </svg>
        Upgrade Plans
    </a>
</div>

<!-- ═══════════════ HERO STRIP ═══════════════ -->
<div class="hero-strip">
    <div class="hero-strip-inner">
        <div class="hero-left">
            <div class="college-logo-wrap">
                <img
                        alt="college logo"
                        onerror="this.onerror=null;this.src='/images/default.png';"
                        src="<%= college_data && college_data.image ? college_data.image : '/images/default.png' %>"
                >
            </div>
            <div class="hero-meta">
                <div class="hero-meta-top">
                    <span class="college-chip"><%= doc.college %></span>
                    <% if (doc.reviewed) { %>
                    <span class="status-chip verified">
                        <svg fill="none" height="10" viewBox="0 0 12 12" width="10"><path d="M2 6l3 3 5-5"
                                                                                          stroke="currentColor"
                                                                                          stroke-linecap="round"
                                                                                          stroke-linejoin="round"
                                                                                          stroke-width="1.8"/></svg>
                        Verified
                    </span>
                    <% } else { %>
                    <span class="status-chip pending">Under Review</span>
                    <% } %>
                </div>
                <h1 class="hero-title"><%= doc.title || doc.chapter %></h1>
                <p class="hero-sub"><%= doc.subject %> &nbsp;·&nbsp; <%= doc.branch %> &nbsp;·&nbsp; Year <%= doc.year
                    %> &nbsp;·&nbsp; Sem <%= doc.semester %></p>
                <div class="hero-tags">
                    <span class="htag"><%= doc.subject %></span>
                    <span class="htag"><%= doc.branch %></span>
                    <span class="htag">Year <%= doc.year %></span>
                    <span class="htag"><%= doc.chapter %></span>
                </div>
            </div>
        </div>

        <div class="hero-actions">
            <a class="ha-btn ghost" href="/college/<%= encodeURIComponent(doc.college) %>">
                <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
                    <path d="M19 12H5M5 12L12 19M5 12L12 5" stroke="currentColor" stroke-linecap="round"
                          stroke-linejoin="round" stroke-width="1.7"/>
                </svg>
                Back
            </a>

            <button class="ha-btn accent" data-doc-chapter="<%= doc.chapter %>" data-doc-college="<%= doc.college %>"
                    data-doc-id="<%= doc._id %>"
                    data-doc-subject="<%= doc.subject %>"
                    id="open-share-doc-modal"
                    type="button">
                <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
                    <path d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13" stroke="currentColor"
                          stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/>
                </svg>
                Share to Chat
            </button>

            <div class="vote-cluster">
                <a class="vote-btn like" href="/update_likes/<%= doc._id %>">
                    <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
                        <path d="M14 9V5a3 3 0 00-3-3l-4 9v11h11.28a2 2 0 002-1.7l1.38-9a2 2 0 00-2-2.3H14zM7 22H4a2 2 0 01-2-2v-7a2 2 0 012-2h3"
                              stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/>
                    </svg>
                    <span><%= doc.likes %></span>
                </a>
                <span class="vote-sep"></span>
                <a class="vote-btn dislike" href="/update_dislikes/<%= doc._id %>">
                    <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
                        <path d="M10 15v4a3 3 0 003 3l4-9V2H5.72a2 2 0 00-2 1.7l-1.38 9a2 2 0 002 2.3H10zM17 2h2.67A2.31 2.31 0 0122 4v7a2.31 2.31 0 01-2.33 2H17"
                              stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/>
                    </svg>
                    <span><%= doc.dislikes %></span>
                </a>
            </div>

            <a class="ha-btn ghost save-btn" href="/save/<%= doc._id %>">
                <svg fill="none" height="15" viewBox="0 0 24 24" width="15">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 012-2h10a2 2 0 012 2z" stroke="currentColor" stroke-linecap="round"
                          stroke-linejoin="round" stroke-width="1.6"/>
                </svg>
                Save
            </a>
        </div>
    </div>
</div>

<!-- ═══════════════ MAIN WORKSPACE ═══════════════ -->
<main class="workspace">

    <!-- ── PDF COLUMN ── -->
    <section class="pdf-column">

        <!-- Floating toolbar -->
        <div class="pdf-toolbar">
            <div class="ptb-left">
                <div class="ptb-zoom-group">
                    <button class="ptb-btn" id="zoom-out" title="Zoom out">
                        <svg fill="none" height="14" viewBox="0 0 24 24" width="14">
                            <path d="M5 12h14" stroke="currentColor" stroke-linecap="round" stroke-width="2"/>
                        </svg>
                    </button>
                    <span class="ptb-zoom-pill" id="zoom-percentage">115%</span>
                    <button class="ptb-btn" id="zoom-in" title="Zoom in">
                        <svg fill="none" height="14" viewBox="0 0 24 24" width="14">
                            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-linecap="round" stroke-width="2"/>
                        </svg>
                    </button>
                    <button class="ptb-btn ptb-fit" id="fit-width">Fit</button>
                </div>

                <div class="ptb-divider"></div>

                <div class="ptb-ai-group">
                    <button class="ptb-btn ptb-ai" id="ask-pdf-btn">
                        <svg fill="none" height="13" viewBox="0 0 24 24" width="13">
                            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.7"/>
                            <path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3M12 17h.01" stroke="currentColor"
                                  stroke-linecap="round" stroke-width="1.7"/>
                        </svg>
                        Ask PDF
                    </button>
                    <button class="ptb-btn ptb-ai" id="explain-page-btn">
                        <svg fill="none" height="13" viewBox="0 0 24 24" width="13">
                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke="currentColor"
                                  stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/>
                            <polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-linecap="round"
                                      stroke-linejoin="round" stroke-width="1.7"/>
                        </svg>
                        Explain Page
                    </button>
                    <button class="ptb-btn ptb-ai" id="summarize-doc-btn">
                        <svg fill="none" height="13" viewBox="0 0 24 24" width="13">
                            <path d="M4 6h16M4 12h10M4 18h7" stroke="currentColor" stroke-linecap="round"
                                  stroke-width="1.7"/>
                        </svg>
                        Summarize
                    </button>
                </div>
            </div>

            <div class="ptb-right">
                <div class="ptb-page-nav">
                    <span class="ptb-page-label">Page</span>
                    <input id="page-jump-input" min="1" type="number" value="1">
                    <span class="ptb-page-total" id="page-jump-total">/ 0</span>
                </div>
                <span class="ptb-status" id="page-status">Loading…</span>
            </div>
        </div>

        <!-- Page counter bubble -->
        <div class="page-bubble-wrap">
            <div class="page-bubble" id="pdf-page-indicator">
                <span id="current-page-number">1</span>
                <span class="pb-sep">/</span>
                <span id="total-page-number">0</span>
            </div>
        </div>

        <!-- PDF Canvas area -->
        <div class="pdf-canvas-area" id="pdf-scroll-area">
            <div class="reader-watermark-shell">
                <div id="pdf-container"></div>
            </div>
        </div>
    </section>

    <!-- ── SIDEBAR ── -->
    <aside class="sidebar">

        <!-- AI Card -->
        <div class="sc ai-sc">
            <div class="sc-header">
                <div class="sc-header-left">
                    <span class="sc-icon-wrap">
                        <svg fill="none" height="14" viewBox="0 0 24 24" width="14"><path
                                d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor"
                                stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
                    </span>
                    <h2>AI Explainer</h2>
                </div>
                <span class="ai-badge" id="ai-status-badge">Beta</span>
            </div>

            <div class="ai-input-row">
                <input id="ask-pdf-input" placeholder="Ask anything from this PDF…" type="text">
                <button id="ask-pdf-send-btn" type="button">
                    <svg fill="none" height="16" viewBox="0 0 24 24" width="16">
                        <path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z" stroke="currentColor" stroke-linecap="round"
                              stroke-linejoin="round" stroke-width="1.8"/>
                    </svg>
                </button>
            </div>

            <div class="ai-pill-row">
                <button class="ai-pill" id="mini-explain-trigger" type="button">Explain this page</button>
                <button class="ai-pill" id="mini-summary-trigger" type="button">Summarize doc</button>
            </div>

            <div class="ai-output" id="ai-panel-content">
                <p class="ai-placeholder">Use Ask PDF, Explain This Page, or Summarize Document to get started.</p>
            </div>
        </div>

        <!-- Doc Info Card -->
        <div class="sc info-sc">
            <div class="sc-header">
                <span class="sc-icon-wrap">
                    <svg fill="none" height="14" viewBox="0 0 24 24" width="14"><rect height="18" rx="2" stroke="currentColor" stroke-width="1.7"
                                                                                      width="18" x="3"
                                                                                      y="3"/><path
                            d="M3 9h18M9 21V9" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"/></svg>
                </span>
                <h2>Document Info</h2>
            </div>
            <dl class="info-dl">
                <div class="info-row">
                    <dt>College</dt>
                    <dd><a href="/college/<%= encodeURIComponent(doc.college) %>"><%= doc.college %></a></dd>
                </div>
                <div class="info-row">
                    <dt>Subject</dt>
                    <dd><%= doc.subject %></dd>
                </div>
                <div class="info-row">
                    <dt>Semester</dt>
                    <dd>Semester <%= doc.semester %></dd>
                </div>
                <div class="info-row">
                    <dt>Branch</dt>
                    <dd><%= doc.branch %></dd>
                </div>
                <div class="info-row">
                    <dt>Chapter</dt>
                    <dd><%= doc.chapter %></dd>
                </div>
                <div class="info-row">
                    <dt>Uploader</dt>
                    <dd><%= doc.uploaded_by || "DocUp User" %></dd>
                </div>
            </dl>
        </div>

        <!-- Discussion Card -->
        <div class="sc discussion-sc">
            <div class="sc-header">
                <span class="sc-icon-wrap">
                    <svg fill="none" height="14" viewBox="0 0 24 24" width="14"><path
                            d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke="currentColor"
                            stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
                </span>
                <h2>Discussion</h2>
                <span class="comment-count-chip"><%= doc.comment_section ? doc.comment_section.length : 0 %></span>
            </div>

            <!-- Comment input -->
            <div class="comment-input-wrap">
                <input class="comment-input-container" placeholder="Join the discussion…" type="text">
                <button aria-label="Send" class="comment-send-btn">
                    <svg class="comment-send-button" fill="none" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M10.3009 13.6949L20.102 3.89742M10.5795 14.1355L12.8019 18.5804C13.339 19.6545 13.6075 20.1916 13.9458 20.3356C14.2394 20.4606 14.575 20.4379 14.8492 20.2747C15.1651 20.0866 15.3591 19.5183 15.7472 18.3818L19.9463 6.08434C20.2845 5.09409 20.4535 4.59896 20.3378 4.27142C20.2371 3.98648 20.013 3.76234 19.7281 3.66167C19.4005 3.54595 18.9054 3.71502 17.9151 4.05315L5.61763 8.2523C4.48114 8.64037 3.91289 8.83441 3.72478 9.15032C3.56153 9.42447 3.53891 9.76007 3.66389 10.0536C3.80791 10.3919 4.34498 10.6605 5.41912 11.1975L9.86397 13.42C10.041 13.5085 10.1295 13.5527 10.2061 13.6118C10.2742 13.6643 10.3352 13.7253 10.3876 13.7933C10.4468 13.87 10.491 13.9585 10.5795 14.1355Z"
                              stroke="#FF4500FF" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
                    </svg>
                </button>
            </div>

            <!-- Comments list -->
            <div class="comments-list">
                <% if (doc.comment_section && doc.comment_section.length > 0) { %>
                <% doc.comment_section.forEach((item) => { %>
                <div class="cmt">
                    <div class="cmt-avatar">
                        <img alt="avatar"
                             src="<%= item.user_id && item.user_id.avatar_img_path ? item.user_id.avatar_img_path : '/images/default-avatar.png' %>">
                    </div>
                    <div class="cmt-body">
                        <div class="cmt-top">
                            <a class="cmt-name"
                               href="/show_other_user_profile/<%= encodeURIComponent(item.user_id.email) %>">
                                <%= item.user_id && item.user_id.name ? item.user_id.name : "DocUp User" %>
                            </a>
                            <span class="cmt-time"><%= new Date(item.createdAt).toLocaleString() %></span>
                        </div>
                        <p class="cmt-text"><%= item.comment %></p>
                        <button class="cmt-reply-btn reply-btn"
                                data-reply-email="<%= item.user_id && item.user_id.email ? item.user_id.email : '' %>"
                                data-reply-name="<%= item.user_id && item.user_id.name ? item.user_id.name : 'DocUp User' %>">
                            ↩ Reply
                        </button>
                    </div>
                </div>
                <% }) %>
                <% } else { %>
                <div class="cmt-empty">No comments yet. Start the discussion!</div>
                <% } %>
            </div>
        </div>

        <!-- Scroll to top -->
        <button class="scroll-top-btn" id="scrollTopBtn">
            <svg fill="none" height="14" viewBox="0 0 24 24" width="14">
                <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                      stroke-width="2"/>
            </svg>
            Back to Top
        </button>
    </aside>
</main>

<!-- ═══════════════ SHARE MODAL ═══════════════ -->
<div class="modal-overlay hidden" id="share-doc-modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card">
        <div class="modal-card-head">
            <span class="modal-eyebrow">DocUp Share</span>
            <h2>Share to College Chat</h2>
            <p>Send this document to your college room with a message.</p>
        </div>

        <div class="modal-doc-preview">
            <div class="mdp-label">Sharing</div>
            <div class="mdp-title"><%= doc.subject %></div>
            <div class="mdp-sub"><%= doc.chapter %> · <%= doc.college %></div>
        </div>

        <textarea class="modal-textarea" id="share-doc-text" maxlength="300"
                  placeholder="Add a message about this document…"></textarea>

        <div class="modal-actions">
            <button class="ma-btn ghost" id="close-share-doc-modal" type="button">Cancel</button>
            <button class="ma-btn accent" id="confirm-share-doc" type="button">Share</button>
        </div>
    </div>
</div>

<!-- Share success -->
<div class="modal-overlay hidden" id="share-success-modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card modal-success">
        <div class="success-icon">
            <svg fill="none" height="28" viewBox="0 0 24 24" width="28">
                <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                      stroke-width="2.2"/>
            </svg>
        </div>
        <h2>Document Shared!</h2>
        <p>Successfully shared to your college chat room.</p>
        <div class="modal-actions">
            <button class="ma-btn ghost" id="continue-reading-btn" type="button">Continue Reading</button>
            <a class="ma-btn accent" href="/college_chat/<%= encodeURIComponent(doc.college) %>"
               id="go-to-chat-room-btn">Go to Chat</a>
        </div>
    </div>
</div>

<!-- ═══════════════ SCRIPTS ═══════════════ -->
<script>
    window.DOC_SHARE_CONFIG = {
        docId: <%-JSON.stringify(String(doc._id)) % >,
        collegeName
    :
    <%-JSON.stringify(doc.college) % >
    }

</script>
<script src="/doc_share.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const input = document.querySelector(".comment-input-container");

        document.querySelectorAll(".reply-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                input.value = `@${btn.dataset.replyEmail}# : `;
                input.focus();
            });
        });

        document.getElementById("mini-explain-trigger")?.addEventListener("click", () => {
            document.getElementById("explain-page-btn")?.click();
        });
        document.getElementById("mini-summary-trigger")?.addEventListener("click", () => {
            document.getElementById("summarize-doc-btn")?.click();
        });
    });
</script>

<script src="/dashboard2.js"></script>
<script>const DOC_ID = "<%= doc._id %>";</script>
<script src="/doc_ai.js"></script>
<script src="/comments.js"></script>

<script>
    // Scroll to top
    const scrollBtn = document.getElementById("scrollTopBtn");
    window.addEventListener("scroll", () => {
        scrollBtn.classList.toggle("visible", window.scrollY > 400);
    });
    scrollBtn.addEventListener("click", () => window.scrollTo({top: 0, behavior: "smooth"}));

    // PDF URL
    const pdfUrl = "<%= doc.file_url %>";

    // Security
    document.addEventListener("contextmenu", e => {
        e.preventDefault();
        alert("Printing and saving are disabled on DocUp.");
    });
    document.addEventListener("keydown", e => {
        const ctrl = e.ctrlKey || e.metaKey;
        const blocked = ["s", "p", "u"].includes(e.key.toLowerCase()) && ctrl
            || (ctrl && e.shiftKey && e.key.toLowerCase() === "i")
            || e.key === "F12";
        if (blocked) {
            e.preventDefault();
            alert("Printing and saving are disabled on DocUp.");
        }
    });

    // Back/forward cache
    window.addEventListener("pageshow", e => {
        if (e.persisted) window.location.reload();
    });
    window.addEventListener("popstate", () => window.location.reload());

    // Mouse tracking
    document.addEventListener("mousemove", e => {
        document.documentElement.style.setProperty("--mx", `${e.clientX}px`);
        document.documentElement.style.setProperty("--my", `${e.clientY}px`);
    });
</script>
<script src="/docview.js"></script>
</body>
</html>
