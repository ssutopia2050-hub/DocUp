<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DocUp | <%= collegeName %> Chat</title>
    <link rel="shortcut icon" href="/images/favicon-32x32.png" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Raleway:wght@400;500;600;700;800&family=Saira:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/college_chat.css" />
</head>
<body>
<div class="topbar">
    <a href="/dashboard" class="logo-wrap">
        <div class="logo-circle">D</div>
        <div class="logo-text-wrap">
            <div class="logo-text">DocUp</div>
            <div class="logo-subtext">College Community</div>
        </div>
    </a>

    <div class="topbar-actions">
        <a href="/college/<%= encodeURIComponent(collegeName) %>" class="top-btn secondary">College Page</a>
        <a href="/dashboard" class="top-btn">Dashboard</a>
    </div>
</div>

<div class="chat-page">
    <div class="chat-shell">
        <div class="page-head">
            <div class="page-head-left">
                <div class="chat-badge">LIVE COLLEGE ROOM</div>
                <h1><%= collegeName %></h1>
                <p>Ask, discuss, and connect with students from your college on DocUp.</p>
            </div>

            <div class="room-status-card">
                <div class="status-row">
                    <span class="live-dot"></span>
                    <span class="status-label">Room Status</span>
                </div>
                <div id="status-text" class="status-value">Connected</div>
            </div>
        </div>

        <div class="chat-room-card">
            <div class="chat-room-header">
                <div class="room-title-wrap">
                    <h2>College Chat</h2>
                    <span class="room-subtitle">Real-time student discussion space</span>
                </div>
            </div>

            <div id="chat-messages" class="chat-messages">
                <% if (!oldMessages || oldMessages.length === 0) { %>
                <div class="empty-chat-state">
                    <div class="empty-chat-icon">💬</div>
                    <h3>No messages yet</h3>
                    <p>Be the first one to start the conversation in this college room.</p>
                </div>
                <% } %>

                <% oldMessages.forEach(msg => { %>
                <div class="message-row <%= msg.sender_email === currentUser.email ? 'mine' : 'other' %>">
                    <% if (msg.sender_email !== currentUser.email) { %>
                    <a
                            class="chat-avatar-link"
                            href="/show_other_user_profile/<%= encodeURIComponent(msg.sender_email) %>"
                            title="View <%= msg.sender_name %>'s profile"
                    >
                        <img
                                class="chat-avatar"
                                src="<%= msg.sender_profile_pic && msg.sender_profile_pic.trim() !== '' ? msg.sender_profile_pic : '/images/default-avatar.png' %>"
                                alt="<%= msg.sender_name %>"
                        />
                    </a>
                    <% } %>

                    <div class="message-bubble">
                        <div class="message-meta">
                            <span class="message-name"><%= msg.sender_name %></span>
                            <span class="message-time">
            <%= new Date(msg.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
        </span>
                        </div>

                        <% if (msg.message && msg.message.trim() !== "") { %>
                        <div class="message-text"><%= msg.message %></div>
                        <% } %>

                        <% if (msg.message_type === "doc_share" && msg.shared_doc && msg.shared_doc.doc_id) { %>
                        <a href="/view/<%= msg.shared_doc.doc_id %>" class="shared-doc-card">
                            <div class="shared-doc-top">
                                <div class="shared-doc-badge">DocUp Document</div>

                                <% if (msg.shared_doc.reviewed) { %>
                                <div class="shared-doc-reviewed">Reviewed</div>
                                <% } %>
                            </div>

                            <div class="shared-doc-title"><%= msg.shared_doc.subject || "Untitled Subject" %></div>

                            <div class="shared-doc-subtitle">
                                <%= msg.shared_doc.chapter || "No chapter" %>
                            </div>

                            <div class="shared-doc-meta">
                                <span><strong>College:</strong> <%= msg.shared_doc.college || "Unknown college" %></span>
                                <span><strong>Uploader:</strong> <%= msg.shared_doc.uploaded_by || "Unknown" %></span>
                                <span><strong>Likes:</strong> <%= typeof msg.shared_doc.likes === "number" ? msg.shared_doc.likes : 0 %></span>
                            </div>

                            <div class="shared-doc-open">Open Document</div>
                        </a>
                        <% } %>
                    </div>

                    <% if (msg.sender_email === currentUser.email) { %>
                    <a
                            class="chat-avatar-link"
                            href="/show_other_user_profile/<%= encodeURIComponent(msg.sender_email) %>"
                            title="View your public profile"
                    >
                        <img
                                class="chat-avatar"
                                src="<%= msg.sender_profile_pic && msg.sender_profile_pic.trim() !== '' ? msg.sender_profile_pic : '/images/default-avatar.png' %>"
                                alt="<%= msg.sender_name %>"
                        />
                    </a>
                    <% } %>
                </div>
                <% }) %>
            </div>

            <div id="system-message" class="system-message"></div>

            <form id="chat-form" class="chat-form">
                <input
                        id="chat-input"
                        type="text"
                        maxlength="1000"
                        placeholder="Type your message to the college room..."
                        autocomplete="off"
                />
                <button type="submit">Send</button>
            </form>
        </div>
    </div>
</div>
<div id="chat-guidelines-modal" class="guidelines-modal hidden">
    <div class="guidelines-backdrop"></div>

    <div class="guidelines-card">
        <div class="guidelines-top">
            <div>
                <div class="guidelines-badge">DocUp Community</div>
                <h2>Chat Guidelines</h2>
                <p>Please follow these rules to keep the college room helpful and respectful.</p>
            </div>
        </div>

        <div class="guidelines-list">
            <div class="guideline-item">
                <div class="guideline-icon">1</div>
                <div>
                    <h3>Be respectful</h3>
                    <p>No harassment, bullying, abusive language, or personal attacks.</p>
                </div>
            </div>

            <div class="guideline-item">
                <div class="guideline-icon">2</div>
                <div>
                    <h3>Keep it relevant</h3>
                    <p>Use the room for college discussions, doubts, help, notes, and useful conversations.</p>
                </div>
            </div>

            <div class="guideline-item">
                <div class="guideline-icon">3</div>
                <div>
                    <h3>No spam</h3>
                    <p>Do not flood the chat with repeated messages, ads, or meaningless text.</p>
                </div>
            </div>

            <div class="guideline-item">
                <div class="guideline-icon">4</div>
                <div>
                    <h3>Protect privacy</h3>
                    <p>Do not share phone numbers, passwords, private files, or anyone’s personal info.</p>
                </div>
            </div>

            <div class="guideline-item">
                <div class="guideline-icon">5</div>
                <div>
                    <h3>Use DocUp properly</h3>
                    <p>Any harmful, fake, offensive, or misleading behavior may lead to removal from the community.</p>
                </div>
            </div>
        </div>

        <div class="guidelines-actions">
            <button id="guidelines-close-btn" class="guidelines-btn secondary" type="button">Close</button>
            <button id="guidelines-accept-btn" class="guidelines-btn primary" type="button">I Understand</button>
        </div>
    </div>
</div>
<script>
    window.CHAT_CONFIG = {
        roomId: <%- JSON.stringify(roomId) %>,
        collegeName: <%- JSON.stringify(collegeName) %>,
        currentUser: <%- JSON.stringify(currentUser) %>
    };
</script>
<script src="/socket.io/socket.io.js"></script>
<script src="/college_chat.js"></script>
</body>
</html>